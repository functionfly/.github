# FlyMind AI Service Environment Variables
# SECURITY: Never commit this file with real API keys!
# Use environment variables or secrets manager in production.

# Service Configuration
SERVICE_NAME=flymind-ai-service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8081
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development  # Set to "production" in production deployments

# =============================================================================
# API KEYS - REQUIRED
# IMPORTANT: Obtain these from your provider dashboards. Never commit real keys!
# =============================================================================

# OpenAI API Key (from https://platform.openai.com/api-keys)
# Format: sk-... (typically starts with sk-)
OPENAI_API_KEY=

# Anthropic API Key (from https://console.anthropic.com/settings/keys)
# Format: sk-ant-... (typically starts with sk-ant-)
ANTHROPIC_API_KEY=

# FunctionFly Multi-Provider Architecture Keys
# Fireworks AI (https://fireworks.ai) - Best for structured output
FIREWORKS_API_KEY=

# Groq (https://console.groq.com) - Best for low-latency
GROQ_API_KEY=

# DeepInfra (https://deepinfra.com) - Best for batch processing
DEEPINFRA_API_KEY=

# Together AI (https://api.together.xyz) - Alternative provider
TOGETHER_API_KEY=

# OpenRouter (https://openrouter.ai) - Multi-model routing
OPENROUTER_API_KEY=

# =============================================================================
# OLLAMA (Local/Development)
# =============================================================================
# Set OLLAMA_BASE_URL to http://host.docker.internal:11434 when running in Docker
# Set to http://localhost:11434 when running locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# PROVIDER CONFIGURATION
# =============================================================================
DEFAULT_PROVIDER=fireworks
DEFAULT_EMBEDDING_PROVIDER=deepinfra

# Rate Limits (requests per minute) - Adjust based on your plan
OPENAI_RATE_LIMIT=60
ANTHROPIC_RATE_LIMIT=50
OLLAMA_RATE_LIMIT=100
OPENROUTER_RATE_LIMIT=60
FIREWORKS_RATE_LIMIT=120
GROQ_RATE_LIMIT=30
DEEPINFRA_RATE_LIMIT=100
TOGETHER_RATE_LIMIT=60

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# Upstash Redis (alternative - recommended for serverless)
# Get from https://console.upstash.com
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
USE_UPSTASH_REDIS=false

# =============================================================================
# DATABASE CONFIGURATION
# SECURITY: Use individual connection params in production, not full URL
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=  # Set via environment variable, never in this file
DB_NAME=functionfly
DB_SSLMODE=require

# Legacy DATABASE_URL (deprecated - use individual params above)
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# =============================================================================
# CORS CONFIGURATION
# SECURITY: Restrict to your frontend domain in production
# =============================================================================
CORS_ORIGINS=["http://localhost:3000"]  # Development only

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_STREAMING=true
ENABLE_CACHING=true
ENABLE_COST_TRACKING=true

# =============================================================================
# RAG CONFIGURATION
# =============================================================================
ENABLE_RAG=true
RAG_EMBEDDING_PROVIDER=ollama
RAG_DOCS_DIR=../web/docs/src/content/docs
RAG_TOP_K=4
RAG_CANDIDATE_CHUNKS=24
RAG_EMBEDDING_RERANK_CHUNKS=6
RAG_EMBEDDING_MAX_SECONDS=3.0
RAG_CHUNK_MAX_CHARS=1600
RAG_CHUNK_MIN_CHARS=250

# =============================================================================
# RETRY CONFIGURATION
# =============================================================================
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

OPENROUTER_MODEL=openrouter/free

FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-405b-instruct
GROQ_MODEL=llama-4-scout-17b-16e-instruct
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DEEPINFRA_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# =============================================================================
# COST TRACKING
# =============================================================================
OPENAI_INPUT_COST=0.0025
OPENAI_OUTPUT_COST=0.01
ANTHROPIC_INPUT_COST=0.003
ANTHROPIC_OUTPUT_COST=0.015

# =============================================================================
# CONTENT MODERATION
# =============================================================================
MODERATION_PROVIDER=auto
OPENAI_MODERATION_MODEL=omni-moderation-latest

# =============================================================================
# ROUTING CONFIGURATION
# =============================================================================
ROUTING_ENABLED=true
ROUTING_LATENCY_WEIGHT=0.30
ROUTING_LOAD_WEIGHT=0.30
ROUTING_AVAILABILITY_WEIGHT=0.40
ROUTING_CACHE_TTL_SECONDS=60

TRAFFIC_REALTIME_PROVIDER=groq
TRAFFIC_STRUCTURED_PROVIDER=fireworks
TRAFFIC_FUNCTION_CALLING_PROVIDER=fireworks
TRAFFIC_BACKGROUND_PROVIDER=deepinfra
TRAFFIC_FALLBACK_PROVIDER=openrouter
ENABLE_TRAFFIC_BASED_ROUTING=true

# =============================================================================
# PREWARMING & ANOMALY DETECTION
# =============================================================================
PREWARMING_ENABLED=true
PREWARMING_THRESHOLD=10
PREWARMING_WINDOW_MINUTES=10
PREWARMING_INSTANCES_DEFAULT=1

ANOMALY_DETECTION_ENABLED=true
ANOMALY_LATENCY_THRESHOLD=3.0
ANOMALY_ERROR_RATE_THRESHOLD=0.01
ANOMALY_COLD_START_THRESHOLD=0.10
ANOMALY_WINDOW_MINUTES=5
ANOMALY_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# ML INTELLIGENCE LAYER
# =============================================================================
ML_ENABLED=true
ML_RETRAIN_CRON=0 3 * * *
ML_MODEL_DIR=/var/lib/flymind/models
ML_MODEL_ENCRYPTION_KEY=  # REQUIRED in production - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ML_COST_ANOMALY_THRESHOLD=3.0
ML_COST_ANOMALY_WINDOW_HOURS=168
ML_PREWARM_SEASONALITY_PERIODS=24
ML_ROUTING_EXPLORATION=0.1
ML_RECOMMENDATION_LATENT_DIMS=50
ML_SYNTHETIC_DATA_ENABLED=true
ML_TRAINING_TIMEOUT_SECONDS=300
ML_TRAINING_MAX_RETRIES=1

# ML Production Security (REQUIRED in production)
ML_REQUIRE_ENCRYPTION_IN_PRODUCTION=true
ML_MODEL_BACKUP_ENABLED=true
ML_MODEL_BACKUP_DIR=/var/lib/flymind/backups
ML_MODEL_MAX_BACKUPS=5

# ML Drift Detection & Monitoring
ML_DRIFT_DETECTION_ENABLED=true
ML_DRIFT_THRESHOLD=0.15
ML_DRIFT_CHECK_INTERVAL_HOURS=6
ML_DRIFT_ALERT_WEBHOOK_URL=  # Optional webhook for drift alerts

# ML File-based Fallback (when Redis is unavailable)
ML_FALLBACK_TO_FILE=true
ML_FALLBACK_FILE_DIR=/var/lib/flymind/ml-state

# =============================================================================
# ORCHESTRATOR INTEGRATION
# =============================================================================
ORCHESTRATOR_URL=http://localhost:8080
ORCHESTRATOR_API_KEY=  # Set via environment variable

# =============================================================================
# gRPC SECURITY (Production requires TLS)
# =============================================================================
GRPC_USE_TLS=false  # Set to true in production
GRPC_USE_AUTH=true  # Set to true to enable API key auth
# GRPC_TLS_CERT_PATH=/path/to/tls.crt
# GRPC_TLS_KEY_PATH=/path/to/tls.key

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
REQUIRE_REDIS=false  # Set to true in production
SECURITY_MODE=strict  # strict | relaxed | disabled
