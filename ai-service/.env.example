# FlyMind AI Service Environment Variables

# Service Configuration
SERVICE_NAME=flymind-ai-service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8081
DEBUG=false
LOG_LEVEL=INFO

# API Keys (REQUIRED for respective providers)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# FunctionFly Multi-Provider Architecture (RECOMMENDED)
# Fireworks: Best for structured output / function calling (FireAttention engine, 4x lower latency than vLLM)
FIREWORKS_API_KEY=your-fireworks-api-key-here

# Groq: Best for real-time low-latency calls (LPU hardware, 0.6-0.9s TTFT, free tier 30 RPM)
GROQ_API_KEY=your-groq-api-key-here

# DeepInfra: Best for background/batch tasks (serverless, up to 90% cost reduction)
DEEPINFRA_API_KEY=your-deepinfra-api-key-here

# Together AI: Alternative for batch processing (200+ models, batch at 50% less cost)
TOGETHER_API_KEY=your-together-api-key-here

# Ollama (Local/Development)
# Set OLLAMA_BASE_URL to http://host.docker.internal:11434 when running in Docker
# Set to http://localhost:11434 when running locally
OLLAMA_BASE_URL=http://localhost:11434
# Small default for typical RAM; `ollama pull llama3.2:3b` — or set a larger model if you have headroom
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Default Provider Selection
# Options: openai, anthropic, ollama, openrouter, fireworks, groq, deepinfra, together
# For FunctionFly architecture:
# - Use "fireworks" for primary (best function calling)
# - Use "groq" for real-time low-latency
# - Use "openrouter" for fallback/routing layer (not locked in)
DEFAULT_PROVIDER=fireworks
DEFAULT_EMBEDDING_PROVIDER=deepinfra

# Rate Limits (requests per minute)
OPENAI_RATE_LIMIT=60
ANTHROPIC_RATE_LIMIT=50
OLLAMA_RATE_LIMIT=100
OPENROUTER_RATE_LIMIT=60

# New Provider Rate Limits
FIREWORKS_RATE_LIMIT=120  # High throughput
GROQ_RATE_LIMIT=30        # Free tier: 30 RPM (upgrade for 3000+ RPM)
DEEPINFRA_RATE_LIMIT=100  # Good for batch
TOGETHER_RATE_LIMIT=60    # Standard rate

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# Upstash Redis (alternative to standard Redis - recommended for serverless)
# Get these from https://console.upstash.com
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=xxx
# USE_UPSTASH_REDIS=false

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/functionfly

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]

# Feature Flags
ENABLE_STREAMING=true
ENABLE_CACHING=true
ENABLE_COST_TRACKING=true

# RAG (docs retrieval for chat)
ENABLE_RAG=true
# Embeddings for RAG: ollama (local, default) or openai
RAG_EMBEDDING_PROVIDER=ollama
# Point at the repo docs directory when running in the monorepo
RAG_DOCS_DIR=../web/docs/src/content/docs
RAG_TOP_K=4
RAG_CANDIDATE_CHUNKS=24
RAG_EMBEDDING_RERANK_CHUNKS=6
RAG_EMBEDDING_MAX_SECONDS=3.0
RAG_CHUNK_MAX_CHARS=1600
RAG_CHUNK_MIN_CHARS=250
# For RAG_EMBEDDING_PROVIDER=ollama: ensure Ollama is running and run: ollama pull nomic-embed-text

# Retry Configuration
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# OpenAI Specific
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Anthropic Specific
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# OpenRouter Specific
OPENROUTER_MODEL=openrouter/free

# Fireworks AI Configuration (primary for function calling / structured output)
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-405b-instruct
FIREWORKS_RATE_LIMIT=120

# Groq Configuration (latency-critical real-time calls)
GROQ_MODEL=llama-4-scout-17b-16e-instruct
GROQ_RATE_LIMIT=30

# DeepInfra Configuration (background/batch processing)
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DEEPINFRA_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
DEEPINFRA_RATE_LIMIT=100

# Together AI Configuration (alternative / batch)
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_RATE_LIMIT=60

# Cost Tracking (per 1K tokens)
OPENAI_INPUT_COST=0.0025
OPENAI_OUTPUT_COST=0.01
ANTHROPIC_INPUT_COST=0.003
ANTHROPIC_OUTPUT_COST=0.015

# Content Moderation (2026: OpenAI Moderation API when OPENAI_API_KEY is set)
# auto = OpenAI if key set, else Detoxify, else keyword fallback
MODERATION_PROVIDER=auto
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Phase 2: Intelligent Routing
ROUTING_ENABLED=true
ROUTING_LATENCY_WEIGHT=0.30
ROUTING_LOAD_WEIGHT=0.30
ROUTING_AVAILABILITY_WEIGHT=0.40
ROUTING_CACHE_TTL_SECONDS=60

# FunctionFly Multi-Provider Traffic-Based Routing
# Configure which providers handle different traffic types
TRAFFIC_REALTIME_PROVIDER=groq              # Real-time: Groq (lowest latency)
TRAFFIC_STRUCTURED_PROVIDER=fireworks       # JSON/tool: Fireworks (best structured)
TRAFFIC_FUNCTION_CALLING_PROVIDER=fireworks # Function calls: Fireworks
TRAFFIC_BACKGROUND_PROVIDER=deepinfra       # Batch: DeepInfra (cost-effective)
TRAFFIC_FALLBACK_PROVIDER=openrouter        # Fallback: OpenRouter (multi-model)
ENABLE_TRAFFIC_BASED_ROUTING=true

# Phase 2: Prewarming
PREWARMING_ENABLED=true
PREWARMING_THRESHOLD=10
PREWARMING_WINDOW_MINUTES=10
PREWARMING_INSTANCES_DEFAULT=1

# Phase 2: Anomaly Detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_LATENCY_THRESHOLD=3.0
ANOMALY_ERROR_RATE_THRESHOLD=0.01
ANOMALY_COLD_START_THRESHOLD=0.10
ANOMALY_WINDOW_MINUTES=5
ANOMALY_CHECK_INTERVAL_SECONDS=30

# Orchestrator Integration
ORCHESTRATOR_URL=http://localhost:8080
ORCHESTRATOR_API_KEY=
