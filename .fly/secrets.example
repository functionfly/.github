# Fly.io Secrets Configuration for FunctionFly Orchestrator API
#
# This file documents all required and optional secrets that need to be set
# for the FunctionFly API to run on Fly.io.
#
# Set secrets using the Fly CLI:
#   fly secrets set KEY=value
#   fly secrets set KEY=value --app functionfly-control   # when app is not current
#
# Or use the provided script (edit variables in the script first):
#   .fly/set-secrets.sh production
#   .fly/set-secrets.sh production functionfly-control
#   FLY_APP=functionfly-control .fly/set-secrets.sh production
#

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
# Option 1: DATABASE_URL (recommended - single variable)
# Get from Neon Console > Connection Details > Connection string (pooled)
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/functionfly?sslmode=require

# Option 2: Individual DB_* variables (used if DATABASE_URL not set)
# DB_HOST=ep-xxx-pooler.us-east-1.aws.neon.tech
# DB_PORT=5432
# DB_USER=yourusername
# DB_PASSWORD=yourpassword
# DB_NAME=functionfly
# DB_SSLMODE=require

# Optional database pool settings:
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m

# Optional: Neon read replicas (hybrid) – primary for writes, replicas for reads; see docs/NEON.md
# DB_READ_REPLICA_ENABLED=true
# DB_REPLICA_1_HOST=ep-xxx-readonly-pooler.us-east-1.aws.neon.tech
# DB_REPLICA_1_PORT=5432

# Optional: Neon CLI (for scripts/CI). Create at https://console.neon.tech/app/settings/api-keys
# NEON_API_KEY=

# =============================================================================
# REDIS
# =============================================================================
# Option A: Fly.io managed Redis (run: fly redis create)
# REDIS_ADDR=your-redis-host:6379
# REDIS_PASSWORD=your-redis-password

# Option B: External Redis (Upstash, Redis Cloud, etc.)
# REDIS_ADDR=your-upstash-host:6379
# REDIS_PASSWORD=your-upstash-password

# Optional Redis settings:
# REDIS_DB=0

# =============================================================================
# AUTHENTICATION & SECURITY (Required)
# =============================================================================
# JWT_SECRET - Generate with: openssl rand -hex 32
# JWT_SECRET=your-jwt-secret-minimum-32-characters

# API_SHARED_SECRET - Generate with: openssl rand -hex 32
# API_SHARED_SECRET=your-api-shared-secret

# DB_MASTER_KEY_PASSWORD - Generate with: openssl rand -hex 32
# DB_MASTER_KEY_PASSWORD=your-secure-master-key-password

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# BASE_URL - The public URL of the API
# BASE_URL=https://api.functionfly.com

# CORS_ALLOWED_ORIGINS - Comma-separated browser origins (marketing, app, admin SPA, status page, etc.)
# Must include https://admin.functionfly.com when admin dashboard is at that host.
# Must include https://status.functionfly.com when the public status SPA calls api.functionfly.com.
# CORS_ALLOWED_ORIGINS=https://functionfly.com,https://www.functionfly.com,https://app.functionfly.com,https://admin.functionfly.com,https://auth.functionfly.com,https://status.functionfly.com

# FRONTEND_URL - Public URL of the dashboard/coming-soon site (required for coming-soon)
# FRONTEND_URL=https://functionfly.com

# LOG_LEVEL - Options: debug, info, warn, error
# LOG_LEVEL=info

# DEVELOPMENT - Set to "false" for production
# DEVELOPMENT=false

# =============================================================================
# OPTIONAL: SMTP Email (for production emails)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=FunctionFly

# =============================================================================
# OPTIONAL: Storage (S3/R2)
# =============================================================================
# STORAGE_BACKEND=local  # Options: local, s3, r2
# STORAGE_BUCKET=functionfly-uploads

# AWS S3:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Cloudflare R2:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_ENDPOINT=your-r2-endpoint
# R2_PUBLIC_URL=https://cdn.yourdomain.com

# =============================================================================
# OPTIONAL: OAuth Providers
# =============================================================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# QUICK START - One-line secrets setup
# =============================================================================
# After configuring the values above, run:
#   fly secrets set DATABASE_URL="postgresql://..." REDIS_ADDR="..." JWT_SECRET="..." API_SHARED_SECRET="..." DB_MASTER_KEY_PASSWORD="..." BASE_URL="https://api.functionfly.com" DEVELOPMENT=false
#
# Or use the provided script:
#   .fly/set-secrets.sh production
