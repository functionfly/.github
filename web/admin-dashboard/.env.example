# API Configuration
VITE_API_BASE_URL=https://api.functionfly.com
VITE_ADMIN_API_BASE_URL=https://api.functionfly.com/v1/admin

# Session Configuration
VITE_SESSION_TIMEOUT=1800000  # 30 minutes
VITE_IDLE_TIMEOUT=900000      # 15 minutes
VITE_MFA_REVERIFY_INTERVAL=14400000  # 4 hours

# Security
VITE_ENABLE_IP_WHITELIST=true
VITE_ENABLE_DEVICE_FINGERPRINT=true

# Features
VITE_ENABLE_AUDIT_LOGGING=true
VITE_ENABLE_SESSION_RECORDING=false

# Zero Trust Headers
VITE_EXPECT_ZT_HEADERS=true

# Development
VITE_DEVELOPMENT=false

# Google Analytics (GA4 measurement ID, e.g. G-XXXXXXXXXX)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mixpanel (product analytics — public token, not sensitive)
# VITE_MIXPANEL_TOKEN=your_mixpanel_project_token_here

# SECURITY:
# Do NOT set VITE_ADMIN_SHARED_SECRET or any other secret as a VITE_* variable.
# VITE_* vars are inlined into the browser bundle. HMAC signing is issued
# server-side via POST /v1/admin/auth/sign-request.
