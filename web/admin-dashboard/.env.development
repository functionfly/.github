# Development environment
VITE_API_BASE_URL=http://localhost:8080
VITE_ADMIN_API_BASE_URL=http://localhost:8080/v1/admin
VITE_SESSION_TIMEOUT=3600000
VITE_IDLE_TIMEOUT=1800000
VITE_MFA_REVERIFY_INTERVAL=7200000
VITE_ENABLE_IP_WHITELIST=false
VITE_ENABLE_DEVICE_FINGERPRINT=false
VITE_ENABLE_AUDIT_LOGGING=true
VITE_ENABLE_SESSION_RECORDING=false
VITE_EXPECT_ZT_HEADERS=false
VITE_DEVELOPMENT=true

# SECURITY: HMAC signing is issued server-side. Never set VITE_ADMIN_SHARED_SECRET.
