{
  "name": "@functionfly/admin-dashboard",
  "version": "1.0.0",
  "description": "FunctionFly Admin Dashboard SPA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx",
