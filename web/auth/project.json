{
  "name": "functionfly-auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/auth/src",
  "projectType": "application",
  "tags": ["type:app", "platform:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "bun run astro build",
        "cwd": "web/auth"
      },
      "configurations": {
        "production": {}
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run astro dev",
        "cwd": "web/auth"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run astro preview",
        "cwd": "web/auth"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vercel --prod",
        "cwd": "web/auth"
      }
    },
    "deploy:preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vercel",
        "cwd": "web/auth"
      }
    }
  }
}
