{
  "framework": null,
  "bunVersion": "1.x",
  "buildCommand": "bun run astro build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
    "env": {
    "PRODUCTION_PUBLIC_API_URL": "https://api.functionfly.com",
    "PRODUCTION_PUBLIC_AUTH_URL": "https://auth.functionfly.com",
    "PRODUCTION_PUBLIC_APP_URL": "https://app.functionfly.com",
    "PRODUCTION_PUBLIC_MARKETING_URL": "https://functionfly.com",
    "STAGING_PUBLIC_API_URL": "https://api.staging.functionfly.com",
    "STAGING_PUBLIC_AUTH_URL": "https://auth.staging.functionfly.com",
    "STAGING_PUBLIC_APP_URL": "https://app.staging.functionfly.com",
    "STAGING_PUBLIC_MARKETING_URL": "https://staging.functionfly.com",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAC0wUyjn2Lu7EjOU"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://challenges.cloudflare.com https://www.googletagmanager.com https://cdn.mxpnl.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://challenges.cloudflare.com https://www.google-analytics.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.functionfly.com https://api.staging.functionfly.com https://app.staging.functionfly.com https://www.google-analytics.com https://www.googletagmanager.com https://api.mixpanel.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.functionfly.com https://api.staging.functionfly.com; upgrade-insecure-requests; frame-src https://challenges.cloudflare.com;"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/confirm",
      "destination": "/confirm.html"
    },
    {
      "source": "/waitlist",
      "destination": "/waitlist.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/verify-email",
      "destination": "/verify-email.html"
    },
    {
      "source": "/auth/saml/sso",
      "destination": "/auth/saml/sso.html"
    },
    {
      "source": "/auth/saml/metadata",
      "destination": "/auth/saml/metadata.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
