---
import { PageGrid } from "../components/sc";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Authenticate to FunctionFly™" } = Astro.props;
const mixpanelToken = import.meta.env.PUBLIC_MIXPANEL_TOKEN as string | undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d11" />
    <title>{title}</title>

    <!-- Google Fonts: Space Grotesk, Inter, IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect for OAuth providers -->
    <link rel="preconnect" href="https://github.com" />
    <link rel="preconnect" href="https://accounts.google.com" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />

    <!-- DNS prefetch fallback -->
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://accounts.google.com" />
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />

    <!-- Sealed Containment Design System -->
    <link rel="stylesheet" href="/src/styles/sc-tokens.css" />
    <link rel="stylesheet" href="/src/styles/sc-main.css" />
    <link rel="stylesheet" href="/src/styles/sc-components.css" />
    <!-- Legacy Velocity Theme (for compatibility with existing components) -->
    <link rel="stylesheet" href="/src/styles/velocity-theme.css" />
    <link rel="stylesheet" href="/src/styles/auth-components.css" />

    <!-- Mixpanel Analytics -->
    <script define:vars={{ mixpanelToken }}>
      (function() {
        if (!mixpanelToken) return;
        (function() {
          var w = window, mp = w.mixpanel = w.mixpanel || [];
          function i() { mp.push(arguments); }
          i.q = mp.q || [];
          mp._i = [];
          mp.init = function(token) { mp.push(['init', token]); return mp; };
          mp.track = function() { return mp.q.push(arguments); };
          mp.people = { track_charge: function() { mp.q.push(['people.track_charge', arguments]); } };
          var s = document.createElement('script');
          s.type = 'text/javascript';
          s.async = true;
          s.src = 'https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js';
          var x = document.getElementsByTagName('script')[0];
          x.parentNode.insertBefore(s, x);
        })();
        window.mixpanel.init(mixpanelToken);
      })();
    </script>

    <style>
      /* Global resets that can't be in component layer */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; }
    </style>

    <!-- Theme initialization (must run before body renders) -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme-storage');
          if (stored) {
            var parsed = JSON.parse(stored);
            if (parsed.state && parsed.state.theme) {
              var theme = parsed.state.theme;
              if (theme === 'light' || theme === 'dark') {
                document.documentElement.setAttribute('data-theme', theme);
              } else if (theme === 'system') {
                var isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
              }
            }
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="antialiased font-sans bg-[var(--ff-tarmac)] text-[var(--ff-primary-text)]">
    <PageGrid client:load />
    <slot />
    <style is:global>
      /* Webkit Scrollbar Styling */
      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }
      ::-webkit-scrollbar-track {
        background: var(--panel);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--steel);
        border-radius: 5px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--steel-light);
      }

      /* Text Selection */
      ::selection {
        background: var(--status-ok);
        color: var(--bg);
      }

      /* Focus Visible Only */
      :focus-visible {
        outline: none;
        box-shadow: var(--shadow-focus);
      }

      /* Smooth Scrolling */
      html {
        scroll-behavior: smooth;
      }
    </style>
  </body>
</html>
