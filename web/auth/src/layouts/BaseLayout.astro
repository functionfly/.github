---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Authenticate to FunctionFly™" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect for OAuth providers -->
    <link rel="preconnect" href="https://github.com" />
    <link rel="preconnect" href="https://accounts.google.com" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />

    <!-- DNS prefetch fallback -->
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://accounts.google.com" />
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />

    <!-- Velocity Theme + Auth Component Styles -->
    <link rel="stylesheet" href="/src/styles/velocity-theme.css" />
    <link rel="stylesheet" href="/src/styles/auth-components.css" />

    <style>
      /* Global resets that can't be in component layer */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; }
    </style>

    <!-- Theme initialization (must run before body renders) -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme-storage');
          if (stored) {
            var parsed = JSON.parse(stored);
            if (parsed.state && parsed.state.theme) {
              var theme = parsed.state.theme;
              if (theme === 'light' || theme === 'dark') {
                document.documentElement.setAttribute('data-theme', theme);
              } else if (theme === 'system') {
                var isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
              }
            }
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="antialiased font-sans bg-[var(--ff-tarmac)] text-[var(--ff-primary-text)]">
    <slot />
  </body>
</html>
