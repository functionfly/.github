---
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle";
import { Chamber, TrustSeal } from "../components/sc";
import { MARKETING_ORIGIN } from "../config";

interface Props {
  title: string;
  description?: string;
  maxWidth?: string;
  showTrustSeal?: boolean;
}
const { title, description, maxWidth = "440px", showTrustSeal = true } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="auth-shell">
    <header class="auth-brand">
      <a href="/" class="brand-link">
        <img src="/functionfly.png" alt="FunctionFly" width="32" height="32" class="brand-logo" />
        <span class="ff-gradient-text font-semibold text-lg tracking-tight">FunctionFly™</span>
      </a>
      <div class="auth-brand-actions">
        <ThemeToggle client:load />
      </div>
    </header>

    <main class="auth-card-wrap" style={`max-width: ${maxWidth}`}>
      <Chamber ribs={true}>
        <slot />
      </Chamber>
    </main>

    <footer class="auth-footer">
      <p>By continuing, you agree to our <a href={`${MARKETING_ORIGIN}/terms`} class="auth-link">Terms</a> and <a href={`${MARKETING_ORIGIN}/privacy`} class="auth-link">Privacy Policy</a>.</p>
    </footer>
  </div>
</BaseLayout>

<style>
.auth-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-7) var(--space-4);
  gap: var(--space-6);
}

.auth-brand {
  width: 100%;
  max-width: 440px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
}

.brand-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  text-decoration: none;
  color: var(--text);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.125rem;
  letter-spacing: -0.01em;
  transition: opacity var(--duration-fast) var(--ease-out);
}

.brand-link:hover {
  opacity: 0.85;
}

.brand-logo {
  width: 32px;
  height: 32px;
  object-fit: contain;
  border-radius: var(--radius-sm);
}

.auth-brand-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.auth-card-wrap {
  width: 100%;
  overflow: hidden;
  min-width: 0;
}

.auth-footer {
  color: var(--text-faint);
  font-size: 0.8125rem;
  text-align: center;
  font-family: var(--font-body);
}

.auth-footer a {
  text-decoration: none;
}

.auth-link {
  color: var(--status-ok);
  transition: color var(--duration-fast) var(--ease-out);
}

.auth-link:hover {
  color: var(--accent);
  text-decoration: underline;
}

/* Responsive */
@media (max-width: 479px) {
  .auth-shell {
    padding: var(--space-4);
    gap: var(--space-5);
  }

  .auth-brand {
    gap: var(--space-3);
  }
}
</style>
