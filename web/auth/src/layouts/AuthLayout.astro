---
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle";
import { MARKETING_ORIGIN } from "../config";

interface Props {
  title: string;
  description?: string;
  maxWidth?: string;
}
const { title, description, maxWidth = "440px" } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="auth-shell">
    <div class="auth-brand">
      <a href="/" class="brand-link">
        <img src="/favicon.svg" alt="" width="32" height="32" class="brand-logo" />
        <span class="ff-gradient-text font-semibold text-lg tracking-tight">FunctionFly™</span>
      </a>
      <ThemeToggle client:load />
    </div>

    <main class="auth-card-wrap" style={`max-width: ${maxWidth}`}>
      <slot />
    </main>

    <footer class="auth-footer">
      <p>By continuing, you agree to our <a href={`${MARKETING_ORIGIN}/terms`} class="auth-link">Terms</a> and <a href={`${MARKETING_ORIGIN}/privacy`} class="auth-link">Privacy Policy</a>.</p>
    </footer>
  </div>
</BaseLayout>

<style>
.auth-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.5rem;
  gap: 2rem;
  background: 
    radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255, 107, 53, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 100%, rgba(0, 212, 255, 0.06) 0%, transparent 50%),
    var(--ff-tarmac);
}

.auth-brand {
  width: 100%;
  max-width: 440px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-link {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  text-decoration: none;
  color: var(--ff-primary-text);
  font-weight: 600;
  font-size: 1.125rem;
  letter-spacing: -0.01em;
  transition: opacity var(--ff-transition-fast);
}

.brand-link:hover {
  opacity: 0.85;
}

.brand-logo {
  filter: drop-shadow(0 0 8px rgba(255, 107, 53, 0.3));
  transition: filter var(--ff-transition-fast);
}

.brand-link:hover .brand-logo {
  filter: drop-shadow(0 0 12px rgba(255, 107, 53, 0.5));
}

:global(.theme-toggle) {
  flex-shrink: 0;
}

:global(.theme-toggle:hover) {
  background: var(--ff-flightdeck) !important;
  border-color: var(--ff-border-strong) !important;
  color: var(--ff-primary-text) !important;
}

.auth-card-wrap {
  width: 100%;
  overflow: hidden;
  min-width: 0;
}

.auth-footer {
  color: var(--ff-muted-text);
  font-size: 0.8125rem;
  text-align: center;
}

.auth-footer a {
  text-decoration: none;
}

.auth-link {
  color: var(--ff-cyan);
  transition: color var(--ff-transition-fast);
}

.auth-link:hover { 
  color: var(--ff-flame); 
  text-decoration: underline; 
}

/* Import brand velocity styles */
:global(@import '../styles/brand-velocity.css')
</style>
