---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";
import Checkbox from "../components/Checkbox";
import ClientTurnstile from "../components/ClientTurnstile";
import OAuthProviders from "../components/OAuthProviders";
import UsernameField from "../components/UsernameField";
import PasswordStrength from "../components/PasswordStrength";
import { API_ORIGIN, MARKETING_ORIGIN } from "../config";
import "../styles/oauth-providers.css";

export const prerender = false;

const urlInviteCode = Astro.url.searchParams.get("invite_code") || undefined;
const redirectAfterLogin = Astro.url.searchParams.get("redirect_uri") || undefined;
const inviteCode = urlInviteCode || "";
---

<AuthLayout title="Create account — FunctionFly™">
  <FormCard title="Create your account" subtitle="Start building on FunctionFly™" client:load>
    <OAuthProviders client:only="react" inviteCode={inviteCode} redirectAfterLogin={redirectAfterLogin} />

    <!-- Divider -->
    <div class="form-divider">
      <span class="divider-text">or sign up with email</span>
    </div>

    <!-- Step Indicator -->
    <div class="step-indicator" id="step-indicator" aria-label="Signup progress">
      <div class="step active" data-step="1" aria-current="step">
        <div class="step-number">1</div>
        <span class="step-label">Account</span>
      </div>
      <div class="step-connector" aria-hidden="true"></div>
      <div class="step" data-step="2">
        <div class="step-number">2</div>
        <span class="step-label">Profile</span>
      </div>
      <div class="step-connector" aria-hidden="true"></div>
      <div class="step" data-step="3">
        <div class="step-number">3</div>
        <span class="step-label">Finish</span>
      </div>
    </div>

    <form id="signup-form" method="POST" novalidate>
      <!-- Step 1: Account Info (Email, Password) -->
      <div class="step-content active" data-step="1">
        <div class="step-header">
          <h3 class="step-title" id="step1-title">Create your account</h3>
          <p class="step-description" id="step1-desc">Start with your email and a secure password</p>
        </div>

        <InputField
          client:load
          label="Email"
          name="email"
          type="email"
          placeholder="you@example.com"
          required
          autoComplete="email"
          id="email-field"
          aria-describedby="step1-desc"
        />

        <div class="password-section">
          <InputField
            client:load
            label="Password"
            name="password"
            type="password"
            placeholder="Min. 8 characters"
            required
            minLength={8}
            autoComplete="new-password"
            id="password-field"
            aria-describedby="password-strength"
          />
          <PasswordStrength client:load />
        </div>

        <InputField
          client:load
          label="Confirm Password"
          name="confirm_password"
          type="password"
          placeholder="Re-enter your password"
          required
          minLength={8}
          autoComplete="new-password"
          id="confirm-password-field"
        />
        <p id="password-match-error" class="field-error hidden" role="alert" aria-live="polite">Passwords do not match</p>

        <!-- Terms of Service toggle -->
        <div class="tos-toggle">
          <Checkbox
            client:load
            label="I agree to the "
            name="tos_accepted"
            required={true}
            id="tos-checkbox"
            termsUrl={`${MARKETING_ORIGIN}/terms`}
            privacyUrl={`${MARKETING_ORIGIN}/privacy`}
          />
        </div>

        <div class="step-navigation">
          <div></div> <!-- Spacer -->
          <button
            type="button"
            class="btn btn-primary"
            id="step1-next"
            aria-describedby="step1-desc"
          >
            Continue
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 6px;" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 2: Profile Info (Name, Username, DOB) -->
      <div class="step-content" data-step="2" aria-labelledby="step2-title">
        <div class="step-header">
          <h3 class="step-title" id="step2-title">Tell us about yourself</h3>
          <p class="step-description" id="step2-desc">This helps us personalize your experience</p>
        </div>

        <InputField
          client:load
          label="Full Name"
          name="name"
          type="text"
          placeholder="John Doe"
          required
          autoComplete="name"
        />

        <UsernameField client:load />

        <InputField
          client:load
          label="Company"
          name="company"
          type="text"
          placeholder="Acme Inc. (optional)"
          autoComplete="organization"
        />

        <div class="dob-field">
          <label class="field-label" for="date_of_birth">
            Date of birth <span class="required" aria-label="required">*</span>
          </label>
          <input
            class="field-input"
            id="date_of_birth"
            name="date_of_birth"
            type="date"
            required
            aria-describedby="dob-hint"
          />
          <p class="field-hint" id="dob-hint">You must be at least 13 years old.</p>
        </div>

        <div class="step-navigation">
          <button type="button" class="btn btn-secondary" id="step2-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back
          </button>
          <button type="button" class="btn btn-primary" id="step2-next">
            Continue
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 6px;" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step 3: Referral & CAPTCHA -->
      <div class="step-content" data-step="3" aria-labelledby="step3-title">
        <div class="step-header">
          <h3 class="step-title" id="step3-title">Almost done!</h3>
          <p class="step-description" id="step3-desc">Review and complete your signup</p>
        </div>

        <div class="referral-section" id="referral-section">
          <InputField
            client:load
            label="Referral code"
            name="referral_code"
            type="text"
            placeholder="Enter a code if you have one (optional)"
            id="referral-code-field"
          />
        </div>

        <!-- CAPTCHA -->
        <div class="captcha-section">
          <ClientTurnstile
            client:only="react"
            action="signup"
            theme="auto"
          />
          <input type="hidden" id="turnstile-token" name="turnstile_token" />
        </div>

        <div class="step-navigation">
          <button type="button" class="btn btn-secondary" id="step3-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back
          </button>
          <Button type="submit" client:load id="submit-btn">Create account</Button>
        </div>
      </div>
    </form>

    <div class="card-footer">
      Already have an account? <a href="/login">Sign in</a>
    </div>
  </FormCard>
</AuthLayout>

<style>
  /* Form containment */
  #signup-form { overflow: hidden; min-width: 0; }

  /* Divider */
  .form-divider {
    display: flex;
    align-items: center;
    margin: 1.5rem 0;
    position: relative;
  }
  .form-divider::before,
  .form-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--ff-flame-rgb), 0.3) 50%, transparent);
  }
  .divider-text {
    padding: 0 1rem;
    font-size: 0.75rem;
    color: var(--ff-muted-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Step Indicator */
  .step-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0 1rem;
  }
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .step-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--ff-flightdeck);
    color: var(--ff-muted-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  .step.active .step-number {
    background: linear-gradient(135deg, var(--ff-flame) 0%, var(--ff-afterburner) 100%);
    color: white;
    box-shadow: 0 0 20px rgba(var(--ff-flame-rgb), 0.4);
  }
  .step.completed .step-number {
    background: var(--ff-success);
    color: var(--ff-tarmac);
  }
  .step-label {
    font-size: 0.75rem;
    color: var(--ff-muted-text);
    font-weight: 500;
  }
  .step.active .step-label {
    color: var(--ff-primary-text);
  }
  .step-connector {
    width: 40px;
    height: 2px;
    background: var(--ff-flightdeck);
    transition: background 0.3s ease;
  }
  .step-connector.completed {
    background: var(--ff-success);
  }

  /* Step Content */
  .step-content {
    display: none;
    animation: fadeIn 0.3s ease;
    min-width: 0;
    overflow: hidden;
  }
  .step-content.active {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(10px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Step Header */
  .step-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .step-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ff-primary-text);
    margin-bottom: 0.25rem;
  }
  .step-description {
    font-size: 0.875rem;
    color: var(--ff-secondary-text);
  }

  /* Step Navigation */
  .step-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ff-border-default);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--ff-flame) 0%, var(--ff-afterburner) 100%);
    color: white;
    box-shadow: 0 4px 14px rgba(var(--ff-flame-rgb), 0.4);
  }
  .btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(var(--ff-flame-rgb), 0.5);
  }
  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .btn-secondary {
    background: transparent;
    color: var(--ff-secondary-text);
    border: 1px solid var(--ff-border-default);
  }
  .btn-secondary:hover {
    background: var(--ff-flightdeck);
    border-color: var(--ff-cyan);
    color: var(--ff-cyan);
  }

  /* Referral Section */
  .referral-section {
    margin-bottom: 1rem;
    min-width: 0;
  }
  .required {
    color: var(--ff-error);
  }

  /* CAPTCHA section */
  .captcha-section {
    margin: 1rem 0 1.5rem;
  }

  /* Password Strength */
  .password-section {
    margin-bottom: 0.5rem;
    min-width: 0;
    overflow: hidden;
  }

  /* TOS toggle */
  .tos-toggle {
    margin: 1rem 0 0.25rem;
  }
  .password-strength {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: var(--ff-flightdeck);
    border-radius: 8px;
    border: 1px solid var(--ff-border-subtle);
  }
  .password-strength.hidden {
    display: none;
  }
  .strength-bar {
    height: 4px;
    background: var(--ff-flightdeck);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .strength-fill {
    height: 100%;
    width: 0%;
    transition: width 0.3s, background-color 0.3s;
  }
  .strength-fill.weak { background: var(--ff-error); width: 25%; }
  .strength-fill.fair { background: var(--ff-warning); width: 50%; }
  .strength-fill.good { background: var(--ff-flame); width: 75%; }
  .strength-fill.strong { background: var(--ff-success); width: 100%; }
  .strength-text {
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .strength-text.weak { color: var(--ff-error); }
  .strength-text.fair { color: var(--ff-warning); }
  .strength-text.good { color: var(--ff-flame); }
  .strength-text.strong { color: var(--ff-success); }
  .password-requirements {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .password-requirements li {
    font-size: 0.75rem;
    color: var(--ff-muted-text);
    padding: 0.125rem 0;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .password-requirements li::before {
    content: "○";
    font-size: 0.5rem;
  }
  .password-requirements li.met {
    color: var(--ff-success);
  }
  .password-requirements li.met::before {
    content: "✓";
  }
  .field-error {
    color: var(--ff-error);
    font-size: 0.875rem;
    margin: -0.5rem 0 0.75rem 0;
  }
  .field-error.hidden {
    display: none;
  }

  /* Date of birth field */
  .dob-field {
    margin-bottom: 1rem;
    min-width: 0;
  }
  .dob-field .field-label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ff-primary-text);
  }
  .dob-field .field-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    background: var(--ff-tower);
    border: 1px solid var(--ff-border-default);
    border-radius: 8px;
    color: var(--ff-primary-text);
    font-size: 0.9375rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .dob-field .field-input:focus {
    outline: none;
    border-color: var(--ff-flame);
    box-shadow: 0 0 0 2px rgba(var(--ff-flame-rgb), 0.2);
  }
  .dob-field .field-input.error {
    border-color: var(--ff-error);
  }
  .dob-field .field-hint {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: var(--ff-muted-text);
  }

  /* Card footer */
  .card-footer {
    text-align: center;
    font-size: 0.875rem;
    color: var(--ff-muted-text);
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ff-border-default);
  }
  .card-footer a {
    color: var(--ff-cyan);
    text-decoration: none;
    font-weight: 500;
  }
  .card-footer a:hover {
    text-decoration: underline;
    color: var(--ff-flame);
  }

  /* Network error styles */
  .network-error {
    background: rgba(var(--ff-error-rgb), 0.1);
    border: 1px solid rgba(var(--ff-error-rgb), 0.3);
    color: var(--ff-error);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>

<script is:inline define:vars={{ apiBase: API_ORIGIN }}>
  (function() {
    // Utility functions
    const validators = {
      email: (value) => {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!value || value.trim() === "") {
          return { valid: false, error: "Email is required" };
        }
        if (!emailRegex.test(value)) {
          return { valid: false, error: "Please enter a valid email address" };
        }
        return { valid: true };
      },
      password: (value, options = {}) => {
        const { minLength = 8 } = options;
        const checks = {
          length: value.length >= minLength,
          upper: /[A-Z]/.test(value),
          lower: /[a-z]/.test(value),
          number: /[0-9]/.test(value),
          special: /[!@#$%^&*(),.?":{}|<>]/.test(value),
        };
        const score = Object.values(checks).filter(Boolean).length;
        let strength = "weak";
        if (score >= 5) strength = "strong";
        else if (score >= 4) strength = "good";
        else if (score >= 3) strength = "fair";
        if (!value || value.length < minLength) {
          return { valid: false, error: `Password must be at least ${minLength} characters`, strength, checks };
        }
        return { valid: true, strength, checks };
      },
      passwordMatch: (password, confirm) => {
        if (confirm && password !== confirm) {
          return { valid: false, error: "Passwords do not match" };
        }
        return { valid: true };
      },
      dateOfBirth: (value) => {
        if (!value) {
          return { valid: false, error: "Date of birth is required" };
        }
        const dob = new Date(value);
        const today = new Date();
        let age = today.getFullYear() - dob.getFullYear();
        const month = today.getMonth() - dob.getMonth();
        if (month < 0 || (month === 0 && today.getDate() < dob.getDate())) {
          age--;
        }
        if (age < 13) {
          return { valid: false, error: "You must be at least 13 years old" };
        }
        if (dob > today) {
          return { valid: false, error: "Date of birth cannot be in the future" };
        }
        return { valid: true };
      }
    };

    function validateAll(validations) {
      const errors = {};
      for (const { name, result } of validations) {
        if (!result.valid && result.error) {
          errors[name] = result.error;
        }
      }
      return { valid: Object.keys(errors).length === 0, errors };
    }

    function getMaxDateOfBirth() {
      const maxDate = new Date();
      maxDate.setFullYear(maxDate.getFullYear() - 13);
      return maxDate.toISOString().split("T")[0];
    }

    function trackAuth(event, properties = {}) {
      const eventName = `auth_${event}`;
      if (typeof window !== "undefined" && (window.plausible || window.posthog)) {
        if (window.plausible) {
          window.plausible(eventName, { props: properties });
        }
        if (window.posthog) {
          window.posthog.capture(eventName, properties);
        }
      }
      if (typeof process !== "undefined" && process.env?.NODE_ENV === "development") {
        console.log(`[Analytics] ${eventName}`, properties);
      }
    }

    function trackFormError(formName, errors) {
      const errorFields = Object.keys(errors);
      trackAuth("signup_error", {
        form: formName,
        fields: errorFields.join(","),
        error_count: errorFields.length,
      });
    }

    // Initialize analytics and validation
    if (typeof window !== 'undefined') {
      const startTime = performance.now();
      trackAuth("signup_start");

        // Step management
        let currentStep = 1;

        const stepContents = document.querySelectorAll('.step-content');
        const steps = document.querySelectorAll('.step');
        const connectors = document.querySelectorAll('.step-connector');

        function updateStepIndicator() {
          steps.forEach((step, index) => {
            const stepNum = index + 1;
            step.classList.remove('active', 'completed');
            step.removeAttribute('aria-current');
            if (stepNum === currentStep) {
              step.classList.add('active');
              step.setAttribute('aria-current', 'step');
            } else if (stepNum < currentStep) {
              step.classList.add('completed');
            }
          });
          connectors.forEach((conn, index) => {
            conn.classList.toggle('completed', index + 1 < currentStep);
          });
        }

        function showStep(stepNum) {
          stepContents.forEach((content) => {
            const contentStep = parseInt(content.getAttribute('data-step') || '1');
            content.classList.toggle('active', contentStep === stepNum);
          });
          currentStep = stepNum;
          updateStepIndicator();

          // Track step completion
          if (stepNum === 2) trackAuth("signup_step_1_complete");
          if (stepNum === 3) trackAuth("signup_step_2_complete");

          // Focus management - focus first input or primary button
          setTimeout(() => {
            const activeContent = document.querySelector('.step-content.active');
            const firstInput = activeContent?.querySelector('input:not([type="hidden"])');
            const primaryBtn = activeContent?.querySelector('.btn-primary');
            (firstInput || primaryBtn)?.focus();
          }, 100);
        }

        // Validation with shared utilities
        function validateStep1() {
          const emailEl = document.getElementById('email-field');
          const passwordEl = document.getElementById('password-field');
          const confirmEl = document.getElementById('confirm-password-field');
          const tosEl = document.getElementById('tos-checkbox');

          const validations = [
            { name: 'email', result: validators.email(emailEl?.value || '') },
            { name: 'password', result: validators.password(passwordEl?.value || '') },
            { name: 'passwordMatch', result: validators.passwordMatch(passwordEl?.value || '', confirmEl?.value || '') },
          ];

          if (!tosEl?.checked) {
            validations.push({ name: 'tos', result: { valid: false, error: 'You must agree to the Terms of Service and Privacy Policy' } });
          }

          const { valid, errors } = validateAll(validations);

          // Show errors inline
          Object.entries(errors).forEach(([field, error]) => {
            if (field === 'tos') return;
            const el = document.getElementById(`${field === 'email' ? 'email' : field === 'passwordMatch' ? 'confirm-password' : 'password'}-field`);
            if (el) {
              el.setAttribute('aria-invalid', 'true');
            }
          });

          if (errors.tos) {
            alert(errors.tos);
          }

          if (!valid) {
            trackFormError('signup_step_1', errors);
          }

          return valid;
        }

        function validateStep2() {
          const usernameEl = document.getElementById('username');
          const dobEl = document.getElementById('date_of_birth');
          const errors = {};

          if (!usernameEl?.value || usernameEl.value.trim().length < 3) {
            errors.username = 'Username is required (min 3 characters)';
            usernameEl?.setAttribute('aria-invalid', 'true');
          } else if (usernameEl.classList.contains('ff-input--error')) {
            errors.username = 'Please choose a valid username';
          }

          const dobResult = validators.dateOfBirth(dobEl?.value || '');
          if (!dobResult.valid) {
            errors.dateOfBirth = dobResult.error || 'Invalid';
            dobEl?.classList.add('error');
            dobEl?.setAttribute('aria-invalid', 'true');
          }

          if (Object.keys(errors).length > 0) {
            trackFormError('signup_step_2', errors);
            return false;
          }

          return true;
        }

        function validateStep3() {
          const captchaEl = document.getElementById('turnstile-token');

          const validations = [];

          if (!captchaEl?.value) {
            validations.push({ name: 'captcha', result: { valid: false, error: 'Please complete the CAPTCHA verification' } });
          }

          const { valid, errors } = validateAll(validations);

          if (!valid) {
            trackFormError('signup_step_3', errors);
            const firstError = Object.values(errors)[0];
            if (firstError) {
              alert(firstError);
            }
          }

          return valid;
        }

        // Navigation with focus management
        document.getElementById('step1-next')?.addEventListener('click', () => {
          if (validateStep1()) showStep(2);
        });
        document.getElementById('step2-back')?.addEventListener('click', () => showStep(1));
        document.getElementById('step2-next')?.addEventListener('click', () => {
          if (validateStep2()) showStep(3);
        });
        document.getElementById('step3-back')?.addEventListener('click', () => showStep(2));

        // Password strength
        const passwordField = document.getElementById('password-field');
        const passwordStrength = document.getElementById('password-strength');
        const strengthFill = document.getElementById('strength-fill');
        const strengthText = document.getElementById('strength-text');

        function checkPasswordStrength(password) {
          const result = validators.password(password);
          const checks = result.checks;

          // Update requirement indicators
          document.getElementById('req-length')?.classList.toggle('met', checks.length);
          document.getElementById('req-upper')?.classList.toggle('met', checks.upper);
          document.getElementById('req-lower')?.classList.toggle('met', checks.lower);
          document.getElementById('req-number')?.classList.toggle('met', checks.number);
          document.getElementById('req-special')?.classList.toggle('met', checks.special);

          if (strengthFill) {
            strengthFill.className = 'strength-fill';
            if (password.length > 0) {
              strengthFill.classList.add(result.strength);
            }
          }

          if (strengthText) {
            strengthText.className = 'strength-text';
            if (password.length > 0) {
              strengthText.classList.add(result.strength);
              const labels = { weak: 'Weak password', fair: 'Fair password', good: 'Good password', strong: 'Strong password' };
              strengthText.textContent = labels[result.strength];
            }
          }

          if (passwordStrength) {
            passwordStrength.classList.toggle('hidden', password.length === 0);
          }
        }

        passwordField?.addEventListener('input', () => {
          checkPasswordStrength(passwordField.value);
          checkPasswordMatch();
        });

        // Password match
        function checkPasswordMatch() {
          const confirmField = document.getElementById('confirm-password-field');
          const errorEl = document.getElementById('password-match-error');
          const pw = passwordField?.value || '';
          const confirm = confirmField?.value || '';

          if (confirm && pw !== confirm) {
            errorEl?.classList.remove('hidden');
            confirmField?.setAttribute('aria-invalid', 'true');
          } else {
            errorEl?.classList.add('hidden');
            confirmField?.setAttribute('aria-invalid', 'false');
          }
        }

        document.getElementById('confirm-password-field')?.addEventListener('input', checkPasswordMatch);

        // Date of birth max
        const dobField = document.getElementById('date_of_birth');
        if (dobField) {
          dobField.max = getMaxDateOfBirth();
        }

        // Signup config
        const urlParams = new URLSearchParams(window.location.search);
        const referralCode = urlParams.get('referral_code');
        if (referralCode) {
          const referralField = document.getElementById('referral-code-field');
          if (referralField) referralField.value = referralCode;
        }

        // Network status monitoring
        function updateNetworkStatus() {
          const submitBtn = document.getElementById('submit-btn');
          if (submitBtn) {
            submitBtn.disabled = !navigator.onLine;
            if (navigator.onLine) {
              submitBtn.removeAttribute('title');
            } else {
              submitBtn.title = 'You appear to be offline';
            }
          }
        }

        window.addEventListener('online', updateNetworkStatus);
        window.addEventListener('offline', updateNetworkStatus);
        setTimeout(updateNetworkStatus, 0);

        // Form submission with analytics and network error handling
        const form = document.getElementById('signup-form');
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (!validateStep3()) return;

          const btn = document.getElementById('submit-btn');
          const originalText = btn?.textContent;
          if (btn) {
            btn.disabled = true;
            btn.textContent = 'Creating account…';
          }

          const fd = new FormData(form);
          const body = Object.fromEntries(fd.entries());

          // Map snake_case form names to camelCase for Go API
          const apiBody = {
            email: body.email,
            password: body.password,
            confirmPassword: body.confirm_password,
            name: body.name,
            username: body.username,
            companyName: body.company || undefined,
            dateOfBirth: body.date_of_birth,
            inviteCode: body.referral_code || undefined,
            termsAccepted: !!body.tos_accepted,
            recaptchaToken: body.turnstile_token,
          };

          try {
            const res = await fetch(`${apiBase}/auth/signup`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(apiBody),
              credentials: 'include',
            });

            const data = await res.json().catch(() => ({}));

            if (res.ok) {
              const duration = Math.round(performance.now() - startTime);
              trackAuth("signup_complete", { duration, has_referral: !!body.referral_code });

              window.location.href = '/confirm?email=' + encodeURIComponent(apiBody.email) +
                '&sent=' + (data.emailSent || data.email_sent || false);
            } else {
              trackAuth("signup_error", { error: data.message || 'unknown', step: 3 });

              const errEl = document.createElement('div');
              errEl.className = 'alert alert-error';
              errEl.setAttribute('role', 'alert');
              errEl.textContent = data.message || 'Sign up failed. Please try again.';
              form.before(errEl);

              if (btn) {
                btn.disabled = false;
                btn.textContent = originalText;
              }
            }
          } catch (err) {
            // Network error handling
            if (!navigator.onLine) {
              const errEl = document.createElement('div');
              errEl.className = 'network-error';
              errEl.setAttribute('role', 'alert');
              errEl.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                You appear to be offline. Please check your connection and try again.
              `;
              form.before(errEl);
            } else {
              trackAuth("signup_error", { error: 'network' });

              const errEl = document.createElement('div');
              errEl.className = 'alert alert-error';
              errEl.setAttribute('role', 'alert');
              errEl.textContent = 'Network error. Please try again.';
              form.before(errEl);
            }

            if (btn) {
              btn.disabled = false;
              btn.textContent = originalText;
            }
          }
        });
    }
  })();
</script>
