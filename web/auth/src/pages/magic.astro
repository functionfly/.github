---
import AuthLayout from "../layouts/AuthLayout.astro";
import { API_ORIGIN, APP_ORIGIN } from "../config";

// Server-rendered to capture magic link token from query params
export const prerender = false;

const urlToken = Astro.url.searchParams.get("token") || "";
const rawToken = Astro.url.searchParams.get("token");

// Debug logging on server
console.log("[Magic Link SSR] URL:", Astro.url.pathname + Astro.url.search);
console.log("[Magic Link SSR] Token present:", !!rawToken, "Length:", urlToken.length);

// If no token, redirect to login
if (!urlToken) {
  console.log("[Magic Link SSR] No token found, redirecting to login");
  return Astro.redirect("/login");
}

const token = urlToken;
---

<AuthLayout title="Verifying Magic Link — FunctionFly™">
  <!-- Server-captured token for client-side verification -->
  <div id="token-data" data-token={token} style="display: none;"></div>

  <div class="verify-container" id="verify-container">
    <div class="verify-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </div>
    <h1 class="verify-title">Verifying your link...</h1>
    <p class="verify-text">Please wait while we verify your magic link.</p>
    <div class="spinner" id="spinner"></div>
    <div class="error-container hidden" id="error-container">
      <div class="error-icon">⚠️</div>
      <h2 class="error-title">Link expired or invalid</h2>
      <p class="error-text" id="error-text">This magic link has expired or already been used.</p>
      <a href="/login" class="btn-primary">Go to login</a>
    </div>
  </div>
</AuthLayout>

<style>
  .verify-container {
    text-align: center;
    padding: 2rem;
    max-width: 400px;
    margin: 0 auto;
  }
  .verify-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    background: rgba(255, 107, 53, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FF6B35;
  }
  .verify-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #F0F6FC;
    margin-bottom: 0.75rem;
  }
  .verify-text {
    color: #8B949E;
    margin-bottom: 2rem;
  }
  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 107, 53, 0.2);
    border-top-color: #FF6B35;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .spinner.hidden {
    display: none;
  }
  .error-container {
    text-align: center;
  }
  .error-container.hidden {
    display: none;
  }
  .error-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .error-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #F0F6FC;
    margin-bottom: 0.5rem;
  }
  .error-text {
    color: #8B949E;
    margin-bottom: 1.5rem;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: #FF6B35;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    transition: background 0.15s;
  }
  .btn-primary:hover {
    background: #FF4F5E;
  }
</style>

<script define:vars={{ apiOrigin: API_ORIGIN, appOrigin: APP_ORIGIN }}>
  // Get token from server-rendered data attribute (more reliable than script var)
  const tokenDataEl = document.getElementById("token-data");
  const token = tokenDataEl?.dataset.token || "";

  // Debug logging
  console.log("[Magic Link] Token captured:", token ? "yes (length: " + token.length + ")" : "NO TOKEN");
  console.log("[Magic Link] Token preview:", token.substring(0, 8) + "...");

  async function verifyMagicLink() {
    const spinner = document.getElementById("spinner");
    const errorContainer = document.getElementById("error-container");
    const verifyTitle = document.querySelector(".verify-title");
    const verifyText = document.querySelector(".verify-text");
    const errorText = document.getElementById("error-text");

    if (!token) {
      console.error("[Magic Link] No token available");
      if (spinner) spinner.classList.add("hidden");
      if (errorContainer) errorContainer.classList.remove("hidden");
      if (verifyTitle) verifyTitle.textContent = "Invalid link";
      if (verifyText) verifyText.textContent = "The magic link is missing or invalid.";
      return;
    }

    try {
      const verifyUrl = `${apiOrigin}/v1/auth/magic-link/verify`;
      console.log("[Magic Link] Sending verification request to:", verifyUrl);
      console.log("[Magic Link] Token being sent (first 16 chars):", token.substring(0, 16));

      const res = await fetch(verifyUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
        credentials: "include",
      });

      console.log("[Magic Link] Response status:", res.status);

      const data = await res.json().catch(() => ({}));
      console.log("[Magic Link] Response data:", data);

      if (res.ok && data.token) {
        // Success - redirect to dashboard with tokens
        const params = new URLSearchParams();
        params.set("token", data.token);
        if (data.refresh_token) params.set("refresh_token", data.refresh_token);
        if (data.redirect_url) params.set("redirect", data.redirect_url);
        params.set("magic_link", "true"); // Flag for toast notification

        window.location.replace(appOrigin + "/auth/callback?" + params.toString());
      } else {
        // Show error
        console.error("[Magic Link] Verification failed:", res.status, data);
        if (spinner) spinner.classList.add("hidden");
        if (errorContainer) errorContainer.classList.remove("hidden");
        if (verifyTitle) verifyTitle.textContent = "Verification failed";
        if (verifyText) verifyText.style.display = "none";

        if (data.message) {
          if (errorText) errorText.textContent = data.message;
        }
      }
    } catch (err) {
      // Network error
      if (spinner) spinner.classList.add("hidden");
      if (errorContainer) errorContainer.classList.remove("hidden");
      if (verifyTitle) verifyTitle.textContent = "Connection error";
      if (verifyText) verifyText.style.display = "none";
      if (errorText) errorText.textContent = "Could not connect to server. Please try again.";
    }
  }

  // Start verification immediately
  verifyMagicLink();
</script>
