---
// OAuth callback page — the orchestrator redirects here with token/refresh_token params
// Server-rendered to capture auth tokens from query params
export const prerender = false;

import { APP_ORIGIN } from "../../config";

const token = decodeURIComponent(Astro.url.searchParams.get("token") || "");
const refreshToken = decodeURIComponent(Astro.url.searchParams.get("refresh_token") || "");
const error = Astro.url.searchParams.get("error") || "";
const errorDescription = Astro.url.searchParams.get("error_description") || "";
const isNewUser = Astro.url.searchParams.get("new_user") === "true";
const redirectParam = decodeURIComponent(Astro.url.searchParams.get("redirect_to") || Astro.url.searchParams.get("redirect") || "");
---

<html>
  <head>
    <meta charset="UTF-8" />
    <title>{error ? "Auth failed" : "Signing in…"} — FunctionFly™</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; background: #0D1117; color: #F0F6FC; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
      .card { background: #161B22; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px; padding: 2rem; max-width: 420px; width: 90%; text-align: center; }
      h1 { font-size: 1.25rem; margin-bottom: 0.75rem; }
      p { color: #8B949E; font-size: 0.9375rem; line-height: 1.6; }
      a { color: #00D4FF; text-decoration: none; }
      a:hover { color: #FF6B35; text-decoration: underline; }
    </style>
  </head>
  <body>
    {error ? (
      <div class="card">
        <h1>Authentication failed</h1>
        <p>{errorDescription || error}. <a href="/login">Try again</a>.</p>
        <script define:vars={{ error, errorDescription }}>
          function trackAuth(event, properties = {}) {
            const eventName = `auth_${event}`;
            if (typeof window !== "undefined" && (window.plausible || window.posthog)) {
              if (window.plausible) {
                window.plausible(eventName, { props: properties });
              }
              if (window.posthog) {
                window.posthog.capture(eventName, properties);
              }
            }
            if (typeof process !== "undefined" && process.env?.NODE_ENV === "development") {
              console.log(`[Analytics] ${eventName}`, properties);
            }
          }
          trackAuth("oauth_error", { error, description: errorDescription });
        </script>
      </div>
    ) : (
      <div class="card">
        <h1>{isNewUser ? "Account created!" : "Signed in!"}</h1>
        <p>Redirecting to your dashboard…</p>
        <script define:vars={{ token, refreshToken, isNewUser, redirectParam, appOrigin: APP_ORIGIN }}>
          function trackAuth(event, properties = {}) {
            const eventName = `auth_${event}`;
            if (typeof window !== "undefined" && (window.plausible || window.posthog)) {
              if (window.plausible) {
                window.plausible(eventName, { props: properties });
              }
              if (window.posthog) {
                window.posthog.capture(eventName, properties);
              }
            }
            if (typeof process !== "undefined" && process.env?.NODE_ENV === "development") {
              console.log(`[Analytics] ${eventName}`, properties);
            }
          }
          // Track OAuth success
          trackAuth("oauth_callback", { new_user: isNewUser });

          // Pass tokens via URL fragment — fragments are never sent to servers, not in logs or Referer.
          // sessionStorage is per-origin so it can't survive cross-origin redirects from auth → app.
          // JWTs contain = and + characters that break URLs — encode properly.
          if (token) {
            const params = new URLSearchParams();
            params.set("token", token);
            if (refreshToken) params.set("refresh_token", refreshToken);
            if (isNewUser) params.set("new_user", "true");
            if (redirectParam) params.set("redirect", redirectParam);
            // Navigate via location.replace to avoid polluting history
            window.location.replace(appOrigin + "/auth/callback#" + params.toString());
          } else {
            // No token — redirect to login
            window.location.replace(appOrigin + "/auth/callback");
          }
        </script>
      </div>
    )}
  </body>
</html>
