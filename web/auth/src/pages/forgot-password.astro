---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";
import { API_ORIGIN } from "../config";
---

<AuthLayout title="Forgot password — FunctionFly™">
  <FormCard
    title="Reset your password"
    subtitle="We'll send you a reset link"
    client:load
  >
    <form id="reset-form" novalidate>
      <InputField
        client:load
        label="Email address"
        name="email"
        type="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />

      <!-- Offline indicator -->
      <p class="offline-indicator" id="offline-indicator" hidden>
        You appear to be offline. Please check your connection.
      </p>

      <Button client:load type="submit" fullWidth id="submit-btn">Send reset link</Button>
    </form>

    <div slot="footer">
      Remember your password? <a href="/login">Sign in</a>
    </div>
  </FormCard>
</AuthLayout>

<style>
  .offline-indicator {
    color: #FF6B7A;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    text-align: center;
  }
  .network-error {
    background: rgba(255, 45, 85, 0.1);
    border: 1px solid rgba(255, 45, 85, 0.3);
    color: #FF6B7A;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .success-message {
    background: rgba(0, 255, 157, 0.1);
    border: 1px solid rgba(0, 255, 157, 0.3);
    color: #00FF9D;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
</style>

<script is:inline define:vars={{ apiOrigin: API_ORIGIN }}>
  (function() {
    // Utility functions
    const validators = {
      email: (value) => {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!value || value.trim() === "") {
          return { valid: false, error: "Email is required" };
        }
        if (!emailRegex.test(value)) {
          return { valid: false, error: "Please enter a valid email address" };
        }
        return { valid: true };
      }
    };

    function validateAll(validations) {
      const errors = {};
      for (const { name, result } of validations) {
        if (!result.valid && result.error) {
          errors[name] = result.error;
        }
      }
      return { valid: Object.keys(errors).length === 0, errors };
    }

    function trackAuth(event, properties = {}) {
      const eventName = `auth_${event}`;
      if (typeof window !== "undefined" && (window.plausible || window.posthog)) {
        if (window.plausible) {
          window.plausible(eventName, { props: properties });
        }
        if (window.posthog) {
          window.posthog.capture(eventName, properties);
        }
      }
      if (typeof process !== "undefined" && process.env?.NODE_ENV === "development") {
        console.log(`[Analytics] ${eventName}`, properties);
      }
    }

    trackAuth("password_reset_start");

      const form = document.getElementById("reset-form");
      const submitBtn = document.getElementById("submit-btn");
      const offlineIndicator = document.getElementById("offline-indicator");

      function updateNetworkStatus() {
        if (offlineIndicator) {
          offlineIndicator.hidden = navigator.onLine;
        }
        if (submitBtn) {
          submitBtn.disabled = !navigator.onLine;
        }
      }

      window.addEventListener("online", updateNetworkStatus);
      window.addEventListener("offline", updateNetworkStatus);
      updateNetworkStatus();

      if (!form) return;

      form.addEventListener("submit", async function(e) {
        e.preventDefault();

        const emailInput = form.querySelector('input[name="email"]');
        const email = emailInput?.value || '';

        // Client-side validation
        const validation = validators.email(email);
        if (!validation.valid) {
          const errEl = document.createElement("div");
          errEl.className = "alert alert-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = validation.error;
          form.before(errEl);
          emailInput?.focus();
          return;
        }

        const originalText = submitBtn?.textContent;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Sending…";
        }

        try {
          const res = await fetch(apiOrigin + "/auth/password-reset", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });

          const data = await res.json().catch(function() { return {}; });

          // Clear any previous alerts
          const card = form.closest(".card");
          const existing = card?.querySelector(".alert, .success-message, .network-error");
          if (existing) existing.remove();

          if (res.ok) {
            trackAuth("password_reset_sent");

            const alert = document.createElement("div");
            alert.className = "success-message";
            alert.setAttribute("role", "status");
            alert.textContent = data.message || "If that email is registered, a reset link has been sent.";
            form.before(alert);

            if (submitBtn) {
              submitBtn.textContent = "Sent!";
            }
          } else {
            trackAuth("password_reset_error", { error: data.message || 'unknown' });

            const alert = document.createElement("div");
            alert.className = "alert alert-error";
            alert.setAttribute("role", "alert");
            alert.textContent = data.message || "Failed to send reset link. Please try again.";
            form.before(alert);

            if (submitBtn) {
              submitBtn.disabled = !navigator.onLine;
              submitBtn.textContent = originalText;
            }
          }
        } catch (err) {
          // Clear previous alerts
          const card = form.closest(".card");
          const existing = card?.querySelector(".alert, .success-message, .network-error");
          if (existing) existing.remove();

          if (!navigator.onLine) {
            const errEl = document.createElement("div");
            errEl.className = "network-error";
            errEl.setAttribute("role", "alert");
            errEl.innerHTML = `
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              You appear to be offline. Please check your connection.
            `;
            form.before(errEl);
          } else {
            trackAuth("password_reset_error", { error: 'network' });

            const errEl = document.createElement("div");
            errEl.className = "alert alert-error";
            errEl.setAttribute("role", "alert");
            errEl.textContent = "Network error. Please try again.";
            form.before(errEl);
          }

          if (submitBtn) {
            submitBtn.disabled = !navigator.onLine;
            submitBtn.textContent = originalText;
          }
        }
      });
  })();
</script>
