---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";
---

<AuthLayout title="Forgot password — FunctionFly">
  <FormCard
    title="Reset your password"
    subtitle="We'll send you a reset link"
    client:load
  >
    <form id="reset-form">
      <InputField
        client:load
        label="Email address"
        name="email"
        type="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />
      <Button client:load type="submit" fullWidth>Send reset link</Button>
    </form>

    <div slot="footer">
      Remember your password? <a href="/login">Sign in</a>
    </div>
  </FormCard>
</AuthLayout>

<script>
  const form = document.getElementById("reset-form") as HTMLFormElement;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const btn = form.querySelector("button") as HTMLButtonElement;
    btn.disabled = true; btn.textContent = "Sending…";

    const res = await fetch("/auth/password-reset", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: fd.get("email") }),
    });

    const data = await res.json().catch(() => ({}));
    const card = form.closest(".card") as HTMLElement;
    const existing = card?.querySelector(".alert");
    existing?.remove();

    const alert = document.createElement("div");
    alert.className = "alert alert-success";
    alert.textContent = data.message || "If that email is registered, a reset link has been sent.";
    form.before(alert);
    btn.textContent = "Sent!";
  });
</script>
