---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";

const token = Astro.url.searchParams.get("token") || "";
const error = Astro.url.searchParams.get("error") || "";
---

<AuthLayout title="Set new password — FunctionFly">
  <FormCard
    title="Set new password"
    subtitle="Choose a strong password"
    error={error}
    client:load
  >
    <form id="set-password-form">
      <input type="hidden" name="token" value={token} />
      <InputField
        client:load
        label="New password"
        name="newPassword"
        type="password"
        placeholder="Min. 8 characters"
        required
        minLength={8}
        autocomplete="new-password"
      />
      <InputField
        client:load
        label="Confirm password"
        name="confirmPassword"
        type="password"
        placeholder="Repeat password"
        required
        minLength={8}
        autocomplete="new-password"
      />
      <Button client:load type="submit" fullWidth>Update password</Button>
    </form>

    <div slot="footer">
      <a href="/login">Back to sign in</a>
    </div>
  </FormCard>
</AuthLayout>

<script>
  const form = document.getElementById("set-password-form") as HTMLFormElement;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const np = fd.get("newPassword") as string;
    const cp = fd.get("confirmPassword") as string;
    if (np !== cp) {
      const err = document.createElement("div");
      err.className = "alert alert-error"; err.textContent = "Passwords do not match.";
      form.before(err); return;
    }
    const btn = form.querySelector("button") as HTMLButtonElement;
    btn.disabled = true; btn.textContent = "Updating…";

    const res = await fetch("/auth/password-reset/confirm", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token: fd.get("token"), newPassword: np }),
    });

    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      window.location.href = "/login?reset=success";
    } else {
      btn.disabled = false; btn.textContent = "Update password";
      const err = document.createElement("div");
      err.className = "alert alert-error"; err.textContent = data.message || "Failed. Please try again.";
      form.before(err);
    }
  });
</script>
