---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";
import { API_ORIGIN } from "../config";

// Server-rendered to capture reset token from query params
export const prerender = false;

const token = Astro.url.searchParams.get("token") || "";
const error = Astro.url.searchParams.get("error") || "";
---

<AuthLayout title="Set new password — FunctionFly™">
  <FormCard
    title="Set new password"
    subtitle="Choose a strong password"
    error={error}
    client:load
  >
    <form id="set-password-form" novalidate>
      <input type="hidden" name="token" value={token} />

      <InputField
        client:load
        label="New password"
        name="newPassword"
        type="password"
        placeholder="Min. 8 characters"
        required
        minLength={8}
        autocomplete="new-password"
        id="new-password-field"
      />

      <!-- Password strength indicator -->
      <div id="password-strength" class="password-strength hidden" role="status" aria-live="polite">
        <div class="strength-bar" aria-hidden="true">
          <div class="strength-fill" id="strength-fill"></div>
        </div>
        <p class="strength-text" id="strength-text"></p>
        <ul class="password-requirements" aria-label="Password requirements">
          <li id="req-length">At least 8 characters</li>
          <li id="req-upper">One uppercase letter</li>
          <li id="req-lower">One lowercase letter</li>
          <li id="req-number">One number</li>
          <li id="req-special">One special character</li>
        </ul>
      </div>

      <InputField
        client:load
        label="Confirm password"
        name="confirmPassword"
        type="password"
        placeholder="Repeat password"
        required
        minLength={8}
        autocomplete="new-password"
        id="confirm-password-field"
      />

      <!-- Offline indicator -->
      <p class="offline-indicator" id="offline-indicator" hidden>
        You appear to be offline. Please check your connection.
      </p>

      <Button client:load type="submit" fullWidth id="submit-btn">Update password</Button>
    </form>

    <div slot="footer">
      <a href="/login">Back to sign in</a>
    </div>
  </FormCard>
</AuthLayout>

<style>
  .offline-indicator {
    color: #FF6B7A;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    text-align: center;
  }
  .network-error {
    background: rgba(255, 45, 85, 0.1);
    border: 1px solid rgba(255, 45, 85, 0.3);
    color: #FF6B7A;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .password-strength {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: rgba(28, 33, 40, 0.5);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .password-strength.hidden {
    display: none;
  }
  .strength-bar {
    height: 4px;
    background: #1C2128;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .strength-fill {
    height: 100%;
    width: 0%;
    transition: width 0.3s, background-color 0.3s;
  }
  .strength-fill.weak { background: #FF6B7A; width: 25%; }
  .strength-fill.fair { background: #FF6B35; width: 50%; }
  .strength-fill.good { background: #FF8C42; width: 75%; }
  .strength-fill.strong { background: #00FF9D; width: 100%; }
  .strength-text {
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .strength-text.weak { color: #FF6B7A; }
  .strength-text.fair { color: #FF6B35; }
  .strength-text.good { color: #FF8C42; }
  .strength-text.strong { color: #00FF9D; }
  .password-requirements {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .password-requirements li {
    font-size: 0.75rem;
    color: #6E7681;
    padding: 0.125rem 0;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .password-requirements li::before {
    content: "○";
    font-size: 0.5rem;
  }
  .password-requirements li.met {
    color: #00FF9D;
  }
  .password-requirements li.met::before {
    content: "✓";
  }
</style>

<script is:inline define:vars={{ apiOrigin: API_ORIGIN }}>
  (function() {
      // Utility functions
      const validators = {
        password: (value, options = {}) => {
          const { minLength = 8 } = options;
          const checks = {
            length: value.length >= minLength,
            upper: /[A-Z]/.test(value),
            lower: /[a-z]/.test(value),
            number: /[0-9]/.test(value),
            special: /[!@#$%^&*(),.?":{}|<>]/.test(value),
          };
          const score = Object.values(checks).filter(Boolean).length;
          let strength = "weak";
          if (score >= 5) strength = "strong";
          else if (score >= 4) strength = "good";
          else if (score >= 3) strength = "fair";
          if (!value || value.length < minLength) {
            return { valid: false, error: `Password must be at least ${minLength} characters`, strength, checks };
          }
          return { valid: true, strength, checks };
        },
        passwordMatch: (password, confirm) => {
          if (confirm && password !== confirm) {
            return { valid: false, error: "Passwords do not match" };
          }
          return { valid: true };
        }
      };

      function trackAuth(event, properties = {}) {
        const eventName = `auth_${event}`;
        if (typeof window !== "undefined" && (window.plausible || window.posthog)) {
          if (window.plausible) {
            window.plausible(eventName, { props: properties });
          }
          if (window.posthog) {
            window.posthog.capture(eventName, properties);
          }
        }
        if (typeof process !== "undefined" && process.env?.NODE_ENV === "development") {
          console.log(`[Analytics] ${eventName}`, properties);
        }
      }

      const form = document.getElementById("set-password-form");
      const submitBtn = document.getElementById("submit-btn");
      const offlineIndicator = document.getElementById("offline-indicator");
      const passwordField = document.getElementById("new-password-field");
      const strengthDisplay = document.getElementById("password-strength");
      const strengthFill = document.getElementById("strength-fill");
      const strengthText = document.getElementById("strength-text");

      function updateNetworkStatus() {
        if (offlineIndicator) {
          offlineIndicator.hidden = navigator.onLine;
        }
        if (submitBtn) {
          submitBtn.disabled = !navigator.onLine;
        }
      }

      window.addEventListener("online", updateNetworkStatus);
      window.addEventListener("offline", updateNetworkStatus);
      updateNetworkStatus();

      // Password strength indicator
      function updatePasswordStrength(password) {
        const result = validators.password(password);
        const checks = result.checks;

        document.getElementById('req-length')?.classList.toggle('met', checks.length);
        document.getElementById('req-upper')?.classList.toggle('met', checks.upper);
        document.getElementById('req-lower')?.classList.toggle('met', checks.lower);
        document.getElementById('req-number')?.classList.toggle('met', checks.number);
        document.getElementById('req-special')?.classList.toggle('met', checks.special);

        if (strengthFill) {
          strengthFill.className = 'strength-fill';
          if (password.length > 0) {
            strengthFill.classList.add(result.strength);
          }
        }

        if (strengthText) {
          strengthText.className = 'strength-text';
          if (password.length > 0) {
            strengthText.classList.add(result.strength);
            const labels = { weak: 'Weak password', fair: 'Fair password', good: 'Good password', strong: 'Strong password' };
            strengthText.textContent = labels[result.strength];
          }
        }

        if (strengthDisplay) {
          strengthDisplay.classList.toggle('hidden', password.length === 0);
        }
      }

      passwordField?.addEventListener('input', (e) => {
        updatePasswordStrength(e.target.value);
      });

      if (!form) return;

      form.addEventListener("submit", async function(e) {
        e.preventDefault();

        const np = document.getElementById("new-password-field")?.value;
        const cp = document.getElementById("confirm-password-field")?.value;
        const token = form.querySelector('input[name="token"]')?.value;

        // Client-side validation
        const passwordValidation = validators.password(np);
        if (!passwordValidation.valid) {
          const errEl = document.createElement("div");
          errEl.className = "alert alert-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = passwordValidation.error || "Please enter a valid password";
          form.before(errEl);
          document.getElementById("new-password-field")?.focus();
          return;
        }

        const matchValidation = validators.passwordMatch(np, cp);
        if (!matchValidation.valid) {
          const errEl = document.createElement("div");
          errEl.className = "alert alert-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = matchValidation.error || "Passwords do not match";
          form.before(errEl);
          return;
        }

        const originalText = submitBtn?.textContent;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Updating…";
        }

        try {
          const res = await fetch(apiOrigin + "/auth/password-reset/confirm", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, newPassword: np }),
          });

          const data = await res.json().catch(function() { return {}; });

          if (res.ok) {
            trackAuth("password_reset_complete");
            window.location.href = "/login?reset=success";
          } else {
            trackAuth("password_reset_error", { error: data.message || 'unknown', step: 'confirm' });

            const errDiv = document.createElement("div");
            errDiv.className = "alert alert-error";
            errDiv.setAttribute("role", "alert");
            errDiv.textContent = data.message || "Failed. Please try again.";
            form.before(errDiv);

            if (submitBtn) {
              submitBtn.disabled = !navigator.onLine;
              submitBtn.textContent = originalText;
            }
          }
        } catch (err) {
          if (!navigator.onLine) {
            const errEl = document.createElement("div");
            errEl.className = "network-error";
            errEl.setAttribute("role", "alert");
            errEl.innerHTML = `
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              You appear to be offline. Please check your connection.
            `;
            form.before(errEl);
          } else {
            trackAuth("password_reset_error", { error: 'network', step: 'confirm' });

            const errDiv = document.createElement("div");
            errDiv.className = "alert alert-error";
            errDiv.setAttribute("role", "alert");
            errDiv.textContent = "Network error. Please try again.";
            form.before(errDiv);
          }

          if (submitBtn) {
            submitBtn.disabled = !navigator.onLine;
            submitBtn.textContent = originalText;
          }
        }
      });
  })();
</script>
