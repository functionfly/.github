---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";
import Checkbox from "../components/Checkbox";
import ClientTurnstile from "../components/ClientTurnstile";
import OAuthProviders from "../components/OAuthProviders";
import { APP_ORIGIN, API_ORIGIN } from "../config";

// Server-rendered to handle query params (invite codes, magic link mode, etc.)
export const prerender = false;

const inviteCode = Astro.url.searchParams.get("invite_code") || undefined;
const redirectTo = Astro.url.searchParams.get("redirect") || Astro.url.searchParams.get("redirect_to") || undefined;
const magicParam = Astro.url.searchParams.get("magic") || undefined;
const showMagic = magicParam === "true";
const resetSuccess = Astro.url.searchParams.get("reset") === "success";
const rememberMe = Astro.url.searchParams.get("remember_me") === "true";
---

<AuthLayout title="Sign in — FunctionFly™">
  <FormCard
    title="Welcome back"
    subtitle={rememberMe ? "You're logged in for 30 days" : "Sign in to your FunctionFly™ account"}
    tagline="Deploy once. Run everywhere. Never go down."
    success={resetSuccess ? "Password updated successfully. Please sign in." : rememberMe ? "Logged in for 30 days" : undefined}
    client:load
  >
    <OAuthProviders client:load inviteCode={inviteCode} redirectAfterLogin={redirectTo} />

    <!-- Login Mode Toggle -->
    <div class="auth-mode-toggle" id="auth-mode-toggle">
      <button
        type="button"
        class={`mode-btn ${!showMagic ? "active" : ""}`}
        id="mode-password"
        aria-pressed={!showMagic ? "true" : "false"}
      >
        Password
      </button>
      <button
        type="button"
        class={`mode-btn ${showMagic ? "active" : ""}`}
        id="mode-magic"
        aria-pressed={showMagic ? "true" : "false"}
      >
        Magic Link
      </button>
    </div>

    <!-- Password Login Form -->
    <form id="login-form" class={`auth-form ${showMagic ? "hidden" : ""}`} novalidate>
      <input type="hidden" name="redirect_to" value={redirectTo || ""} />
      <InputField
        client:load
        label="Username or Email"
        name="email"
        type="text"
        placeholder="username or you@example.com"
        required
        autocomplete="username"
        hint="Sign in with your username or email address"
      />
      <InputField
        client:load
        label="Password"
        name="password"
        type="password"
        placeholder="••••••••"
        required
        autocomplete="current-password"
      />

      <!-- Rate Limit Indicator -->
      <div class="rate-limit-indicator hidden" id="rate-limit-indicator" role="status" aria-live="polite">
        <div class="rate-limit-warning">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 9v2m0 4h.01M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/>
          </svg>
          <span id="rate-limit-message">5 attempts remaining</span>
        </div>
        <div class="rate-limit-countdown hidden" id="rate-limit-countdown">
          Retry in <span id="countdown-timer">--:--</span>
        </div>
      </div>

      <!-- Turnstile CAPTCHA - shown after 2 failed attempts -->
      <div class="captcha-section hidden" id="turnstile-section">
        <ClientTurnstile
          client:only="react"
          action="login"
          theme="dark"
        />
        <input type="hidden" id="turnstile-token" name="turnstile_token" />
      </div>

      <!-- Remember Me & Forgot Password Row -->
      <div class="form-row">
        <Checkbox
          client:load
          label="Remember me for 30 days"
          name="remember"
          id="remember-checkbox"
        />
        <a href="/forgot-password" class="forgot-link">Forgot password?</a>
      </div>

      <Button client:load type="submit" fullWidth id="login-btn">Sign in</Button>
    </form>

    <!-- Magic Link Form -->
    <form id="magic-form" class={`auth-form ${!showMagic ? "hidden" : ""}`}>
      <p class="magic-description">
        We'll send a secure login link to your email. No password needed.
      </p>
      <InputField
        client:load
        label="Email"
        name="magic_email"
        type="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />
      <Button client:load type="submit" fullWidth variant="secondary" id="magic-btn">
        Send magic link
      </Button>
    </form>

    <div slot="footer" class="auth-footer">
      <span class="auth-footer__text">Don't have an account?</span>
      <a href={`/signup${inviteCode ? `?invite_code=${inviteCode}` : ""}`} class="auth-footer__link">
        Create account
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </FormCard>
</AuthLayout>

<style>
  .auth-mode-toggle {
    display: flex;
    gap: 0.5rem;
    margin: 1.5rem 0;
    padding: 0.25rem;
    background: var(--ff-flightdeck);
    border-radius: 8px;
    border: 1px solid var(--ff-border-subtle);
  }
  .mode-btn {
    flex: 1;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--ff-secondary-text);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .mode-btn:hover {
    color: var(--ff-primary-text);
  }
  .mode-btn.active {
    background: var(--ff-cockpit);
    color: var(--ff-primary-text);
    border: 1px solid var(--ff-flame);
    box-shadow: var(--ff-shadow-sm);
  }
  .auth-form {
    animation: fadeIn 0.3s ease;
  }
  .auth-form.hidden {
    display: none;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .magic-description {
    color: #8B949E;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .form-row :global(.ff-field) {
    margin-bottom: 0;
  }
  /* Add spacing before submit button */
  form > :global(.ff-btn) {
    margin-top: 0.5rem;
  }
  .forgot-link {
    font-size: 0.875rem;
    color: #8B949E;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .forgot-link:hover {
    color: #FF6B35;
    text-decoration: underline;
  }
  .network-error {
    background: rgba(255, 45, 85, 0.1);
    border: 1px solid rgba(255, 45, 85, 0.3);
    color: #FF6B7A;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .offline-indicator {
    color: #f87171;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: none;
  }
  .offline-indicator.visible {
    display: block;
  }
  /* Legacy button styles removed - using ff-btn component classes now */
  /* Rate limit indicator styles */
  .rate-limit-indicator {
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: rgba(255, 107, 53, 0.1);
    border: 1px solid rgba(255, 107, 53, 0.3);
    border-radius: 8px;
  }
  .rate-limit-indicator.hidden {
    display: none;
  }
  .rate-limit-warning {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #FF6B35;
    font-size: 0.875rem;
  }
  .rate-limit-countdown {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: #8B949E;
    text-align: center;
  }
  .rate-limit-countdown.hidden {
    display: none;
  }
  #countdown-timer {
    font-family: monospace;
    font-weight: 600;
    color: #FF6B7A;
  }
  /* CAPTCHA section */
  .captcha-section {
    margin-bottom: 1rem;
  }
  .captcha-section.hidden {
    display: none;
  }

  /* Error/Alert styles */
  .alert {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .alert-error {
    background: rgba(255, 45, 85, 0.1);
    border: 1px solid rgba(255, 45, 85, 0.3);
    color: #FF6B7A;
  }
  .alert-success {
    background: rgba(72, 199, 116, 0.1);
    border: 1px solid rgba(72, 199, 116, 0.3);
    color: #48C774;
  }

  /* Auth footer - Sign up prompt */
  .auth-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
    font-size: 0.875rem;
  }

  .auth-footer__text {
    color: #8B949E;
  }

  .auth-footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: #FF6B35;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
    border-radius: 6px;
  }

  .auth-footer__link:hover {
    color: #FF4F5E;
    background: rgba(255, 107, 53, 0.1);
    text-decoration: none;
  }

  .auth-footer__link svg {
    transition: transform 0.15s ease;
  }

  .auth-footer__link:hover svg {
    transform: translateX(2px);
  }

  .auth-footer__link:focus-visible {
    outline: 2px solid #FF6B35;
    outline-offset: 2px;
  }
</style>

<script define:vars={{ appOrigin: APP_ORIGIN, apiOrigin: API_ORIGIN }}>
  // Analytics utilities
  function trackAuth(event, properties = {}) {
    const eventName = `auth_${event}`;
    if (typeof window !== "undefined" && (window.plausible || window.posthog)) {
      if (window.plausible) {
        window.plausible(eventName, { props: properties });
      }
      if (window.posthog) {
        window.posthog.capture(eventName, properties);
      }
    }
    if (typeof process !== "undefined" && process.env?.NODE_ENV === "development") {
      console.log(`[Analytics] ${eventName}`, properties);
    }
  }

  function createTimer(variable) {
    const start = performance.now();
    return () => {
      const duration = Math.round(performance.now() - start);
      trackAuth("timing", { category: "auth", variable, value: duration });
    };
  }

  // Rate limiting state
  let failedAttempts = 0;
  const MAX_ATTEMPTS = 5;
  const CAPTCHA_THRESHOLD = 2; // Show CAPTCHA after 2 failures
  let lockoutEndTime = null;
  let countdownInterval = null;

  function updateRateLimitUI() {
    const indicator = document.getElementById('rate-limit-indicator');
    const message = document.getElementById('rate-limit-message');
    const countdown = document.getElementById('rate-limit-countdown');
    const timer = document.getElementById('countdown-timer');
    const captchaSection = document.getElementById('turnstile-section');

    if (!indicator) return;

    const remaining = Math.max(0, MAX_ATTEMPTS - failedAttempts);

    // Show/hide CAPTCHA based on failed attempts
    if (failedAttempts >= CAPTCHA_THRESHOLD && captchaSection) {
      captchaSection.classList.remove('hidden');
    }

    if (failedAttempts === 0) {
      indicator.classList.add('hidden');
      return;
    }

    indicator.classList.remove('hidden');

    if (remaining > 0) {
      message.textContent = `${remaining} attempt${remaining === 1 ? '' : 's'} remaining before account lockout`;
      countdown.classList.add('hidden');
    } else {
      message.textContent = 'Account temporarily locked due to too many failed attempts';
      countdown.classList.remove('hidden');
      startCountdown();
    }
  }

  function startCountdown() {
    const timer = document.getElementById('countdown-timer');
    const countdown = document.getElementById('rate-limit-countdown');
    const btn = document.getElementById('login-btn');

    if (!lockoutEndTime) {
      // Default 15 minute lockout
      lockoutEndTime = Date.now() + 15 * 60 * 1000;
    }

    if (btn) {
      btn.disabled = true;
    }

    if (countdownInterval) {
      clearInterval(countdownInterval);
    }

    countdownInterval = setInterval(() => {
      const remaining = Math.max(0, lockoutEndTime - Date.now());
      const minutes = Math.floor(remaining / 60000);
      const seconds = Math.floor((remaining % 60000) / 1000);
      timer.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

      if (remaining === 0) {
        clearInterval(countdownInterval);
        countdown.classList.add('hidden');
        failedAttempts = 0;
        updateRateLimitUI();
        if (btn) {
          btn.disabled = false;
        }
      }
    }, 1000);
  }

  // Delay execution to avoid conflicts with React hydration
  setTimeout(() => {
    // Auto-focus first field
    const firstEmailInput = document.querySelector('input[type="email"]');
    if (firstEmailInput && !firstEmailInput.value) {
      firstEmailInput.focus();
    }

    // Initialize analytics
    const stopTimer = createTimer("login_form_interaction");

    // Track login start
    trackAuth("login_start");

    // Mode toggle
    const modePassword = document.getElementById("mode-password");
    const modeMagic = document.getElementById("mode-magic");
    const loginForm = document.getElementById("login-form");
    const magicForm = document.getElementById("magic-form");

    function setMode(mode) {
      const isPassword = mode === "password";
      modePassword?.classList.toggle("active", isPassword);
      modePassword?.setAttribute("aria-pressed", isPassword);
      modeMagic?.classList.toggle("active", !isPassword);
      modeMagic?.setAttribute("aria-pressed", !isPassword);
      loginForm?.classList.toggle("hidden", !isPassword);
      magicForm?.classList.toggle("hidden", isPassword);

      // Focus first input of visible form
      const visibleForm = isPassword ? loginForm : magicForm;
      const firstInput = visibleForm?.querySelector('input[type="email"]');
      firstInput?.focus();
    }

    modePassword?.addEventListener("click", () => setMode("password"));
    modeMagic?.addEventListener("click", () => {
      setMode("magic");
      trackAuth("magic_link_requested");
    });

    // Check network status - only show warning after failed submission
    let offlineIndicators = [];

    function createOfflineIndicator() {
      const indicator = document.createElement("div");
      indicator.className = "offline-indicator";
      indicator.textContent = "⚠️ You appear to be offline. Please check your connection.";
      return indicator;
    }

    function showOfflineIndicators(show) {
      const forms = document.querySelectorAll(".auth-form");
      forms.forEach((form) => {
        let indicator = form.querySelector(".offline-indicator");
        if (show && !indicator) {
          indicator = createOfflineIndicator();
          form.prepend(indicator);
        }
        if (indicator) {
          indicator.classList.toggle("visible", show);
        }
      });

      const submitBtns = document.querySelectorAll('button[type="submit"]');
      submitBtns.forEach((btn) => {
        btn.disabled = show;
        btn.title = show ? 'You appear to be offline' : '';
      });
    }

    async function checkNetworkConnectivity(timeoutMs = 3000) {
      if (!navigator.onLine) return false;
      try {
        const response = await fetch(`${apiOrigin}/health`, {
          method: 'GET',
          cache: 'no-cache',
          signal: AbortSignal.timeout(timeoutMs),
        });
        return response.ok;
      } catch {
        return false;
      }
    }

    async function updateNetworkStatus(showImmediately = false) {
      if (!hasSubmitted && !showImmediately) return;

      const isOnline = await checkNetworkConnectivity();
      showOfflineIndicators(!isOnline);
      return isOnline;
    }

    window.addEventListener("online", () => {
      hasSubmitted = true;
      showOfflineIndicators(false);
    });
    window.addEventListener("offline", () => {
      hasSubmitted = true;
      showOfflineIndicators(true);
    });

    // Password form submission
    const form = document.getElementById("login-form");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      hasSubmitted = true;

      // Check connectivity before attempting login
      const isOnline = await updateNetworkStatus(true);
      if (isOnline === false) {
        // Offline - don't proceed, warning is already shown
        return;
      }

      const fd = new FormData(form);

      // Only include email and password in the request body (backend LoginRequest expects these only)
      const body = {
        email: fd.get("email"),
        password: fd.get("password")
      };

      // Add turnstile token if CAPTCHA is visible
      const turnstileToken = fd.get("turnstile_token");
      const captchaSection = document.getElementById('turnstile-section');
      if (turnstileToken && !captchaSection?.classList.contains('hidden')) {
        body.turnstile_token = turnstileToken;
      }

      // Store redirect_to and remember for post-login handling
      const redirectTo = fd.get("redirect_to");
      const remember = fd.get("remember");

      // Track attempt
      trackAuth("login_attempt", { method: "password", has_captcha: !!body.turnstile_token });

      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn?.textContent;
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Signing in…";
      }

      try {
        const res = await fetch(`${apiOrigin}/auth/login`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
          credentials: "include",
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.token) {
          // Track success
          trackAuth("login_success", { method: "password", remember: !!remember });
          stopTimer();

          // Redirect
          const params = new URLSearchParams();
          params.set("token", data.token);
          if (data.refresh_token) params.set("refresh_token", data.refresh_token);
          // Pass through the original redirect if provided
          if (redirectTo) params.set("redirect", redirectTo.toString());
          // Add remember me flag for toast on callback
          if (remember) params.set("remember_me", "true");
          window.location.replace(appOrigin + "/auth/callback?" + params.toString());
        } else {
          // Track error
          trackAuth("login_error", { method: "password", error: data.message || "unknown" });

          // Increment failed attempts
          failedAttempts++;

          // Check if server provided lockout info
          if (data.lockout_until) {
            lockoutEndTime = new Date(data.lockout_until).getTime();
          }
          if (data.remaining_attempts !== undefined) {
            failedAttempts = MAX_ATTEMPTS - data.remaining_attempts;
          }

          updateRateLimitUI();

          // Show error
          const card = form.closest(".card");
          const errEl = document.createElement("div");
          errEl.className = "alert alert-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = data.message || "Sign in failed. Please try again.";
          form.before(errEl);

          // Reset button
          if (btn) {
            btn.disabled = false;
            btn.textContent = originalText;
          }
        }
      } catch (err) {
        // Network error handling
        if (!navigator.onLine) {
          const card = form.closest(".card");
          const errEl = document.createElement("div");
          errEl.className = "network-error";
          errEl.setAttribute("role", "alert");
          errEl.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            You appear to be offline. Please check your connection.
          `;
          form.before(errEl);
        } else {
          trackAuth("login_error", { method: "password", error: "network" });

          const card = form.closest(".card");
          const errEl = document.createElement("div");
          errEl.className = "alert alert-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = "Network error. Please try again.";
          form.before(errEl);
        }

        if (btn) {
          btn.disabled = false;
          btn.textContent = originalText;
        }
      }
    });

    // Magic link form submission
    const magicFormEl = document.getElementById("magic-form");
    magicFormEl?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(magicFormEl);
      const email = fd.get("magic_email");

      const btn = magicFormEl.querySelector('button[type="submit"]');
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Sending…";
      }

      try {
        const res = await fetch(`${apiOrigin}/auth/magic-link`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          trackAuth("magic_link_sent");
          const card = magicFormEl.closest(".card");
          const successEl = document.createElement("div");
          successEl.className = "alert alert-success";
          successEl.setAttribute("role", "status");
          successEl.textContent = data.message || "Check your email for the magic link!";
          magicFormEl.before(successEl);
          magicFormEl.reset();
        } else {
          trackAuth("magic_link_error", { error: data.message });
          const card = magicFormEl.closest(".card");
          const errEl = document.createElement("div");
          errEl.className = "alert alert-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = data.message || "Failed to send magic link.";
          magicFormEl.before(errEl);
        }
      } catch (err) {
        if (!navigator.onLine) {
          const errEl = document.createElement("div");
          errEl.className = "network-error";
          errEl.setAttribute("role", "alert");
          errEl.textContent = "You appear to be offline.";
          magicFormEl.before(errEl);
        }
      }

      if (btn) {
        btn.disabled = false;
        btn.textContent = "Send magic link";
      }
    });
  }, 100); // Delay to allow React hydration
</script>
