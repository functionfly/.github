---
import AuthLayout from "../layouts/AuthLayout.astro";
import FormCard from "../components/FormCard";
import InputField from "../components/InputField";
import Button from "../components/Button";
import OAuthProviders from "../components/OAuthProviders";

// At build time, we can't fetch from API - use client-side fetching instead
// The OAuthProviders component will fetch providers on mount
const inviteCode = Astro.url.searchParams.get("invite_code") || undefined;
const redirectTo = Astro.url.searchParams.get("redirect_to") || undefined;
---

<AuthLayout title="Sign in — FunctionFly">
  <FormCard
    title="Welcome back"
    subtitle="Sign in to your FunctionFly account"
    client:load
  >
    <OAuthProviders client:load inviteCode={inviteCode} redirectAfterLogin={redirectTo} />

    <form id="login-form" method="POST" action={`${import.meta.env.PUBLIC_API_URL || "http://localhost:8080"}/auth/login`}>
      <input type="hidden" name="redirect_to" value={redirectTo || ""} />
      <InputField
        client:load
        label="Email"
        name="email"
        type="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      />
      <InputField
        client:load
        label="Password"
        name="password"
        type="password"
        placeholder="••••••••"
        required
        autocomplete="current-password"
      />
      <div class="form-row">
        <a href="/forgot-password" class="forgot-link">Forgot password?</a>
      </div>
      <Button client:load type="submit" fullWidth>Sign in</Button>
    </form>

    <div slot="footer">
      Don't have an account?{" "}
      <a href={`/signup${inviteCode ? `?invite_code=${inviteCode}` : ""}`}>
        Create one
      </a>
    </div>
  </FormCard>
</AuthLayout>

<style>
  .form-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.25rem;
  }
  .forgot-link {
    font-size: 0.875rem;
    color: #a1a1aa;
    text-decoration: none;
  }
  .forgot-link:hover { color: #fafafa; text-decoration: underline; }
</style>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const body = Object.fromEntries(fd.entries());

    const res = await fetch(form.action, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      credentials: "include",
    });

    const data = await res.json().catch(() => ({}));
    if (res.ok && data.token) {
      const redirectTo = (body.redirect_to as string) || "/auth/callback";
      window.location.href = redirectTo + `?token=${data.token}&refresh_token=${data.refresh_token || ""}`;
    } else {
      const card = form.closest(".card") as HTMLElement;
      const errEl = card?.querySelector(".alert-error") || document.createElement("div");
      errEl.className = "alert alert-error";
      errEl.textContent = data.message || "Sign in failed. Please try again.";
      form.before(errEl);
    }
  });
</script>
