# Auth site environment variables
# Copy to .env for local development

# Public site URL
PUBLIC_AUTH_URL=http://localhost:4324

# Orchestrator API (for local dev with CORS)
PUBLIC_API_URL=http://localhost:8080

# Dashboard URL (redirect after auth)
PUBLIC_APP_URL=http://localhost:3000

# Marketing site URL (for terms & privacy links)
PUBLIC_MARKETING_URL=http://localhost:4321

# Cloudflare Turnstile CAPTCHA (optional - uses test key if not set)
# Get your site key from https://dash.cloudflare.com/?to=/:account/:zone/turnstile
# Test key: 1x00000000000000000000AA (always passes)
# Public key for local dev
PUBLIC_TURNSTILE_SITE_KEY=0x0099090909090
