---
export interface Props {
  status: 'testing' | 'beta' | 'in-progress' | 'planned' | 'design' | 'shipped';
}
const { status } = Astro.props;

const config = {
  testing: { label: 'Testing', class: 'testing' },
  beta: { label: 'Beta', class: 'beta' },
  'in-progress': { label: 'In Progress', class: 'in-progress' },
  planned: { label: 'Planned', class: 'planned' },
  design: { label: 'Design', class: 'design' },
  shipped: { label: 'Shipped', class: 'shipped' },
};

const { label, class: statusClass } = config[status] || config.planned;
---

<span class={`roadmap-status ${statusClass}`}>
  <span class="roadmap-status-dot"></span>
  {label}
</span>

<style>
  .roadmap-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
    font-family: var(--font-mono, monospace);
  }

  .roadmap-status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .testing {
    background: rgb(168 85 247 / 0.2);
    color: rgb(192 132 252);
    border: 1px solid rgb(168 85 247 / 0.4);
  }
  .testing .roadmap-status-dot {
    background: rgb(168 85 247);
    box-shadow: 0 0 0.375rem rgb(168 85 247);
  }

  .beta {
    background: rgb(59 130 246 / 0.2);
    color: rgb(96 165 250);
    border: 1px solid rgb(59 130 246 / 0.4);
  }
  .beta .roadmap-status-dot {
    background: rgb(59 130 246);
    box-shadow: 0 0 0.375rem rgb(59 130 246);
  }

  .in-progress {
    background: rgb(34 197 94 / 0.2);
    color: rgb(74 222 128);
    border: 1px solid rgb(34 197 94 / 0.4);
  }
  .in-progress .roadmap-status-dot {
    background: rgb(34 197 94);
    box-shadow: 0 0 0.375rem rgb(34 197 94);
    animation: pulse 2s ease-in-out infinite;
  }

  .planned {
    background: rgb(251 191 36 / 0.2);
    color: rgb(251 191 36);
    border: 1px solid rgb(251 191 36 / 0.4);
  }
  .planned .roadmap-status-dot {
    background: rgb(251 191 36);
  }

  .design {
    background: rgb(236 72 153 / 0.2);
    color: rgb(244 114 182);
    border: 1px solid rgb(236 72 153 / 0.4);
  }
  .design .roadmap-status-dot {
    background: rgb(236 72 153);
  }

  .shipped {
    background: rgb(20 184 166 / 0.2);
    color: rgb(45 212 191);
    border: 1px solid rgb(20 184 166 / 0.4);
  }
  .shipped .roadmap-status-dot {
    background: rgb(20 184 166);
    box-shadow: 0 0 0.375rem rgb(20 184 166);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
