---
// LanguagePicker.astro — language selector for the docs sidebar
import { LANGUAGES_BY_NATIVE_NAME, getLanguage } from '../lib/i18n/languages';
import type { Language } from '../lib/i18n/languages';

interface Props {
  currentLang?: string;
  locales?: Record<string, Record<string, string>>;
}
const { currentLang = 'en', locales = {} } = Astro.props;

function t(key: string): string {
  const parts = key.split('.');
  let val: unknown = locales[currentLang] ?? locales['en'];
  for (const p of parts) {
    if (val && typeof val === 'object' && p in (val as Record<string, unknown>)) {
      val = (val as Record<string, unknown>)[p];
    } else return key;
  }
  return typeof val === 'string' ? val : key;
}

const current = getLanguage(currentLang) ?? getLanguage('en')!;

import { detectLanguage } from '../lib/i18n/languages';
const acceptLang = Astro.request.headers.get('accept-language');
const detectedCode = detectLanguage(acceptLang);
const showDetected = detectedCode !== currentLang && detectedCode !== 'en';
const detectedLang = getLanguage(detectedCode);
---

<div class="docs-lang-picker">
  <button class="docs-lang-trigger" id="docs-lang-trigger" aria-label={t('language.title')} aria-expanded="false">
    <span class="docs-lang-flag">{current.flag}</span>
    <span class="docs-lang-name">{current.name}</span>
    <svg width="10" height="10" viewBox="0 0 12 12" fill="none">
      <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="docs-lang-dropdown" id="docs-lang-dropdown">
    <div class="docs-lang-dropdown-header">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
      {t('language.title')}
    </div>

    {showDetected && (
      <div class="docs-lang-detected">
        <span class="docs-lang-detected-badge">{t('language.detected')}</span>
        <span class="docs-lang-detected-name">{detectedLang?.flag} {detectedLang?.name}</span>
      </div>
    )}

    <div class="docs-lang-list">
      {LANGUAGES_BY_NATIVE_NAME.map((lang: Language) => {
        const selected = lang.code === currentLang;
        return (
          <button
            class:list={['docs-lang-option', { selected }]}
            data-lang={lang.code}
            dir={lang.dir ?? 'ltr'}
          >
            <span class="docs-lang-option-flag">{lang.flag}</span>
            <span class="docs-lang-option-name">{lang.name}</span>
            {selected && (
              <svg class="docs-lang-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            )}
          </button>
        );
      })}
    </div>

    <div class="docs-lang-footer">{t('language.autoDetected')}</div>
  </div>
</div>

<script>
  document.querySelectorAll('.docs-lang-option[data-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).getAttribute('data-lang');
      if (!lang) return;
      localStorage.setItem('ff_lang', lang);
      document.cookie = `ff_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
      window.dispatchEvent(new CustomEvent('ff:lang-change', { detail: { lang } }));
      window.location.reload();
    });
  });

  const trigger = document.getElementById('docs-lang-trigger');
  const dropdown = document.getElementById('docs-lang-dropdown');
  trigger?.addEventListener('click', () => {
    const isOpen = dropdown?.classList.contains('open');
    dropdown?.classList.toggle('open', !isOpen);
    trigger?.setAttribute('aria-expanded', String(!isOpen));
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.docs-lang-picker')) {
      dropdown?.classList.remove('open');
      trigger?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .docs-lang-picker { position: relative; }

  .docs-lang-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all 0.15s;
    width: 100%;
  }
  .docs-lang-trigger:hover {
    color: var(--color-text);
    background: rgba(99,102,241,0.08);
    border-color: var(--color-border);
  }
  .docs-lang-flag { font-size: 1rem; line-height: 1; }
  .docs-lang-name { flex: 1; text-align: left; font-weight: 500; }

  .docs-lang-dropdown {
    display: none;
    position: absolute;
    left: 0;
    bottom: calc(100% + 6px);
    min-width: 200px;
    background: #1a2336;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.5);
    z-index: 300;
    overflow: hidden;
  }
  .docs-lang-dropdown.open { display: block; }

  .docs-lang-dropdown-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .docs-lang-dropdown-header svg { opacity: 0.5; }

  .docs-lang-detected {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    background: rgba(245,158,11,0.08);
    border-bottom: 1px solid rgba(245,158,11,0.15);
    font-size: 0.72rem;
  }
  .docs-lang-detected-badge {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #f59e0b;
  }
  .docs-lang-detected-name { color: var(--color-text-muted); }

  .docs-lang-list {
    max-height: 280px;
    overflow-y: auto;
    padding: 0.3rem 0;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  .docs-lang-list::-webkit-scrollbar { width: 4px; }
  .docs-lang-list::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 4px; }

  .docs-lang-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.5rem 0.9rem;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.1s;
    text-align: left;
  }
  .docs-lang-option:hover { background: rgba(99,102,241,0.1); }
  .docs-lang-option.selected { background: rgba(99,102,241,0.12); }

  .docs-lang-option-flag { font-size: 1.05rem; }
  .docs-lang-option-name { flex: 1; font-weight: 500; }
  .docs-lang-check { color: #818cf8; }

  .docs-lang-footer {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.68rem;
    color: var(--color-text-subtle);
    text-align: center;
  }
</style>
