---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ApiReference from '../legacy-vite/ApiReference.tsx';
---

<StarlightPage frontmatter={{ title: 'API Reference', description: 'Complete reference for the FunctionFly REST API' }}>
  <div class="api-reference-wrapper">
    <ApiReference client:only="react" />
  </div>
</StarlightPage>

<style>
  .api-reference-wrapper {
    margin: -1.5rem -1rem;
  }
  
  :global(.api-reference-wrapper > div) {
    min-height: calc(100vh - 200px);
  }
</style>
