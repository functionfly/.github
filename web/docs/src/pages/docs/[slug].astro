---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/i, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description ?? '';
---

<Layout title={entry.data.title} description={description}>
  <article class="doc-prose">
    <Content />
  </article>
</Layout>

<style>
  .doc-prose {
    max-width: 52rem;
  }

  .doc-prose :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .doc-prose :global(h2) {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  .doc-prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }

  .doc-prose :global(p),
  .doc-prose :global(li) {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .doc-prose :global(ul),
  .doc-prose :global(ol) {
    margin: 0.5rem 0 1rem 1.25rem;
  }

  .doc-prose :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .doc-prose :global(a:hover) {
    color: var(--color-text);
  }

  .doc-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-light);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .doc-prose :global(pre) {
    margin: 1rem 0;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    background: #0f1419;
    border: 1px solid var(--color-border);
    overflow-x: auto;
  }

  .doc-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .doc-prose :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--color-primary);
    color: var(--color-text-muted);
  }

  .doc-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
  }

  .doc-prose :global(th),
  .doc-prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .doc-prose :global(th) {
    background: var(--color-bg-light);
  }

  .doc-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
</style>
