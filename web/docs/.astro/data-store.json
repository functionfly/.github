a-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"import { Request, Response } from &#x22;@functionfly/types&#x22;;interface Handler\u003CTInput, TOutput> {    (request: Request\u003CTInput>): Promise\u003CResponse\u003CTOutput>>;}function createHandler\u003CTInput, TOutput>(    fn: (input: TInput) => Promise\u003CTOutput>): Handler\u003CTInput, TOutput> {    return async (request): Promise\u003CResponse\u003CTOutput>> => {        try {            const output = await fn(request.body);            return {                status: 200,                body: output            };        } catch (error) {            return {                status: 500,                body: { error: (error as Error).message } as unknown as TOutput            };        }    };}// Usageinterface GreetInput {    name: string;}interface GreetOutput {    message: string;}const greetHandler = createHandler\u003CGreetInput, GreetOutput>(    async (input) => ({        message: &#x60;Hello, ${input.name}!&#x60;    }));export default greetHandler;\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h3\">\u003Ch3 id=\"middleware-pattern\">Middleware Pattern\u003C/h3>\u003Ca class=\"sl-anchor-link\" href=\"#middleware-pattern\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C