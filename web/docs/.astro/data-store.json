1:#403F53\">}\u003C/span>\u003C/div>\u003C/div>\u003C/code>\u003C/pre>\u003Cdiv class=\"copy\">\u003Cdiv aria-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"import functionfly.*import kotlinx.serialization.json.*fun main() {    val transformer = Function { input ->        val request = Json.parseToJsonElement(input).jsonObject        val body = request[&#x22;body&#x22;]?.jsonObject ?: return@Function &#x22;&#x22;&#x22;{&#x22;status&#x22;: 400}&#x22;&#x22;&#x22;        val firstName = body[&#x22;first_name&#x22;]?.jsonPrimitive?.content ?: &#x22;&#x22;        val lastName = body[&#x22;last_name&#x22;]?.jsonPrimitive?.content ?: &#x22;&#x22;        val name = &#x22;$firstName $lastName&#x22;.trim()        buildJsonObject {            put(&#x22;status&#x22;, 200)            put(&#x22;body&#x22;, buildJsonObject {                put(&#x22;id&#x22;, body[&#x22;id&#x22;]?.jsonPrimitive?.content ?: &#x22;&#x22;)                put(&#x22;name&#x22;, name)                put(&#x22;email&#x22;, body[&#x22;email&#x22;]?.jsonPrimitive?.content?.lowercase() ?: &#x22;&#x22;)                put(&#x22;timestamp&#x22;, body[&#x22;created_at&#x22;]?.jsonPrimitive?.content ?: &#x22;&#x22;)            })        }.toString()    }    FunctionFly.run(transformer)}\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h3\">\u003Ch3 id=\"using-environment-variables\">Using Environment Variables\u003C/h3>\u003Ca class=\"sl-anchor-link\" href=\"#using-environment-variables\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42