hooks",{"depth":61,"slug":2693,"text":2694},"local-testing","Local Testing",{"depth":61,"slug":2696,"text":2697},"payload-inspection","Payload Inspection",{"depth":25,"slug":2699,"text":2700},"advanced-features","Advanced Features",{"depth":61,"slug":2702,"text":2703},"webhook-batching","Webhook Batching",{"depth":61,"slug":2705,"text":2706},"transformations","Transformations",{"depth":61,"slug":2708,"text":2709},"filtering","Filtering",{"depth":25,"slug":424,"text":425},{"depth":61,"slug":2712,"text":2713},"webhook-logs","Webhook Logs",{"depth":61,"slug":2715,"text":2716},"metrics","Metrics",{"depth":25,"slug":784,"text":785},{"depth":61,"slug":2719,"text":2720},"webhooks-not-received","Webhooks Not Received",{"depth":61,"slug":2722,"text":2723},"signature-mismatch","Signature Mismatch",{"depth":61,"slug":2725,"text":2726},"timeouts","Timeouts",{"depth":25,"slug":290,"text":291},[],[],{"title":2623,"description":2624,"sidebar":2731},{"order":37},[],"index",{"id":2733,"data":2735,"body":2763,"filePath":2764,"digest":2765,"rendered":2766},{"title":2736,"description":2737,"editUrl":8,"head":2738,"template":10,"hero":2739,"sidebar":2761,"pagefind":8,"draft":13},"FunctionFly Documentation","The fastest way to deploy serverless functions to the global edge.",[],{"title":2740,"tagline":2741,"actions":2742},"FunctionFly","Deploy serverless functions to 35+ edge locations worldwide",[2743,2750,2756],{"text":2744,"link":2745,"variant":2746,"icon":2747},"Get Started","/getting-started/","primary",{"type":2748,"name":2749},"icon","right-arrow",{"text":2751,"link":2752,"variant":2753,"icon":2754},"View on GitHub","https://github.com/functionfly","secondary",{"type":2748,"name":2755},"github",{"text":2757,"link":2758,"variant":2753,"icon":2759},"Try the Playground","/guides/playground/",{"type":2748,"name":2760},"open-book",{"hidden":13,"attrs":2762},{},"import { Card, CardGrid } from '@astrojs/starlight/components';\n\n## Key Features\n\n\u003CCardGrid stagger>\n  \u003CCard title=\"35+ Edge Locations\" icon=\"cloud\">\n    Deploy to major cities across North America, Europe, Asia, and Australia\n  \u003C/Card>\n  \u003CCard title=\"Multi-runtime Support\" icon=\"open-book\">\n    Write functions in JavaScript, TypeScript, Python, or Go\n  \u003C/Card>\n  \u003CCard title=\"Enterprise Security\" icon=\"seti:lock\">\n    Built-in malware scanning, signature verification, and trust levels\n  \u003C/Card>\n  \u003CCard title=\"Real-time Analytics\" icon=\"chart\">\n    Monitor function performance with detailed metrics\n  \u003C/Card>\n\u003C/CardGrid>\n\n## Quick Start\n\n```bash\n# Install the ffly CLI (Go 1.25+)\ngo install github.com/functionfly/functionfly/cmd/fly@latest\n\n# Login to FunctionFly\nffly login\n\n# Initialize a new function\nffly init my-function\n\n# Deploy to the edge\nffly deploy\n```\n\n## Documentation\n\nBrowse our documentation sections:\n\n- **Getting Started** - Quick start guides and installation\n- **Core Concepts** - Functions, CLI, and deployment\n- **Trust & Security** - Trust API and security protocols","src/content/docs/index.md","4c2d706d0068308b",{"html":2767,"metadata":2768},"\u003Cp>import { Card, CardGrid } from ‘@astrojs/starlight/components’;\u003C/p>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"key-features\">Key Features\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#key-features\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z