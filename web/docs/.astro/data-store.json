003Ctr>\u003Cth>Plan\u003C/th>\u003Cth>Graphs\u003C/th>\u003Cth>Nodes per Graph\u003C/th>\u003Cth>Executions/mo\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Free\u003C/td>\u003Ctd>3\u003C/td>\u003Ctd>10\u003C/td>\u003Ctd>1,000\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Starter\u003C/td>\u003Ctd>10\u003C/td>\u003Ctd>50\u003C/td>\u003Ctd>10,000\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Professional\u003C/td>\u003Ctd>50\u003C/td>\u003Ctd>200\u003C/td>\u003Ctd>100,000\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Enterprise\u003C/td>\u003Ctd>Unlimited\u003C/td>\u003Ctd>Unlimited\u003C/td>\u003Ctd>Unlimited\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Chr>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"best-practices\">Best Practices\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#best-practices\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Best Practices”\u003C/span>\u003C/a>\u003C/div>\n\u003Col>\n\u003Cli>\u003Cstrong>Start simple\u003C/strong> — Build basic flow first, then add complexity\u003C/li>\n\u003Cli>\u003Cstrong>Use meaningful names\u003C/strong> — Name nodes clearly (e.g., “ValidateUser” not “node_1”)\u003C/li>\n\u003Cli>\u003Cstrong>Add error handling\u003C/strong> — Always include error edges and handlers\u003C/li>\n\u003Cli>\u003Cstrong>Test incrementally\u003C/strong> — Test each branch before moving on\u003C/li>\n\u003Cli>\u003Cstrong>Version before major changes\u003C/strong> — Save a version before refactoring\u003C/li>\n\u003Cli>\u003Cstrong>Use AI as assistant\u003C/strong> — Let AI suggest improvements but review carefully\u003C/li>\n\u003Cli>\u003Cstrong>Monitor performance\u003C/strong> — Check execution times for bottlenecks\u003C/li>\n\u003Cli>\u003Cstrong>Document complex flows\u003C/strong> — Add descriptions to nodes for team clarity\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"troubleshooting\">Troubleshooting\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#troubleshooting\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Troubleshooting”\u003C/span>\u003C/a>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h3\">\u003Ch3 id=\"graph-wont-execute\">Graph won’t execute\u003C/h3>\u003Ca class=\"sl-anchor-link\" href=\"#graph-wont-execute\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.