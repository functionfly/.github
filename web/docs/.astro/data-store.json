47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “403 Forbidden”\u003C/span>\u003C/a>\u003C/div>\n\u003Cul>\n\u003Cli>The key may not have permission for the requested action\u003C/li>\n\u003Cli>The function may be private or require different authentication\u003C/li>\n\u003C/ul>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"next-steps\">Next Steps\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#next-steps\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Next Steps”\u003C/span>\u003C/a>\u003C/div>\n\u003Cul>\n\u003Cli>Learn about \u003Ca href=\"/guides/secrets-vault/\">Secrets &#x26; Vault\u003C/a> for managing sensitive data\u003C/li>\n\u003Cli>Set up \u003Ca href=\"/guides/rate-limiting/\">rate limiting\u003C/a> to protect your functions\u003C/li>\n\u003Cli>Explore \u003Ca href=\"/guides/webhooks/\">webhooks\u003C/a> for event-driven workflows\u003C/li>\n\u003C/ul>",{"headings":732,"localImagePaths":793,"remoteImagePaths":794,"frontmatter":795,"imagePaths":797},[733,736,739,742,745,748,751,754,757,760,763,766,769,772,775,778,779,782,783,786,789,792],{"depth":25,"slug":734,"text":735},"authentication-methods","Authentication Methods",{"depth":61,"slug":737,"text":738},"1-session-based-authentication","1. Session-Based Authentication",{"depth":61,"slug":740,"text":741},"2-api-keys","2. API Keys",{"depth":61,"slug":743,"text":744},"3-jwt-tokens","3. JWT Tokens",{"depth":25,"slug":746,"text":747},"securing-functions","Securing Functions",{"depth":61,"slug":749,"text":750},"public-functions","Public Functions",{"depth":61,"slug":752,"text":753},"authenticated-functions","Authenticated Functions",{"depth":61,"slug":755,"text":756},"private-functions","Private Functions",{"depth":25,"slug":758,"text":759},"using-api-keys","Using API Keys",{"depth":61,"slug":761,"text":762},"in-headers","In Headers",{"depth":61,"slug":764,"text":765},"in-sdks","In SDKs",{"depth":25,"slug":767,"text":768},"api-key-permissions","API Key Permissions",{"depth":61,"slug":770,"text":771},"example-read-only-key","Example: Read-Only Key",{"depth":61,"slug":773,"text":774},"example-deployment-key","Example: Deployment Key",{"depth":25,"slug":776,"text":777},"environment-scoping","Environment Scoping",{"depth":25,"slug":108,"text":109},{"depth":25,"slug":780,"text":781},"rotating-keys","Rotating Keys",{"depth":25,"slug":533,"text":534},{"depth":25,"slug":784,"text":785},"troubleshooting","Troubleshooting",{"depth":61,"slug":787,"text":788},"401-unauthorized","401 Unauthorized",{"depth":61,"slug":790,"text":791},"403-forbidden","403 Forbidden",{"depth":25,"slug":290,"text":291},[],[],{"title":721,"description":722,"sidebar":796},{"order":61},[],"guides/aws-lambda",{"id":798,"data":800,"body":806,"filePath":807,"digest":808,"rendered":809},{"title":801,"description":802,"editUrl":8,"head":803,"template":10,"sidebar":804,"pagefind":8,"draft":13},"AWS Lambda","Deploy FunctionFly functions to AWS Lambda",[],{"hidden":13,"attrs":805},{},"# AWS Lambda\n\nDeploy your FunctionFly functions to [AWS Lambda](https://aws.amazon.com/lambda/) for enterprise-grade serverless compute with deep AWS integration.\n\n## Features\n\n- **Deep AWS integration** - S3, DynamoDB, SQS, and more\n- **Maximum memory** - Up to 10GB\n- **Longest timeout** - Up to 900 seconds\n- **Pay per invocation** - No idle costs\n\n## Prerequisites\n\n- AWS account with Lambda permissions\n- AWS CLI configured: `aws configure`\n\n## Configuration\n\n```jsonc\n// functionfly.jsonc\n{\n  \"provider\": \"aws-lambda\",\n  \"provider_config\": {\n    \"runtime\": \"nodejs18.x\",\n    \"role\": \"arn:aws:iam::123456789:role/lambda-role\",\n    \"s3_bucket\": \"my-functionfly-bucket\",\n    \"vpc_config\": {\n      \"subnet_ids\": [\"subnet-123\", \"subnet-456\"],\n      \"security_group_ids\": [\"sg-789\"]\n    }\n  }\n}\n```\n\n## Deployment\n\n```bash\n# Deploy to AWS Lambda\nffly deploy --provider aws-lambda\n\n# Deploy specific region\nffly deploy --provider aws-lambda --region us-east-1\n```\n\n## Environment Variables\n\n```bash\n# Set AWS credentials\nffly env set AWS_ACCESS_KEY_ID=AKIA... --provider aws-lambda\nffly env set AWS_SECRET_ACCESS_KEY=... --provider aws-lambda\nffly env set AWS_REGION=us-east-1 --provider aws-lambda\n```\n\n## Supported Runtimes\n\n| Runtime | Architecture |\n|---------|-------------|\n| nodejs18.x | x86_64, arm64 |\n| python3.11 | x86_64, arm64 |\n| java17 | x86_64 |\n| go1.x | x86_64 |\n| provided.al2 | x86_64, arm64 |\n\n## Limitations\n\n- Cold start ~1 second\n- Maximum 10GB memory\n- Maximum 900 second timeout\n- AWS-specific (not portable)","src/content/docs/guides/aws-lambda.md","29efe803e5bba769",{"html":810,"metadata":811},"\u003Cdiv class=\"sl-heading-wrapper level-h1\">\u003Ch1 id=\"aws-lambda\">AWS Lambda\u003C/h1>\u003Ca class=\"sl-anchor-link\" href=\"#aws-lambda\">\u003Cspan aria-hidden=\"true\