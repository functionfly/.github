3F53\"> \u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">--monthly\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\"> \u003C/span>\u003Cspan style=\"--0:#F78C6C;--1:#AA0982\">500\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\"> \u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">--alert\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\"> \u003C/span>\u003Cspan style=\"--0:#ECC48D;--1:#3B61B0\">80%\u003C/span>\u003C/div>\u003C/div>\u003C/code>\u003C/pre>\u003Cdiv class=\"copy\">\u003Cdiv aria-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"ffly wallet historyffly dna set-budget --monthly 500 --alert 80%\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Chr>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"best-practices\">Best Practices\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#best-practices\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Best Practices”\u003C/span>\u003C/a>\u003C/div>\n\u003Col>\n\u003Cli>\u003Cstrong>Enable on critical functions\u003C/strong> — Prioritize functions with high traffic or business impact\u003C/li>\n\u003Cli>\u003Cstrong>Review mutations promptly\u003C/strong> — Check daily to not miss proposals\u003C/li>\n\u003Cli>\u003Cstrong>Monitor after acceptance\u003C/strong> — Watch metrics for 24 hours post-deployment\u003C/li>\n\u003Cli>\u003Cstrong>Keep backups\u003C/strong> — Maintain version history to rollback if needed\u003C/li>\n\u003Cli>\u003Cstrong>Understand the diff\u003C/strong> — Don’t accept blindly; review each mutation\u003C/li>\n\u003Cli>\u003Cstrong>Test in staging\u003C/strong> — Use a staging environment for testing mutations first\u003C/li>\n\u003C/ol>",{"headings":1820,"localImagePaths":1909,"remoteImagePaths":1910,"frontmatter":1911,"imagePaths":1913},[1821,1824,1827,1830,1833,1836,1839,1842,1845,1848,1851,1854,1857,1860,1863,1866,1869,1872,1875,1878,1881,1884,1887,1888,1889,1892,1895,1898,1899,1902,1905,1908],{"depth":25,"slug":1822,"text":1823},"how-it-works","How It Works",{"depth":25,"slug":1825,"text":1826},"enabling-function-dna","Enabling Function DNA",{"depth":61,"slug":1828,"text":1829},"for-individual-functions","For Individual Functions",{"depth":61,"slug":1831,"text":1832},"platform-wide-settings","Platform-Wide Settings",{"depth":25,"slug":1834,"text":1835},"understanding-your-functions-dna","Understanding Your Function’s DNA",{"depth":61,"slug":1837,"text":1838},"fitness-score","Fitness Score",{"depth":61,"slug":1840,"text":1841},"dna-attributes","DNA Attributes",{"depth":61,"slug":1843,"text":1844},"viewing-your-functions-dna","Viewing Your Function’s DNA",{"depth":25,"slug":1846,"text":1847},"mutations","Mutations",{"depth":61,"slug":1849,"text":1850},"what-are-mutations","What Are Mutations?",{"depth":61,"slug":1852,"text":1853},"types-of-mutations","Types of Mutations",{"depth":61,"slug":1855,"text":1856},"mutation-lifecycle","Mutation Lifecycle",{"depth":61,"slug":1858,"text":1859},"reviewing-a-mutation","Reviewing a Mutation",{"depth":61,"slug":1861,"text":1862},"mutation-diff-example","Mutation Diff Example",{"depth":61,"slug":1864,"text":1865},"acceptingrejecting","Accepting/Rejecting",{"depth":25,"slug":1867,"text":1868},"canary-deployments","Canary Deployments",{"depth":61,"slug":1870,"text":1871},"how-canary-works","How Canary Works",{"depth":61,"slug":1873,"text":1874},"canary-configuration","Canary Configuration",{"depth":61,"slug":1876,"text":1877},"manual-rollback","Manual Rollback",{"depth":25,"slug":1879,"text":1880},"auto-evolution-settings","Auto-Evolution Settings",{"depth":61,"slug":1882,"text":1883},"platform-settings","Platform Settings",{"depth":61,"slug":1885,"text":1886},"per-function-settings","Per-Function Settings",{"depth":25,"slug":1786,"text":1787},{"depth":25,"slug":271,"text":272},{"depth":25,"slug":1890,"text":1891},"interpreting-results","Interpreting Results",{"depth":61,"slug":1893,"text":1894},"after-accepting-a-mutation","After Accepting a Mutation",{"depth":61,"slug":1896,"text":1897},"when-to-accept-vs-reject","When to Accept vs Reject",{"depth":25,"slug":784,"text":785},{"depth":61,"slug":1900,"text":1901},"no-mutations-proposed","No Mutations Proposed",{"depth":61,"slug":1903,"text":1904},"mutation-failed-canary","Mutation Failed Canary",{"depth":61,"slug":1906,"text":1907},"high-credit-usage","High Credit Usage",{"depth":25,"slug":533,"text":534},[],[],{"title":1808,"description":1809,"sidebar":1912},{"order":1812},[],"guides/functionfly-edge",{"id":1914,"data":1916,"body":1922,"filePath":1923,"digest":1924,"rendered":1925},{"title":1917,"description":1918,"editUrl":8,"head":1919,"template":10,"sidebar":1920,"pagefind":8,"draft":13},"FunctionFly Edge","Deploy FunctionFly functions to the FunctionFly global edge network",[],{"hidden":13,"attrs":1921},{},"# FunctionFly Edge\n\nDeploy your FunctionFly functions to the FunctionFly global edge network for the fastest possible execution with deep platform integration.\n\n## Features\n\n- **Fastest cold start** - Sub-millisecond execution\n- **35+ edge locations** - Global anycast network\n- **Zero-configuration** - Automatic scaling and distribution\n- **Deep platform integration** - Trust API, Secrets Vault, StateFabric\n\n## Prerequisites\n\n- FunctionFly account (sign up at [functionfly.com](https://functionfly.com))\n- FunctionFly CLI installed\n\n## Configuration\n\n```jsonc\n// functionfly.jsonc\n{\n  \"provider\": \"functionfly-edge\",\n  \"provider_config\": {\n    \"url\": \"https://edge.functionfly.com\",\n    \"wasm_url\": \"https://wasm.functionfly.com\",\n    \"regions\": [\"global\"]\n  }\n}\n```\n\n## Deployment\n\n```bash\n# Deploy to FunctionFly Edge (default)\nffly deploy\n\n# Explicitly deploy to FunctionFly Edge\nffly deploy --provider functionfly-edge\n\n# Deploy to specific region\nffly deploy --provider functionfly-edge --region us-east\n```\n\n## Environment Variables\n\n```bash\n# FunctionFly uses your account credentials\nffly login\nffly whoami\n```\n\n## Available Regions\n\n| Region | Location |\n|--------|----------|\n| global | Anycast (automatic) |\n| us-east | US East (Virginia) |\n| us-west | US West (California) |\n| eu-west | EU West (Ireland) |\n| eu-central | EU Central (Frankfurt) |\n| ap-east | Asia Pacific (Hong Kong) |\n| ap-south | Asia Pacific (Singapore) |\n\n## WASM Runtime\n\nFunctionFly Edge supports WASM for additional isolation and portability:\n\n```jsonc\n{\n  \"provider\": \"functionfly-wasm\",\n  \"runtime\": \"wasm\",\n  \"provider_config\": {\n    \"wasm_url\": \"https://wasm.functionfly.com\"\n  }\n}\n```\n\n## Features Only on FunctionFly Edge\n\n- **Trust API** - Built-in verification and attestation\n- **Secrets Vault** - Zero-knowledge secret management\n- **StateFabric** - Durable state at the edge\n- **Native WASM** - First-class WASM support\n- **Function Registry** - Built-in function marketplace\n\n## Limitations\n\n- Maximum 512MB memory\n- Maximum 30 second timeout\n- Requires FunctionFly account","src/content/docs/guides/functionfly-edge.md","df20ae56195a9bae",{"html":1926,"metadata":1927},"\u003Cdiv class=\"sl-heading-wrapper level-h1\">\u003Ch1 id=\"functionfly-edge\">FunctionFly Edge\u003C/h1>\u003Ca class=\"sl-anchor-link\" href=\"#fu