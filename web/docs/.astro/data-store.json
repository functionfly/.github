n>\u003Cspan style=\"--0:#7FDBCA;--1:#096E72\">process\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">.\u003C/span>\u003Cspan style=\"--0:#FAF39F;--1:#111111\">env\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">.\u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">UPSTASH_REDIS_URL\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">);\u003C/span>\u003C/div>\u003C/div>\u003C/code>\u003C/pre>\u003Cdiv class=\"copy\">\u003Cdiv aria-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"// PostgreSQL via Supabaseconst { Client } = await import(&#x22;postgres&#x22;);// PlanetScaleconst mysql = await import(&#x22;@planetscale/database&#x22;);// Upstash Redisconst redis = new Redis(process.env.UPSTASH_REDIS_URL);\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"web-assembly\">Web Assembly\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#web-assembly\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Web Assembly”\u003C/span>\u003C/a>\u003C/div>\n\u003Cp>Deploy WASM modules:\u003C/p>\n\u003Cdiv class=\"expressive-code\">\u003Cfigure class=\"frame not-content\">\u003Cfigcaption class=\"header\">\u003C/figcaption>\u003Cpre data-language=\"javascript\">\u003Ccode>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">const \u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">wasm\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\"> = await \u003C/span>\u003Cspan style=\"--0:#7FDBCA;--1:#096E72\">WebAssembly\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">.\u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">instantiateStreaming\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">(\u003C/span>\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan class=\"indent\">  \u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">fetch\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">(\u003C/span>\u003Cspan style=\"--0:#D9F5DD;--1:#111111\">\"\u003C/span>\u003Cspan style=\"--0:#ECC48D;--1:#984E4D\">https://your-cdn.com/module.wasm\u003C/span>\u003Cspan style=\"--0:#D9F5DD;--1:#111111\">\"\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">)\u003C/span>\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">);\u003C/span>\u003C/div>\u003C/div>\u003C/code>\u003C/pre>\u003Cdiv class=\"copy\">\u003Cdiv aria-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"const wasm = await WebAssembly.instantiateStreaming(  fetch(&#x22;https://your-cdn.com/module.wasm&#x22;));\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>",{"headings":2974,"localImagePaths":2992,"remoteImagePaths":2993,"frontmatter":2994,"imagePaths":2995},[2975,2976,2979,2982,2983,2984,2985,2986,2989],{"depth":25,"slug":2901,"text":2902},{"depth":25,"slug":2977,"text":2978},"regions","Regions",{"depth":25,"slug":2980,"text":2981},"deno-kv","Deno KV",{"depth":25,"slug":427,"text":428},{"depth":25,"slug":421,"text":422},{"depth":25,"slug":2915,"text":2916},{"depth":25,"slug":2922,"text":2923},{"depth":25,"slug":2987,"text":2988},"database-integration","Database Integration",{"depth":25,"slug":2990,"text":2991},"web-assembly","Web Assembly",[],[],{"title":2963,"description":2964},[],"providers/environment",{"id":2996,"data":2998,"body":3004,"filePath":3005,"digest":3006,"rendered":3007},{"title":2999,"description":3000,"editUrl":8,"head":3001,"template":10,"sidebar":3002,"pagefind":8,"draft":13},"Environment Variables Reference","Common environment variables for FunctionFly functions across all providers.",[],{"hidden":13,"attrs":3003},{},"This page documents provider-agnostic environment variables available to your functions at runtime.\n\n## Runtime Context Variables\n\nThese variables are available to all functions regardless of provider:\n\n| Variable | Description |\n|----------|-------------|\n| `FUNCTION_NAME` | Name of the executing function |\n| `FUNCTION_VERSION` | Version of the executing function |\n| `FUNCTION_REGION` | Edge region where the function is executing |\n| `FUNCTION_RUNTIME` | Runtime environment (python, nodejs, go, etc.) |\n| `FUNCTION_MEMORY_LIMIT_MB` | Memory limit for the function (MB) |\n| `FUNCTION_TIMEOUT_MS` | Timeout for the function (milliseconds) |\n\n## Request Context\n\n| Variable | Description |\n|----------|-------------|\n| `REQUEST_ID` | Unique identifier for the current request |\n| `INVOCATION_ID` | Unique ID for this specific invocation |\n| `TRACE_ID` | Distributed tracing identifier |\n\n## Platform Information\n\n| Variable | Description |\n|----------|-------------|\n| `PLATFORM_VERSION` | FunctionFly platform version |\n| `PLATFORM_API_URL` | URL for platform API calls |\n| `SECRETS_VAULT_URL` | URL for secrets vault service |\n| `STATEFABRIC_URL` | URL for StateFabric service |\n\n## Provider Detection\n\nTo determine which provider your function is running on:\n\n```javascript\nconst provider = process.env.FFLY_PROVIDER || 'functionfly-edge';\n```\n\n## Common Provider Variables\n\n| Provider | Variable | Description |\n|----------|----------|-------------|\n| All | `FFLY_PROVIDER` | Provider identifier |\n| All | `FFLY_DEPLOYMENT_ID` | Unique deployment ID |\n| All | `FFLY_FUNCTION_ID` | Function identifier |\n| All | `FFLY_SECRET_KEY` | Provider-specific secret key |\n\n## Secrets Vault\n\nAccess secrets from the vault using standard environment variable expansion:\n\n```bash\n# In your function code, reference secrets as:\n# ${SECRET_NAME} or $SECRET_NAME\n\n# Common patterns:\nDATABASE_URL=${VAULT_DB_URL}\nAPI_KEY=${VAULT_API_KEY}\n```\n\n## Next Steps\n\n- [FunctionFly Edge environment](./functionfly-edge/environment)\n- [Vercel environment](./vercel/environment)\n- [Cloudflare Workers environment](./cloudflare-workers/environment)\n- [AWS Lambda environment](./aws-lambda/environment)\n- [Fly.io environment](./fly-io/environment)\n- [Deno Deploy environment](./deno-deploy/environment)","src/content/docs/providers/environment.md","25591999e7353e52",{"html":3008,"metadata":3009},"\u003Cp>This page documents provider-agnostic environment variables available to your functions at runtime.\u003C/p>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"runtime-context-variables\">Runtime Context Variables\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#runtime-context-variables\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Runtime Context Variables”\u003C/span>\u003C/a>\u003C/div>\n\u003Cp>These variables are available to all functions regardless of provider:\u003C/p>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Variable\u003C/th>\u003Cth>Description\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FUNCTION_NAME\u003C/code>\u003C/td>\u003Ctd>Name of the executing function\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FUNCTION_VERSION\u003C/code>\u003C/td>\u003Ctd>Version of the executing function\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FUNCTION_REGION\u003C/code>\u003C/td>\u003Ctd>Edge region where the function is executing\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FUNCTION_RUNTIME\u003C/code>\u003C/td>\u003Ctd>Runtime environment (python, nodejs, go, etc.)\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FUNCTION_MEMORY_LIMIT_MB\u003C/code>\u003C/td>\u003Ctd>Memory limit for the function (MB)\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FUNCTION_TIMEOUT_MS\u003C/code>\u003C/td>\u003Ctd>Timeout for the function (milliseconds)\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"request-context\">Request Context\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#request-context\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.9