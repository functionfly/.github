3Ctd>FunctionFly platform version\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">PLATFORM_API_URL\u003C/code>\u003C/td>\u003Ctd>URL for platform API calls\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">SECRETS_VAULT_URL\u003C/code>\u003C/td>\u003Ctd>URL for secrets vault service\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">STATEFABRIC_URL\u003C/code>\u003C/td>\u003Ctd>URL for StateFabric service\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"provider-detection\">Provider Detection\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#provider-detection\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Provider Detection”\u003C/span>\u003C/a>\u003C/div>\n\u003Cp>To determine which provider your function is running on:\u003C/p>\n\u003Cdiv class=\"expressive-code\">\u003Clink rel=\"stylesheet\" href=\"/_astro/ec.v4551.css\">\u003Cscript type=\"module\" src=\"/_astro/ec.0vx5m.js\">\u003C/script>\u003Cfigure class=\"frame not-content\">\u003Cfigcaption class=\"header\">\u003C/figcaption>\u003Cpre data-language=\"javascript\">\u003Ccode>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">const \u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">provider\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\"> = \u003C/span>\u003Cspan style=\"--0:#7FDBCA;--1:#096E72\">process\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">.\u003C/span>\u003Cspan style=\"--0:#FAF39F;--1:#111111\">env\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">.\u003C/span>\u003Cspan style=\"--0:#82AAFF;--1:#3B61B0\">FFLY_PROVIDER\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\"> || \u003C/span>\u003Cspan style=\"--0:#D9F5DD;--1:#111111\">'\u003C/span>\u003Cspan style=\"--0:#ECC48D;--1:#984E4D\">functionfly-edge\u003C/span>\u003Cspan style=\"--0:#D9F5DD;--1:#111111\">'\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">;\u003C/span>\u003C/div>\u003C/div>\u003C/code>\u003C/pre>\u003Cdiv class=\"copy\">\u003Cdiv aria-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"const provider = process.env.FFLY_PROVIDER || &#x27;functionfly-edge&#x27;;\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"common-provider-variables\">Common Provider Variables\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#common-provider-variables\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Common Provider Variables”\u003C/span>\u003C/a>\u003C/div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Provider\u003C/th>\u003Cth>Variable\u003C/th>\u003Cth>Description\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>All\u003C/td>\u003Ctd>\u003Ccode dir=\"auto\">FFLY_PROVIDER\u003C/code>\u003C/td>\u003Ctd>Provider identifier\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>All\u003C/td>\u003Ctd>\u003Ccode dir=\"auto\">FFLY_DEPLOYMENT_ID\u003C/code>\u003C/td>\u003Ctd>Unique deployment ID\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>All\u003C/td>\u003Ctd>\u003Ccode dir=\"auto\">FFLY_FUNCTION_ID\u003C/code>\u003C/td>\u003Ctd>Function identifier\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>All\u003C/td>\u003Ctd>\u003Ccode dir=\"auto\">FFLY_SECRET_KEY\u003C/code>\u003C/td>\u003Ctd>Provider-specific secret key\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"secrets-vault\">Secrets Vault\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#secrets-vault\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Secrets Vault”\u003C/span>\u003C/a>\u003C/div>\n\u003Cp>Access secrets from the vault using standard environment variable expansion:\u003C/p>\n\u003Cdiv class=\"expressive-code\">\u003Cfigure class=\"frame is-terminal not-content\">\u003Cfigcaption class=\"header\">\u003Cspan class=\"title\">\u003C/span>\u003Cspan class=\"sr-only\">Terminal window\u003C/span>\u003C/figcaption>\u003Cpre data-language=\"bash\">\u003Ccode>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#919F9F;--1:#5F636F\"># In your function code, reference secrets as:\u003C/span>\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#919F9F;--1:#5F636F\"># ${SECRET_NAME} or $SECRET_NAME\u003C/span>\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\n\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#919F9F;--1:#5F636F\"># Common patterns:\u003C/span>\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#C5E478;--1:#3B61B0\">DATABASE_URL\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">=\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">${\u003C/span>\u003Cspan style=\"--0:#C5E478;--1:#3B61B0\">VAULT_DB_URL\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">}\u003C/span>\u003C/div>\u003C/div>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#C5E478;--1:#3B61B0\">API_KEY\u003C/span>\u003Cspan style=\"--0:#C792EA;--1:#8844AE\">=\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">${\u003C/span>\u003Cspan style=\"--0:#C5E478;--1:#3B61B0\">VAULT_API_KEY\u003C/span>\u003Cspan style=\"--0:#D6DEEB;--1:#403F53\">}\u003C/span>\u003C/div>\u003C/div>\u003C/code>\u003C/pre>\u003Cdiv class=\"copy\">\u003Cdiv aria-live=\"polite\">\u003C/div>\u003Cbutton title=\"Copy to clipboard\" data-copied=\"Copied!\" data-code=\"DATABASE_URL=${VAULT_DB_URL}API_KEY=${VAULT_API_KEY}\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"next-steps\">Next Steps\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#next-steps\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Next Steps”\u003C/span>\u003C/a>\u003C/div>\n\u003Cul>\n\u003Cli>\u003Ca href=\"./functionfly-edge/environment\">FunctionFly Edge environment\u003C/a>\u003C/li>\n\u003Cli>\u003Ca href=\"./vercel/environment\">Vercel environment\u003C/a>\u003C/li>\n\u003Cli>\u003Ca href=\"./cloudflare-workers/environment\">Cloudflare Workers environment\u003C/a>\u003C/li>\n\u003Cli>\u003Ca href=\"./aws-lambda/environment\">AWS Lambda environment\u003C/a>\u003C/li>\n\u003Cli>\u003Ca href=\"./fly-io/environment\">Fly.io environment\u003C/a>\u003C/li>\n\u003Cli>\u003Ca href=\"./deno-deploy/environment\">Deno Deploy environment\u003C/a>\u003C/li>\n\u003C/ul>",{"headings":3010,"localImagePaths":3026,"remoteImagePaths":3027,"frontmatter":3028,"imagePaths":3029},[3011,3014,3015,3016,3019,3022,3025],{"depth":25,"slug":3012,"text":3013},"runtime-context-variables","Runtime Context Variables",{"depth":25,"slug":1459,"text":1460},{"depth":25,"slug":1465,"text":1466},{"depth":25,"slug":3017,"text":3018},"provider-detection","Provider Detection",{"depth":25,"slug":3020,"text":3021},"common-provider-variables","Common Provider Variables",{"depth":25,"slug":3023,"text":3024},"secrets-vault","Secrets Vault",{"depth":25,"slug":290,"text":291},[],[],{"title":2999,"description":3000},[],"providers/fly-io/environment",{"id":3030,"data":3032,"body":3038,"filePath":3039,"digest":3040,"rendered":3041},{"title":3033,"description":3034,"editUrl":8,"head":3035,"template":10,"sidebar":3036,"pagefind":8,"draft":13},"Fly.io Environment","Environment variables specific to Fly.io deployment.",[],{"hidden":13,"attrs":3037},{},"Deploy FunctionFly functions to Fly.io's distributed platform.\n\n## Provider Variables\n\n| Variable | Description |\n|----------|-------------|\n| `FLY_APP_NAME` | Application name |\n| `FLY_APP_ID` | Application ID |\n| `FLY_REGION` | Primary region |\n| `FLY_MACHINE_ID` | Machine identifier |\n| `FLY_MACHINE_LAUNCH_ID` | Machine launch ID |\n| `FLY_IMAGE_REF` | Docker image reference |\n| `FLY_PRIMARY_REGION` | Primary region |\n| `FLY_VOLUME_MOUNT_POINT` | Volume mount path |\n| `FLY_ALLOC_ID` | Allocation ID |\n\n## Regions\n\nAvailable regions include:\n\n| Region | Code |\n|--------|------|\n| Amsterdam | `ams` |\n| Dallas | `dfw` |\n| Frankfurt | `fra` |\n| Hong Kong | `hkg` |\n| London | `lhr` |\n| New York | `ewr` |\n| San Jose | `sjc` |\n| Seattle | `sea` |\n| Singapore | `sin` |\n| Tokyo | `nrt` |\n\n## Persistent Storage\n\n| Variable | Description |\n|----------|-------------|\n| `FLY_VOLUME_PATH` | Path to persistent volume |\n| `FLY_VOLUME_SIZE_GB` | Volume size in GB |\n\n## Configuration\n\n| Variable | Default | Description |\n|----------|---------|-------------|\n| `FLY_MEMORY_MB` | `256` | Memory allocation |\n| `FLY_CPU_COUNT` | `1` | Number of CPUs |\n| `FLY_GLOBAL_SECONDS` | `600` | Seconds per Global second |\n\n## Health Checks\n\n| Variable | Default | Description |\n|----------|---------|-------------|\n| `FLY_HEALTHCHECK_INTERVAL_SEC` | `30` | Health check interval |\n| `FLY_HEALTHCHECK_TIMEOUT_SEC` | `5` | Health check timeout |\n| `FLY_HEALTHCHECK_PATH` | `/health` | Health check path |\n\n## Secrets\n\nStore secrets in Fly.io secrets:\n\n```bash\nfly secrets set API_KEY=your-secret\nfly secrets set DATABASE_URL=postgres://...\n```\n\n## Example Configuration\n\n```jsonc\n// functionfly.jsonc\n{\n  \"provider\": \"fly\",\n  \"environment\": {\n    \"FLY_MEMORY_MB\": \"512\",\n    \"FLY_CPU_COUNT\": \"1\"\n  },\n  \"mount\": {\n    \"/data\": {\n      \"size_gb\": 10\n    }\n  }\n}\n```\n\n## Scale Configuration\n\n```bash\n# Scale to 3 instances\nfly scale count 3 --region ams\n\n# Scale with specific resources\nfly scale vm shared-cpu-1x --memory 512\n```","src/content/docs/providers/fly-io/environment.md","74e022503110113d",{"html":3042,"metadata":3043},"\u003Cp>Deploy FunctionFly functions to Fly.io’s distributed platform.\u003C/p>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"provider-variables\">Provider Variables\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#provider-variables\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Provider Variables”\u003C/span>\u003C/a>\u003C/div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Variable\u003C/th>\u003Cth>Description\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FLY_APP_NAME\u003C/code>\u003C/td>\u003Ctd>Application name\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FLY_APP_ID\u003C/code>\u003C/td>\u003Ctd>Application ID\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode dir=\"auto\">FLY_REGION\u003C/code>