 Initialize default    value = {&#x22;items&#x22;: []}    state.set(&#x22;carts/user123&#x22;, value)except EdgeStatePermissionError:    # Handle permission error    return {&#x22;error&#x22;: &#x22;Access denied&#x22;}\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h3\">\u003Ch3 id=\"performance-tips\">Performance Tips\u003C/h3>\u003Ca class=\"sl-anchor-link\" href=\"#performance-tips\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Performance Tips”\u003C/span>\u003C/a>\u003C/div>\n\u003Col>\n\u003Cli>\u003Cstrong>Use Edge State for Edge Functions\u003C/strong>: Lower latency than HTTP API\u003C/li>\n\u003Cli>\u003Cstrong>Batch Operations\u003C/strong>: Group multiple reads/writes when possible\u003C/li>\n\u003Cli>\u003Cstrong>Cache Locally\u003C/strong>: Store frequently accessed data in function memory\u003C/li>\n\u003Cli>\u003Cstrong>Use Snapshots Wisely\u003C/strong>: Don’t create snapshots on every write\u003C/li>\n\u003C/ol>\n\u003Cdiv class=\"sl-heading-wrapper level-h2\">\u003Ch2 id=\"storage-types\">Storage Types\u003C/h2>\u003Ca class=\"sl-anchor-link\" href=\"#storage-types\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d