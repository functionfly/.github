://api.functionfly.com/v1/functions \\  -H &#x22;Authorization: Bearer ${FF_TOKEN}&#x22; \\  -H &#x22;Content-Type: application/json&#x22; \\  -d &#x27;{    &#x22;name&#x22;: &#x22;hello-quickstart&#x22;,    &#x22;runtime&#x22;: &#x22;local&#x22;,    &#x22;code&#x22;: &#x22;export default async function(req) { return { body: \\&#x22;Hello from FunctionFly!\\&#x22; }; }&#x22;  }&#x27;curl -X POST https://api.functionfly.com/v1/execute/hello-quickstart \\  -H &#x22;Authorization: Bearer ${FF_TOKEN}&#x22; \\  -H &#x22;Content-Type: application/json&#x22; \\  -d &#x27;{}&#x27;\">\u003Cdiv>\u003C/div>\u003C/button>\u003C/div>\u003C/figure>\u003C/div>\n\u003Cdiv class=\"sl-heading-wrapper level-h3\">\u003Ch3 id=\"database-connection-neon\">Database Connection (Neon)\u003C/h3>\u003Ca class=\"sl-anchor-link\" href=\"#database-connection-neon\">\u003Cspan aria-hidden=\"true\" class=\"sl-anchor-icon\">\u003Csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\">\u003Cpath fill=\"currentcolor\" d=\"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z\">\u003C/path>\u003C/svg>\u003C/span>\u003Cspan class=\"sr-only\" data-pagefind-ignore=\"\">Section titled “Database Connection (Neon)”\u003C/span>\u003C/a>\u003C/div>\n\u003Cdiv class=\"expressive-code\">\u003Cfigure class=\"frame is-terminal not-content\">\u003Cfigcaption class=\"header\">\u003Cspan class=\"title\">\u003C/span>\u003Cspan class=\"sr-only\">Terminal window\u003C/span>\u003C/figcaption>\u003Cpre data-language=\"bash\">\u003Ccode>\u003Cdiv class=\"ec-line\">\u003Cdiv class=\"code\">\u003Cspan style=\"--0:#919F9F;-