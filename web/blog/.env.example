# Blog API Configuration (NestJS blog-api for posts)
BLOG_API_URL=http://localhost:3001/api/v1
PUBLIC_BLOG_API_URL=http://localhost:3001/api/v1

# Main API URL (for categories/authors - shared with admin dashboard)
PUBLIC_MAIN_API_URL=http://localhost:8080/v1

# Blog Site Configuration
BLOG_SITE_URL=http://localhost:4327
PUBLIC_BLOG_SITE_URL=http://localhost:4327
PUBLIC_BLOG_DOMAIN=blog.functionfly.local

# SEO
PUBLIC_SITE_NAME=FunctionFly Blog
PUBLIC_SITE_DESCRIPTION=Tutorials, product updates, and edge computing insights from FunctionFly

# Google Analytics (GA4 measurement ID, e.g. G-XXXXXXXXXX)
# PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mixpanel (product analytics — public token, not sensitive)
# PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token_here
