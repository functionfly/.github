{
  "name": "functionfly-blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/blog/src",
  "projectType": "application",
  "tags": ["type:app", "platform:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "bun run astro build",
        "cwd": "web/blog",
        "envFile": "web/blog/.env"
      },
      "configurations": {
        "production": {}
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env -i HOME=/home/micro TERM=$TERM PATH=/home/micro/.n/bin:/home/micro/.bun/bin:/usr/bin:/bin bun run astro dev",
        "cwd": "web/blog",
        "envFile": "web/blog/.env"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run astro preview",
        "cwd": "web/blog"
      }
    }
  }
}
