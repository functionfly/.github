          </a>
          <a href="https://discord.gg/functionfly" target="_blank" rel="noopener" aria-label="Discord">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .footer {
    position: relative;
    z-index: 1;
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.85);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 2rem 1.5rem;
  }

  [data-theme='light'] .footer {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(99, 102, 241, 0.12);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3rem;
  }

  .footer-brand {
    flex-shrink: 0;
    min-width: 180px;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .footer-brand img {
    display: block;
  }

  .footer-brand p {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.5;
    opacity: 0.7;
  }

  [data-theme='light'] .footer-brand p {
    color: #6B7280;
    opacity: 0.8;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    flex: 1;
    width: 100%;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-column h4 {
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  [data-theme='light'] .footer-column h4 {
    color: #64748b;
  }

  .footer-column a {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    transition: color 0.15s;
    padding: 0;
    margin: 0;
  }

  .footer-column a:hover {
    color: var(--color-text);
  }

  [data-theme='light'] .footer-column a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 1.5rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-bottom p {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .footer-bottom-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-legal {
    display: flex;
    gap: 1rem;
  }

  .footer-legal a {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    transition: color 0.15s;
  }

  .footer-legal a:hover {
    color: var(--color-text);
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--color-text-muted);
    transition: color 0.15s, background 0.15s;
  }

  .footer-social a:hover {
    color: var(--color-text);
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.3);
  }

  [data-theme='light'] .footer-social a:hover {
    background: rgba(99, 102, 241, 0.08);
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
      gap: 2rem;
    }

    .footer-links {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .footer-bottom-left {
      flex-direction: column;
      gap: 0.75rem;
    }

    .footer-bottom-right {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding: 2rem 1rem 1.5rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
</style>
