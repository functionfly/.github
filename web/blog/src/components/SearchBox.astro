---
import { getLocaleFromUrl, loadTranslations, createT } from '../i18n/index';

interface Props {
  query?: string;
}

const { query = '' } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const translations = await loadTranslations(locale);
const t = createT(translations);
---

<form class="search-box" action="/search" method="GET">
  <div class="search-box__input-wrapper">
    <svg class="search-box__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="search"
      name="q"
      value={query}
      placeholder={t('search.placeholder')}
      class="search-box__input"
      aria-label={t('search.label')}
    />
    <button type="submit" class="search-box__button">
      {t('search.button')}
    </button>
  </div>
</form>

<style>
  .search-box {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .search-box__input-wrapper {
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--color-bg-light) 80%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
    transition: all 0.2s;
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  .search-box__input-wrapper:focus-within {
    border-color: var(--color-primary);
    outline-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .search-box__icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    margin-right: 0.75rem;
  }

  .search-box__input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: 1rem;
    padding: 0.5rem 0;
    outline: none;
  }

  .search-box__input::placeholder {
    color: var(--color-text-muted);
  }

  .search-box__button {
    flex-shrink: 0;
    padding: 0.55rem 1.1rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .search-box__button:hover {
    background: var(--color-primary-dark);
    box-shadow: 0 4px 14px rgba(var(--ff-flame-rgb), 0.35);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .search-box__button {
      display: none;
    }

    .search-box__input-wrapper {
      padding: 0.75rem;
    }
  }
</style>
