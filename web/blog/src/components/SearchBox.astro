---
interface Props {
  query?: string;
}

const { query = '' } = Astro.props;
---

<form class="search-box" action="/search" method="GET">
  <div class="search-box__input-wrapper">
    <svg class="search-box__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="search"
      name="q"
      value={query}
      placeholder="Search articles..."
      class="search-box__input"
      aria-label="Search articles"
    />
    <button type="submit" class="search-box__button">
      Search
    </button>
  </div>
</form>

<style>
  .search-box {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .search-box__input-wrapper {
    display: flex;
    align-items: center;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
    transition: all 0.2s;
  }

  .search-box__input-wrapper:focus-within {
    border-color: rgba(99, 102, 241, 0.5);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  .search-box__icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    margin-right: 0.75rem;
  }

  .search-box__input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: 1rem;
    padding: 0.5rem 0;
    outline: none;
  }

  .search-box__input::placeholder {
    color: var(--color-text-muted);
  }

  .search-box__button {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .search-box__button:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 640px) {
    .search-box__button {
      display: none;
    }

    .search-box__input-wrapper {
      padding: 0.75rem;
    }
  }
</style>
