---
import { formatDate } from '../lib/utils';
import { calculateReadingTime } from '../lib/slate-to-html';
import type { BlogPost } from '../lib/api';
import { getLocaleFromUrl, loadTranslations, createT } from '../i18n/index';

const locale = getLocaleFromUrl(Astro.url);
const translations = await loadTranslations(locale);
const t = createT(translations);

interface Props {
  post: BlogPost;
  variant?: 'default' | 'featured' | 'compact';
  index?: number;
}

const { post, variant = 'default', index = 0 } = Astro.props;

const readingMinutes = calculateReadingTime(post.body);

// Determine if we should show the image based on variant and availability
const showImage = variant !== 'compact' && post.heroImage?.url;
const imageUrl = post.heroImage?.url;

// Category color mapping — SC-compatible palette
const categoryColors: Record<string, string> = {
  'engineering': '#9fd8ff',
  'product': '#8fffd0',
  'company-news': '#ff7a3d',
  'tutorials': '#e8c468',
  'community': '#d9c4ff',
  'security': '#ff6b6b',
  'ai-ml': '#ff7a3d',
  'devops': '#8fffd0',
  'api-sdks': '#ffd9f0',
  'releases': '#9fd8ff',
  'case-studies': '#d9c4ff',
};

const categoryColor = post.category?.slug ? categoryColors[post.category.slug] || '#ff7a3d' : '#ff7a3d';
const isTrending = post.tags?.includes('trending') || index < 2;
---

<article
  class:list={['blog-card', `blog-card--${variant}`, { 'animate-in': true, 'is-trending': isTrending }]}
  style={`--category-color: ${categoryColor}; --animation-delay: ${index * 0.1}s`}
>
  <a href={`/${post.slug}`} class="blog-card__link">
    {showImage && imageUrl && (
      <div class="blog-card__image-wrapper">
        <div class="blog-card__image-overlay"></div>
        <img
          src={imageUrl}
          alt={post.heroImage?.alt || post.title}
          class="blog-card__image"
          loading={variant === 'featured' ? 'eager' : 'lazy'}
        />
        <div class="blog-card__image-glow"></div>
        {isTrending && (
          <div class="blog-card__trending-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
            {t('blogCard.trending')}
          </div>
        )}
        {post.publishedAt && (
          <div class="blog-card__date-badge">
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
          </div>
        )}
      </div>
    )}

    <div class="blog-card__content">
      {post.category && (
        <span class="blog-card__category" style={`--cat-color: ${categoryColor}`}>
          <span class="blog-card__category-dot"></span>
          {post.category.title}
        </span>
      )}

      <h3 class="blog-card__title">
        <span class="blog-card__title-text">{post.title}</span>
      </h3>

      {variant !== 'compact' && (
        <p class="blog-card__description">{post.description}</p>
      )}

      <div class="blog-card__meta">
        <div class="blog-card__meta-item blog-card__meta-author">
          {post.author?.photo && typeof post.author.photo === 'object' && 'url' in post.author.photo && (post.author.photo as { url: string }).url ? (
            <img
              src={(post.author.photo as { url: string }).url}
              alt={post.author.name}
              class="blog-card__meta-avatar"
              loading="lazy"
            />
          ) : (
            <img
              src="/functionfly.png"
              alt="FunctionFly"
              class="blog-card__meta-avatar"
              loading="lazy"
            />
          )}
          <span>{post.author?.name || 'FunctionFly'}</span>
        </div>
        <div class="blog-card__meta-separator"></div>
        <div class="blog-card__meta-item">
          <svg class="blog-card__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {post.publishedAt && (
            <time datetime={post.publishedAt}>
              {formatDate(post.publishedAt)}
            </time>
          )}
        </div>
        <div class="blog-card__meta-separator"></div>
        <div class="blog-card__meta-item">
          <svg class="blog-card__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{readingMinutes} {t('blogCard.minRead')}</span>
        </div>
      </div>

      <div class="blog-card__share">
        <button class="blog-card__share-btn" aria-label={t('blogCard.shareArticle')} data-title={post.title} data-slug={post.slug}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
        </button>
      </div>

      <div class="blog-card__arrow">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>
    </div>
  </a>
</article>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.blog-card__share-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const title = (btn as HTMLElement).dataset.title || '';
        const slug = (btn as HTMLElement).dataset.slug || '';
        const url = `${window.location.origin}/${slug}`;
        if (navigator.share) {
          navigator.share({ title, url });
        } else {
          navigator.clipboard.writeText(url);
          const originalLabel = btn.getAttribute('aria-label') || '';
          btn.setAttribute('aria-label', 'Link copied!');
          setTimeout(() => btn.setAttribute('aria-label', originalLabel), 2000);
        }
      });
    });
  });
</script>

<style>
  .blog-card {
    position: relative;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateY(20px);
    animation: cardFadeIn 0.6s ease-out forwards;
    animation-delay: var(--animation-delay, 0s);
  }

  @keyframes cardFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: var(--glass-border-hover);
    box-shadow: var(--shadow-glow);
  }

  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .blog-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--ff-cockpit) 0%, var(--ff-tarmac) 100%);
  }

  .blog-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(var(--ff-tarmac-rgb), 0.8) 100%);
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.08);
  }

  .blog-card__image-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, var(--category-color, var(--ff-flame)) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .blog-card:hover .blog-card__image-glow {
    opacity: 0.3;
  }

  .blog-card__trending-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    background: linear-gradient(135deg, var(--ff-flame) 0%, var(--ff-afterburner) 100%);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 3;
    box-shadow: 0 4px 12px rgba(var(--ff-flame-rgb), 0.4);
    animation: pulse-badge 2s ease-in-out infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .blog-card__date-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.75rem;
    background: rgba(var(--ff-tarmac-rgb), 0.85);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    z-index: 3;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .blog-card__content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .blog-card__category {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(var(--ff-flame-rgb), 0.1);
    border: 1px solid rgba(var(--ff-flame-rgb), 0.2);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ff-flame);
    margin-bottom: 0.875rem;
    width: fit-content;
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card__category {
    background: rgba(var(--ff-flame-rgb), 0.2);
    border-color: rgba(var(--ff-flame-rgb), 0.4);
    transform: translateX(4px);
  }

  .blog-card__category-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ff-flame);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .blog-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    position: relative;
  }

  .blog-card__title-text {
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .blog-card:hover .blog-card__title-text {
    color: var(--ff-flame-light);
  }

  .blog-card__description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .blog-card:hover .blog-card__description {
    color: var(--color-text-secondary);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .blog-card__meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .blog-card__meta-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .blog-card__meta-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .blog-card__meta-icon {
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card__meta-icon {
    opacity: 1;
    color: var(--ff-flame-light);
  }

  .blog-card__meta-separator {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-text-dim);
  }

  .blog-card__arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(var(--ff-flame-rgb), 0.1);
    border: 1px solid rgba(var(--ff-flame-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ff-flame-light);
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-card:hover .blog-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .blog-card__arrow svg {
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-card__arrow svg {
    transform: translateX(2px);
  }

  /* Share button */
  .blog-card__share {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    opacity: 0;
    transform: translateY(-5px);
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card__share {
    opacity: 1;
    transform: translateY(0);
  }

  .blog-card__share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(var(--ff-tarmac-rgb), 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .blog-card__share-btn:hover {
    background: var(--ff-flame);
    border-color: var(--ff-flame);
    color: white;
    transform: scale(1.1);
  }

  /* Featured variant */
  .blog-card--featured {
    grid-column: span 2;
  }

  .blog-card--featured .blog-card__link {
    flex-direction: row;
  }

  .blog-card--featured .blog-card__image-wrapper {
    aspect-ratio: 4 / 3;
    flex: 0 0 55%;
    max-width: 500px;
  }

  .blog-card--featured .blog-card__content {
    padding: 2rem;
    justify-content: center;
  }

  .blog-card--featured .blog-card__category {
    font-size: 0.8125rem;
    padding: 0.5rem 1rem;
  }

  .blog-card--featured .blog-card__title {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .blog-card--featured .blog-card__description {
    font-size: 1rem;
    -webkit-line-clamp: 4;
    margin-bottom: 1.5rem;
  }

  .blog-card--featured .blog-card__meta {
    font-size: 0.875rem;
    gap: 1rem;
  }

  /* Compact variant */
  .blog-card--compact {
    border-radius: 12px;
  }

  .blog-card--compact .blog-card__link {
    flex-direction: row;
    padding: 1rem;
  }

  .blog-card--compact .blog-card__content {
    padding: 0 0 0 1rem;
    justify-content: center;
  }

  .blog-card--compact .blog-card__category {
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    padding: 0.25rem 0.6rem;
  }

  .blog-card--compact .blog-card__title {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .blog-card--compact .blog-card__meta {
    font-size: 0.7rem;
    padding-top: 0.5rem;
    border-top: none;
  }

  .blog-card--compact .blog-card__arrow,
  .blog-card--compact .blog-card__share {
    display: none;
  }

  @media (max-width: 968px) {
    .blog-card--featured {
      grid-column: span 1;
    }

    .blog-card--featured .blog-card__link {
      flex-direction: column;
    }

    .blog-card--featured .blog-card__image-wrapper {
      flex: none;
      max-width: none;
      aspect-ratio: 16 / 9;
    }

    .blog-card--featured .blog-card__title {
      font-size: 1.375rem;
    }
  }

  @media (max-width: 640px) {
    .blog-card__content {
      padding: 1.25rem;
    }

    .blog-card__title {
      font-size: 1rem;
    }

    .blog-card__description {
      -webkit-line-clamp: 2;
    }

    .blog-card__arrow {
      display: none;
    }

    .blog-card__share {
      display: none;
    }
  }
</style>