---
interface Props {
  items: Array<{
    label: string;
    platform: string;
    registry: string;
  }>;
  title?: string;
}

const { items, title } = Astro.props;
---

<div class="api-comparison-card">
  <div class="api-comparison-header">
    <div class="api-header-label"></div>
    <div class="api-header-col">
      <span class="platform-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="9" y1="21" x2="9" y2="9"/>
        </svg>
        Platform (Create)
      </span>
    </div>
    <div class="api-header-col">
      <span class="registry-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        Registry (Publish)
      </span>
    </div>
  </div>
  {items.map((item) => (
    <div class="api-row">
      <div class="api-label"><strong set:html={item.label}></strong></div>
      <div class="api-cell platform-cell" set:html={item.platform}></div>
      <div class="api-cell registry-cell" set:html={item.registry}></div>
    </div>
  ))}
</div>
