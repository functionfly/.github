---
interface Props {
  stages?: string[];
}

const stages = Astro.props.stages || ['draft', 'published', 'deprecated', 'archived'];
---

<div class="lifecycle-flow">
  {stages.map((stage, index) => (
    <>
      <span class={`lifecycle-badge ${stage}`}>{stage}</span>
      {index < stages.length - 1 && (
        <svg class="lifecycle-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      )}
    </>
  ))}
</div>

<style>
  .lifecycle-flow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1rem 0 1.5rem;
    padding: 1rem 1.5rem;
    background: var(--panel);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    justify-content: center;
  }

  .lifecycle-badge {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    text-transform: lowercase;
  }

  .lifecycle-badge.draft {
    background: color-mix(in srgb, var(--accent-amber, #f59e0b) 15%, transparent);
    color: var(--accent-amber, #f59e0b);
    border: 1px solid color-mix(in srgb, var(--accent-amber, #f59e0b) 30%, transparent);
  }

  .lifecycle-badge.published {
    background: color-mix(in srgb, var(--accent-emerald, #10b981) 15%, transparent);
    color: var(--accent-emerald, #10b981);
    border: 1px solid color-mix(in srgb, var(--accent-emerald, #10b981) 30%, transparent);
  }

  .lifecycle-badge.deprecated {
    background: color-mix(in srgb, var(--accent-red, #ef4444) 15%, transparent);
    color: var(--accent-red, #ef4444);
    border: 1px solid color-mix(in srgb, var(--accent-red, #ef4444) 30%, transparent);
  }

  .lifecycle-badge.archived {
    background: var(--panel-raised);
    color: var(--text-dim);
    border: 1px solid var(--color-border);
  }

  .lifecycle-badge.active {
    background: color-mix(in srgb, var(--accent-indigo, #6366f1) 15%, transparent);
    color: var(--accent-indigo, #6366f1);
    border: 1px solid color-mix(in srgb, var(--accent-indigo, #6366f1) 30%, transparent);
  }

  .lifecycle-arrow {
    color: var(--text-faint);
    flex-shrink: 0;
  }
</style>
