---
import type { Author } from '../lib/api';

interface Props {
  author: Partial<Author>;
  showSocial?: boolean;
}

const { author, showSocial = true } = Astro.props;

// Parse social links if they exist
const socialLinks = author.socialLinks && typeof author.socialLinks === 'object'
  ? author.socialLinks as unknown as Record<string, string>
  : {};
---

<div class="author-card">
  <div class="author-visual">
    {author.photo && typeof author.photo === 'object' && 'url' in author.photo ? (
      <img
        src={(author.photo as { url: string }).url}
        alt={author.name}
        class="author-photo"
        loading="lazy"
      />
    ) : (
      <div class="author-avatar-fallback">
        {(author.name || '?').charAt(0).toUpperCase()}
      </div>
    )}
    <div class="author-accent"></div>
  </div>
  
  <div class="author-info">
    <div class="author-header">
      <div>
        <h3 class="author-name">
          <a href={`/author/${author.slug}`} class="author-link">
            {author.name}
          </a>
        </h3>
        {author.role && <p class="author-role">{author.role}</p>}
      </div>
      
      {showSocial && Object.keys(socialLinks).length > 0 && (
        <div class="social-links">
          {socialLinks.twitter && (
            <a href={socialLinks.twitter} target="_blank" rel="noopener" class="social-link" aria-label="Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          )}
          {socialLinks.github && (
            <a href={socialLinks.github} target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          )}
          {socialLinks.linkedin && (
            <a href={socialLinks.linkedin} target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {author.website && (
            <a href={author.website} target="_blank" rel="noopener" class="social-link" aria-label="Website">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </a>
          )}
        </div>
      )}
    </div>
    
    {author.bio && <p class="author-bio">{author.bio}</p>}
  </div>
</div>

<style>
  .author-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--color-bg-light) 40%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .author-visual {
    position: relative;
    flex-shrink: 0;
  }

  .author-photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    transition: all 0.3s ease;
  }

  .author-photo:hover {
    border-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    transform: scale(1.05);
  }

  .author-avatar-fallback {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--gradient-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    border: 3px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .author-accent {
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    background: var(--color-secondary);
    border-radius: 50%;
    border: 2px solid var(--color-bg);
  }

  .author-info {
    flex: 1;
    min-width: 0;
  }

  .author-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .author-name {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  .author-link {
    color: var(--color-text);
    transition: color 0.2s;
  }

  .author-link:hover {
    color: var(--color-primary);
  }

  .author-role {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 500;
  }

  .author-bio {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: 0.75rem;
  }

  .social-links {
    display: flex;
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-bg-light) 30%, transparent);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .author-card {
      flex-direction: column;
      text-align: center;
    }

    .author-header {
      flex-direction: column;
      align-items: center;
    }

    .social-links {
      justify-content: center;
    }

    .author-accent {
      display: none;
    }
  }
</style>