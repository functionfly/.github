---
import BlogCard from './BlogCard.astro';
import type { BlogPost } from '../lib/api';

interface Props {
  posts: BlogPost[];
  columns?: 1 | 2 | 3 | 4;
  featuredFirst?: boolean;
}

const { posts, columns = 3, featuredFirst = false } = Astro.props;

const gridClass = `blog-grid--${columns}`;

// Split posts for featured layout
const featuredPost = featuredFirst && posts.length > 0 ? posts[0] : null;
const remainingPosts = featuredFirst && posts.length > 1 ? posts.slice(1) : posts;
---

<div class="blog-grid-wrapper">
  {featuredPost && (
    <div class="blog-grid__featured">
      <BlogCard post={featuredPost} variant="featured" />
    </div>
  )}
  
  <div class:list={['blog-grid', gridClass]}>
    {remainingPosts.map((post) => (
      <BlogCard post={post} variant="default" />
    ))}
  </div>
</div>

<style>
  .blog-grid-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-grid__featured {
    margin-bottom: 1rem;
  }

  .blog-grid {
    display: grid;
    gap: 1.5rem;
  }

  .blog-grid--1 {
    grid-template-columns: 1fr;
  }

  .blog-grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .blog-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .blog-grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 1200px) {
    .blog-grid--4 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 992px) {
    .blog-grid--3,
    .blog-grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid--2,
    .blog-grid--3,
    .blog-grid--4 {
      grid-template-columns: 1fr;
    }
  }
</style>
