---
import BlogCard from './BlogCard.astro';
import type { BlogPost } from '../lib/api';

interface Props {
  posts: BlogPost[];
  columns?: 1 | 2 | 3 | 4;
  featuredFirst?: boolean;
}

const { posts, columns = 3, featuredFirst = false } = Astro.props;

const gridStyle = `grid-template-columns: repeat(${columns}, 1fr);`;

// Split posts for featured layout
const featuredPost = featuredFirst && posts.length > 0 ? posts[0] : null;
const remainingPosts = featuredFirst && posts.length > 1 ? posts.slice(1) : posts;
---

<div class="blog-grid-wrapper">
  {featuredPost && (
    <div class="blog-grid__featured">
      <BlogCard post={featuredPost} variant="featured" />
    </div>
  )}

  <div class="blog-grid" style={gridStyle}>
    {remainingPosts.map((post) => (
      <BlogCard post={post} variant="default" />
    ))}
  </div>
</div>

<style>
  .blog-grid-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .blog-grid__featured {
    margin-bottom: var(--space-4);
  }

  .blog-grid {
    display: grid;
    gap: var(--space-5);
  }

  /* Drop to 2 columns earlier — the sidebar (260px) + container padding eats
     enough of the width that 3 columns under ~1180px produces ~240px cards
     that clip the meta row and break lines like "8 min rea". */
  @media (max-width: 1180px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
