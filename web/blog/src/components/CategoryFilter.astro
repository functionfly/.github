---
import type { Category } from '../types/blog';

interface Props {
  categories: Category[];
  activeCategory?: string;
}

const { categories, activeCategory } = Astro.props;

// Icon mapping for category icons - inline SVGs
const iconSvgs: Record<string, string> = {
  'code': '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>',
  'layers': '<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>',
  'building': '<rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M8 10h.01"></path><path d="M16 10h.01"></path><path d="M8 14h.01"></path><path d="M16 14h.01"></path>',
  'book-open': '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>',
  'users': '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>',
  'shield': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
  'brain': '<path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24l1.286-.772A2.5 2.5 0 0 1 9.5 2z"></path><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24l-1.286-.772A2.5 2.5 0 0 0 14.5 2z"></path>',
  'server': '<rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line>',
  'terminal': '<polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line>',
  'tag': '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line>',
  'file-text': '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line>',
  'default': '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>'
};

function getIconSvg(icon?: string): string {
  if (!icon) return iconSvgs['default'];
  const normalized = icon.toLowerCase().replace(/_/g, '-');
  return iconSvgs[normalized] || iconSvgs['default'];
}

function getIconColor(color?: string): string {
  return color || '#FF6B35';
}
---

<aside class="category-filter">
  <div class="category-filter__header">
    <h3 class="category-filter__title">Categories</h3>
    <span class="category-filter__count">{categories.length}</span>
  </div>
  
  <nav class="category-filter__nav">
    <a
      href="/"
      class:list={['category-filter__link', { 'category-filter__link--active': !activeCategory }]}
    >
      <span class="category-filter__icon-wrapper category-filter__icon-wrapper--all">
        <svg class="category-filter__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </span>
      <span class="category-filter__text">All Posts</span>
      <span class="category-filter__arrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </span>
    </a>
    
    {categories.map((category, index) => {
      const iconSvg = getIconSvg(category.icon);
      const color = getIconColor(category.color);
      const isActive = activeCategory === category.slug;
      
      return (
        <a
          href={`/category/${category.slug}`}
          class:list={['category-filter__link', { 'category-filter__link--active': isActive }]}
          style={`--cat-color: ${color}; --delay: ${index * 0.05}s`}
        >
          <span class="category-filter__icon-wrapper" style={`background: ${color}15; color: ${color}`}>
            <svg class="category-filter__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvg} />
          </span>
          <span class="category-filter__text">{category.title}</span>
          <span class="category-filter__arrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </a>
      );
    })}
  </nav>
</aside>

<style>
  .category-filter {
    position: relative;
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.25rem;
    overflow: hidden;
    animation: slideIn 0.5s ease-out;
  }

  .category-filter::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, color-mix(in srgb, var(--color-primary) 8%, transparent) 0%, transparent 50%);
    pointer-events: none;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .category-filter__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .category-filter__title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .category-filter__count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg-lighter);
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
  }

  .category-filter__nav {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    position: relative;
    z-index: 1;
  }

  .category-filter__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-10px);
    animation: linkFadeIn 0.4s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes linkFadeIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .category-filter__link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--cat-color, var(--color-primary)) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .category-filter__link:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    transform: translateX(4px);
  }

  .category-filter__link:hover::before {
    opacity: 0.05;
  }

  .category-filter__link--active {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .category-filter__link--active::before {
    opacity: 0.1;
  }

  .category-filter__link--active:hover {
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .category-filter__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .category-filter__icon-wrapper--all {
    background: var(--color-bg-lighter);
    color: var(--color-text-muted);
  }

  .category-filter__link:hover .category-filter__icon-wrapper {
    transform: scale(1.1);
  }

  .category-filter__link--active .category-filter__icon-wrapper--all {
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
    color: var(--color-primary);
  }

  .category-filter__icon {
    transition: all 0.3s ease;
  }

  .category-filter__text {
    flex: 1;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .category-filter__link:hover .category-filter__text {
    transform: translateX(4px);
  }

  .category-filter__arrow {
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    color: var(--color-text-dim);
  }

  .category-filter__link:hover .category-filter__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .category-filter__link--active .category-filter__arrow {
    color: var(--color-primary);
  }

  /* Mobile responsiveness */
  @media (max-width: 968px) {
    .category-filter {
      padding: 1rem;
    }

    .category-filter__link {
      padding: 0.5rem 0.625rem;
    }
  }
</style>
