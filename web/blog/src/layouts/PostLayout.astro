---
import BlogLayout from './BlogLayout.astro';
import { slateBodyToHtml, calculateReadingTime } from '../lib/slate-to-html';
import { formatDate, formatDateISO } from '../lib/utils';
import AuthorBio from '../components/AuthorBio.astro';
import type { BlogPost } from '../lib/api';
import { getLocaleFromUrl, loadTranslations, createT } from '../i18n/index';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const bodyHtml = slateBodyToHtml(post.body);
const readingMinutes = calculateReadingTime(post.body);
const metaTitle = post.seoTitle || post.title;
const metaDesc = post.seoDescription || post.description;
const canonicalUrl = post.canonicalUrl || new URL(`/${post.slug}`, Astro.site).toString();
const ogImageUrl = post.ogImage?.url || post.heroImage?.url;

const locale = getLocaleFromUrl(Astro.url);
const translations = await loadTranslations(locale);
const t = createT(translations);
---

<BlogLayout 
  title={`${metaTitle} - FunctionFly Blog`}
  description={metaDesc}
  ogImage={ogImageUrl || undefined}
  canonical={canonicalUrl}
>
  {/* JSON-LD Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": post.description,
    "image": post.heroImage?.url,
    "datePublished": post.publishedAt,
    "dateModified": post.updatedAt,
    "author": post.author ? {
      "@type": "Person",
      "name": post.author.name,
      "url": `${Astro.site}author/${post.author.slug}`
    } : undefined,
    "publisher": {
      "@type": "Organization",
      "name": "FunctionFly",
      "url": "https://functionfly.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl
    },
    "keywords": post.tags?.join(", "),
    "wordCount": readingMinutes * 200
  })} />

  <div class="post-surface">
    <article class="blog-post">
      <div class="post-container">
        <!-- Reading Progress Sidebar -->
        <aside class="post-sidebar">
          <div class="sidebar-sticky">
            <div class="reading-indicator">
              <span class="reading-indicator__time">{readingMinutes} {t('blogCard.minRead')}</span>
              <span class="reading-indicator__label">{t('post.read')}</span>
            </div>
            {post.tags && post.tags.length > 0 && (
              <div class="sidebar-tags">
                <h4 class="sidebar-title">{t('post.tags')}</h4>
                <div class="sidebar-tag-list">
                  {post.tags.map((tag) => (
                    <a href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="sidebar-tag">
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>

        <div class="post-main">
          <!-- Back Link -->
          <nav class="post-nav">
            <a href="/" class="back-link">
              <svg class="back-link__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>{t('post.allPosts')}</span>
            </a>
          </nav>

          <!-- Hero Header -->
          <header class="post-hero">
            {post.category && (
              <a href={`/category/${post.category.slug}`} class="post-category">
                <span class="post-category__dot"></span>
                {post.category.title}
              </a>
            )}
            
            <h1 class="post-title">
              <span class="title-accent">{post.title}</span>
            </h1>
            
            <p class="post-description">{post.description}</p>
            
            <div class="post-meta">
              <div class="meta-author">
                {post.author?.name && (
                  <a href={`/author/${post.author.slug}`} class="author-link">
                    {post.author.photo && typeof post.author.photo === 'object' && 'url' in post.author.photo && (post.author.photo as { url: string }).url ? (
                      <img 
                        src={(post.author.photo as { url: string }).url} 
                        alt={post.author.name}
                        class="author-avatar"
                      />
                    ) : (
                      <img
                        src="/functionfly.png"
                        alt="FunctionFly"
                        class="author-avatar"
                      />
                    )}
                    <span class="author-name">{post.author.name}</span>
                  </a>
                )}
              </div>
              
              <span class="meta-separator"></span>
              
              {post.publishedAt && (
                <time datetime={formatDateISO(post.publishedAt)} class="meta-date">
                  {formatDate(post.publishedAt)}
                </time>
              )}
              
              <span class="meta-separator"></span>
              
              <span class="meta-reading">{readingMinutes} min read</span>
            </div>
          </header>

          <!-- Hero Image -->
          {post.heroImage?.url && (
            <div class="hero-image-wrapper">
              <img
                src={post.heroImage.url}
                alt={post.heroImage.alt || post.title}
                class="hero-image"
                loading="eager"
              />
              {post.heroImage.caption && (
                <figcaption class="hero-caption">{post.heroImage.caption}</figcaption>
              )}
            </div>
          )}

          <!-- Content -->
          <div class="post-content-wrapper">
            <div class="post-content blog-content" set:html={bodyHtml} />
          </div>

          <!-- Author Bio at bottom -->
          {post.author && (
            <div class="author-section">
              <AuthorBio author={post.author as any} />
            </div>
          )}

          <!-- Tags Footer -->
          {post.tags && post.tags.length > 0 && (
            <footer class="post-footer">
              <h3 class="footer-title">{t('post.relatedTopics')}</h3>
              <ul class="tag-list">
                {post.tags.map((tag) => (
                  <li>
                    <a href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag-link">
                      <span class="tag-hash">#</span>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            </footer>
          )}
        </div>
      </div>

      <slot name="related-posts" />
    </article>
  </div>

  <!-- Copy Code Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const codeBlocks = document.querySelectorAll('.code-box__copy, .copy-code-btn');

      // Create aria-live region for announcements
      const liveRegion = document.createElement('div');
      liveRegion.setAttribute('aria-live', 'polite');
      liveRegion.setAttribute('aria-atomic', 'true');
      liveRegion.className = 'sr-only';
      liveRegion.style.cssText = 'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;';
      document.body.appendChild(liveRegion);

      codeBlocks.forEach(btn => {
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        btn.addEventListener('click', async function() {
          const code = this.getAttribute('data-code');

          try {
            await navigator.clipboard.writeText(code);

            // Show copied state
            this.classList.add('code-box__copy--copied');
            const span = this.querySelector('span');
            if (span) span.textContent = 'Copied';
            liveRegion.textContent = 'Code copied to clipboard';

            setTimeout(() => {
              this.classList.remove('code-box__copy--copied');
              if (span) span.textContent = 'Copy';
            }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
            liveRegion.textContent = 'Failed to copy code';
          }
        });
      });
      
      // Reading progress
      const progressBar = document.createElement('div');
      progressBar.className = 'reading-progress';
      document.body.appendChild(progressBar);
      
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        progressBar.style.width = `${scrollPercent}%`;
      }, { passive: true });
    });
  </script>
</BlogLayout>

<style is:global>
  /* ============================
     POST LAYOUT STYLES
     ============================ */
  
  .post-surface {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
  }

  .post-surface::before {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(143, 255, 208, 0.06), transparent 55%),
      radial-gradient(ellipse 40% 20% at 100% 0%, rgba(159, 216, 255, 0.04), transparent 40%);
  }

  .blog-post {
    position: relative;
    padding: 2rem 1rem 5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .post-container {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* ============================
     SIDEBAR
     ============================ */
  
  .post-sidebar {
    position: relative;
  }

  .sidebar-sticky {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .reading-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--color-bg-light) 60%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .reading-indicator__time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1;
  }

  [data-theme='light'] .reading-indicator__time {
    color: #0f172a;
  }

  .reading-indicator__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .sidebar-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .sidebar-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sidebar-tag {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--color-primary-light);
    transition: all 0.2s ease;
  }

  .sidebar-tag:hover {
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  /* ============================
     MAIN CONTENT
     ============================ */
  
  .post-main {
    min-width: 0;
  }

  .post-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #94a3b8;
    transition: color 0.2s;
  }

  [data-theme='light'] .back-link {
    color: #64748b;
  }

  .back-link:hover {
    color: #e2e8f0;
  }

  [data-theme='light'] .back-link:hover {
    color: #0f172a;
  }

  .back-link__icon {
    transition: transform 0.2s;
  }

  .back-link:hover .back-link__icon {
    transform: translateX(-3px);
  }

  /* ============================
     HERO HEADER
     ============================ */
  
  .post-hero {
    margin-bottom: 2.5rem;
  }

  .post-category {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #10b981;
    margin-bottom: 1.25rem;
    transition: all 0.2s;
  }

  [data-theme='light'] .post-category {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
    color: #059669;
  }

  .post-category:hover {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
  }

  [data-theme='light'] .post-category:hover {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.5);
  }

  .post-category__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
  }

  .post-title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .title-accent {
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 40%, #94a3b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  [data-theme='light'] .title-accent {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 40%, #475569 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .post-description {
    font-size: 1.25rem;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 650px;
    margin-bottom: 1.5rem;
  }

  [data-theme='light'] .post-description {
    color: #475569;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #64748b;
  }

  .author-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #e2e8f0;
    transition: color 0.2s;
  }

  .author-link:hover {
    color: #f8fafc;
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(148, 163, 184, 0.2);
  }

  .author-avatar--initial {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: white;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .author-name {
    font-weight: 500;
  }

  .meta-separator {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #475569;
  }

  .meta-date {
    color: #94a3b8;
  }

  .meta-reading {
    color: #94a3b8;
  }

  /* ============================
     HERO IMAGE
     ============================ */
  
  .hero-image-wrapper {
    margin-bottom: 3rem;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .hero-image {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .hero-caption {
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--color-bg-light) 80%, transparent);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
  }

  [data-theme='light'] .hero-caption {
    background: #f1f5f9;
    color: #475569;
  }

  /* ============================
     CONTENT STYLES
     ============================ */
  
  .post-content-wrapper {
    margin-bottom: 3rem;
  }

  .post-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #e2e8f0;
  }

  [data-theme='light'] .post-content {
    color: #1e293b;
  }

  /* Paragraphs */
  .post-content .content-paragraph {
    margin-bottom: 1.5rem;
  }

  /* Headings */
  .post-content h1,
  .post-content h2,
  .post-content h3,
  .post-content h4 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  [data-theme='light'] .post-content h1,
  [data-theme='light'] .post-content h2,
  [data-theme='light'] .post-content h3,
  [data-theme='light'] .post-content h4 {
    color: #0f172a;
  }

  .post-content h1 {
    font-size: 2rem;
  }

  .post-content h2 {
    font-size: 1.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }

  .post-content h3 {
    font-size: 1.5rem;
  }

  .post-content h4 {
    font-size: 1.25rem;
  }

  /* Links */
  .post-content .content-link {
    color: #818cf8;
    text-decoration: underline;
    text-decoration-color: rgba(129, 140, 248, 0.4);
    text-underline-offset: 3px;
    transition: all 0.2s;
  }

  [data-theme='light'] .post-content .content-link {
    color: #4f46e5;
    text-decoration-color: rgba(79, 70, 229, 0.4);
  }

  .post-content .content-link:hover {
    color: #a5b4fc;
    text-decoration-color: #a5b4fc;
  }

  [data-theme='light'] .post-content .content-link:hover {
    color: #4338ca;
    text-decoration-color: #4338ca;
  }

  /* Inline Code */
  .post-content .inline-code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875em;
    padding: 0.2em 0.4em;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: 4px;
    color: var(--color-primary-light);
  }

  /* Lists */
  .post-content .content-list,
  .post-content ul,
  .post-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content .content-list li,
  .post-content ul li,
  .post-content ol li {
    margin-bottom: 0.5rem;
    color: var(--color-text);
    line-height: 1.7;
  }

  [data-theme='light'] .post-content .content-list li,
  [data-theme='light'] .post-content ul li,
  [data-theme='light'] .post-content ol li {
    color: #1e293b;
  }

  .post-content .content-list--bullet,
  .post-content ul {
    list-style-type: disc;
  }

  .post-content .content-list--numbered,
  .post-content ol {
    list-style-type: decimal;
  }

  .post-content ul ul,
  .post-content ol ol,
  .post-content ul ol,
  .post-content ol ul {
    margin-bottom: 0;
    margin-top: 0.4rem;
  }

  /* Blockquote */
  .post-content .content-blockquote {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  [data-theme='light'] .post-content .content-blockquote {
    background: rgba(232, 90, 42, 0.05);
    color: #475569;
  }

  .post-content .content-blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Divider */
  .post-content .content-divider {
    margin: 3rem 0;
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.3), transparent);
  }

  /* ============================
     CODE BLOCKS
     ============================ */
  
.code-block-wrapper {
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  [data-theme='light'] .code-block-wrapper {
    background: #1e293b;
    border-color: rgba(148, 163, 184, 0.3);
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--color-bg-light) 80%, transparent);
    border-bottom: 1px solid var(--color-border);
  }

  .code-language-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding: 0.25rem 0.5rem;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .copy-code-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: 6px;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .copy-code-btn:hover {
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
    color: var(--color-text);
  }

  .copy-code-btn.copied {
    background: color-mix(in srgb, var(--color-secondary) 20%, transparent);
    border-color: rgba(16, 185, 129, 0.4);
    color: #10b981;
  }

  .copy-code-btn .copied-text {
    display: none;
  }

  .copy-code-btn.copied .copy-text {
    display: none;
  }

  .copy-code-btn.copied .copied-text {
    display: inline;
  }

  .code-block-content {
    display: flex;
    overflow-x: auto;
  }

  .line-numbers {
    flex-shrink: 0;
    padding: 1rem 0.75rem;
    background: color-mix(in srgb, var(--color-bg-light) 50%, transparent);
    border-right: 1px solid var(--color-border);
    text-align: right;
    user-select: none;
  }

  .line-number {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-dim);
  }

  .code-block {
    flex: 1;
    margin: 0;
    padding: 1rem 1.25rem;
    background: transparent;
    overflow-x: auto;
  }

  .code-block code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text);
    background: transparent;
    padding: 0;
    display: block;
  }

  [data-theme='light'] .code-block code {
    color: #e2e8f0;
  }

  /* ============================
     AUTHOR SECTION
     ============================ */
  
  .author-section {
    margin: 3rem 0;
