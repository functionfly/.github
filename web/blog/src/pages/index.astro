---
import BlogLayout from '../layouts/BlogLayout.astro';
import BlogGrid from '../components/BlogGrid.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import Pagination from '../components/Pagination.astro';
import SearchBox from '../components/SearchBox.astro';
import { getPosts, getCategories } from '../lib/api';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/constants';
import { getLocaleFromUrl, loadTranslations, createT } from '../i18n/index';

// Get pagination parameters from URL
const url = Astro.url;
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);
const limit = parseInt(url.searchParams.get('limit') || '10', 10);

// Fetch posts and categories
const [postsResponse, categories, recentPostsResponse] = await Promise.all([
  getPosts({ page: currentPage, limit, status: 'published' }),
  getCategories(),
  getPosts({ limit: 5, status: 'published' }),
]);

const posts = postsResponse.data || [];
const { totalPages } = postsResponse.meta;
const totalPosts = postsResponse.meta.total;
const recentPosts = recentPostsResponse.data || [];

const locale = getLocaleFromUrl(Astro.url);
const translations = await loadTranslations(locale);
const t = createT(translations);
---

<BlogLayout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
>
  <!-- Hero Section -->
  <section class="blog-hero-section">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="ff-container">
      <header class="blog-hero">
        <div class="hero-badge-wrapper">
          <span class="hero-badge">
            <span class="hero-badge-dot"></span>
            {t('hero.badge')}
          </span>
        </div>

        <h1 class="blog-title">{SITE_NAME}</h1>

        <p class="blog-subtitle">
          {t('hero.subtitle')}
        </p>

        <div class="blog-search">
          <SearchBox />
        </div>
      </header>

      <!-- Stats bar -->
      <div class="stats-bar">
        <div class="stat-item">
          <span class="stat-number">{totalPosts > 0 ? totalPosts : '50'}+</span>
          <span class="stat-label">{t('stats.articles')}</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-number">12k+</span>
          <span class="stat-label">{t('stats.readers')}</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-number">Weekly</span>
          <span class="stat-label">{t('stats.updates')}</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-number">8</span>
          <span class="stat-label">{t('stats.authors')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Content -->
  <section class="blog-page">
    <div class="ff-container">
      <div class="blog-content-wrapper">
        <aside class="blog-sidebar">
          <CategoryFilter categories={categories} showCounts={true} totalPosts={totalPosts} />

          <!-- Recent Posts Widget -->
          <div class="trending-widget">
            <h3 class="trending-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              {t('category.recentPosts')}
            </h3>
            <ul class="trending-list">
              {recentPosts.length > 0 ? (
                recentPosts.map((post) => (
                  <li class="trending-item">
                    <a href={`/post/${post.slug}`} class="trending-link">
                      <span class="trending-tag">#</span> {post.title}
                    </a>
                    {post.publishedAt && (
                      <span class="trending-views">
                        {new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                      </span>
                    )}
                  </li>
                ))
              ) : (
                <li class="trending-item">
                  <span class="trending-link">{t('category.noRecentPosts')}</span>
                </li>
              )}
            </ul>
          </div>
        </aside>

        <div class="blog-main">
          <BlogGrid posts={posts} featuredFirst={currentPage === 1} />

          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl="/"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="newsletter-section">
    <div class="ff-container">
      <div class="newsletter-card">
        <div class="newsletter-card__content">
          <div class="newsletter-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="newsletter-card__text">
            <h2 class="newsletter-card__title">{t('newsletter.title')}</h2>
            <p class="newsletter-card__description">{t('newsletter.description')}</p>
          </div>
        </div>
        <form class="newsletter-form" action="/api/subscribe" method="POST">
          <div class="newsletter-input-group">
            <input
              type="email"
              name="email"
              placeholder={t('newsletter.placeholder')}
              class="newsletter-input"
              aria-label="Email address"
              required
            />
            <button type="submit" class="newsletter-button">
              {t('newsletter.button')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
          <p class="newsletter-privacy">{t('newsletter.privacy')}</p>
        </form>
      </div>
    </div>
  </section>
</BlogLayout>

<style>
  .blog-search {
    max-width: 540px;
    margin: 0 auto;
  }
</style>
