# FunctionFly Status Page - Environment Configuration

# API Base URL for backend communication
# Development: leave unset to use Vite dev-server proxy (/api -> orchestrator on :8080).
# Or set direct URL: VITE_API_URL=http://localhost:8080
# VITE_API_URL=

# Mixpanel Product Analytics (public page — no auth required)
# Get your Project Token from Mixpanel (Project Settings -> Keys)
# VITE_MIXPANEL_TOKEN=your_mixpanel_project_token_here
# Optional: EU residency endpoint (e.g. https://eu.mixpanel.com for GDPR compliance)
# VITE_MIXPANEL_HOST=https://eu.mixpanel.com
# Optional: enable Mixpanel debug console logging in development
# VITE_MIXPANEL_DEBUG=true

# Staging (uncomment for staging builds)
# VITE_API_URL=https://api.staging.functionfly.com

# Production (uncomment for production builds)
# VITE_API_URL=https://api.functionfly.com
