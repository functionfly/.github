{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FunctionFly Studio",
  "version": "1.0.0",
  "identifier": "com.functionfly.studio",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "devUrl": "http://localhost:3000/studio",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "FunctionFly Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com http://localhost:3000 http://localhost:8080 ws://localhost:8080 wss://localhost:8081"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": null,
      "certificateThumbprint": "${TAURI_WINDOWS_CERT_THUMBPRINT}",
      "timestampUrl": "http://timestamp.digicert.com",
      "digestAlgorithm": "sha256"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "signingIdentity": "${TAURI_MACOS_SIGNING_IDENTITY}",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["functionfly"]
      }
    }
  }
}