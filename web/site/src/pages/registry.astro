---
/**
 * /registry — The MCP Function Registry landing page.
 *
 * The page is statically rendered for SEO. The tool list is hydrated on
 * the client from the public `GET /v1/mcp/tools` JSON-RPC-free index
 * (Vite proxies /v1 → http://localhost:8080 in dev; in production the
 * marketing site calls the API origin directly).
 *
 * Server-side rendering of the tool list is also supported: if
 * `PUBLIC_API_URL` is set at build time AND the request is SSR, we attempt
 * a server-side fetch and embed the result in the HTML so the page is
 * fully crawlable by Google. We fall back to the static shell + client
 * hydration if the server fetch fails.
 */
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN, API_ORIGIN } from '../config';

interface ToolItem {
  name: string;
  title: string;
  description: string;
  inputSchema: unknown;
  annotations: { category?: string; readOnlyHint?: boolean; openWorldHint?: boolean };
  _meta: {
    functionfly: {
      author: string;
      name: string;
      version: string;
      trust_score: number;
      trust_tier: string;
      verified_mcp: boolean;
      homepage: string;
      tags: string[];
      runtime: string;
    };
  };
}

interface ToolsIndex {
  tools: ToolItem[];
  total: number;
  next_cursor?: string;
}

const title = 'MCP Function Registry — The default directory of AI agent tools';
const description =
  'Searchable, trust-scored directory of Model Context Protocol (MCP) compatible functions. The npm for AI agent functions. Install in one click for Claude Desktop, Cursor, and VS Code.';

// Server-side fetch: try to embed the initial list so search engines can
// crawl real content. If the API is unreachable at build time we ship
// the static shell + client hydration.
let initialTools: ToolItem[] = [];
let initialTotal = 0;
let initialFetchError: string | null = null;

try {
  const resp = await fetch(
    `${API_ORIGIN}/v1/mcp/tools?limit=24`,
    { headers: { 'accept': 'application/json' } },
  );
  if (resp.ok) {
    const data = (await resp.json()) as ToolsIndex;
    initialTools = data.tools ?? [];
    initialTotal = data.total ?? 0;
  } else {
    initialFetchError = `API returned ${resp.status}`;
  }
} catch (e) {
  initialFetchError = e instanceof Error ? e.message : 'unknown error';
}

// JSON-LD: ItemList of tools (crawlable), plus Organization, WebSite, BreadcrumbList.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'MCP Function Registry',
  description:
    'Searchable directory of Model Context Protocol (MCP) compatible functions for AI agents.',
  url: `${SITE_ORIGIN}/registry`,
  numberOfItems: initialTotal,
  itemListElement: initialTools.slice(0, 10).map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: t._meta?.functionfly?.homepage || `${SITE_ORIGIN}/@${t._meta?.functionfly?.author}/v1/fx/${t._meta?.functionfly?.name}`,
    name: t.title || t.name,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN },
    { '@type': 'ListItem', position: 2, name: 'MCP Function Registry', item: `${SITE_ORIGIN}/registry` },
  ],
};

const registryPageSchemas = [itemListSchema, breadcrumbSchema];

// Categories we surface as filter chips. The full list is generated
// dynamically on the client from the data.
const seedCategories = [
  { slug: 'document-processing', label: 'Documents' },
  { slug: 'data-extraction', label: 'Data Extraction' },
  { slug: 'ai', label: 'AI & ML' },
  { slug: 'communication', label: 'Communication' },
  { slug: 'finance', label: 'Finance' },
  { slug: 'developer-tools', label: 'Developer Tools' },
];

// Install snippet shown to readers. The `npx` command installs the
// FunctionFly MCP server npm package, which proxies stdio → HTTP /v1/mcp.
const installSnippet = `{
  "mcpServers": {
    "functionfly": {
      "command": "npx",
      "args": ["-y", "@functionfly/mcp-server"],
      "env": {
        "FUNCTIONFLY_API_KEY": "ffp_..."
      }
    }
  }
}`;
---

<Layout
  title={title}
  description={description}
  canonical={`${SITE_ORIGIN}/registry`}
  ogImage="/og-registry.png"
  schema={registryPageSchemas}
>
  <main class="min-h-screen bg-white text-slate-900" data-page="registry">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-200 mb-6">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse" aria-hidden="true"></span>
            Now live · Model Context Protocol
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900">
            The default directory of
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 to-violet-600">
              AI agent functions
            </span>
          </h1>
          <p class="mt-6 text-lg text-slate-600 leading-relaxed">
            The first searchable registry of Model Context Protocol (MCP) compatible functions.
            Install in one click for Claude Desktop, Cursor, and VS Code — every function
            is trust-scored, sandboxed, and shipped with an execution receipt.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#install"
              class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2"
            >
              Install registry
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a
              href={`${SITE_ORIGIN}/docs/mcp`}
              class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300 hover:bg-slate-50"
            >
              Read the docs
            </a>
            <a
              href={`${SITE_ORIGIN}/v1/mcp/manifest`}
              class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 ring-1 ring-inset ring-slate-200 hover:bg-slate-50"
            >
              <code class="text-xs">/v1/mcp/manifest</code>
            </a>
          </div>
          <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-6 text-sm">
            <div>
              <dt class="text-slate-500">MCP-enabled functions</dt>
              <dd class="mt-1 text-2xl font-bold text-slate-900" data-stat="mcp-enabled">{initialTotal}</dd>
            </div>
            <div>
              <dt class="text-slate-500">Public functions</dt>
              <dd class="mt-1 text-2xl font-bold text-slate-900" data-stat="total">{initialTotal}</dd>
            </div>
            <div>
              <dt class="text-slate-500">Transports</dt>
              <dd class="mt-1 text-base font-mono text-slate-900">streamable-http · stdio</dd>
            </div>
            <div>
              <dt class="text-slate-500">Spec</dt>
              <dd class="mt-1 text-base font-mono text-slate-900">MCP 2025-03-26</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Filters + Search -->
    <section class="border-b border-slate-200 bg-white sticky top-0 z-10 backdrop-blur supports-[backdrop-filter]:bg-white/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
          <div class="flex-1 max-w-md">
            <label for="registry-search" class="sr-only">Search functions</label>
            <div class="relative">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
              </svg>
              <input
                id="registry-search"
                type="search"
                placeholder="Search functions (e.g. summarize, extract, classify)…"
                autocomplete="off"
                class="block w-full rounded-lg border-0 bg-slate-100 py-2 pl-10 pr-3 text-sm text-slate-900 placeholder:text-slate-500 focus:bg-white focus:ring-2 focus:ring-indigo-600"
              />
            </div>
          </div>
          <div class="flex flex-wrap gap-2" id="registry-categories" role="tablist" aria-label="Filter by category">
            <button
              type="button"
              data-category=""
              class="rounded-full bg-slate-900 text-white px-3 py-1 text-xs font-medium"
              role="tab"
              aria-selected="true"
            >All</button>
            {seedCategories.map((c) => (
              <button
                type="button"
                data-category={c.slug}
                class="rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1 text-xs font-medium"
                role="tab"
                aria-selected="false"
              >{c.label}</button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Tool Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div id="registry-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-initial={JSON.stringify(initialTools)}>
        {initialTools.length === 0 && (
          <div class="col-span-full text-center py-16 text-slate-500">
            <p class="text-lg font-medium">No MCP-enabled functions yet.</p>
            <p class="mt-2 text-sm">
              Be the first — <a href={`${SITE_ORIGIN}/docs/mcp/publish-mcp`} class="text-indigo-600 hover:underline">publish a function with MCP support</a> in 2 minutes.
            </p>
            {initialFetchError && (
              <p class="mt-4 text-xs text-slate-400">Note: server-side fetch returned: {initialFetchError}</p>
            )}
          </div>
        )}
        {initialTools.map((t) => (
          <article class="group relative rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
            <header class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-base font-semibold text-slate-900 line-clamp-1">
                  {t.title || t.name}
                </h3>
                <p class="mt-0.5 text-xs text-slate-500 font-mono">@{t._meta?.functionfly?.author}/{t._meta?.functionfly?.name}</p>
              </div>
              {t._meta?.functionfly?.verified_mcp && (
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">
                  <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1.001 1.001 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Verified MCP
                </span>
              )}
            </header>
            <p class="mt-3 text-sm text-slate-600 line-clamp-3">
              {t.description || `Function ${t._meta?.functionfly?.name}.`}
            </p>
            <dl class="mt-4 grid grid-cols-2 gap-2 text-xs">
              {t._meta?.functionfly?.trust_score > 0 && (
                <div>
                  <dt class="text-slate-500">Trust</dt>
                  <dd class="font-semibold text-slate-900">{Math.round(t._meta.functionfly.trust_score)}</dd>
                </div>
              )}
              {t._meta?.functionfly?.runtime && (
                <div>
                  <dt class="text-slate-500">Runtime</dt>
                  <dd class="font-mono text-slate-900">{t._meta.functionfly.runtime}</dd>
                </div>
              )}
            </dl>
            {t._meta?.functionfly?.tags && t._meta.functionfly.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1">
                {t._meta.functionfly.tags.slice(0, 4).map((tag) => (
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">{tag}</span>
                ))}
              </div>
            )}
            <footer class="mt-4 flex gap-2">
              <a
                href={t._meta?.functionfly?.homepage || `${SITE_ORIGIN}/@${t._meta?.functionfly?.author}/v1/fx/${t._meta?.functionfly?.name}`}
                class="text-xs font-semibold text-indigo-600 hover:text-indigo-500"
              >
                View →
              </a>
              <button
                type="button"
                class="text-xs font-semibold text-slate-600 hover:text-slate-900"
                data-copy-install={t.name}
              >
                Copy install
              </button>
            </footer>
          </article>
        ))}
      </div>
      <div id="registry-empty" class="hidden text-center py-12 text-slate-500">
        <p>No functions match your filters.</p>
      </div>
    </section>

    <!-- Install snippet -->
    <section id="install" class="border-t border-slate-200 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-slate-900">Install in 30 seconds</h2>
            <p class="mt-4 text-lg text-slate-600">
              Add the FunctionFly MCP server to Claude Desktop, Cursor, or VS Code with a
              single config block. The server proxies every call to FunctionFly's secure
              execution runtime — no keys to manage, no functions to host.
            </p>
            <ul class="mt-6 space-y-3 text-slate-700">
              <li class="flex gap-3">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span><strong>Trust-scored.</strong> Every tool is rated on reliability, success rate, and latency.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span><strong>Sandboxed.</strong> Tools run in Firecracker MicroVMs; you get a signed execution receipt.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span><strong>Pay-per-call.</strong> Free functions cost nothing. Paid functions bill the caller's wallet.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span><strong>Open spec.</strong> MCP 2025-03-26, streamable-HTTP and stdio transports.</span>
              </li>
            </ul>
          </div>
          <div class="rounded-xl bg-slate-900 text-slate-100 p-6 shadow-2xl ring-1 ring-slate-800">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-slate-400">claude_desktop_config.json</span>
              <button type="button" id="copy-install" class="text-xs font-semibold text-indigo-300 hover:text-indigo-200">
                Copy
              </button>
            </div>
            <pre class="overflow-x-auto text-sm font-mono leading-relaxed"><code>{installSnippet}</code></pre>
            <p class="mt-4 text-xs text-slate-400">
              Get an API key at <a href={`${SITE_ORIGIN}/settings/api-keys`} class="text-indigo-300 hover:underline">functionfly.com/settings/api-keys</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO content / FAQ -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-2xl font-bold text-slate-900">What is the MCP Function Registry?</h2>
      <p class="mt-4 text-slate-700 leading-relaxed">
        The MCP Function Registry is the canonical, public directory of <a href="https://modelcontextprotocol.io" class="text-indigo-600 hover:underline">Model Context Protocol</a> compatible
        functions. Every agent framework that adopts MCP — Anthropic's Claude, OpenAI's plugin ecosystem, Cursor, Continue, Windsurf, Cline, and dozens more — needs a
        way to discover tools their agents can call. The MCP Function Registry is that default answer.
      </p>
      <p class="mt-4 text-slate-700 leading-relaxed">
        Unlike other directories, every function in the registry is a live, executable service with a trust score, an execution receipt, and a verified sandbox.
        You can install any function with one config line, and your agent will be calling real production code in 30 seconds.
      </p>

      <h3 class="mt-10 text-xl font-semibold text-slate-900">How do I publish a function?</h3>
      <p class="mt-3 text-slate-700">
        Publish a function via the dashboard or the CLI, then flip the "MCP-compatible" toggle. Your function becomes
        discoverable at <code>functionfly.com/registry</code> and callable from any MCP-compatible agent. See
        <a href={`${SITE_ORIGIN}/docs/mcp/publish-mcp`} class="text-indigo-600 hover:underline">the publishing guide</a>.
      </p>
    </section>
  </main>

  <script type="application/json" id="registry-initial-data" set:html={JSON.stringify({
    tools: initialTools,
    total: initialTotal,
    categories: seedCategories,
  })} />

  <script is:inline>
    /* eslint-disable @typescript-eslint/no-explicit-any */
    // Client-side hydration: search, category filter, copy-install, and
    // pagination (load more). The page works without JS (initial server-
    // rendered list is visible), but interactivity needs the script below.
    (function() {
      const grid = document.getElementById('registry-grid');
      const empty = document.getElementById('registry-empty');
      const search = document.getElementById('registry-search');
      const catButtons = document.querySelectorAll('#registry-categories button[data-category]');
      if (!grid || !search) return;

      let state = { q: '', category: '', cursor: null, loading: false };
      let tools = [];

      // Seed with server-rendered initial data.
      const initialEl = document.getElementById('registry-initial-data');
      try {
        const init = JSON.parse(initialEl?.textContent || '{}');
        tools = init.tools || [];
        const totalEl = document.querySelector('[data-stat="mcp-enabled"]');
        if (totalEl) totalEl.textContent = String(init.total ?? 0);
      } catch (e) {
        console.error('registry: failed to parse initial data', e);
      }

      async function fetchPage(reset = false) {
        if (state.loading) return;
        state.loading = true;
        try {
          const params = new URLSearchParams();
          if (state.q) params.set('q', state.q);
          if (state.category) params.set('category', state.category);
          if (!reset && state.cursor) params.set('cursor', state.cursor);
          params.set('limit', '24');
          const url = `/v1/mcp/tools?${params.toString()}`;
          const resp = await fetch(url, { headers: { 'accept': 'application/json' } });
          if (!resp.ok) throw new Error('HTTP ' + resp.status);
          const data = await resp.json();
          if (reset) tools = data.tools || [];
          else tools = tools.concat(data.tools || []);
          state.cursor = data.next_cursor || null;
          render();
        } catch (e) {
          console.error('registry: fetch failed', e);
        } finally {
          state.loading = false;
        }
      }

      function render() {
        // Re-render the grid. For simplicity we just rebuild the innerHTML.
        // This is fine for ≤ a few hundred tools; for thousands we should
        // add virtualization.
        if (tools.length === 0) {
          grid.classList.add('hidden');
          empty?.classList.remove('hidden');
          return;
        }
        grid.classList.remove('hidden');
        empty?.classList.add('hidden');
        grid.innerHTML = tools.map(toolCard).join('');
      }

      function toolCard(t) {
        const meta = t._meta?.functionfly || {};
        const verified = meta.verified_mcp
          ? `<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">Verified MCP</span>`
          : '';
        const tags = (meta.tags || []).slice(0, 4).map(tag =>
          `<span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">${escapeHtml(tag)}</span>`
        ).join('');
        const trust = meta.trust_score
          ? `<div><dt class="text-slate-500">Trust</dt><dd class="font-semibold text-slate-900">${Math.round(meta.trust_score)}</dd></div>`
          : '';
        const runtime = meta.runtime
          ? `<div><dt class="text-slate-500">Runtime</dt><dd class="font-mono text-slate-900">${escapeHtml(meta.runtime)}</dd></div>`
          : '';
        const homepage = meta.homepage || `/@${meta.author}/v1/fx/${meta.name}`;
        return `
          <article class="group relative rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
            <header class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-base font-semibold text-slate-900 line-clamp-1">${escapeHtml(t.title || t.name)}</h3>
                <p class="mt-0.5 text-xs text-slate-500 font-mono">@${escapeHtml(meta.author || '')}/${escapeHtml(meta.name || '')}</p>
              </div>
              ${verified}
            </header>
            <p class="mt-3 text-sm text-slate-600 line-clamp-3">${escapeHtml(t.description || '')}</p>
            <dl class="mt-4 grid grid-cols-2 gap-2 text-xs">${trust}${runtime}</dl>
            ${tags ? `<div class="mt-3 flex flex-wrap gap-1">${tags}</div>` : ''}
            <footer class="mt-4 flex gap-2">
              <a href="${escapeAttr(homepage)}" class="text-xs font-semibold text-indigo-600 hover:text-indigo-500">View →</a>
              <button type="button" class="text-xs font-semibold text-slate-600 hover:text-slate-900" data-copy-install="${escapeAttr(t.name)}">Copy install</button>
            </footer>
          </article>
        `;
      }

      function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
      function escapeAttr(s) { return escapeHtml(s); }

      // Wire up filters.
      let debounce;
      search.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => {
          state.q = search.value.trim();
          state.cursor = null;
          fetchPage(true);
        }, 200);
      });

      catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          catButtons.forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('bg-slate-900', 'text-white');
          btn.classList.remove('bg-slate-100', 'text-slate-700');
          btn.setAttribute('aria-selected', 'true');
          state.category = btn.dataset.category || '';
          state.cursor = null;
          fetchPage(true);
        });
      });

      // Copy-install handler (event delegation).
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;
        if (target.id === 'copy-install') {
          const pre = document.querySelector('#install pre code');
          if (!pre) return;
          navigator.clipboard?.writeText(pre.textContent || '').then(() => {
            const orig = target.textContent;
            target.textContent = 'Copied!';
            setTimeout(() => { target.textContent = orig; }, 1500);
          });
          return;
        }
        if (target.dataset.copyInstall) {
          const t = target.dataset.copyInstall;
          const snippet = JSON.stringify({
            'mcpServers': {
              'functionfly': {
                command: 'npx',
                args: ['-y', '@functionfly/mcp-server'],
                env: { FUNCTIONFLY_API_KEY: 'ffp_...' },
              },
            },
          }, null, 2);
          const full = `// Add the function "${t}" to your config:\n${snippet}`;
          navigator.clipboard?.writeText(full).then(() => {
            const orig = target.textContent;
            target.textContent = 'Copied!';
            setTimeout(() => { target.textContent = orig; }, 1500);
          });
        }
      });
    })();
  </script>
</Layout>
