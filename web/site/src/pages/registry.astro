---
import Layout from '../layouts/Layout.astro';
import RegistryPage from '../components/RegistryPage';
import { SITE_ORIGIN, API_ORIGIN } from '../config';

const title = 'MCP Function Registry — The default directory of AI agent tools';
const description =
  'Searchable, trust-scored directory of Model Context Protocol (MCP) compatible functions. The npm for AI agent functions. Install in one click for Claude Desktop, Cursor, and VS Code.';

interface ToolItem {
  name: string;
  title: string;
  description: string;
  inputSchema: unknown;
  annotations: { category?: string; readOnlyHint?: boolean; openWorldHint?: boolean };
  _meta: {
    functionfly: {
      author: string;
      name: string;
      version: string;
      trust_score: number;
      trust_tier: string;
      verified_mcp: boolean;
      homepage: string;
      tags: string[];
      runtime: string;
    };
  };
}

interface ToolsIndex {
  tools: ToolItem[];
  total: number;
  next_cursor?: string;
}

interface RegistryStats {
  total_functions: number;
  total_executions: string;
  trust_tiers: number;
  runtimes: number;
}

// Fetch stats and trending tools
let stats: RegistryStats | null = null;
let trendingTools: ToolItem[] = [];

try {
  // Fetch stats
  const statsResp = await fetch(`${API_ORIGIN}/v1/mcp/stats`, {
    headers: { 'accept': 'application/json' },
  });
  if (statsResp.ok) {
    stats = await statsResp.json() as RegistryStats;
  }
} catch (e) {
  // Stats unavailable
}

try {
  // Fetch trending (top 4 by trust score)
  const toolsResp = await fetch(`${API_ORIGIN}/v1/mcp/tools?limit=4&sort=trust_score`, {
    headers: { 'accept': 'application/json' },
  });
  if (toolsResp.ok) {
    const data = (await toolsResp.json()) as ToolsIndex;
    trendingTools = data.tools ?? [];
  }
} catch (e) {
  // Tools unavailable
}

// Fetch categories
let categories: Array<{ slug: string; label: string; count: number }> = [];
try {
  const catResp = await fetch(`${API_ORIGIN}/v1/mcp/categories`, {
    headers: { 'accept': 'application/json' },
  });
  if (catResp.ok) {
    categories = await catResp.json() as typeof categories;
  }
} catch (e) {
  // Use default categories if API unavailable
  categories = [
    { slug: 'document-processing', label: 'Documents', count: 0 },
    { slug: 'data-extraction', label: 'Data Extraction', count: 0 },
    { slug: 'ai', label: 'AI & ML', count: 0 },
    { slug: 'communication', label: 'Communication', count: 0 },
    { slug: 'finance', label: 'Finance', count: 0 },
    { slug: 'developer-tools', label: 'Developer Tools', count: 0 },
  ];
}

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'MCP Function Registry',
  description: 'Searchable directory of Model Context Protocol (MCP) compatible functions for AI agents.',
  url: `${SITE_ORIGIN}/registry`,
  numberOfItems: stats?.total_functions ?? 0,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN },
    { '@type': 'ListItem', position: 2, name: 'MCP Function Registry', item: `${SITE_ORIGIN}/registry` },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={`${SITE_ORIGIN}/registry`}
  ogImage="/og-registry.png"
  schema={[itemListSchema, breadcrumbSchema]}
>
  <RegistryPage
    client:load
    stats={stats}
    trendingTools={trendingTools}
    categories={categories}
  />
</Layout>