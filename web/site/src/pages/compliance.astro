---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import CompliancePage from '../components/CompliancePage.tsx';

const title = 'Compliance & Security — FunctionFly';
const description = 'Enterprise-grade security and compliance. SOC 2 Type II, GDPR, CCPA, COPPA compliant with zero-knowledge vault and custom security options.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <CompliancePage client:load />
</Layout>
