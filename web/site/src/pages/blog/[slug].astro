---
import Layout from '../../layouts/Layout.astro';

const BLOG_API = import.meta.env.PUBLIC_BLOG_API_URL || 'http://localhost:3000';

export async function getStaticPaths() {
  try {
    const res = await fetch(`${BLOG_API}/api/v1/blog/posts?limit=200`);
    if (!res.ok) return [];
    const json = await res.json();
    const posts = json.data || [];
    return posts.map((p: { slug: string }) => ({ params: { slug: p.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

let post: {
  id: string;
  title: string;
  slug: string;
  description: string;
  body: unknown;
  publishedAt: string | null;
  author: { name: string; slug: string; bio?: string } | null;
  category: { title: string; slug: string } | null;
  tags?: string[];
  heroImage?: { url: string; alt?: string } | null;
  seoTitle?: string | null;
  seoDescription?: string | null;
} | null = null;

try {
  const res = await fetch(`${BLOG_API}/api/v1/blog/posts/${encodeURIComponent(slug)}`);
  if (res.ok) {
    post = await res.json();
  }
} catch {
  // fallthrough to 404
}

if (!post) {
  return Astro.redirect('/blog');
}

// Simple render of common rich-text body (e.g. paragraph blocks with text children)
function renderBody(body: unknown): string {
  if (body == null) return '';
  if (typeof body === 'string') return body;
  if (Array.isArray(body)) {
    return body
      .map((block) => {
        if (block && typeof block === 'object' && 'children' in block) {
          const children = (block as { children?: unknown[] }).children;
          if (Array.isArray(children)) {
            return children
              .map((c) => (c && typeof c === 'object' && 'text' in c ? (c as { text: string }).text : ''))
              .join('');
          }
        }
        return '';
      })
      .filter(Boolean)
      .join('\n\n');
  }
  return '';
}

const bodyHtml = renderBody(post.body);
const metaTitle = post.seoTitle || post.title;
const metaDesc = post.seoDescription || post.description;
---

<Layout title={`${metaTitle} - FunctionFly Blog`} description={metaDesc || undefined}>
  <article class="blog-post">
    <div class="container">
      <header class="post-header">
        <a href="/blog" class="back-link">← Blog</a>
        <h1 class="post-title">{post.title}</h1>
        <div class="post-meta">
          {post.publishedAt && (
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
          {post.author?.name && <span class="post-author">{post.author.name}</span>}
          {post.category?.title && (
            <a href={`/blog?category=${post.category.slug}`} class="post-category">
              {post.category.title}
            </a>
          )}
        </div>
        {post.heroImage?.url && (
          <img
            src={post.heroImage.url}
            alt={post.heroImage.alt || post.title}
            class="post-hero"
          />
        )}
      </header>

      <div class="post-content">
        {bodyHtml ? (
          <div class="post-body">
            {bodyHtml.split('\n\n').map((p) => (
              <p>{p}</p>
            ))}
          </div>
        ) : (
          <p class="post-description">{post.description}</p>
        )}
      </div>

      {post.tags && post.tags.length > 0 && (
        <footer class="post-footer">
          <ul class="tag-list">
            {post.tags.map((tag) => (
              <li><span class="tag">{tag}</span></li>
            ))}
          </ul>
        </footer>
      )}
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    padding: 4rem 2rem 6rem;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .post-author::before,
  .post-category::before {
    content: '·';
    margin-right: 0.75rem;
  }

  .post-category {
    color: var(--color-primary);
    transition: opacity 0.2s;
  }

  .post-category:hover {
    opacity: 0.8;
  }

  .post-hero {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .post-content {
    line-height: 1.7;
  }

  .post-description {
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .post-body p {
    margin-bottom: 1rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-bg-light);
    border-radius: 9999px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
