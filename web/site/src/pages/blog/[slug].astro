---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { getBlogPosts } from '../../lib/blog-api';

export async function getStaticPaths() {
  // Fetch published blog posts from NestJS API
  const blogPostsResponse = await getBlogPosts({ limit: 100 });
  const blogPosts = blogPostsResponse.data;

  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const title = post.seoTitle || post.title;
const description = post.seoDescription || post.description;

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.description,
  "author": {
    "@type": "Person",
    "name": post.author?.name || "FunctionFly Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "datePublished": post.publishedAt,
  "dateModified": post.updatedAt || post.publishedAt,
  "keywords": post.keywords?.join(', ') || post.tags?.join(', ') || '',
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="mb-6">
            <span class="bg-accent-primary/10 text-accent-primary px-4 py-2 rounded-full text-sm font-medium">
              {post.category?.title || 'Uncategorized'}
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-6">
            {post.title}
          </h1>

          <p class="text-xl text-text-secondary mb-8 max-w-2xl mx-auto">
            {post.description}
          </p>

          <div class="flex items-center justify-center gap-6 text-sm text-text-secondary">
            {post.author && (
              <div class="flex items-center gap-3">
                {post.author.photo && (
                  <img
                    src={post.author.photo.url || post.author.photo}
                    alt={post.author.name}
                    class="w-10 h-10 rounded-full"
                  />
                )}
                <div>
                  <span class="text-text-primary font-medium">{post.author.name}</span>
                  {post.author.role && <div class="text-xs">{post.author.role}</div>}
                </div>
              </div>
            )}
            <span>•</span>
            <span>{new Date(post.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}</span>
            {post.updatedAt && post.updatedAt !== post.publishedAt && (
              <>
                <span>•</span>
                <span>Updated {new Date(post.updatedAt).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}</span>
              </>
            )}
          </div>

          {post.tags && post.tags.length > 0 && (
            <div class="flex gap-2 justify-center mt-6">
              {post.tags.map((tag) => (
                <span class="bg-bg-primary text-text-secondary px-3 py-1 rounded-full text-sm">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <article class="py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {post.heroImage && (
          <div class="mb-12">
            <img
              src={post.heroImage.url}
              alt={post.heroImage.alt || post.title}
              class="w-full h-96 object-cover rounded-xl"
            />
            {post.heroImage.caption && (
              <p class="text-sm text-text-secondary mt-2 text-center italic">
                {post.heroImage.caption}
              </p>
            )}
          </div>
        )}

        <div class="prose prose-lg prose-invert max-w-none">
          {typeof post.body === 'string' ? (
            <div set:html={post.body}></div>
          ) : (
            <PortableText value={post.body} />
          )}
        </div>

        <!-- Social Share Buttons -->
        <div class="mt-12 pt-8 border-t border-text-secondary/20">
          <div class="flex items-center justify-center gap-4">
            <button class="bg-bg-secondary hover:bg-bg-primary text-text-secondary hover:text-text-primary p-3 rounded-lg transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
              </svg>
            </button>
            <button class="bg-bg-secondary hover:bg-bg-primary text-text-secondary hover:text-text-primary p-3 rounded-lg transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </button>
            <button class="bg-bg-secondary hover:bg-bg-primary text-text-secondary hover:text-text-primary p-3 rounded-lg transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.751.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.746-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24c6.624 0 11.99-5.367 11.99-11.987C24.007 5.367 18.641.001.012.017z"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Author Bio -->
        {post.author && (post.author.bio || post.author.socialLinks) && (
          <div class="mt-12 pt-8 border-t border-text-secondary/20">
            <div class="flex items-start gap-6">
              {post.author.photo && (
                <img
                  src={post.author.photo.url || post.author.photo}
                  alt={post.author.name}
                  class="w-20 h-20 rounded-full"
                />
              )}
              <div class="flex-1">
                <h3 class="text-xl font-bold text-text-primary mb-2">About {post.author.name}</h3>
                {post.author.bio && (
                  <p class="text-text-secondary mb-4">{post.author.bio}</p>
                )}
                {post.author.socialLinks && (
                  <div class="flex gap-3">
                    {/* Social links handling - adapt based on new API structure */}
                    {Object.entries(post.author.socialLinks).map(([platform, url]) => (
                      <a
                        href={url as string}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-secondary hover:text-accent-primary transition-colors"
                      >
                        {platform === 'twitter' && (
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                          </svg>
                        )}
                        {platform === 'linkedin' && (
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                          </svg>
                        )}
                        {platform === 'github' && (
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                          </svg>
                        )}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  // Add any client-side functionality here
</script>