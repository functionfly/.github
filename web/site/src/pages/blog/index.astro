---
import Layout from '../../layouts/Layout.astro';
import { BLOG_API_ORIGIN } from '../../config';

let posts: Array<{
  id: string;
  title: string;
  slug: string;
  description: string;
  publishedAt: string | null;
  author: { name: string; slug: string } | null;
  category: { title: string; slug: string } | null;
  tags?: string[];
}> = [];
let categories: Array<{
  id: string;
  title: string;
  slug: string;
  description: string | null;
  order: number | null;
}> = [];
let error: string | null = null;

try {
  const [postsRes, catsRes] = await Promise.all([
    fetch(`${BLOG_API_ORIGIN}/api/v1/blog/posts?limit=50`),
    fetch(`${BLOG_API_ORIGIN}/api/v1/blog/categories`),
  ]);
  if (postsRes.ok) {
    const json = await postsRes.json();
    posts = json.data || [];
  } else {
    error = `Blog API returned ${postsRes.status}`;
  }
  if (catsRes.ok) {
    categories = await catsRes.json();
    if (!Array.isArray(categories)) categories = [];
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load posts';
}

const countByCategorySlug = posts.reduce<Record<string, number>>((acc, p) => {
  const s = p.category?.slug;
  if (s) acc[s] = (acc[s] || 0) + 1;
  return acc;
}, {});
---

<Layout
  title="Blog - FunctionFly"
  description="FunctionFly blog: tutorials, product updates, and edge computing insights."
>
  <div class="blog-surface">
    <section class="blog-page">
      <div class="blog-inner">
        <header class="blog-hero">
          <div class="blog-hero-pill">
            <svg class="blog-hero-pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            <span>Insights &amp; updates</span>
          </div>
          <h1 class="blog-title">
            <span class="blog-title-gradient">Blog</span>
          </h1>
          <p class="blog-subtitle">Tutorials, product updates, and edge computing insights.</p>
        </header>

        {error && (
          <div class="blog-coming-soon">
            <div class="blog-coming-soon-icon" aria-hidden="true">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                <path d="M12 6v4M12 14h.01" />
              </svg>
            </div>
            <h2 class="blog-coming-soon-title">Blog coming soon</h2>
            <p class="blog-coming-soon-text">Tutorials, product updates, and edge computing insights are on the way.</p>
            <div class="blog-coming-soon-pill">
              <span class="blog-coming-soon-dot"></span>
              <span>Launching 2026</span>
            </div>
          </div>
        )}

</Layout>

<style>
  .blog-surface {
    position: relative;
    overflow: hidden;
  }

  .blog-surface::before {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(99, 102, 241, 0.18), transparent 55%),
      radial-gradient(ellipse 60% 40% at 100% 0%, rgba(16, 185, 129, 0.06), transparent 45%);
  }

  .blog-page {
    position: relative;
    padding: 3rem 1.5rem 5rem;
  }

  .blog-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0.25rem;
  }

  .blog-hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .blog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-secondary);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    margin-bottom: 1.25rem;
  }

  .blog-hero-pill-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .blog-title {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .blog-title-gradient {
    background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 45%, #94a3b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .blog-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 32rem;
    margin: 0 auto;
  }

  .blog-coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 1.5rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .blog-coming-soon-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 20px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: var(--color-primary);
    margin-bottom: 1.75rem;
  }

  .blog-coming-soon-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .blog-coming-soon-text {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .blog-coming-soon-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary);
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .blog-coming-soon-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 768px) {
    .blog-coming-soon {
      padding: 3rem 1rem;
    }
  }
</style>
