---
import Layout from '../../layouts/Layout.astro';
import { BLOG_API_ORIGIN } from '../../config';

let posts: Array<{
  id: string;
  title: string;
  slug: string;
  description: string;
  publishedAt: string | null;
  author: { name: string; slug: string } | null;
  category: { title: string; slug: string } | null;
  tags?: string[];
}> = [];
let categories: Array<{
  id: string;
  title: string;
  slug: string;
  description: string | null;
  order: number | null;
}> = [];
let error: string | null = null;

try {
  const [postsRes, catsRes] = await Promise.all([
    fetch(`${BLOG_API_ORIGIN}/api/v1/blog/posts?limit=50`),
    fetch(`${BLOG_API_ORIGIN}/api/v1/blog/categories`),
  ]);
  if (postsRes.ok) {
    const json = await postsRes.json();
    posts = json.data || [];
  } else {
    error = `Blog API returned ${postsRes.status}`;
  }
  if (catsRes.ok) {
    categories = await catsRes.json();
    if (!Array.isArray(categories)) categories = [];
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load posts';
}

const countByCategorySlug = posts.reduce<Record<string, number>>((acc, p) => {
  const s = p.category?.slug;
  if (s) acc[s] = (acc[s] || 0) + 1;
  return acc;
}, {});
---

<Layout
  title="Blog - FunctionFly"
  description="FunctionFly blog: tutorials, product updates, and edge computing insights."
>
  <div class="blog-surface">
    <section class="blog-page">
      <div class="blog-inner">
        <header class="blog-hero">
          <div class="blog-hero-pill">
            <svg class="blog-hero-pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            <span>Insights &amp; updates</span>
          </div>
          <h1 class="blog-title">
            <span class="blog-title-gradient">Blog</span>
          </h1>
          <p class="blog-subtitle">Tutorials, product updates, and edge computing insights.</p>
        </header>

        {error && (
          <div class="blog-panel blog-panel--error" role="alert">
            <p class="blog-panel-title">Couldn’t load posts</p>
            <p class="blog-panel-text">{error}</p>
            <p class="blog-panel-hint">
              Set <code>PUBLIC_BLOG_API_URL</code> in <code>web/site/.env</code> and run the Nest blog API
              (<code>cmd/blog-api</code>), then rebuild or refresh.
            </p>
          </div>
        )}

        {!error && posts.length === 0 && (
          <div class="blog-panel blog-panel--empty">
            <div class="blog-empty-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            </div>
            <p class="blog-empty-title">No posts yet</p>
            <p class="blog-empty-text">Check back soon for tutorials and product news.</p>
          </div>
        )}

        {!error && posts.length > 0 && (
          <div class="blog-layout">
            <aside class="blog-sidebar" aria-label="Categories">
              <h2 class="blog-sidebar-title">Categories</h2>
              <nav class="blog-sidebar-nav">
                <a href="/blog" class="blog-sidebar-link" data-cat-filter="all">
                  All posts
                  <span class="blog-sidebar-count">{posts.length}</span>
                </a>
                {categories.length > 0
                  ? categories.map((cat) => (
                      <a
                        href={`/blog?category=${encodeURIComponent(cat.slug)}`}
                        class="blog-sidebar-link"
                        data-cat-filter={cat.slug}
                      >
                        {cat.title}
                        <span class="blog-sidebar-count">{countByCategorySlug[cat.slug] ?? 0}</span>
                      </a>
                    ))
                  : Object.entries(countByCategorySlug)
                      .sort((a, b) => a[0].localeCompare(b[0]))
                      .map(([slug, count]) => {
                        const label =
                          posts.find((p) => p.category?.slug === slug)?.category?.title || slug;
                        return (
                          <a
                            href={`/blog?category=${encodeURIComponent(slug)}`}
                            class="blog-sidebar-link"
                            data-cat-filter={slug}
                          >
                            {label}
                            <span class="blog-sidebar-count">{count}</span>
                          </a>
                        );
                      })}
              </nav>
            </aside>
            <div class="blog-main">
              <p class="blog-filter-hint" id="blog-filter-hint" hidden></p>
              <ul class="post-grid" id="blog-post-list">
                {posts.map((post) => (
                  <li data-category-slug={post.category?.slug ?? ''}>
                    <a href={`/blog/${post.slug}`} class="post-card">
                      <div class="post-card-inner">
                        <h2 class="post-card-title">{post.title}</h2>
                        <p class="post-card-desc">{post.description || ''}</p>
                        <div class="post-card-meta">
                          {post.publishedAt && (
                            <time datetime={post.publishedAt}>
                              {new Date(post.publishedAt).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                              })}
                            </time>
                          )}
                          {post.author?.name && <span class="post-card-author">{post.author.name}</span>}
                          {post.category?.title && (
                            <span class="post-card-cat">{post.category.title}</span>
                          )}
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </div>
    </section>
  </div>

  <script is:inline>
    function applyBlogCategoryFilter() {
      var params = new URLSearchParams(window.location.search);
      var cat = params.get('category');
      var list = document.getElementById('blog-post-list');
      var hint = document.getElementById('blog-filter-hint');
      if (!list) return;

      var items = list.querySelectorAll('li[data-category-slug]');
      var visible = 0;
      items.forEach(function (li) {
        var slug = li.getAttribute('data-category-slug') || '';
        var show = !cat || slug === cat;
        if (!show) li.setAttribute('hidden', '');
        else {
          li.removeAttribute('hidden');
          visible++;
        }
      });

      document.querySelectorAll('[data-cat-filter]').forEach(function (el) {
        var filter = el.getAttribute('data-cat-filter');
        var active = filter === 'all' ? !cat : filter === cat;
        el.classList.toggle('blog-sidebar-link--active', active);
        if (active) el.setAttribute('aria-current', 'page');
        else el.removeAttribute('aria-current');
      });

      if (hint) {
        if (cat && visible === 0) {
          hint.textContent = 'No posts in this category.';
          hint.hidden = false;
        } else {
          hint.textContent = '';
          hint.hidden = true;
        }
      }
    }

    function initBlogCategoryFilter() {
      applyBlogCategoryFilter();
      window.addEventListener('popstate', applyBlogCategoryFilter);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogCategoryFilter);
    } else {
      initBlogCategoryFilter();
    }
  </script>
</Layout>

<style>
  .blog-surface {
    position: relative;
    overflow: hidden;
  }

  .blog-surface::before {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(99, 102, 241, 0.18), transparent 55%),
      radial-gradient(ellipse 60% 40% at 100% 0%, rgba(16, 185, 129, 0.06), transparent 45%);
  }

  .blog-page {
    position: relative;
    padding: 3rem 1.5rem 5rem;
  }

  .blog-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0.25rem;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: minmax(200px, 240px) 1fr;
    gap: 2rem 2.5rem;
    align-items: start;
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  .blog-sidebar {
    position: sticky;
    top: 5.5rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: rgba(30, 41, 59, 0.45);
    padding: 1.25rem 1.1rem;
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.35);
  }

  @media (max-width: 768px) {
    .blog-sidebar {
      position: static;
    }
  }

  .blog-sidebar-title {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.85rem;
    padding: 0 0.35rem;
  }

  .blog-sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .blog-sidebar-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.65rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .blog-sidebar-link:hover {
    background: rgba(99, 102, 241, 0.12);
    color: var(--color-text);
  }

  .blog-sidebar-link--active {
    background: rgba(16, 185, 129, 0.12);
    color: var(--color-secondary);
    border: 1px solid rgba(16, 185, 129, 0.22);
  }

  .blog-sidebar-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    opacity: 0.85;
    min-width: 1.5rem;
    text-align: right;
  }

  .blog-sidebar-link--active .blog-sidebar-count {
    color: var(--color-secondary);
    opacity: 1;
  }

  .blog-main {
    min-width: 0;
  }

  .blog-filter-hint {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    border: 1px dashed rgba(239, 68, 68, 0.35);
    background: rgba(239, 68, 68, 0.06);
  }

  .blog-hero {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .blog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-secondary);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    margin-bottom: 1.25rem;
  }

  .blog-hero-pill-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .blog-title {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .blog-title-gradient {
    background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 45%, #94a3b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .blog-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 32rem;
    margin: 0 auto 2.5rem;
  }

  .blog-panel {
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .blog-panel--error {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .blog-panel--empty {
    background: rgba(30, 41, 59, 0.5);
    border: 1px dashed var(--color-border);
  }

  .blog-panel-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .blog-panel-text {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: 0.75rem;
  }

  .blog-panel-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 28rem;
    margin: 0 auto;
  }

  .blog-panel-hint code {
    font-family: var(--font-mono);
    font-size: 0.75em;
    padding: 0.1em 0.35em;
    background: var(--color-bg);
    border-radius: 4px;
    color: var(--color-text);
  }

  .blog-empty-icon {
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
  }

  .blog-empty-title {
    font-weight: 600;
    font-size: 1.125rem;
    margin-bottom: 0.35rem;
    color: var(--color-text);
  }

  .blog-empty-text {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .post-grid {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: rgba(30, 41, 59, 0.5);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .post-card:hover {
    border-color: rgba(99, 102, 241, 0.45);
    box-shadow: 0 8px 32px rgba(15, 23, 42, 0.6);
    transform: translateY(-2px);
  }

  .post-card-inner {
    padding: 1.5rem 1.5rem 1.35rem;
  }

  .post-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .post-card-desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .post-card-author::before,
  .post-card-cat::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--color-border);
  }

  .post-card-cat {
    color: var(--color-secondary);
    font-weight: 500;
  }
</style>
