---
import Layout from '../../layouts/Layout.astro';

const BLOG_API = import.meta.env.PUBLIC_BLOG_API_URL || 'http://localhost:3000';

let posts: Array<{
  id: string;
  title: string;
  slug: string;
  description: string;
  publishedAt: string | null;
  author: { name: string; slug: string } | null;
  category: { title: string; slug: string } | null;
  tags?: string[];
}> = [];
let error: string | null = null;

try {
  const res = await fetch(`${BLOG_API}/api/v1/blog/posts?limit=50`);
  if (res.ok) {
    const json = await res.json();
    posts = json.data || [];
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load posts';
}
---

<Layout
  title="Blog - FunctionFly"
  description="FunctionFly blog: tutorials, product updates, and edge computing insights."
>
  <section class="blog-page">
    <div class="container">
      <header class="blog-header">
        <h1>Blog</h1>
        <p class="blog-subtitle">Tutorials, product updates, and edge computing insights.</p>
      </header>

      {error && (
        <p class="blog-error">Unable to load posts. Make sure the blog API is running.</p>
      )}

      {!error && posts.length === 0 && (
        <p class="blog-empty">No posts yet. Check back soon.</p>
      )}

      {!error && posts.length > 0 && (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-card">
              <a href={`/blog/${post.slug}`} class="post-link">
                <h2 class="post-title">{post.title}</h2>
                <p class="post-description">{post.description || ''}</p>
                <div class="post-meta">
                  {post.publishedAt && (
                    <time datetime={post.publishedAt}>
                      {new Date(post.publishedAt).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                  {post.author?.name && <span class="post-author">{post.author.name}</span>}
                  {post.category?.title && (
                    <span class="post-category">{post.category.title}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-page {
    padding: 4rem 2rem 6rem;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .blog-header {
    margin-bottom: 3rem;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .blog-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .blog-error,
  .blog-empty {
    color: var(--color-text-muted);
    text-align: center;
    padding: 3rem;
  }

  .post-list {
    list-style: none;
  }

  .post-card {
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .post-card:first-child {
    padding-top: 0;
  }

  .post-link {
    display: block;
    color: inherit;
    transition: opacity 0.2s;
  }

  .post-link:hover {
    opacity: 0.9;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .post-description {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .post-author::before {
    content: '·';
    margin-right: 1rem;
  }

  .post-category::before {
    content: '·';
    margin-right: 1rem;
  }
</style>
