---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/blog-api';

const title = "Blog - FunctionFly | Serverless Reliability Insights";
const description = "Stay updated with the latest in serverless reliability, multi-cloud architectures, and best practices from the FunctionFly team.";

// Fetch blog posts from NestJS API
const blogPostsResponse = await getBlogPosts({ limit: 50 });
const blogPosts = blogPostsResponse.data;
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-text-primary mb-6">
            FunctionFly
            <span class="text-accent-primary block">Blog</span>
          </h1>
          <p class="text-xl md:text-2xl text-text-secondary mb-8 max-w-3xl mx-auto">
            Insights, best practices, and deep dives into serverless reliability and multi-cloud architectures.
          </p>
        </div>
      </div>
    </section>

    <!-- Blog Posts -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <article class="bg-bg-secondary rounded-xl p-6 border border-text-secondary/20 hover:border-accent-primary transition-colors">
              <div class="mb-4">
                <span class="bg-accent-primary/10 text-accent-primary px-3 py-1 rounded-full text-sm font-medium">
                  {post.category?.title || 'Uncategorized'}
                </span>
              </div>

              <h2 class="text-xl font-bold text-text-primary mb-3 hover:text-accent-primary transition-colors">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>

              <p class="text-text-secondary mb-4">{post.description}</p>

              <div class="flex items-center justify-between text-sm text-text-secondary">
                <span>By {post.author?.name || 'Anonymous'}</span>
                <span>{post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : 'Not published'}</span>
              </div>

              <div class="flex gap-2 mt-4">
                {post.tags?.slice(0, 3).map((tag) => (
                  <span class="bg-bg-primary text-text-secondary px-2 py-1 rounded text-xs">
                    #{tag}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Newsletter Signup -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-text-primary mb-4">Stay Updated</h2>
        <p class="text-xl text-text-secondary mb-8">
          Get the latest insights on serverless reliability delivered to your inbox.
        </p>

        <form class="max-w-md mx-auto">
          <div class="flex gap-4">
            <input
              type="email"
              placeholder="Enter your email"
              class="flex-1 px-4 py-3 bg-bg-primary border border-text-secondary/20 rounded-lg text-text-primary placeholder-text-secondary focus:outline-none focus:border-accent-primary"
              required
            />
            <button
              type="submit"
              class="bg-accent-primary hover:bg-accent-primary/90 text-white px-6 py-3 rounded-lg font-semibold transition-colors"
            >
              Subscribe
            </button>
          </div>
        </form>

        <p class="text-sm text-text-secondary mt-4">
          No spam, unsubscribe anytime. We respect your privacy.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>