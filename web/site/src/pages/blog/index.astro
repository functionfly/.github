---
import Layout from '../../layouts/Layout.astro';

// Blog lives in the dashboard app; redirect there.
const appBlogUrl = import.meta.env.DEV
  ? 'http://localhost:3000/blog'
  : 'https://app.functionfly.com/blog';
---

<Layout title="Blog - FunctionFly" description="FunctionFly blog: tutorials, product updates, and edge computing insights.">
  <section class="blog-redirect">
    <div class="blog-redirect-content">
      <h1>Blog</h1>
      <p>Our blog lives in the FunctionFly dashboard. Redirecting you now…</p>
      <a href={appBlogUrl} class="btn btn-primary">Go to Blog</a>
    </div>
  </section>
  <script is:inline define:vars={{ appBlogUrl }}>
    window.location.replace(appBlogUrl);
  </script>
</Layout>

<style>
  .blog-redirect {
    padding: 8rem 2rem 6rem;
    text-align: center;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-redirect-content {
    max-width: 480px;
  }

  .blog-redirect h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .blog-redirect p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    background: var(--color-primary);
    color: white;
    transition: background 0.2s;
  }

  .btn:hover {
    background: var(--color-primary-dark);
  }
</style>
