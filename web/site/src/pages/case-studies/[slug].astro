---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { sanityClient, queries, urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const caseStudies = await sanityClient.fetch(queries.caseStudies);
  return caseStudies.map((study) => ({
    params: { slug: study.slug.current },
    props: { study },
  }));
}

const { study } = Astro.props;

const title = study.title;
const description = study.description;

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": study.title,
  "description": study.description,
  "author": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "datePublished": study.publishedAt,
  "dateModified": study.updatedAt || study.publishedAt,
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="mb-6">
              <span class="bg-accent-primary/10 text-accent-primary px-4 py-2 rounded-full text-sm font-medium">
                Case Study
              </span>
            </div>

            <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-6">
              {study.title}
            </h1>

            <div class="flex items-center gap-4 mb-6">
              {study.logo && (
                <img
                  src={urlFor(study.logo).width(80).height(80).fit('crop').url()}
                  alt={`${study.company} logo`}
                  class="w-20 h-20 object-contain rounded"
                />
              )}
              <div>
                <h2 class="text-2xl font-bold text-accent-primary">{study.company}</h2>
                {study.industry && (
                  <p class="text-text-secondary">{study.industry}</p>
                )}
              </div>
            </div>

            <p class="text-xl text-text-secondary mb-8">
              {study.description}
            </p>

            <div class="text-sm text-text-secondary">
              Published: {new Date(study.publishedAt).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </div>
          </div>

          {study.heroImage && (
            <div>
              <img
                src={urlFor(study.heroImage).width(600).height(400).fit('crop').url()}
                alt={study.heroImage.alt || study.title}
                class="w-full h-80 object-cover rounded-xl"
              />
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Challenge & Solution Overview -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-3xl font-bold text-text-primary mb-6">The Challenge</h2>
            <p class="text-lg text-text-secondary leading-relaxed">
              {study.challenge}
            </p>
          </div>

          <div>
            <h2 class="text-3xl font-bold text-text-primary mb-6">Our Solution</h2>
            <p class="text-lg text-text-secondary leading-relaxed">
              {study.solution}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Results -->
    {study.results && study.results.length > 0 && (
      <section class="py-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-4xl font-bold text-text-primary mb-12 text-center">The Results</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            {study.results.map((result) => (
              <div class="text-center">
                <div class="text-4xl font-bold text-accent-primary mb-2">{result.value}</div>
                <div class="text-lg font-medium text-text-primary mb-2">{result.metric}</div>
                {result.description && (
                  <p class="text-text-secondary">{result.description}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Full Case Study -->
    <article class="py-24 bg-bg-secondary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg prose-invert max-w-none">
          <PortableText value={study.body} />
        </div>
      </div>
    </article>

    <!-- CTA Section -->
    <section class="py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-text-primary mb-4">Ready to Achieve Similar Results?</h2>
        <p class="text-xl text-text-secondary mb-8">
          Join {study.company} and thousands of other organizations using FunctionFly for serverless reliability.
        </p>

        <div class="flex gap-4 justify-center">
          <a
            href="/pricing"
            class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-3 rounded-lg font-semibold transition-colors"
          >
            Start Free Trial
          </a>
          <a
            href="/docs/getting-started"
            class="bg-bg-secondary hover:bg-bg-primary text-text-primary px-8 py-3 rounded-lg font-semibold border border-text-secondary/20 transition-colors"
          >
            View Documentation
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Add any client-side functionality here
</script>