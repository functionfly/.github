---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Team - FunctionFly | Serverless Reliability Experts";
const description = "Meet the FunctionFly team - engineers who built systems that handle billions of requests daily. Former AWS, Netflix, and Stripe engineers united by a mission to eliminate serverless downtime.";

const teamMembers = [
  {
    name: "Alex Chen",
    role: "Founder & CEO",
    bio: "Former AWS engineer who witnessed too many serverless failures. Built FunctionFly after losing $50K in a single outage.",
    image: "/api/placeholder/200/200",
    values: ["Reliability First", "Developer Experience", "Transparency"],
    expertise: "Distributed Systems"
  },
  {
    name: "Sarah Rodriguez",
    role: "CTO",
    bio: "Ex-Netflix SRE specializing in chaos engineering. Joined after experiencing the Great Netflix Outage of 2021.",
    image: "/api/placeholder/200/200",
    values: ["Resilience", "Innovation", "Quality"],
    expertise: "Site Reliability Engineering"
  },
  {
    name: "Marcus Johnson",
    role: "Head of Product",
    bio: "Product leader from Stripe and Twilio. Saw developers struggle with serverless complexity and wanted to fix it.",
    image: "/api/placeholder/200/200",
    values: ["User-Centric", "Simplicity", "Empowerment"],
    expertise: "Product Strategy"
  },
  {
    name: "Dr. Emily Zhang",
    role: "VP of Engineering",
    bio: "PhD in Computer Science from MIT. Specializes in fault-tolerant distributed systems and loves making complex things simple.",
    image: "/api/placeholder/200/200",
    values: ["Excellence", "Learning", "Collaboration"],
    expertise: "Systems Architecture"
  }
];

const companyValues = [
  {
    title: "Reliability Above All",
    description: "We believe uptime isn't a feature—it's a fundamental right. Every decision we make prioritizes system stability."
  },
  {
    title: "Developer-First Mindset",
    description: "We build tools we'd want to use ourselves. No compromises on developer experience or productivity."
  },
  {
    title: "Transparency & Trust",
    description: "Open about our architecture, pricing, and roadmap. No hidden fees, no vendor lock-in, no surprises."
  },
  {
    title: "Continuous Learning",
    description: "Serverless is evolving rapidly. We stay ahead of the curve through research, testing, and community engagement."
  }
];
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-text-primary mb-6">
            Meet the Team Behind
            <span class="text-accent-primary block">FunctionFly</span>
          </h1>
          <p class="text-xl md:text-2xl text-text-secondary mb-8 max-w-3xl mx-auto">
            Engineers who built systems handling billions of requests. United by the scars of serverless failures and the dream of perfect reliability.
          </p>
        </div>
      </div>
    </section>

    <!-- Team Members -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          {teamMembers.map((member) => (
            <div class="bg-bg-secondary rounded-xl p-8 border border-text-secondary/20">
              <div class="flex items-start gap-6">
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-20 h-20 rounded-full object-cover flex-shrink-0"
                />
                <div class="flex-1">
                  <h3 class="text-2xl font-bold text-text-primary mb-1">{member.name}</h3>
                  <p class="text-accent-primary font-semibold mb-4">{member.role}</p>
                  <p class="text-text-secondary mb-4">{member.bio}</p>

                  <div class="mb-4">
                    <h4 class="font-semibold text-text-primary mb-2">Values:</h4>
                    <div class="flex flex-wrap gap-2">
                      {member.values.map((value) => (
                        <span class="bg-accent-primary/10 text-accent-primary px-3 py-1 rounded-full text-sm">
                          {value}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div>
                    <h4 class="font-semibold text-text-primary mb-2">Expertise:</h4>
                    <p class="text-text-secondary">{member.expertise}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Company Values -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-text-primary mb-4">Our Values</h2>
          <p class="text-xl text-text-secondary max-w-2xl mx-auto">
            The principles that guide every decision we make and every line of code we write.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {companyValues.map((value) => (
            <div class="bg-bg-primary rounded-xl p-8 border border-text-secondary/20">
              <h3 class="text-xl font-bold text-text-primary mb-3">{value.title}</h3>
              <p class="text-text-secondary">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Join Us CTA -->
    <section class="py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-bold text-text-primary mb-4">Join Our Mission</h2>
        <p class="text-xl text-text-secondary mb-8">
          We're always looking for exceptional engineers who share our passion for reliability and developer experience.
        </p>
        <a
          href="mailto:careers@functionfly.com"
          class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors inline-block"
        >
          careers@functionfly.com
        </a>
      </div>
    </section>
  </main>
</BaseLayout>