---
import Layout from '../../layouts/Layout.astro';
import '../../styles/sc-main.css';
import { APP_DASHBOARD_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN } from '../../config';

const activeTab = Astro.url.searchParams.get('tab') || 'agents';
---

<Layout
  title="Pricing Details — FunctionFly"
  description="Detailed pricing for platform plans, agent execution tiers, and Backend-in-a-Box bundles."
>
  <section class="details-hero">
    <div class="container">
      <div class="badge">Detailed pricing</div>
      <h1>Everything in one place</h1>
      <p class="lead">
        Full details on platform plans, agent execution, and Backend-in-a-Box bundles.
        <a href="/pricing">← Back to simplified pricing</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="details-tabs">
        <button
          class={`details-tab ${activeTab === 'agents' ? 'active' : ''}`}
          data-tab="agents"
        >
          🤖 Agent execution
        </button>
        <button
          class={`details-tab ${activeTab === 'bundles' ? 'active' : ''}`}
          data-tab="bundles"
        >
          📦 Bundles
        </button>
      </div>

      <div class="details-panels">
        {/* Agent Execution Panel */}
        <div class={`details-panel ${activeTab === 'agents' ? 'active' : ''}`} id="panel-agents">
          <div class="section-head">
            <h2>Agent execution</h2>
            <p class="muted">
              Run tool calls, state, and memory for AI agents on dedicated infrastructure. AI agent capabilities are bundled into all platform plans.
            </p>
          </div>

          <div class="agent-table-wrap">
            <table class="agent-table">
              <thead>
                <tr>
                  <th scope="col">Plan</th>
                  <th scope="col">Price</th>
                  <th scope="col">AI Calls / Month</th>
                  <th scope="col">Agents</th>
                  <th scope="col">Concurrency</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Free</strong></td>
                  <td class="agent-price-cell"><span class="price-amount">$0</span></td>
                  <td class="muted-cell">10K (hard stop)</td>
                  <td class="muted-cell">3</td>
                  <td class="muted-cell">10 req/min</td>
                </tr>
                <tr>
                  <td><strong>Starter</strong></td>
                  <td class="agent-price-cell"><span class="price-amount">$24/mo</span></td>
                  <td class="muted-cell">100K + $0.15/1K overage</td>
                  <td class="muted-cell">10</td>
                  <td class="muted-cell">100 req/min</td>
                </tr>
                <tr>
                  <td><strong>Professional</strong></td>
                  <td class="agent-price-cell"><span class="price-amount">$79/mo</span></td>
                  <td class="muted-cell">1M + $0.08/1K overage</td>
                  <td class="muted-cell">100</td>
                  <td class="muted-cell">500 req/min</td>
                </tr>
                <tr>
                  <td><strong>Enterprise</strong></td>
                  <td class="agent-price-cell"><span class="price-amount">$299/mo</span></td>
                  <td class="muted-cell">5M + $0.05/1K overage</td>
                  <td class="muted-cell">500</td>
                  <td class="muted-cell">2,000 req/min</td>
                </tr>
                <tr>
                  <td><strong>Agent Enterprise</strong></td>
                  <td class="agent-price-cell"><span class="price-amount">$499/mo</span></td>
                  <td class="muted-cell">Unlimited</td>
                  <td class="muted-cell">Unlimited</td>
                  <td class="muted-cell">Unlimited</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="agent-table-wrap" style="margin-top: 2rem;">
            <h3 style="margin-bottom: 1rem;">State Fabric (included in all plans)</h3>
            <table class="agent-table">
              <thead>
                <tr>
                  <th scope="col">Plan</th>
                  <th scope="col">State Objects</th>
                  <th scope="col">Hot Cache</th>
                  <th scope="col">Multi-Region</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Free</strong></td>
                  <td>1 (Sandbox)</td>
                  <td>—</td>
                  <td>—</td>
                </tr>
                <tr>
                  <td><strong>Starter</strong></td>
                  <td>3</td>
                  <td>Add-on</td>
                  <td>Add-on</td>
                </tr>
                <tr>
                  <td><strong>Professional</strong></td>
                  <td>10</td>
                  <td>Add-on</td>
                  <td>Add-on</td>
                </tr>
                <tr>
                  <td><strong>Enterprise</strong></td>
                  <td>Unlimited</td>
                  <td>Add-on</td>
                  <td>Add-on</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="statefabric-addons" style="margin-top: 2rem;">
            <h3 class="statefabric-addons-title">State Fabric Add-ons</h3>
            <p class="muted statefabric-addons-sub">
              Enhance your State Fabric with premium capabilities. Available on Starter and above.
            </p>

            <div class="addon-grid">
              <article class="addon-card">
                <div class="addon-top">
                  <h4>Hot Cache Booster</h4>
                  <div class="addon-price">
                    $49 <span>/mo per 5GB</span>
                  </div>
                </div>
                <p class="addon-desc">Reduces replay and read costs.</p>
              </article>

              <article class="addon-card">
                <div class="addon-top">
                  <h4>Multi-Region Replication</h4>
                  <div class="addon-price">
                    $99 <span>/mo</span>
                  </div>
                </div>
                <p class="addon-desc">Active-active replication across regions for HA and global latency.</p>
              </article>

              <article class="addon-card">
                <div class="addon-top">
                  <h4>AI Memory Pack</h4>
                  <div class="addon-price">
                    $149 <span>/mo</span>
                  </div>
                </div>
                <p class="addon-desc">Vector index, embeddings storage, fast read engine.</p>
              </article>

              <article class="addon-card">
                <div class="addon-top">
                  <h4>Advanced Insights</h4>
                  <div class="addon-price">
                    $79 <span>/mo</span>
                  </div>
                </div>
                <p class="addon-desc">Cost forecasting, anomaly detection, hot path alerts.</p>
              </article>

              <article class="addon-card">
                <div class="addon-top">
                  <h4>Advanced Security Pack</h4>
                  <div class="addon-price">
                    $99 <span>/mo</span>
                  </div>
                </div>
                <p class="addon-desc">SOC2-friendly logs, key rotation, audit streams.</p>
              </article>
            </div>

            <p class="statefabric-note">
              Add-ons are available on all paid plans (Starter and above). Prices can change—confirm current rates in your billing page.
            </p>
          </div>

          <div class="agent-cta" style="margin-top: 2rem;">
            <a class="btn btn-primary" href={`${AUTH_ORIGIN}/signup`}>Get started</a>
            <a class="btn btn-secondary" href="/for-agents">For AI agents</a>
          </div>
        </div>

        {/* Bundles Panel */}
        <div class={`details-panel ${activeTab === 'bundles' ? 'active' : ''}`} id="panel-bundles">
          <div class="section-head">
            <h2>Backend-in-a-Box</h2>
            <p class="muted">
              Skip the decision fatigue. Get pre-configured bundles with Auth, Payments, User DB, and more.
              <strong>Start free</strong> until you hit 100 users or $1K MRR.
            </p>
          </div>

          <div class="bundles-grid">
            <div class="bundle-item">
              <span class="bundle-icon">🚀</span>
              <strong>SaaS Starter</strong> — $29/mo
              <span class="bundle-features">Auth · Payments · User DB · Email · Analytics</span>
              <ul class="feature-list" style="margin-top: 1rem;">
                <li><span class="check" aria-hidden="true">✓</span> Pre-configured auth (OAuth, magic links)</li>
                <li><span class="check" aria-hidden="true">✓</span> Stripe payments &amp; subscription management</li>
                <li><span class="check" aria-hidden="true">✓</span> User DB with role-based access</li>
                <li><span class="check" aria-hidden="true">✓</span> Transactional email via SendGrid</li>
                <li><span class="check" aria-hidden="true">✓</span> Usage analytics dashboard</li>
              </ul>
              <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing/bundles?plan=saas`} style="margin-top: 1rem;">Choose SaaS Starter</a>
            </div>

            <div class="bundle-item">
              <span class="bundle-icon">🛒</span>
              <strong>Marketplace</strong> — $49/mo
              <span class="bundle-features">Listings · Payments · Messaging · Notifications</span>
              <ul class="feature-list" style="margin-top: 1rem;">
                <li><span class="check" aria-hidden="true">✓</span> Product listings &amp; search</li>
                <li><span class="check" aria-hidden="true">✓</span> Stripe Connect for multi-vendor payments</li>
                <li><span class="check" aria-hidden="true">✓</span> Real-time messaging between buyers/sellers</li>
                <li><span class="check" aria-hidden="true">✓</span> Push &amp; email notifications</li>
                <li><span class="check" aria-hidden="true">✓</span> Order management &amp; dispute resolution</li>
              </ul>
              <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing/bundles?plan=marketplace`} style="margin-top: 1rem;">Choose Marketplace</a>
            </div>

            <div class="bundle-item">
              <span class="bundle-icon">🤖</span>
              <strong>AI App</strong> — $39/mo
              <span class="bundle-features">Vector DB · Embeddings · Chat · Memory</span>
              <ul class="feature-list" style="margin-top: 1rem;">
                <li><span class="check" aria-hidden="true">✓</span> pgvector for semantic search</li>
                <li><span class="check" aria-hidden="true">✓</span> OpenAI &amp; Anthropic embeddings pipeline</li>
                <li><span class="check" aria-hidden="true">✓</span> Chat history &amp; conversation memory</li>
                <li><span class="check" aria-hidden="true">✓</span> RAG-ready document ingestion</li>
                <li><span class="check" aria-hidden="true">✓</span> Token usage analytics</li>
              </ul>
              <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing/bundles?plan=ai-app`} style="margin-top: 1rem;">Choose AI App</a>
            </div>
          </div>

          <div class="bundles-trust" style="margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
            <span class="pill">🎯 100 users free</span>
            <span class="pill">💰 $1K MRR free</span>
            <span class="pill">⏰ 3 months free</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Ready to ship trusted tools?</h2>
      <p class="muted">Create a workspace, connect providers, and see live limits.</p>
      <div class="actions">
        <a class="btn primary" href={`${AUTH_ORIGIN}/signup`}>Try now</a>
        <a class="btn secondary" href="/contact">Talk to sales</a>
      </div>
    </div>
  </section>

  <script>
    const tabs = document.querySelectorAll('.details-tab');
    const panels = document.querySelectorAll('.details-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;

        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        panels.forEach(panel => {
          panel.classList.remove('active');
          if (panel.id === `panel-${target}`) {
            panel.classList.add('active');
          }
        });

        const url = new URL(window.location.href);
        url.searchParams.set('tab', target);
        history.replaceState(null, '', url);
      });
    });
  </script>
</Layout>
