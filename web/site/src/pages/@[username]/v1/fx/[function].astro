---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return [];
}

const { username, function: functionName } = Astro.params;

// Fetch function data from API
let func = null;
let error = null;

try {
  const response = await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:8080'}/v1/@/${username}/v1/fx/${functionName}`);
  if (response.ok) {
    func = await response.json();
  } else if (response.status === 404) {
    error = 'Function not found';
  }
} catch (e) {
  console.error('Failed to fetch function:', e);
  error = 'Failed to load function';
}

const title = func ? `${func.name} by @${username} - FunctionFly` : `${functionName} - FunctionFly`;
const description = func?.description || `Function ${functionName} by @${username} on FunctionFly`;
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-gray-50">
    {error ? (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">Function Not Found</h1>
          <p class="text-lg text-gray-600 mb-8">The function {functionName} by @{username} does not exist.</p>
          <a href={`/@${username}`} class="text-indigo-600 hover:text-indigo-500">View @{username}'s profile</a>
        </div>
      </div>
    ) : (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        {/* Function Header */}
        <div class="bg-white rounded-lg shadow-sm p-8 mb-8">
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center space-x-3 mb-2">
                <a href={`/@${username}`} class="text-lg text-indigo-600 hover:text-indigo-500">
                  @{username}
                </a>
                <span class="text-gray-400">/</span>
                <h1 class="text-3xl font-bold text-gray-900">{functionName}</h1>
              </div>
              {func?.description && (
                <p class="text-gray-600 mt-2">{func.description}</p>
              )}
            </div>
            <div class="flex space-x-3">
              <a 
                href={`/run/${username}/${functionName}`}
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700"
              >
                Try it
              </a>
            </div>
          </div>

          {/* Stats */}
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-gray-200">
            <div>
              <div class="text-lg font-semibold text-gray-900">{func?.version || '1.0.0'}</div>
              <div class="text-sm text-gray-500">Version</div>
            </div>
            <div>
              <div class="text-lg font-semibold text-gray-900">{func?.totalCalls?.toLocaleString() || 0}</div>
              <div class="text-sm text-gray-500">Total Calls</div>
            </div>
            <div>
              <div class="text-lg font-semibold text-gray-900">{func?.successRate || 0}%</div>
              <div class="text-sm text-gray-500">Success Rate</div>
            </div>
            <div>
              <div class="text-lg font-semibold text-gray-900">{func?.avgLatency || 0}ms</div>
              <div class="text-sm text-gray-500">Avg Latency</div>
            </div>
          </div>
        </div>

        {/* Documentation */}
        <div class="bg-white rounded-lg shadow-sm p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Documentation</h2>
          
          {/* Input/Output Schema */}
          {func?.inputSchema && (
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-3">Input</h3>
              <pre class="bg-gray-50 p-4 rounded-lg overflow-x-auto text-sm">
{JSON.stringify(func.inputSchema, null, 2)}
              </pre>
            </div>
          )}

          {func?.outputSchema && (
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-3">Output</h3>
              <pre class="bg-gray-50 p-4 rounded-lg overflow-x-auto text-sm">
{JSON.stringify(func.outputSchema, null, 2)}
              </pre>
            </div>
          )}

          {/* Usage Examples */}
          {func?.examples && (
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-3">Examples</h3>
              <div class="space-y-4">
                {func.examples.map((example: any) => (
                  <div class="border border-gray-200 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-2">Input:</div>
                    <pre class="bg-gray-50 p-3 rounded text-sm mb-3">
{example.input}
                    </pre>
                    <div class="text-sm text-gray-500 mb-2">Output:</div>
                    <pre class="bg-gray-50 p-3 rounded text-sm">
{example.output}
                    </pre>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Code Examples */}
        <div class="bg-white rounded-lg shadow-sm p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Usage</h2>
          
          <div class="space-y-6">
            {/* cURL */}
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-3">cURL</h3>
              <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm">
curl -X POST https://functionfly.com/fx/{username}/{functionName} \
  -H "Content-Type: application/json" \
  -d '{ "input": "your input" }'
              </pre>
            </div>

            {/* JavaScript */}
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-3">JavaScript</h3>
              <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm">
const response = await fetch('https://functionfly.com/fx/{username}/{functionName}', {{
  method: 'POST',
  headers: {{ 'Content-Type': 'application/json' }},
  body: JSON.stringify({{ input: 'your input' }})
}});
const result = await response.json();
              </pre>
            </div>

            {/* Python */}
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-3">Python</h3>
              <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm">
import requests

response = requests.post(
    'https://functionfly.com/fx/{username}/{functionName}',
    json={{'input': 'your input'}}
)
result = response.json()
              </pre>
            </div>
          </div>
        </div>

        {/* SEO Structured Data */}
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": functionName,
          "description": func?.description,
          "url": `https://functionfly.com/@${username}/v1/fx/${functionName}`,
          "author": {
            "@type": "Person",
            "name": username,
            "url": `https://functionfly.com/@${username}`
          },
          "applicationCategory": "DeveloperApplication",
          "programmingLanguage": func?.language || "JavaScript"
        })} />
      </div>
    )}
  </main>
</BaseLayout>
