---
import Layout from '../layouts/Layout.astro';
import PlansPage from '../components/PlansPage';
import { SITE_ORIGIN } from '../config';

const plansSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FunctionFly Plans',
  description: 'Simple, transparent pricing for FunctionFly. Start free, pay as you grow with trust infrastructure for AI agents.',
  url: SITE_ORIGIN,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do function requests work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Each function call counts as one request, regardless of execution time. Failed calls due to trust policy enforcement also count toward your limit.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I upgrade or downgrade anytime?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. You can change your plan at any time. Upgrades take effect immediately, and you will be charged a prorated amount. Downgrades take effect at your next billing cycle.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens if I exceed my request limit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We will notify you when you reach 80% of your limit. If you exceed it, functions will return a rate limit error until you upgrade or the cycle resets.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a free trial for paid plans?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, Pro and Team plans come with a 14-day free trial. No credit card required to start. Enterprise does not have a public trial, but you can request a custom demo.',
      },
    },
  ],
};
---

<Layout
  title="Plans — FunctionFly"
  description="Simple, transparent pricing for FunctionFly. Start free, pay as you grow with trust infrastructure for AI agents."
  schema={[plansSchema, faqSchema]}
  ogImage="/og-plans.svg"
>
  <PlansPage client:load />
</Layout>