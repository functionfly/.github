---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import ForAgentsPage from '../components/ForAgentsPage.tsx';

const title = 'For AI Agents — FunctionFly';
const description = 'Discover verified tools with manifests and schemas, enforce trust with the Trust API, and scale agent workloads with execution plans and State Fabric—built for policies that need real signals.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <ForAgentsPage client:load />
</Layout>
