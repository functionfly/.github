---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import TrustPage from '../components/TrustPage.tsx';

const title = 'Trust Layer for AI Agents — FunctionFly';
const description = 'Verification levels, signed attestations, revocation, and the Trust API: the trust infrastructure AI agents need to select safe tools.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <TrustPage client:load />
</Layout>
