---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "FunctionFly - Serverless Failover & Reliability Platform";
const description = "Eliminate serverless downtime with intelligent multi-cloud failover. FunctionFly automatically routes traffic to healthy functions across AWS Lambda, Cloudflare Workers, and Vercel.";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "FunctionFly",
      "url": "https://functionfly.com",
      "logo": "https://functionfly.com/logo.png",
      "description": "Serverless reliability platform with multi-cloud failover for AWS Lambda, Cloudflare Workers, and Vercel Functions.",
      "foundingDate": "2024",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "hello@functionfly.com",
        "contactType": "customer service"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": "FunctionFly",
      "description": "Multi-cloud serverless failover and reliability platform",
      "url": "https://functionfly.com",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "99",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "99",
          "priceCurrency": "USD",
          "referenceQuantity": {
            "@type": "QuantitativeValue",
            "value": "1",
            "unitText": "MON"
          }
        }
      },
      "featureList": [
        "Multi-cloud failover",
        "Automatic traffic routing",
        "Real-time monitoring",
        "99.9% uptime SLA"
      ]
    },
    {
      "@type": "WebSite",
      "name": "FunctionFly",
      "url": "https://functionfly.com",
      "description": "Serverless reliability platform with multi-cloud failover",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://functionfly.com/docs/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <div class="text-center">
          <h1 class="text-5xl md:text-7xl font-bold text-text-primary mb-6">
            Serverless
            <span class="text-accent-primary">Reliability</span>
            <br />
            Done Right
          </h1>
          <p class="text-xl md:text-2xl text-text-secondary mb-8 max-w-3xl mx-auto">
            {description}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/pricing" class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
              Start Free Trial
            </a>
            <a href="/docs" class="border border-text-secondary hover:border-accent-primary text-text-primary hover:text-accent-primary px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
              View Documentation
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Metrics -->
    <section class="py-16 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-accent-primary">99.9%</div>
            <div class="text-text-secondary">Uptime SLA</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-primary">50ms</div>
            <div class="text-text-secondary">Average Latency</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-primary">3</div>
            <div class="text-text-secondary">Cloud Providers</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-primary">24/7</div>
            <div class="text-text-secondary">Monitoring</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Preview -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-text-primary mb-4">Why Choose FunctionFly?</h2>
          <p class="text-xl text-text-secondary max-w-2xl mx-auto">
            Built by engineers who lost millions to serverless failures. Now you don't have to.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-accent-primary/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">Automatic Failover</h3>
            <p class="text-text-secondary">Instantly route traffic to healthy functions when failures occur, maintaining uptime.</p>
          </div>
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-accent-primary/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">Multi-Cloud Support</h3>
            <p class="text-text-secondary">Deploy across AWS Lambda, Cloudflare Workers, and Vercel with unified management.</p>
          </div>
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-accent-primary/10 rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">Real-Time Monitoring</h3>
            <p class="text-text-secondary">Comprehensive dashboards and alerts for performance and reliability metrics.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-bold text-text-primary mb-4">Ready to Never Worry About Downtime Again?</h2>
        <p class="text-xl text-text-secondary mb-8">
          Join hundreds of companies that trust FunctionFly with their critical serverless infrastructure.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/pricing" class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
            View Pricing
          </a>
          <a href="/contact" class="border border-text-secondary hover:border-accent-primary text-text-primary hover:text-accent-primary px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
            Contact Sales
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
