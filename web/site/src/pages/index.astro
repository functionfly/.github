---
import Layout from '../layouts/Layout.astro';
import { DOCS_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN } from '../config';
import '../styles/global.css';
import '../styles/sc-main.css';
import HomePage from '../components/HomePage.tsx';

const docsGuidesUrl = `${DOCS_ORIGIN.replace(/\/\$/, '')}/docs/`;

// Organization Schema for rich snippets
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  alternateName: 'FunctionFly LLC',
  url: SITE_ORIGIN,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_ORIGIN}/favicon.svg`,
    width: '512',
    height: '512',
  },
  sameAs: [
    'https://github.com/functionfly',
    'https://x.com/functionflycom',
    'https://linkedin.com/company/functionfly',
    'https://discord.gg/functionfly',
  ],
  description: 'Functions deployed. Agents trusted. Verified functions, trust scores, and zero-knowledge vault for AI agents.',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_ORIGIN}/registry?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FunctionFly',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (Cloud-based)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    priceValidUntil: '2028-12-31',
    availability: 'https://schema.org/InStock',
  },
  description: 'The platform for AI-accessible functions. Publish in any language, execute in sandboxes, route by trust.',
  url: SITE_ORIGIN,
  featureList: [
    'Multi-language function support (Python, Go, Rust, JavaScript, WebAssembly)',
    'Sandboxed execution with Firecracker MicroVMs',
    'Trust scoring and verification',
    'Agent swarm orchestration',
    'Policy engine for safe execution',
  ],
};

const homePageSchemas = [organizationSchema, websiteSchema, softwareSchema];
---

<Layout
  title="FunctionFly™ — Ship Functions. Agents Trust Them."
  description="The platform for AI-accessible functions. Publish in any language, execute in sandboxes, route by trust, and monitor everything — so your agents can call tools safely at scale."
  schema={homePageSchemas}
  ogImage="/og-home.svg"
>
  <HomePage client:load authOrigin={AUTH_ORIGIN} docsUrl={docsGuidesUrl} />
</Layout>
