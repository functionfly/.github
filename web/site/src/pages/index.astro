---
import Layout from '../layouts/Layout.astro';
import { APP_DASHBOARD_ORIGIN, DOCS_ORIGIN } from '../config';

const docsGuidesUrl = `${DOCS_ORIGIN.replace(/\/$/, '')}/docs/`;
---

<Layout
  title="FunctionFly — Trust Layer for AI Agents"
  description="Verified, signed, auditable tools with trust scores and a zero-knowledge vault for safe AI agent execution."
>
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Now in General Availability
      </div>
      <h1>
        <span class="hero-title-line">The Trust Layer for</span><br />
        <span class="gradient-text">AI Agents</span>
      </h1>
      <p class="hero-lead">
        The Trust Layer for AI Agents. Verified, signed, auditable tools with trust scores and a zero-knowledge vault for safe
        agent execution.
      </p>
      <div class="hero-actions">
        <a href={`${APP_DASHBOARD_ORIGIN}/signup`} class="btn btn-primary">
          Get Started Free <span class="hero-arrow" aria-hidden="true">→</span>
        </a>
        <a href={docsGuidesUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">View Documentation</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">Verified</span>
          <span class="stat-label">tiered checks</span>
        </div>
        <div class="stat">
          <span class="stat-value">Signed</span>
          <span class="stat-label">function attestations</span>
        </div>
        <div class="stat">
          <span class="stat-value">Private</span>
          <span class="stat-label">zero-knowledge vault</span>
        </div>
      </div>
    </div>
  </section>

  <section class="audience">
    <div class="container">
      <h2>Who benefits most from FunctionFly</h2>
      <p class="section-subtitle audience-intro">
        From solo founders to enterprise teams, FunctionFly provides the reliability and flexibility you need to focus on building
        great products.
      </p>
      <div class="audience-grid">
        <article class="audience-card">
          <div class="audience-card-head">
            <div class="audience-icon audience-icon-blue" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                />
              </svg>
            </div>
            <div>
              <h3>Indie SaaS Founder</h3>
              <p class="audience-sub">Deploying your first app</p>
            </div>
          </div>
          <p class="audience-desc">
            You built an amazing product and now need trustworthy agent tooling without enterprise overhead. FunctionFly gives you
            verified functions, clear trust signals, and a path to scale safely.
          </p>
          <ul class="audience-benefits">
            <li>Publish once, run everywhere</li>
            <li>Trust scores and verification tiers</li>
            <li>Zero-knowledge vault for secrets</li>
            <li>Pay as you grow</li>
          </ul>
        </article>
        <article class="audience-card">
          <div class="audience-card-head">
            <div class="audience-icon audience-icon-purple" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                />
              </svg>
            </div>
            <div>
              <h3>Growing Startup</h3>
              <p class="audience-sub">Scaling agent + API workloads</p>
            </div>
          </div>
          <p class="audience-desc">
            Your team is shipping fast and agents are calling more tools every week. You need policy-friendly trust metadata,
            attestations, and execution-backed signals—not a pile of unvetted endpoints.
          </p>
          <ul class="audience-benefits">
            <li>Multi-level verification workflows</li>
            <li>Signed artifacts and revocation</li>
            <li>Execution history for trust scoring</li>
            <li>Marketplace discovery with trust filters</li>
          </ul>
        </article>
        <article class="audience-card">
          <div class="audience-card-head">
            <div class="audience-icon audience-icon-teal" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
            </div>
            <div>
              <h3>Enterprise</h3>
              <p class="audience-sub">Governance and compliance</p>
            </div>
          </div>
          <p class="audience-desc">
            Your organization needs auditability, least-privilege access to tools, and consistent trust policies across agents and
            teams. FunctionFly aligns verification, signing, and vault semantics with how you already think about risk.
          </p>
          <ul class="audience-benefits">
            <li>Enterprise-grade security posture</li>
            <li>Attestations and policy-ready metadata</li>
            <li>Multi-team and multi-app patterns</li>
            <li>Room for custom SLAs and support</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <h2>Everything you need to trust agent tools</h2>
      <p class="section-subtitle">Verification + trust scoring so agents can act safely.</p>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <h3>Verified Tool Publishing</h3>
          <p>Turn code into trusted functions with verification checks and signed artifacts before they can be used by agents.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>Verification Levels & Revocation</h3>
          <p>Trust is earned. Verify at multiple levels, sign with platform keys, and revoke when issues are found.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 20V10M12 20V4M6 20v-6"></path>
            </svg>
          </div>
          <h3>Execution Trace & Trust Scores</h3>
          <p>Agents get history-backed trust signals so “works” and “safe” are distinguishable and policy-driven.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3>Agent-ready Tooling</h3>
          <p>Expose capabilities with clear manifests and schemas—so agents can select tools that match their trust policy.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3>Marketplace for Verified Tools</h3>
          <p>Creators publish once. Agents discover trusted functions with built-in trust filters and ranked placement.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </div>
          <h3>Trust-powered Routing</h3>
          <p>Enforce budgets and trust constraints at runtime—so agent execution is predictable, not reckless.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="code-example">
    <div class="container">
      <h2>Verify & publish in seconds</h2>
      <p class="section-subtitle">Turn your code into an agent-ready trusted tool</p>
      <div class="code-block">
        <pre><code><span class="code-comment"># Install the fly CLI (Go 1.25+)</span>
<span class="code-prompt">$</span> go install github.com/functionfly/functionfly/cmd/fly@latest

<span class="code-comment"># Or download a release binary from GitHub Releases</span>

<span class="code-comment"># Initialize a new function</span>
<span class="code-prompt">$</span> fly init my-function

<span class="code-comment"># Publish with verification</span>
<span class="code-prompt">$</span> fly deploy

🚀 Published verified & signed tool!
🧾 Verification: Level 2+  <span class="code-comment">(example; actual level depends on checks)</span></code></pre>
      </div>
      <p class="code-footnote">
        The CLI ships as the <code>fly</code> binary via Go install or
        <a href="https://github.com/functionfly/functionfly/releases">GitHub Releases</a>, not as an npm package.
      </p>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Where trusted tools meet agent execution</h2>
      <p>Start free. Verified tooling and auditable execution history help your agents move faster—with fewer surprises.</p>
      <div class="cta-actions">
        <a href={`${APP_DASHBOARD_ORIGIN}/signup`} class="btn btn-primary btn-large">Get Started Free</a>
        <a href="/contact" class="btn btn-outline">Contact Sales</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 7rem 2rem 4rem;
    text-align: center;
    background:
      radial-gradient(ellipse at top, rgba(99, 102, 241, 0.18) 0%, transparent 50%),
      radial-gradient(ellipse at bottom right, rgba(16, 185, 129, 0.12) 0%, transparent 50%),
      var(--color-bg);
  }

  .hero-content {
    max-width: 840px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.25);
    margin-bottom: 1.5rem;
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.5);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  h1 {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-title-line {
    color: var(--color-text);
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1 0%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .hero-arrow {
    margin-left: 0.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: var(--color-bg-light);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-border);
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }

  .btn-outline {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-outline:hover {
    background: var(--color-bg-light);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .audience {
    padding: 5rem 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .audience h2 {
    text-align: center;
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .audience-intro {
    margin-bottom: 3rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .audience-card {
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .audience-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .audience-card-head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .audience-icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: white;
  }

  .audience-icon-blue {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.35), rgba(6, 182, 212, 0.35));
    border: 1px solid rgba(59, 130, 246, 0.35);
  }

  .audience-icon-purple {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.35), rgba(236, 72, 153, 0.3));
    border: 1px solid rgba(168, 85, 247, 0.35);
  }

  .audience-icon-teal {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.35), rgba(20, 184, 166, 0.35));
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .audience-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.2rem;
  }

  .audience-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .audience-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .audience-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .audience-benefits li {
    padding-left: 1.25rem;
    position: relative;
  }

  .audience-benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .features {
    padding: 6rem 0;
    background: var(--color-bg-light);
  }

  .features h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 4rem;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-card {
    background: var(--color-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    transition:
      transform 0.2s,
      border-color 0.2s;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.1);
    border-radius: 12px;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .code-example {
    padding: 6rem 0;
    background: var(--color-bg);
  }

  .code-example h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .code-footnote {
    max-width: 600px;
    margin: 1.25rem auto 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    text-align: center;
  }

  .code-footnote code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text);
  }

  .code-footnote a {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  .code-block {
    max-width: 600px;
    margin: 3rem auto 0;
    background: #1a1f2e;
    border-radius: 12px;
    padding: 2rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .code-block pre {
    margin: 0;
  }

  .code-block code {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .code-comment {
    color: var(--color-text-muted);
  }

  .code-prompt {
    color: var(--color-primary);
  }

  .cta {
    padding: 6rem 0;
    background:
      radial-gradient(ellipse at center, rgba(99, 102, 241, 0.2) 0%, transparent 60%),
      var(--color-bg-light);
    text-align: center;
  }

  .cta h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .cta p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.35rem;
    }

    .hero-stats {
      gap: 2rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions,
    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }
</style>
