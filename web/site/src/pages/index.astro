  /* 3D Neural Nexus Hero Section */
  .hero-with-3d {
    position: relative;
    min-height: auto;
    display: flex;
    flex-direction: column;
    padding: 6rem 2rem 2rem !important;
  }

  .hero-3d-container {
    position: relative;
    width: 100%;
    height: 500px;
    z-index: 1;
    order: -1;
    margin-bottom: 2rem;
    perspective: 800px;
    overflow: hidden;
  }

  .neural-scene {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    animation: neural-rotate 20s ease-in-out infinite;
  }

  @keyframes neural-rotate {
    0%, 100% { transform: rotateY(-8deg) rotateX(5deg); }
    25% { transform: rotateY(5deg) rotateX(-3deg); }
    50% { transform: rotateY(10deg) rotateX(4deg); }
    75% { transform: rotateY(-5deg) rotateX(-5deg); }
  }

  .neural-layer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .neural-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.6);
    box-shadow:
      0 0 8px rgba(99, 102, 241, 0.5),
      0 0 20px rgba(99, 102, 241, 0.2);
    transform: translateZ(var(--z));
    animation: node-pulse 3s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .neural-node.node-primary {
    width: 16px;
    height: 16px;
    background: rgba(99, 102, 241, 0.9);
    box-shadow:
      0 0 12px rgba(99, 102, 241, 0.7),
      0 0 30px rgba(99, 102, 241, 0.3),
      0 0 50px rgba(99, 102, 241, 0.15);
  }

  @keyframes node-pulse {
    0%, 100% {
      opacity: 0.5;
      transform: translateZ(var(--z)) scale(1);
    }
    50% {
      opacity: 1;
      transform: translateZ(var(--z)) scale(1.4);
    }
  }

  .neural-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .neural-line {
    stroke: rgba(99, 102, 241, 0.15);
    stroke-width: 0.3;
    animation: line-pulse 4s ease-in-out infinite;
  }

  .neural-line:nth-child(odd) {
    animation-delay: 1s;
    stroke: rgba(56, 189, 248, 0.12);
  }

