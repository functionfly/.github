<script is:inline>
(function() {
  if (typeof document === 'undefined') return;

  // Language tabs
  document.querySelectorAll('.lang-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var lang = tab.getAttribute('data-lang');
      document.querySelectorAll('.lang-tab').forEach(function(t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.lang-panel').forEach(function(p) {
        p.classList.remove('active');
        if (p.getAttribute('data-lang') === lang) {
          p.classList.add('active');
        }
      });
    });
  });

  // OS install tabs
  document.querySelectorAll('.install-os-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var os = tab.getAttribute('data-os');
      document.querySelectorAll('.install-os-tab').forEach(function(t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.install-panel').forEach(function(p) {
        p.classList.remove('active');
        if (p.getAttribute('data-os') === os) {
          p.classList.add('active');
        }
      });
    });
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var panel = btn.closest('.install-panel');
      var code = panel.querySelector('code');
      var text = code ? code.innerText : '';
      navigator.clipboard.writeText(text).then(function() {
        btn.classList.add('copied');
        var iconCopy = btn.querySelector('.icon-copy');
        var iconCheck = btn.querySelector('.icon-check');
        var label = btn.querySelector('.copy-label');
        if (iconCopy) iconCopy.style.display = 'none';
        if (iconCheck) iconCheck.style.display = 'block';
        if (label) label.textContent = 'Copied!';
        setTimeout(function() {
          btn.classList.remove('copied');
          if (iconCopy) iconCopy.style.display = 'block';
          if (iconCheck) iconCheck.style.display = 'none';
          if (label) label.textContent = 'Copy';
        }, 2000);
      });
    });
  });

  // Line-level copy buttons
  document.querySelectorAll('.line-copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = btn.closest('.code-line');
      var textEl = line ? line.querySelector('.lc-text') : null;
      var text = textEl ? textEl.innerText : '';
      navigator.clipboard.writeText(text).then(function() {
        btn.classList.add('copied');
        var iconCopy = btn.querySelector('.lc-icon-copy');
        var iconCheck = btn.querySelector('.lc-icon-check');
        if (iconCopy) iconCopy.style.display = 'none';
        if (iconCheck) iconCheck.style.display = 'block';
        setTimeout(function() {
          btn.classList.remove('copied');
          if (iconCopy) iconCopy.style.display = 'block';
          if (iconCheck) iconCheck.style.display = 'none';
        }, 2000);
      });
    });
  });

  // Waitlist form
  var waitlistForm = document.getElementById('waitlist-form');
  if (waitlistForm) {
    waitlistForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var emailInput = document.getElementById('waitlist-email');
      var btnText = waitlistForm.querySelector('.waitlist-btn-text');
      var btnLoading = waitlistForm.querySelector('.waitlist-btn-loading');
      var successMsg = document.getElementById('waitlist-success');
      var errorMsg = document.getElementById('waitlist-error');
      var submitBtn = waitlistForm.querySelector('.waitlist-btn');
      var email = emailInput.value.trim();
      if (!email || !email.includes('@') || !email.includes('.')) {
        errorMsg.textContent = 'Please enter a valid email address.';
        errorMsg.hidden = false;
        successMsg.hidden = true;
        return;
      }
      btnText.textContent = 'Joining...';
      btnLoading.style.display = 'inline-flex';
      submitBtn.disabled = true;
      errorMsg.hidden = true;
      successMsg.hidden = true;
      var formData = new FormData();
      formData.append('feedbackType', 'launch_waitlist');
      formData.append('subject', 'Waitlist signup');
      formData.append('message', 'Waitlist signup from homepage form.');
      formData.append('email', email);
      fetch('/v1/feedback', {
        method: 'POST',
        body: formData
      }).then(function(res) {
        if (res.ok) {
          successMsg.hidden = false;
          errorMsg.hidden = true;
          emailInput.value = '';
        } else {
          return res.json().then(function(data) {
            throw new Error(data.error || 'Something went wrong. Please try again.');
          });
        }
      }).catch(function(err) {
        errorMsg.textContent = err.message;
        errorMsg.hidden = false;
        successMsg.hidden = true;
      }).finally(function() {
        btnText.textContent = 'Join Waitlist';
        btnLoading.style.display = 'none';
        submitBtn.disabled = false;
      });
    });
  }
})();
</script>
</Layout>

<style>
  /* =============================================
     DESIGN SYSTEM: Midnight Aurora + Glass Protocol + Vector Terminal
     ============================================= */
  :root {
    /* Core palette evolution */
    --color-aurora-primary: #818cf8;
    --color-aurora-glow: rgba(99, 102, 241, 0.4);
    --color-cyan: #38bdf8;
    --color-cyan-glow: rgba(56, 189, 248, 0.3);
    --glass-bg: rgba(30, 41, 59, 0.6);
    --glass-border: rgba(99, 102, 241, 0.25);
    --glass-border-hover: rgba(99, 102, 241, 0.5);
    --terminal-grid: rgba(99, 102, 241, 0.03);
    --depth-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    --glow-shadow: 0 0 40px rgba(99, 102, 241, 0.15);
  }

  /* Animated aurora background */
  @keyframes aurora-shift {
    0%, 100% { opacity: 0.4; transform: translateX(0) scale(1); }
    33% { opacity: 0.6; transform: translateX(5%) scale(1.1); }
    66% { opacity: 0.5; transform: translateX(-5%) scale(1.05); }
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px var(--color-aurora-glow); }
    50% { box-shadow: 0 0 40px var(--color-aurora-glow), 0 0 60px var(--color-cyan-glow); }
  }

  @keyframes signal-flow {
    0% { opacity: 0.3; }
    50% { opacity: 1; filter: drop-shadow(0 0 8px var(--color-aurora-primary)); }
    100% { opacity: 0.3; }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes grid-pulse {
    0%, 100% { opacity: 0.02; }
    50% { opacity: 0.05; }
  }

  /* Subtle grid overlay for terminal aesthetic */
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(circle at 1px 1px, var(--terminal-grid) 1px, transparent 0);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 1;
    animation: grid-pulse 8s ease-in-out infinite;
  }

  main {
    position: relative;
    z-index: 2;
  }

  .hero {
    padding: 7rem 2rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(99, 102, 241, 0.25) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 60%, rgba(16, 185, 129, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse 50% 30% at 20% 80%, rgba(56, 189, 248, 0.12) 0%, transparent 50%),
      var(--color-bg);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at 30% 30%, rgba(99, 102, 241, 0.15) 0%, transparent 50%);
    animation: aurora-shift 15s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-content {
    max-width: 840px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-aurora-primary);
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(56, 189, 248, 0.1));
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.15);
    margin-bottom: 1.5rem;
    animation: float 6s ease-in-out infinite;
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-cyan));
    box-shadow: 0 0 12px var(--color-aurora-glow);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.2);
    }
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }

  .hero-title-line {
    color: var(--color-text);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.3);
  }

  .gradient-text {
    background: linear-gradient(135deg, #818cf8 0%, #38bdf8 30%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 30px rgba(99, 102, 241, 0.3));
  }

  /* Terminal-style prompt markers for section titles */
  h2::before {
    content: '>';
    display: inline-block;
    margin-right: 0.5rem;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-weight: 400;
    opacity: 0.6;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .hero-arrow {
    margin-left: 0.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: left 0.5s;
  }

  .btn:hover::before {
    left: 100%;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary) 0%, #818cf8 100%);
    color: white;
    border: 1px solid rgba(99, 102, 241, 0.5);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3), 0 0 0 1px rgba(99, 102, 241, 0.2);
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #818cf8 0%, #a5b4fc 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4), 0 0 0 1px rgba(99, 102, 241, 0.3);
  }

  .btn-secondary {
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    border: 1px solid var(--glass-border);
  }

  .btn-secondary:hover {
    background: rgba(99, 102, 241, 0.15);
    border-color: var(--glass-border-hover);
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    border-radius: 12px;
  }

  .btn-outline {
    background: rgba(30, 41, 59, 0.4);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-outline:hover {
    background: var(--glass-bg);
    border-color: var(--color-cyan);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .audience {
    padding: 5rem 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .audience h2 {
    text-align: center;
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .audience-intro {
    margin-bottom: 3rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .audience-card {
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .audience-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .audience-card-head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .audience-icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: white;
  }

  .audience-icon-blue {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.35), rgba(6, 182, 212, 0.35));
    border: 1px solid rgba(59, 130, 246, 0.35);
  }

  .audience-icon-purple {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.35), rgba(236, 72, 153, 0.3));
    border: 1px solid rgba(168, 85, 247, 0.35);
  }

  .audience-icon-teal {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.35), rgba(20, 184, 166, 0.35));
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .audience-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.2rem;
  }

  .audience-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .audience-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .audience-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .audience-benefits li {
    padding-left: 1.25rem;
    position: relative;
  }

  .audience-benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .features {
    padding: 6rem 0;
    background: var(--color-bg-light);
  }

  .features h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 4rem;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-card {
    background: var(--color-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    transition:
      transform 0.2s,
      border-color 0.2s;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.1);
    border-radius: 12px;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .publish-section {
    padding: 8rem 0;
    background: linear-gradient(180deg, var(--color-bg) 0%, #0f1117 50%, var(--color-bg) 100%);
    position: relative;
    overflow: hidden;
  }

  .publish-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.3), transparent);
  }

  .publish-section .container {
    position: relative;
    z-index: 1;
  }

  .publish-section h2 {
    text-align: center;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .publish-section .section-subtitle {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  /* Per-OS install tabs */
  .install-os-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 0;
    position: relative;
    z-index: 2;
  }

  .install-os-tab {
    background: rgba(26, 31, 46, 0.6);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: 12px 12px 0 0;
    padding: 0.75rem 2rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    margin: 0 -1px;
  }

  .install-os-tab:first-child {
    border-radius: 12px 12px 0 0;
  }

  .install-os-tab:hover {
    color: var(--color-text);
    background: rgba(26, 31, 46, 0.8);
  }

  .install-os-tab.active {
    color: var(--color-text);
    background: linear-gradient(180deg, #1e2333 0%, #1a1f2e 100%);
    border-color: rgba(99, 102, 241, 0.4);
    border-bottom: 1px solid #1a1f2e;
    margin-bottom: -1px;
    z-index: 3;
    box-shadow: 0 -2px 10px rgba(99, 102, 241, 0.15);
  }

  .install-os-tab.active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-secondary), transparent);
    border-radius: 12px 12px 0 0;
  }

  /* CLI block */
  .publish-cli {
    max-width: 800px;
    margin: 0 auto;
    border-radius: 0 16px 16px 16px;
    margin-top: -1px;
    background: linear-gradient(180deg, #1a1f2e 0%, #151922 100%);
    border: 1px solid rgba(99, 102, 241, 0.25);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.4),
      0 0 40px rgba(99, 102, 241, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .publish-cli::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.4), transparent);
  }

  .install-panel {
    display: none;
  }

  .install-panel.active {
    display: block;
  }

  .code-block-inner {
    position: relative;
  }

  .code-block-inner .code-pre {
    margin: 0;
  }

  .code-block-inner code {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .code-footnote {
    max-width: 640px;
    margin: 2rem auto 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    text-align: center;
    padding: 1rem 1.5rem;
    background: rgba(26, 31, 46, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    backdrop-filter: blur(10px);
  }

  .code-footnote code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
  }

  .code-footnote a {
    color: var(--color-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .code-footnote a:hover {
    color: #34d399;
    text-decoration: underline;
  }

  .code-block {
    max-width: 100%;
    background: linear-gradient(180deg, #1a1f2e 0%, #151922 100%);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    border: 1px solid rgba(99, 102, 241, 0.2);
    text-align: left;
    overflow-x: auto;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .code-block::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.4), transparent);
    border-radius: 16px 16px 0 0;
  }

  .code-block pre {
    margin: 0;
  }

  .code-block code {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  /* Copy button */
  .copy-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
    z-index: 10;
  }

  .copy-btn:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .copy-btn.copied {
    color: var(--color-secondary);
    border-color: rgba(16, 185, 129, 0.3);
  }

  .copy-label {
    line-height: 1;
  }

  /* Code lines container */
  .code-lines {
    padding: 1.5rem 1rem;
  }

  /* Line-level copy button */
  .code-line {
    display: flex;
    align-items: center;
    min-height: 2em;
    padding: 0.25rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 6px;
    transition: background 0.15s ease;
  }

  .code-line:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .code-line--blank {
    min-height: 1em;
  }

  .line-copy-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-right: 0.75rem;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s ease;
  }

  .code-line:hover .line-copy-btn {
    opacity: 0.6;
  }

  .line-copy-btn:hover {
    opacity: 1 !important;
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.1);
  }

  .line-copy-btn.copied {
    color: var(--color-secondary);
    opacity: 1;
    background: rgba(16, 185, 129, 0.15);
  }

  .lc-icon {
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  .lc-text {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.7;
    letter-spacing: -0.01em;
  }

  /* Enhanced syntax highlighting */
  .code-comment {
    color: #64748b;
    font-style: italic;
  }

  .code-prompt {
    color: #a78bfa;
    font-weight: 600;
    margin-right: 0.5rem;
  }

  .code-success {
    color: #34d399;
    font-weight: 500;
  }

  .code-info {
    color: #38bdf8;
    font-weight: 500;
  }

  .cta {
    padding: 6rem 0;
    background:
      radial-gradient(ellipse at center, rgba(99, 102, 241, 0.2) 0%, transparent 60%),
      var(--color-bg-light);
    text-align: center;
  }

  .cta h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .cta p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }

    .steps-grid {
      flex-wrap: wrap;
    }

    .step-card {
      flex-basis: calc(50% - 0.75rem);
    }

    .step-connector {
      display: none;
    }

    .observability-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .capabilities-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.35rem;
    }

    .hero-stats {
      gap: 2rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions,
    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .steps-grid {
      flex-direction: column;
      gap: 1.5rem;
    }

    .step-connector {
      display: none;
    }

    .observability-grid {
      grid-template-columns: 1fr;
    }

    .capabilities-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .capability-grid {
      grid-template-columns: 1fr;
    }

    .comparison-table th,
    .comparison-table td {
      padding: 0.75rem 0.5rem;
      font-size: 0.8125rem;
    }

    .waitlist-input-group {
      flex-direction: column;
      border-radius: 10px;
    }

    .waitlist-input-group input {
      padding: 0.875rem 1rem;
    }

    .waitlist-btn {
      border-radius: 0 0 8px 8px;
      padding: 0.875rem 1rem;
      justify-content: center;
    }
  }


  /* =============================================
     HOW IT WORKS
     ============================================= */
  .how-it-works {
    padding: 6rem 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .how-it-works h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .steps-grid {
    display: flex;
    align-items: flex-start;
    gap: 0;
    margin-top: 4rem;
  }

  .step-card {
    flex: 1;
    padding: 2rem 1.5rem;
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    position: relative;
    transition: border-color 0.2s, transform 0.2s;
  }

  .step-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .step-number {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  .step-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.1);
    border-radius: 14px;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .step-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .step-card p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .step-connector {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    padding-top: 2rem;
    color: var(--color-border);
  }

  /* =============================================
     LANGUAGE EXAMPLES
     ============================================= */
  .language-examples {
    padding: 6rem 0;
    background: var(--color-bg-light);
    border-top: 1px solid var(--color-border);
  }

  .language-examples h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .lang-tabs {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 3rem;
    margin-bottom: 0;
    flex-wrap: wrap;
  }

  .lang-tab {
    padding: 0.625rem 1.25rem;
    border-radius: 8px 8px 0 0;
    border: 1px solid var(--color-border);
    border-bottom: none;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .lang-tab:hover {
    background: var(--color-bg-light);
    color: var(--color-text);
  }

  .lang-tab.active {
    background: #1a1f2e;
    color: #e2e8f0;
    border-color: #2d3748;
  }

  .lang-panels {
    background: #1a1f2e;
    border-radius: 0 12px 12px 12px;
    border: 1px solid #2d3748;
    padding: 2rem;
  }

  .lang-panel {
    display: none;
  }

  .lang-panel.active {
    display: block;
  }

  .lang-panel .code-block {
    margin: 0;
    max-width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    overflow-x: auto;
  }

  /* =============================================
     CAPABILITIES
     ============================================= */
  .capabilities {
    padding: 6rem 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .capabilities-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .capabilities-intro h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    text-align: left;
  }

  .capability-legend {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-dot.allowed {
    background: #10b981;
  }

  .legend-dot.denied {
    background: #ef4444;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .capability-category {
