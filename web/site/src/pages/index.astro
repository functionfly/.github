      <div class="cta-actions">
        <a href={`${AUTH_ORIGIN}/signup`} class="btn btn-primary btn-large">Start Free</a>
        <a href="/contact" class="btn btn-outline">Contact Sales</a>
      </div>
      <div class="waitlist-form-wrapper">
        <p class="waitlist-tagline">Join the waitlist for early access to new features</p>
        <form id="waitlist-form" class="waitlist-form" novalidate>
          <div class="waitlist-input-group">
            <input
              type="email"
              id="waitlist-email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
            <button type="submit" class="btn btn-primary waitlist-btn">
              <span class="waitlist-btn-text">Join Waitlist</span>
              <span class="waitlist-btn-loading" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                </svg>
              </span>
            </button>
          </div>
          <div id="waitlist-success" class="waitlist-success" role="alert" aria-live="polite" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            <span>You're on the list. We'll be in touch.</span>
          </div>
          <div id="waitlist-error" class="waitlist-error" role="alert" aria-live="polite" hidden></div>
