     ============================================= */

  /* =============================================
     WAITLIST FORM
     ============================================= */
  .waitlist-form-wrapper {
    margin-top: 3rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .waitlist-tagline {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .waitlist-input-group {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-bg-light);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .waitlist-input-group:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .waitlist-input-group input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .waitlist-btn {
    flex-shrink: 0;
    padding: 0.75rem 1.25rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 0;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .waitlist-btn:hover:not(:disabled) {
    background: var(--color-primary-dark);
  }

  .waitlist-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .waitlist-btn-loading {
    display: none;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .waitlist-success {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 8px;
    color: #10b981;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .waitlist-success[hidden] {
    display: none;
  }

  .waitlist-error {
    display: flex;
    padding: 0.75rem 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 8px;
    color: #ef4444;
    font-size: 0.875rem;
  }

  .waitlist-error[hidden] {
    display: none;
  }

  /* Light mode overrides for waitlist form */
  :global([data-theme='light']) .waitlist-input-group {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
  }

  :global([data-theme='light']) .waitlist-input-group:focus-within {
    border-color: #E85A2A !important;
    box-shadow: 0 0 0 3px rgba(232, 90, 42, 0.15) !important;
