---
import Layout from '../layouts/Layout.astro';
import ChangelogPage from '../components/ChangelogPage/ChangelogPage';
import { SITE_ORIGIN } from '../config';
import '../components/homepage.css';

const changelogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'FunctionFly Changelog',
  description: 'FunctionFly release history and notable changes. Stay updated with new features, improvements, and fixes.',
  author: {
    '@type': 'Organization',
    name: 'FunctionFly',
    url: SITE_ORIGIN,
  },
  publisher: {
    '@type': 'Organization',
    name: 'FunctionFly',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_ORIGIN}/favicon.svg`,
    },
  },
  datePublished: '2026-04-13',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${SITE_ORIGIN}/changelog`,
  },
};
---

<Layout
  title="Changelog — FunctionFly"
  description="FunctionFly release history and notable changes. Stay updated with new features, improvements, and fixes."
  schema={changelogSchema}
  ogImage="/og-changelog.svg"
>
  <ChangelogPage client:load />
</Layout>
