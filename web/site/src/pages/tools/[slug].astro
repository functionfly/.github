---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { sanityClient, queries, urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const tools = await sanityClient.fetch(queries.tools);
  return tools.map((tool) => ({
    params: { slug: tool.slug.current },
    props: { tool },
  }));
}

const { tool } = Astro.props;

const title = tool.title;
const description = tool.description;

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": tool.title,
  "description": tool.description,
  "publisher": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "datePublished": tool.publishedAt,
  "dateModified": tool.updatedAt || tool.publishedAt,
  "keywords": tool.keywords?.join(', ') || tool.tags?.join(', ') || '',
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="mb-6">
            <span class="bg-accent-primary/10 text-accent-primary px-4 py-2 rounded-full text-sm font-medium capitalize">
              {tool.type}
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-6">
            {tool.title}
          </h1>

          <p class="text-xl text-text-secondary mb-8 max-w-2xl mx-auto">
            {tool.description}
          </p>

          <div class="flex gap-4 justify-center mb-6">
            {tool.downloadUrl && (
              <a
                href={tool.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-3 rounded-lg font-semibold transition-colors"
              >
                Download Resource
              </a>
            )}
            {tool.demoUrl && (
              <a
                href={tool.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-bg-secondary hover:bg-bg-primary text-text-primary px-8 py-3 rounded-lg font-semibold border border-text-secondary/20 transition-colors"
              >
                View Demo
              </a>
            )}
          </div>

          <div class="flex items-center justify-center gap-6 text-sm text-text-secondary">
            <span>Published: {new Date(tool.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}</span>
            {tool.updatedAt && tool.updatedAt !== tool.publishedAt && (
              <>
                <span>•</span>
                <span>Updated: {new Date(tool.updatedAt).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}</span>
              </>
            )}
          </div>

          {tool.tags && tool.tags.length > 0 && (
            <div class="flex gap-2 justify-center mt-6">
              {tool.tags.map((tag) => (
                <span class="bg-bg-primary text-text-secondary px-3 py-1 rounded-full text-sm">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <article class="py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {tool.heroImage && (
          <div class="mb-12">
            <img
              src={urlFor(tool.heroImage).width(1200).height(600).fit('crop').url()}
              alt={tool.heroImage.alt || tool.title}
              class="w-full h-96 object-cover rounded-xl"
            />
            {tool.heroImage.caption && (
              <p class="text-sm text-text-secondary mt-2 text-center italic">
                {tool.heroImage.caption}
              </p>
            )}
          </div>
        )}

        <div class="prose prose-lg prose-invert max-w-none">
          <PortableText value={tool.body} />
        </div>

        <!-- Action Buttons -->
        <div class="mt-12 pt-8 border-t border-text-secondary/20">
          <div class="flex gap-4 justify-center">
            {tool.downloadUrl && (
              <a
                href={tool.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-3 rounded-lg font-semibold transition-colors"
              >
                Download {tool.type}
              </a>
            )}
            {tool.demoUrl && (
              <a
                href={tool.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-bg-secondary hover:bg-bg-primary text-text-primary px-8 py-3 rounded-lg font-semibold border border-text-secondary/20 transition-colors"
              >
                Try Live Demo
              </a>
            )}
          </div>
        </div>

        <!-- Share Section -->
        <div class="mt-8">
          <div class="flex items-center justify-center gap-4">
            <span class="text-text-secondary">Share:</span>
            <button class="text-text-secondary hover:text-accent-primary transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
              </svg>
            </button>
            <button class="text-text-secondary hover:text-accent-primary transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </article>

    <!-- Related Tools -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-text-primary mb-12 text-center">More Resources</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {/* Related tools would be fetched and displayed here */}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Add any client-side functionality here
</script>