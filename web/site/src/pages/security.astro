---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import SecurityPage from '../components/SecurityPage.tsx';

const title = 'Security Hub — FunctionFly';
const description = 'Security at FunctionFly: encryption, access controls, monitoring, and responsible disclosure. Report vulnerabilities securely.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <SecurityPage client:load />
</Layout>
