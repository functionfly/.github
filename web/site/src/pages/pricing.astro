---
import Layout from '../layouts/Layout.astro';
import '../styles/pricing.css';
import { APP_DASHBOARD_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN } from '../config';

// FAQPage schema for the FAQ section (rich results eligibility)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do prices include tax?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the Trust API and verification billing work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can we upgrade or downgrade?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does Enterprise include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. Contact sales with your requirements.',
      },
    },
  ],
};

// SoftwareApplication schema for the product
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FunctionFly',
  applicationCategory: 'DeveloperApplication',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free Tier',
      price: '0',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '29',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Professional',
      price: '99',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '127',
  },
  operatingSystem: 'Any (Cloud-based)',
  url: `${SITE_ORIGIN}/pricing`,
};

const pricingSchemas = [faqSchema, productSchema];
---

<Layout
  title="Pricing — FunctionFly"
  description="Platform plans for functions, providers, and requests—plus State Fabric and agent execution tiers for AI workloads. Start free; scale with Starter, Professional, or Enterprise."
  schema={pricingSchemas}
  ogImage="/og-pricing.svg"
>
  <section class="pricing-hero">
    <div class="container">
      <div class="badge">Plans &amp; limits</div>
      <h1>Simple pricing that scales with trust</h1>
      <p class="lead">
        Start free. Paid tiers add capacity for functions, providers, and traffic—aligned with what you see in product. Agent execution is billed separately so AI workloads can grow on their own curve.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Platform</h2>
        <p class="muted">Functions, hosting providers, custom domains, vault secrets, and collaboration—priced per workspace.</p>
      </div>

      {/* Billing Cycle Toggle */}
      <div class="billing-toggle-wrap">
        <div class="billing-toggle">
          <button class="toggle-btn active" data-period="monthly">Monthly</button>
          <button class="toggle-btn" data-period="annual">
            Annual
            <span class="save-badge">Save 20%</span>
          </button>
        </div>
      </div>

      <div class="pricing-grid">
        <article class="price-card">
          <h3 class="tier-name">Free</h3>
          <div class="price-row">
            <span class="price-amount">$0</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Perfect for getting started with FunctionFly.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> 1 function</li>
            <li><span class="check" aria-hidden="true">✓</span> 2 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> 100,000 requests / month</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: 0 instances</li>
            <li><span class="check" aria-hidden="true">✓</span> Community support</li>
          </ul>
          <a class="btn btn-secondary full-width" href={`${AUTH_ORIGIN}/signup`}>Start free</a>
        </article>

        <article class="price-card" data-plan="starter">
          <h3 class="tier-name">Starter</h3>
          <div class="price-row">
            <span class="price-amount" data-monthly="$29" data-annual="$23">$29</span>
            <span class="price-period">/ month</span>
          </div>
          <div class="annual-note" style="display: none;">$278 billed annually</div>
          <p class="tier-desc">For side projects and MVPs.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> 5 functions</li>
            <li><span class="check" aria-hidden="true">✓</span> 3 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> 1M requests / month</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 custom domain</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: up to 1 instance</li>
            <li><span class="check" aria-hidden="true">✓</span> Email support &amp; basic analytics</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${AUTH_ORIGIN}/signup?plan=starter`}>Choose Starter</a>
        </article>

        <article class="price-card price-card--featured" data-plan="professional">
          <div class="featured-pill">Most popular</div>
          <h3 class="tier-name">Professional</h3>
          <div class="price-row">
            <span class="price-amount" data-monthly="$99" data-annual="$79">$99</span>
            <span class="price-period">/ month</span>
          </div>
          <div class="annual-note" style="display: none;">$950 billed annually</div>
          <p class="tier-desc">For growing teams and production SaaS.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> 25 functions</li>
            <li><span class="check" aria-hidden="true">✓</span> 5 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> 10M requests / month</li>
            <li><span class="check" aria-hidden="true">✓</span> 5 custom domains</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: up to 5 instances</li>
            <li><span class="check" aria-hidden="true">✓</span> 99.9% SLA, priority support</li>
            <li><span class="check" aria-hidden="true">✓</span> Advanced analytics &amp; team collaboration</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=functions&plan=professional`}>Choose Professional</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Enterprise</h3>
          <div class="price-row">
            <span class="price-amount price-amount--custom">Custom</span>
          </div>
          <p class="tier-desc">For large-scale apps, compliance, and custom trust policies.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Unlimited functions &amp; requests</li>
            <li><span class="check" aria-hidden="true">✓</span> All providers &amp; domains</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: unlimited instances</li>
            <li><span class="check" aria-hidden="true">✓</span> 99.99% SLA &amp; dedicated support</li>
            <li><span class="check" aria-hidden="true">✓</span> Custom integrations &amp; onboarding</li>
          </ul>
          <a class="btn btn-secondary full-width" href="/contact">Contact sales</a>
        </article>
      </div>
      <p class="footnote">
        Limits and features match what your workspace shows. Verification, marketplace, and Trust API usage may be billed separately—see <a href="/trust">Trust layer</a> and in-product usage for current rates.
      </p>

      {/* Backend-in-a-Box Bundles Promo */}
      <div class="bundles-promo">
        <div class="bundles-badge">
          <span class="sparkle">✨</span> NEW: Backend-in-a-Box
        </div>
        <h3 class="bundles-title">One Click → Full Backend</h3>
        <p class="bundles-desc">
          Skip the decision fatigue. Get pre-configured bundles with Auth, Payments, User DB, and more.
          <strong>Start free</strong> until you hit 100 users or $1K MRR.
        </p>
        <div class="bundles-grid">
          <div class="bundle-item">
            <span class="bundle-icon">🚀</span>
            <strong>SaaS Starter</strong> — $29/mo
            <span class="bundle-features">Auth · Payments · User DB · Email · Analytics</span>
          </div>
          <div class="bundle-item">
            <span class="bundle-icon">🛒</span>
            <strong>Marketplace</strong> — $49/mo
            <span class="bundle-features">Listings · Payments · Messaging · Notifications</span>
          </div>
          <div class="bundle-item">
            <span class="bundle-icon">🤖</span>
            <strong>AI App</strong> — $39/mo
            <span class="bundle-features">Vector DB · Embeddings · Chat · Memory</span>
          </div>
        </div>
        <div class="bundles-cta">
          <a class="btn btn-gradient" href={`${APP_DASHBOARD_ORIGIN}/pricing/bundles`}>
            Explore Bundles →
          </a>
          <span class="bundles-trust">
            <span class="pill">🎯 100 users free</span>
            <span class="pill">💰 $1K MRR free</span>
            <span class="pill">⏰ 3 months free</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="section statefabric-section">
    <div class="container">
      <div class="section-head">
        <h2 id="state-fabric">State Fabric</h2>
        <p class="muted">
          Stateful capabilities for serverless. Start with Sandbox and scale up to Enterprise. Optional add-ons can be enabled in your workspace.
        </p>
      </div>

      <div class="statefabric-grid">
        <article class="price-card">
          <h3 class="tier-name">Sandbox</h3>
          <div class="price-row">
            <span class="price-amount">$0</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Great for experimentation &amp; onboarding.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Stateless usage</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 state object</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 GB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 10,000 state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 7-day snapshot retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Community support</li>
          </ul>
          <a class="btn btn-secondary full-width" href={`${AUTH_ORIGIN}/signup`}>Try now — free</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Starter</h3>
          <div class="price-row">
            <span class="price-amount">$19</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Internal dev &amp; small side projects.</p>
          <div class="tier-desc tier-desc--tight">Storage: $0.10/GB · Ops: $0.50/100k</div>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Up to 5 state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> 10 GB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 100,000 state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 30-day snapshot retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Basic snapshot scheduling</li>
            <li><span class="check" aria-hidden="true">✓</span> Replay engine (limited)</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=state-fabric&plan=sf_starter`}>Choose Starter</a>
        </article>

        <article class="price-card price-card--featured">
          <div class="featured-pill">Best for production</div>
          <h3 class="tier-name">Pro</h3>
          <div class="price-row">
            <span class="price-amount">$99</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Production apps &amp; team projects.</p>
          <div class="tier-desc tier-desc--tight">Storage: $0.08/GB · Ops: $0.35/100k</div>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Up to 50 state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> 100 GB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 1M state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 90-day snapshot retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Hot cache tier</li>
            <li><span class="check" aria-hidden="true">✓</span> Fast deterministic replay</li>
            <li><span class="check" aria-hidden="true">✓</span> Replay API + billing analytics</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=state-fabric&plan=sf_pro`}>Choose Pro</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Business</h3>
          <div class="price-row">
            <span class="price-amount">$499</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Business-critical systems.</p>
          <div class="tier-desc tier-desc--tight">Storage: $0.06/GB · Archive: $30/TB/mo</div>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Up to 500 state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 TB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 10M state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 180-day retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Multi-region replication</li>
            <li><span class="check" aria-hidden="true">✓</span> Dedicated hot cache</li>
            <li><span class="check" aria-hidden="true">✓</span> SLA + advanced analytics</li>
            <li><span class="check" aria-hidden="true">✓</span> Event subscription streams</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=state-fabric&plan=sf_business`}>Choose Business</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Enterprise</h3>
          <div class="price-row">
            <span class="price-amount price-amount--custom">Custom</span>
          </div>
          <p class="tier-desc">Large enterprises &amp; regulated industries.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Unlimited state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> Unlimited event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> Unlimited ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 365-day retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Multi-region + edge replication</li>
            <li><span class="check" aria-hidden="true">✓</span> Enterprise key management (BYOK)</li>
            <li><span class="check" aria-hidden="true">✓</span> Immutable audit logs</li>
            <li><span class="check" aria-hidden="true">✓</span> Replay export · Dedicated support</li>
          </ul>
          <a class="btn btn-secondary full-width" href="/contact">Contact sales</a>
        </article>
      </div>

      <div class="statefabric-table-wrap">
        <table class="agent-table statefabric-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Sandbox</th>
              <th scope="col">Starter</th>
              <th scope="col">Pro</th>
              <th scope="col">Business</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>State objects</td>
              <td>1</td>
              <td>5</td>
              <td>50</td>
              <td>500</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Event storage</td>
              <td>1 GB</td>
              <td>10 GB</td>
              <td>100 GB</td>
              <td>1 TB</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>State ops</td>
              <td>10K</td>
              <td>100K</td>
              <td>1M</td>
              <td>10M</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Snapshot retention</td>
              <td>7 days</td>
              <td>30 days</td>
              <td>90 days</td>
              <td>180 days</td>
              <td>365 days</td>
            </tr>
            <tr>
              <td>Replay</td>
              <td>—</td>
              <td>Limited</td>
              <td>Fast + API</td>
              <td>Full</td>
              <td>Export</td>
            </tr>
            <tr>
              <td>Multi-region</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
              <td>Yes</td>
              <td>Yes + edge</td>
            </tr>
            <tr>
              <td>Hot cache</td>
              <td>—</td>
              <td>—</td>
              <td>Yes</td>
              <td>Dedicated</td>
              <td>Dedicated</td>
            </tr>
            <tr>
              <td>Support</td>
              <td>Community</td>
              <td>Email</td>
              <td>Priority</td>
              <td>SLA</td>
              <td>Dedicated</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="statefabric-addons">
        <h3 class="statefabric-addons-title">Optional add-ons</h3>
        <p class="muted statefabric-addons-sub">
          Enhance any State Fabric plan with performance, security, or analytics add-ons.
        </p>

        <div class="addon-grid">
          <article class="addon-card">
            <div class="addon-top">
              <h4>Hot Cache Booster</h4>
              <div class="addon-price">
                $49 <span>/mo per 5GB</span>
              </div>
            </div>
            <p class="addon-desc">Reduces replay and read costs.</p>
          </article>

          <article class="addon-card">
            <div class="addon-top">
              <h4>Advanced Security Pack</h4>
              <div class="addon-price">
                $99 <span>/mo</span>
              </div>
            </div>
            <p class="addon-desc">SOC2-friendly logs, key rotation, audit streams.</p>
          </article>

          <article class="addon-card">
            <div class="addon-top">
              <h4>AI Memory Pack</h4>
              <div class="addon-price">
                $149 <span>/mo</span>
              </div>
            </div>
            <p class="addon-desc">Vector index, embeddings storage, fast read engine.</p>
          </article>

          <article class="addon-card">
            <div class="addon-top">
              <h4>Advanced Insights</h4>
              <div class="addon-price">
                $79 <span>/mo</span>
              </div>
            </div>
            <p class="addon-desc">Cost forecasting, anomaly detection, hot path alerts.</p>
          </article>
        </div>

        <p class="statefabric-note">
          Add-on prices can change over time. Always confirm current rates in your billing page.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Agent execution</h2>
        <p class="muted">
          Run tool calls, state, and memory for AI agents on dedicated infrastructure. Add an agent plan when you outgrow experimentation.
        </p>
      </div>
      <div class="agent-table-wrap">
        <table class="agent-table">
          <thead>
            <tr>
              <th scope="col">Plan</th>
              <th scope="col">From</th>
              <th scope="col">Includes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Agent Starter</strong></td>
              <td>$49 / mo</td>
              <td class="muted-cell">500K tool calls / mo, 10 concurrent agents, email support</td>
            </tr>
            <tr>
              <td><strong>Agent Scale</strong></td>
              <td>$299 / mo</td>
              <td class="muted-cell">5M tool calls / mo, 100 concurrent agents, priority support</td>
            </tr>
            <tr>
              <td><strong>Agent Pro</strong></td>
              <td>$999 / mo</td>
              <td class="muted-cell">25M tool calls / mo, 500 concurrent agents, dedicated support</td>
            </tr>
            <tr>
              <td><strong>Agent Enterprise</strong></td>
              <td>Custom</td>
              <td class="muted-cell">Unlimited scale, custom caps, security reviews</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="agent-cta">
        <a class="btn btn-primary" href={`${AUTH_ORIGIN}/signup`}>Configure</a>
        <a class="btn btn-secondary" href="/for-agents">For AI agents</a>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container container--narrow">
      <h2>Frequently asked questions</h2>
      <dl class="faq">
        <div class="faq-item">
          <dt>Do prices include tax?</dt>
          <dd>Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.</dd>
        </div>
        <div class="faq-item">
          <dt>How does the Trust API and verification billing work?</dt>
          <dd>
            Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Where does State Fabric pricing show up?</dt>
          <dd>
            State Fabric tiers are billed alongside your workspace plan. Optional add-ons can be enabled to increase performance, security, or analytics—confirm live rates in your billing page.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Can we upgrade or downgrade?</dt>
          <dd>Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.</dd>
        </div>
        <div class="faq-item">
          <dt>What does Enterprise include?</dt>
          <dd>
            Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. <a href="/contact">Contact sales</a> with your requirements.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Ready to ship trusted tools?</h2>
      <p class="muted">Create a workspace, connect providers, and see live limits.</p>
      <div class="actions">
        <a class="btn primary" href={`${AUTH_ORIGIN}/signup`}>Try now</a>
        <a class="btn secondary" href="/contact">Talk to sales</a>
      </div>
    </div>
  </section>

  <script>
    const toggleBtns = document.querySelectorAll('.toggle-btn');
    const priceAmounts = document.querySelectorAll('.price-amount[data-monthly]');
    const annualNotes = document.querySelectorAll('.annual-note');
    const cards = document.querySelectorAll('.price-card[data-plan]');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const period = btn.dataset.period;

        toggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        priceAmounts.forEach(el => {
          const monthly = el.dataset.monthly;
          const annual = el.dataset.annual;
          el.textContent = period === 'annual' ? annual : monthly;
        });

        annualNotes.forEach(note => {
          note.style.display = period === 'annual' ? 'flex' : 'none';
        });

        cards.forEach(card => {
          if (period === 'annual') {
            card.classList.add('annual-selected');
          } else {
            card.classList.remove('annual-selected');
          }
        });
      });
    });
  </script>

</Layout>
