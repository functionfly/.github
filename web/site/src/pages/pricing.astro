---
import Layout from '../layouts/Layout.astro';
import '../styles/pricing.css';
import { APP_DASHBOARD_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN } from '../config';

// FAQPage schema for the FAQ section (rich results eligibility)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do prices include tax?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the Trust API and verification billing work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can we upgrade or downgrade?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does Enterprise include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. Contact sales with your requirements.',
      },
    },
  ],
};

// SoftwareApplication schema for the product
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FunctionFly',
  applicationCategory: 'DeveloperApplication',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free Tier',
      price: '0',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '24',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Professional',
      price: '79',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Enterprise',
      price: '299',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Agent Enterprise',
      price: '499',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '127',
  },
  operatingSystem: 'Any (Cloud-based)',
  url: `${SITE_ORIGIN}/pricing`,
};

const pricingSchemas = [faqSchema, productSchema];
---

<Layout
  title="Pricing — FunctionFly"
  description="Platform plans for functions, providers, and AI agents. Start free; scale with Starter, Professional, or Enterprise. State Fabric and advanced agent execution on the details page."
  schema={pricingSchemas}
  ogImage="/og-pricing.svg"
>
  <section class="pricing-hero">
    <div class="container">
      <div class="badge">Plans &amp; limits</div>
      <h1>Simple pricing that scales with trust</h1>
      <p class="lead">
        Start free. Paid tiers include AI agents with generous call volumes and concurrency. Upgrade as your agent workloads grow.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Platform</h2>
        <p class="muted">Functions, hosting providers, custom domains, vault secrets, and collaboration—priced per workspace.</p>
      </div>

      {/* Billing Cycle Toggle */}
      <div class="billing-toggle-wrap">
        <div class="billing-toggle">
          <button class="toggle-btn active" data-period="monthly">Monthly</button>
          <button class="toggle-btn" data-period="annual">
            Annual
            <span class="save-badge">Save 20%</span>
          </button>
        </div>
      </div>

      <div class="pricing-grid">
        <article class="price-card">
          <h3 class="tier-name">Free</h3>
          <div class="price-row">
            <span class="price-amount">$0</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">For side projects and experimentation.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> 3 functions</li>
            <li><span class="check" aria-hidden="true">✓</span> 2 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> 500 requests / month</li>
            <li><span class="check" aria-hidden="true">✓</span> 3 AI agents, 10K calls/mo</li>
            <li><span class="check" aria-hidden="true">✓</span> Community support</li>
            <li class="tm-feature"><span class="check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 24h replay window, 100 executions</li>
            <li class="consciousness-feature"><span aria-hidden="true">—</span> <strong>Consciousness:</strong> Not included on Free</li>
          </ul>
          <a class="btn btn-secondary full-width" href={`${AUTH_ORIGIN}/signup`}>Start free</a>
        </article>

        <article class="price-card" data-plan="starter">
          <h3 class="tier-name">Starter</h3>
          <div class="price-row">
            <span class="price-amount" data-monthly="$24" data-annual="$20">$24</span>
            <span class="price-period">/ month</span>
          </div>
          <div class="annual-note" style="display: none;">$240 billed annually</div>
          <p class="tier-desc">For side projects and MVPs.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> 5 functions</li>
            <li><span class="check" aria-hidden="true">✓</span> 2 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> 1M requests / month</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 custom domain</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: up to 3 instances</li>
            <li><span class="check" aria-hidden="true">✓</span> AI Agents: 10 agents, 100K calls/mo, 10 concurrency</li>
            <li><span class="check" aria-hidden="true">✓</span> Email support &amp; basic analytics</li>
            <li class="tm-feature"><span class="check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 72h window, 1,000 execs/replay</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${AUTH_ORIGIN}/signup?plan=starter`}>Choose Starter</a>
        </article>

        <article class="price-card price-card--featured" data-plan="professional">
          <h3 class="tier-name">Professional</h3>
          <div class="price-row">
            <span class="price-amount" data-monthly="$79" data-annual="$66">$79</span>
            <span class="price-period">/ month</span>
          </div>
          <div class="annual-note" style="display: none;">$792 billed annually</div>
          <p class="tier-desc">For growing teams and production SaaS.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> 25 functions</li>
            <li><span class="check" aria-hidden="true">✓</span> 3 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> 10M requests / month</li>
            <li><span class="check" aria-hidden="true">✓</span> 5 custom domains</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: up to 10 instances</li>
            <li><span class="check" aria-hidden="true">✓</span> AI Agents: 100 agents, 1M calls/mo, 100 concurrency</li>
            <li><span class="check" aria-hidden="true">✓</span> 99.9% SLA, priority support</li>
            <li><span class="check" aria-hidden="true">✓</span> Advanced analytics &amp; team collaboration</li>
            <li class="tm-feature"><span class="check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 30-day window, 10K execs, dry-run reconciliation</li>
            <li class="consciousness-feature"><span class="check" aria-hidden="true">✓</span> <strong>Consciousness:</strong> system awareness score, daily digest, 7-day lookback</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=functions&plan=professional`}>Choose Professional</a>
        </article>

        <article class="price-card" data-plan="enterprise">
          <h3 class="tier-name">Enterprise</h3>
          <div class="price-row">
            <span class="price-amount" data-monthly="$299" data-annual="$249">$299</span>
            <span class="price-period">/ month</span>
          </div>
          <div class="annual-note" style="display: none;">$2990 billed annually</div>
          <p class="tier-desc">For large-scale apps, compliance, and custom trust policies.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Unlimited functions &amp; requests</li>
            <li><span class="check" aria-hidden="true">✓</span> 5 providers</li>
            <li><span class="check" aria-hidden="true">✓</span> State Fabric: unlimited instances</li>
            <li><span class="check" aria-hidden="true">✓</span> AI Agents: 500 agents, 5M calls/mo, 500 concurrency</li>
            <li><span class="check" aria-hidden="true">✓</span> 99.99% SLA &amp; dedicated support</li>
            <li><span class="check" aria-hidden="true">✓</span> Custom integrations &amp; onboarding</li>
            <li class="tm-feature"><span class="check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 90-day window, 100K execs, live reconciliation, SOC2/HIPAA audit certs</li>
            <li class="consciousness-feature"><span class="check" aria-hidden="true">✓</span> <strong>Consciousness:</strong> real-time insights, predictive alerts, Slack &amp; webhook, auto-fix proposals, 30-day lookback</li>
          </ul>
          <a class="btn btn-secondary full-width" href="/contact">Contact sales</a>
        </article>
      </div>
      <p class="footnote">
        Limits and features match what your workspace shows. Verification, marketplace, and Trust API usage may be billed separately—see <a href="/trust">Trust layer</a> and in-product usage for current rates.
      </p>

      <div class="comparison-table-wrap">
        <h3 class="comparison-title">Compare platform plans</h3>
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Free</th>
              <th scope="col">Starter</th>
              <th scope="col">Professional</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Functions</td>
              <td>3</td>
              <td>5</td>
              <td>25</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Providers</td>
              <td>2</td>
              <td>2</td>
              <td>3</td>
              <td>5</td>
            </tr>
            <tr>
              <td>Custom domains</td>
              <td>—</td>
              <td>1</td>
              <td>5</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Requests / month</td>
              <td>500</td>
              <td>1M</td>
              <td>10M</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>AI Agents</td>
              <td>3</td>
              <td>10</td>
              <td>100</td>
              <td>500</td>
            </tr>
            <tr>
              <td>AI Agents calls / mo</td>
              <td>10K</td>
              <td>100K</td>
              <td>1M</td>
              <td>5M</td>
            </tr>
            <tr>
              <td>AI Agents concurrency</td>
              <td>3</td>
              <td>10</td>
              <td>100</td>
              <td>500</td>
            </tr>
            <tr>
              <td>Time Machine</td>
              <td>24h / 100 execs</td>
              <td>72h / 1K execs</td>
              <td>30d / 10K execs</td>
              <td>90d / 100K execs</td>
            </tr>
            <tr>
              <td>Consciousness</td>
              <td>—</td>
              <td>—</td>
              <td>7-day lookback</td>
              <td>30-day lookback</td>
            </tr>
            <tr>
              <td>SLA</td>
              <td>—</td>
              <td>—</td>
              <td>99.9%</td>
              <td>99.99%</td>
            </tr>
            <tr>
              <td>Support</td>
              <td>Community</td>
              <td>Email</td>
              <td>Priority</td>
              <td>Dedicated</td>
            </tr>
          </tbody>
        </table>
      </div>

      </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Agent execution</h2>
        <p class="muted">
          Run tool calls, state, and memory for AI agents on dedicated infrastructure. Add an agent plan when you outgrow experimentation.
        </p>
      </div>
      <div class="agent-table-wrap">
        <table class="agent-table">
          <thead>
            <tr>
              <th scope="col">Plan</th>
              <th scope="col">From</th>
              <th scope="col">Includes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Free</strong></td>
              <td class="agent-price-cell"><span class="price-amount" data-monthly="Included" data-annual="Included">Included</span></td>
              <td class="muted-cell">3 agents, basic discovery</td>
            </tr>
            <tr>
              <td><strong>Bundled</strong> (Starter &amp; Professional)</td>
              <td class="agent-price-cell"><span class="price-amount" data-monthly="Included" data-annual="Included">Included</span></td>
              <td class="muted-cell">10–100 agents, 100K–1M calls/mo, up to 500 concurrency</td>
            </tr>
            <tr>
              <td><strong>Enterprise</strong></td>
              <td class="agent-price-cell"><span class="price-amount" data-monthly="$299 / mo" data-annual="$249 / mo">$299 / mo</span></td>
              <td class="muted-cell">500 agents, 5M calls/mo, 2K calls/min, $0.05/1K overage</td>
            </tr>
            <tr>
              <td><strong>Agent Enterprise</strong></td>
              <td class="agent-price-cell"><span class="price-amount" data-monthly="$499 / mo" data-annual="$399 / mo">$499 / mo</span></td>
              <td class="muted-cell">Unlimited AI calls, unlimited agents, dedicated infrastructure</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="agent-cta">
        <a class="btn btn-primary" href={`${AUTH_ORIGIN}/signup`}>Configure</a>
        <a class="btn btn-secondary" href="/for-agents">For AI agents</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="details-cta">
        <h3>Need more details?</h3>
        <div class="details-cta-links">
          <a class="details-cta-card" href="/pricing-details?tab=state-fabric">
            <span class="details-cta-icon">🧵</span>
            <span class="details-cta-label">State Fabric</span>
            <span class="details-cta-sub">5 plans, add-ons &amp; storage pricing</span>
          </a>
          <a class="details-cta-card" href="/pricing-details?tab=agents">
            <span class="details-cta-icon">🤖</span>
            <span class="details-cta-label">Agent execution</span>
            <span class="details-cta-sub">Full agent table &amp; overage rates</span>
          </a>
          <a class="details-cta-card" href="/pricing-details?tab=bundles">
            <span class="details-cta-icon">📦</span>
            <span class="details-cta-label">Bundles</span>
            <span class="details-cta-sub">Backend-in-a-Box plans</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container container--narrow">
      <h2>Frequently asked questions</h2>
      <dl class="faq">
        <div class="faq-item">
          <dt>Do prices include tax?</dt>
          <dd>Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.</dd>
        </div>
        <div class="faq-item">
          <dt>How does the Trust API and verification billing work?</dt>
          <dd>
            Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.
          </dd>
        </div>
        <div class="faq-item">
          <dt>Can we upgrade or downgrade?</dt>
          <dd>Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.</dd>
        </div>
        <div class="faq-item">
          <dt>What does Enterprise include?</dt>
          <dd>
            Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. <a href="/contact">Contact sales</a> with your requirements.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Ready to ship trusted tools?</h2>
      <p class="muted">Create a workspace, connect providers, and see live limits.</p>
      <div class="actions">
        <a class="btn primary" href={`${AUTH_ORIGIN}/signup`}>Try now</a>
        <a class="btn secondary" href="/contact">Talk to sales</a>
      </div>
    </div>
  </section>

  <script>
    const toggleBtns = document.querySelectorAll('.toggle-btn');
    const priceAmounts = document.querySelectorAll('.price-amount[data-monthly]');
    const annualNotes = document.querySelectorAll('.annual-note');
    const cards = document.querySelectorAll('.price-card[data-plan]');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const period = btn.dataset.period;

        toggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        priceAmounts.forEach(el => {
          const monthly = el.dataset.monthly;
          const annual = el.dataset.annual;
          el.textContent = period === 'annual' ? annual : monthly;
        });

        annualNotes.forEach(note => {
          note.style.display = period === 'annual' ? 'flex' : 'none';
        });

        cards.forEach(card => {
          if (period === 'annual') {
            card.classList.add('annual-selected');
          } else {
            card.classList.remove('annual-selected');
          }
        });
      });
    });
  </script>

</Layout>
