---
import Layout from '../layouts/Layout.astro';
import '../styles/sc-main.css';
import PricingPage from '../components/PricingPage.tsx';
import { APP_DASHBOARD_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN, DOCS_ORIGIN } from '../config';

const docsGuidesUrl = `${DOCS_ORIGIN.replace(/\/\$/, '')}/docs/`;

// FAQPage schema for the FAQ section (rich results eligibility)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do prices include tax?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the Trust API and verification billing work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can we upgrade or downgrade?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does Enterprise include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. Contact sales with your requirements.',
      },
    },
  ],
};

// SoftwareApplication schema for the product
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FunctionFly',
  applicationCategory: 'DeveloperApplication',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free Tier',
      price: '0',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '24',
      priceCurrency: 'USD',
      priceValidUntil: '2028-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Professional',
      price: '79',
      priceCurrency: 'USD',
      priceValidUntil: '2028-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Enterprise',
      price: '299',
      priceCurrency: 'USD',
      priceValidUntil: '2028-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Agent Enterprise',
      price: '499',
      priceCurrency: 'USD',
      priceValidUntil: '2028-12-31',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '127',
  },
  operatingSystem: 'Any (Cloud-based)',
  url: `${SITE_ORIGIN}/pricing`,
};

const pricingSchemas = [faqSchema, productSchema];
---

<Layout
  title="Pricing — FunctionFly"
  description="Platform plans for functions, providers, and AI agents. Start free; scale with Starter, Professional, or Enterprise. State Fabric and advanced agent execution on the details page."
  schema={pricingSchemas}
  ogImage="/og-pricing.svg"
>
  <PricingPage client:load />
</Layout>
