---
import Layout from '../layouts/Layout.astro';
import '../styles/design-system.css';
import '../components/homepage.css';
import '../components/pricing.css';
import { APP_DASHBOARD_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN, DOCS_ORIGIN } from '../config';

const docsGuidesUrl = `${DOCS_ORIGIN.replace(/\/\$/, '')}/docs/`;

// FAQPage schema for the FAQ section (rich results eligibility)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do prices include tax?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the Trust API and verification billing work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can we upgrade or downgrade?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does Enterprise include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. Contact sales with your requirements.',
      },
    },
  ],
};

// SoftwareApplication schema for the product
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FunctionFly',
  applicationCategory: 'DeveloperApplication',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free Tier',
      price: '0',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '24',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Professional',
      price: '79',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Enterprise',
      price: '299',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
    {
      '@type': 'Offer',
      name: 'Agent Enterprise',
      price: '499',
      priceCurrency: 'USD',
      priceValidUntil: '2026-12-31',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '127',
  },
  operatingSystem: 'Any (Cloud-based)',
  url: `${SITE_ORIGIN}/pricing`,
};

const pricingSchemas = [faqSchema, productSchema];
---

<Layout
  title="Pricing — FunctionFly"
  description="Platform plans for functions, providers, and AI agents. Start free; scale with Starter, Professional, or Enterprise. State Fabric and advanced agent execution on the details page."
  schema={pricingSchemas}
  ogImage="/og-pricing.svg"
>
  <section class="pricing-hero">
    <div class="pricing-hero-inner">
      <div class="pricing-hero-eyebrow">
        <span class="ff-pulse-dot" />
        <span>Infrastructure layer</span>
        <span class="ff-live-badge">LIVE</span>
      </div>
      <h1 class="ff-hero-headline">
        Pricing built for <span class="ff-flame-text">trust</span>
      </h1>
      <p class="pricing-hero-lead">
        Start free. Paid tiers include AI agents with generous call volumes and concurrency. Upgrade as your agent workloads grow.
      </p>
      <div class="ff-hero-actions">
        <a href={`${AUTH_ORIGIN}/signup`} class="ff-btn ff-btn-primary ff-btn-xl ff-glow">
          <span>Get started</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8L13 8M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={docsGuidesUrl} class="ff-btn ff-btn-secondary ff-btn-xl" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M7 1L7 15M1 8L15 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span>Read the docs</span>
        </a>
      </div>
    </div>
  </section>

  <section class="pricing-section">
    <div class="pricing-section-inner">
      <div class="pricing-section-head">
        <div class="pricing-section-label">Platform</div>
        <h2 class="pricing-section-title">Platform</h2>
        <p class="pricing-section-sub">Functions, hosting providers, custom domains, vault secrets, and collaboration—priced per workspace.</p>
      </div>

      {/* Billing Cycle Toggle */}
      <div class="pricing-toggle-wrap">
        <div class="pricing-toggle">
          <button class="pricing-toggle-btn active" data-period="monthly">Monthly</button>
          <button class="pricing-toggle-btn" data-period="annual">
            Annual
            <span class="pricing-save-badge">Save 20%</span>
          </button>
        </div>
      </div>

      <div class="pricing-grid">
<article class="pricing-card">
          <h3 class="pricing-tierName">Free</h3>
          <div class="pricing-price">
            <span class="pricing-price-amount">$0</span>
            <span class="pricing-price-period">/ month</span>
          </div>
          <p class="pricing-tier-desc">For side projects and experimentation.</p>
          <ul class="pricing-features">
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 3 functions</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 2 providers</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 25K requests / month</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 3 AI agents, 10K calls/mo</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> Community support</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Zero-Knowledge Vault:</strong> 25 secrets, expiration</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 24h replay window, 100 executions</li>
            <li class="pricing-feature-special"><span aria-hidden="true">—</span> <strong>Consciousness:</strong> Not included on Free</li>
          </ul>
          <a class="pricing-btn pricing-btn-secondary" href={`${AUTH_ORIGIN}/signup`}>Start free</a>
        </article>

        <article class="pricing-card" data-plan="starter">
          <h3 class="pricing-tier-name">Starter</h3>
          <div class="pricing-price">
            <span class="pricing-price-amount" data-monthly="$24" data-annual="$20">$24</span>
            <span class="pricing-price-period">/ month</span>
          </div>
          <div class="pricing-annual-note" style="display: none;">$240 billed annually</div>
          <p class="pricing-tier-desc">For side projects and MVPs.</p>
          <ul class="pricing-features">
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 5 functions</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 2 providers</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 250K requests / month</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 1 custom domain</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> State Fabric: up to 3 instances</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> AI Agents: 10 agents, 100K calls/mo, 10 concurrency</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> Email support &amp; basic analytics</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Zero-Knowledge Vault:</strong> 500 secrets, expiration</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 72h window, 1,000 execs/replay</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Consciousness:</strong> system awareness score, daily digest, 7-day lookback</li>
          </ul>
          <a class="pricing-btn pricing-btn-primary" href={`${AUTH_ORIGIN}/signup?plan=starter`}>Choose Starter</a>
        </article>

        <article class="pricing-card pricing-card--featured" data-plan="professional">
          <span class="pricing-featured-badge">Popular</span>
          <h3 class="pricing-tier-name">Professional</h3>
          <div class="pricing-price">
            <span class="pricing-price-amount" data-monthly="$79" data-annual="$66">$79</span>
            <span class="pricing-price-period">/ month</span>
          </div>
          <div class="pricing-annual-note" style="display: none;">$792 billed annually</div>
          <p class="pricing-tier-desc">For growing teams and production SaaS.</p>
          <ul class="pricing-features">
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 25 functions</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 3 providers</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 2.5M requests / month</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 5 custom domains</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> State Fabric: up to 10 instances</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> AI Agents: 100 agents, 1M calls/mo, 100 concurrency</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 99.9% SLA, priority support</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> Advanced analytics &amp; team collaboration</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Zero-Knowledge Vault:</strong> 5K secrets, MFA, IP allowlist, break-glass</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 30-day window, 10K execs, dry-run reconciliation</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Consciousness:</strong> system awareness score, daily digest, 7-day lookback</li>
          </ul>
          <a class="pricing-btn pricing-btn-primary" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=functions&plan=professional`}>Choose Professional</a>
        </article>

        <article class="pricing-card" data-plan="enterprise">
          <h3 class="pricing-tier-name">Enterprise</h3>
          <div class="pricing-price">
            <span class="pricing-price-amount" data-monthly="$299" data-annual="$249">$299</span>
            <span class="pricing-price-period">/ month</span>
          </div>
          <div class="pricing-annual-note" style="display: none;">$2990 billed annually</div>
          <p class="pricing-tier-desc">For large-scale apps, compliance, and custom trust policies.</p>
          <ul class="pricing-features">
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> Unlimited functions &amp; requests</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 5 providers</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> State Fabric: unlimited instances</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> AI Agents: 500 agents, 5M calls/mo, 500 concurrency</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> 99.99% SLA &amp; dedicated support</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> Custom integrations &amp; onboarding</li>
            <li><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Zero-Knowledge Vault:</strong> 1M secrets, MFA, IP allowlist, break-glass, RBAC, SIEM, escrow</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Time Machine:</strong> 90-day window, 100K execs, live reconciliation, SOC2/HIPAA audit certs</li>
            <li class="pricing-feature-special"><span class="pricing-feature-check" aria-hidden="true">✓</span> <strong>Consciousness:</strong> real-time insights, predictive alerts, Slack &amp; webhook, auto-fix proposals, 30-day lookback</li>
          </ul>
          <a class="pricing-btn pricing-btn-secondary" href="/contact">Contact sales</a>
        </article>
      </div>
      <p class="pricing-footnote">
        Limits and features match what your workspace shows. Verification, marketplace, and Trust API usage may be billed separately—see <a href="/trust">Trust layer</a> and in-product usage for current rates.
      </p>

      <div class="pricing-compare-wrap">
        <h3 class="pricing-compare-title">Compare platform plans</h3>
        <table class="pricing-compare-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Free</th>
              <th scope="col">Starter</th>
              <th scope="col">Professional</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Functions</td>
              <td>3</td>
              <td>5</td>
              <td>25</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Providers</td>
              <td>2</td>
              <td>2</td>
              <td>3</td>
              <td>5</td>
            </tr>
            <tr>
              <td>Custom domains</td>
              <td>—</td>
              <td>1</td>
              <td>5</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Requests / month</td>
              <td>25K</td>
              <td>250K</td>
              <td>2.5M</td>
              <td>25M</td>
            </tr>
            <tr>
              <td>AI Agents</td>
              <td>3</td>
              <td>10</td>
              <td>100</td>
              <td>500</td>
            </tr>
            <tr>
              <td>AI Agents calls / mo</td>
              <td>10K</td>
              <td>100K</td>
              <td>1M</td>
              <td>5M</td>
            </tr>
            <tr>
              <td>AI Agents concurrency</td>
              <td>3</td>
              <td>10</td>
              <td>100</td>
              <td>500</td>
            </tr>
            <tr>
              <td>Time Machine</td>
              <td>24h / 100 execs</td>
              <td>72h / 1K execs</td>
              <td>30d / 10K execs</td>
              <td>90d / 100K execs</td>
            </tr>
            <tr>
              <td>Consciousness</td>
              <td>—</td>
              <td>7-day lookback</td>
              <td>7-day lookback</td>
              <td>30-day lookback</td>
            </tr>
            <tr>
              <td>SLA</td>
              <td>—</td>
              <td>—</td>
              <td>99.9%</td>
              <td>99.99%</td>
            </tr>
            <tr>
              <td>Support</td>
              <td>Community</td>
              <td>Email</td>
              <td>Priority</td>
              <td>Dedicated</td>
            </tr>
            <tr>
              <td>Zero-Knowledge Vault</td>
              <td>25 secrets</td>
              <td>500 secrets</td>
              <td>5,000 secrets</td>
              <td>1M secrets</td>
            </tr>
          </tbody>
        </table>
      </div>

      </div>
  </section>

  <section class="pricing-section pricing-section--alt">
    <div class="pricing-section-inner">
      <div class="pricing-section-head">
        <div class="pricing-section-label">Agent execution</div>
        <h2 class="pricing-section-title">Agent execution</h2>
        <p class="pricing-section-sub">
          Run tool calls, state, and memory for AI agents on dedicated infrastructure. Add an agent plan when you outgrow experimentation.
        </p>
      </div>
      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead>
            <tr>
              <th scope="col">Plan</th>
              <th scope="col">From</th>
              <th scope="col">Includes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Free</strong></td>
              <td><span class="pricing-price-amount" data-monthly="Included" data-annual="Included">Included</span></td>
              <td>3 agents, 10K calls/mo, dynamic creds (PostgreSQL)</td>
            </tr>
            <tr>
              <td><strong>Bundled</strong> (Starter &amp; Professional)</td>
              <td><span class="pricing-price-amount" data-monthly="Included" data-annual="Included">Included</span></td>
              <td>10–100 agents, 100K–1M calls/mo, up to 500 concurrency, dynamic creds</td>
            </tr>
            <tr>
              <td><strong>Enterprise</strong></td>
              <td><span class="pricing-price-amount" data-monthly="$299 / mo" data-annual="$249 / mo">$299 / mo</span></td>
              <td>500 agents, 5M calls/mo, 2K calls/min, dynamic creds (PostgreSQL + MySQL)</td>
            </tr>
            <tr>
              <td><strong>Agent Enterprise</strong></td>
              <td><span class="pricing-price-amount" data-monthly="$499 / mo" data-annual="$399 / mo">$499 / mo</span></td>
              <td>Unlimited AI calls, unlimited agents, dedicated infrastructure, SSO, HA status</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="pricing-agent-cta">
        <a class="pricing-btn pricing-btn-primary" href={`${AUTH_ORIGIN}/signup`}>Configure</a>
        <a class="pricing-btn pricing-btn-secondary" href="/for-agents">For AI agents</a>
      </div>
    </div>
  </section>

  <section class="pricing-section">
    <div class="pricing-section-inner">
      <div class="pricing-section-head">
        <h2 class="pricing-section-title">Need more details?</h2>
      </div>
      <div class="pricing-details-grid">
        <a class="pricing-detail-card" href="/state-fabric">
          <span class="pricing-detail-icon">🧵</span>
          <span class="pricing-detail-label">State Fabric</span>
          <span class="pricing-detail-sub">5 plans, add-ons &amp; storage pricing</span>
        </a>
<a class="pricing-detail-card" href="/agent-execution">
          <span class="pricing-detail-icon">🤖</span>
          <span class="pricing-detail-label">Agent execution</span>
          <span class="pricing-detail-sub">Tool calls, state, memory & credentials</span>
        </a>
        <a class="pricing-detail-card" href="/bundles">
          <span class="pricing-detail-icon">📦</span>
          <span class="pricing-detail-label">Bundles</span>
          <span class="pricing-detail-sub">Backend-in-a-Box plans</span>
        </a>
      </div>
    </div>
  </section>

  <section class="pricing-section">
    <div class="pricing-section-inner">
      <div class="pricing-section-head">
        <div class="pricing-section-label">FAQ</div>
        <h2 class="pricing-section-title">Frequently asked questions</h2>
      </div>
      <dl class="pricing-faq">
        <div class="pricing-faq-item">
          <dt class="pricing-faq-question">Do prices include tax?</dt>
          <dd class="pricing-faq-answer">Listed prices are in USD before applicable taxes. Your invoice will reflect tax rules for your billing address.</dd>
        </div>
        <div class="pricing-faq-item">
          <dt class="pricing-faq-question">How does the Trust API and verification billing work?</dt>
          <dd class="pricing-faq-answer">
            Trust scores, attestations, and verification levels are part of the trust layer. Usage-based components are metered separately so you only pay for what agents and policies query—details appear alongside your workspace usage.
          </dd>
        </div>
        <div class="pricing-faq-item">
          <dt class="pricing-faq-question">Can we upgrade or downgrade?</dt>
          <dd class="pricing-faq-answer">Yes. Move between platform tiers as your traffic and team change; agent plans can be adjusted when your concurrency and call volume need it.</dd>
        </div>
        <div class="pricing-faq-item">
          <dt class="pricing-faq-question">What does Enterprise include?</dt>
          <dd class="pricing-faq-answer">
            Volume pricing, custom SLAs, security questionnaires, SSO, and tailored trust policies. <a href="/contact">Contact sales</a> with your requirements.
          </dd>
        </div>
        <div class="pricing-faq-item">
          <dt class="pricing-faq-question">What is the Zero-Knowledge Vault?</dt>
          <dd class="pricing-faq-answer">
            Client-side encrypted secrets storage—your passphrase and secrets are never sent to our servers. All encryption uses AES-256-GCM in your browser. Free includes 25 secrets, Starter 500, Professional 5,000, and Enterprise unlimited.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="pricing-cta">
    <div class="pricing-cta-inner">
      <h2>Ready to ship trusted tools?</h2>
      <p class="pricing-cta-sub">Create a workspace, connect providers, and see live limits.</p>
      <div class="pricing-cta-actions">
        <a class="pricing-btn pricing-btn-primary" href={`${AUTH_ORIGIN}/signup`}>Try now</a>
        <a class="pricing-btn pricing-btn-secondary" href="/contact">Talk to sales</a>
      </div>
    </div>
  </section>

  <script>
    const toggleBtns = document.querySelectorAll('.pricing-toggle-btn');
    const priceAmounts = document.querySelectorAll('.pricing-price-amount[data-monthly]');
    const annualNotes = document.querySelectorAll('.pricing-annual-note');
    const cards = document.querySelectorAll('.pricing-card[data-plan]');

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const period = btn.dataset.period;

        toggleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        priceAmounts.forEach(el => {
          const monthly = el.dataset.monthly;
          const annual = el.dataset.annual;
          el.textContent = period === 'annual' ? annual : monthly;
        });

        annualNotes.forEach(note => {
          note.style.display = period === 'annual' ? 'flex' : 'none';
        });

        cards.forEach(card => {
          if (period === 'annual') {
            card.classList.add('annual-selected');
          } else {
            card.classList.remove('annual-selected');
          }
        });
      });
    });
  </script>

</Layout>
