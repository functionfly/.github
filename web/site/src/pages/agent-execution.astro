---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import AgentExecutionPage from '../components/AgentExecutionPage.tsx';

const title = 'Agent Execution Pricing — FunctionFly';
const description = 'Agent execution plans, tool calls, dynamic credentials, and memory for AI agents. From free to enterprise scale.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <AgentExecutionPage client:load />
</Layout>