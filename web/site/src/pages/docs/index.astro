---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = "Documentation - FunctionFly | Serverless Reliability Platform";
const description = "Complete documentation for FunctionFly. Learn how to set up multi-cloud serverless failover, configure providers, and monitor your applications.";

const docs = await getCollection('docs');
const categories = [...new Set(docs.map(doc => doc.data.category))];

const docsByCategory = categories.reduce((acc, category) => {
  acc[category] = docs.filter(doc => doc.data.category === category);
  return acc;
}, {} as Record<string, typeof docs>);
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-text-primary mb-6">
            FunctionFly
            <span class="text-accent-primary block">Documentation</span>
          </h1>
          <p class="text-xl md:text-2xl text-text-secondary mb-8 max-w-3xl mx-auto">
            Everything you need to know about setting up and managing multi-cloud serverless failover.
          </p>

          <!-- Search Placeholder -->
          <div class="max-w-md mx-auto mb-8">
            <div class="relative">
              <input
                type="text"
                placeholder="Search documentation..."
                class="w-full px-4 py-3 bg-bg-secondary border border-text-secondary/20 rounded-lg text-text-primary placeholder-text-secondary focus:outline-none focus:border-accent-primary"
                disabled
              />
              <div class="absolute right-3 top-3 text-text-secondary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
            </div>
            <p class="text-sm text-text-secondary mt-2">Search coming soon with Pagefind integration</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Docs Content -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {Object.entries(docsByCategory).map(([category, categoryDocs]) => (
          <div class="mb-16">
            <h2 class="text-3xl font-bold text-text-primary mb-8">{category}</h2>
            <div class="grid md:grid-cols-2 gap-6">
              {categoryDocs.map((doc) => (
                <a
                  href={`/docs/${doc.slug}`}
                  class="block bg-bg-secondary rounded-xl p-6 border border-text-secondary/20 hover:border-accent-primary transition-colors"
                >
                  <h3 class="text-xl font-semibold text-text-primary mb-2">{doc.data.title}</h3>
                  <p class="text-text-secondary mb-4">{doc.data.description}</p>
                  <div class="flex items-center text-sm text-text-secondary">
                    <span>Updated {doc.data.updatedDate.toLocaleDateString()}</span>
                    <span class="mx-2">•</span>
                    <div class="flex gap-1">
                      {doc.data.tags.slice(0, 3).map((tag) => (
                        <span class="bg-accent-primary/10 text-accent-primary px-2 py-1 rounded text-xs">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Help Section -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-text-primary mb-4">Need Help?</h2>
        <p class="text-xl text-text-secondary mb-8">
          Can't find what you're looking for? Our community and support team are here to help.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://discord.gg/functionfly"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors"
          >
            Join Discord Community
          </a>
          <a
            href="https://github.com/functionfly/functionfly/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="border border-text-secondary hover:border-accent-primary text-text-primary hover:text-accent-primary px-8 py-4 rounded-lg font-semibold text-lg transition-colors"
          >
            Report Issue
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>