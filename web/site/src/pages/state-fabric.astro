---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import StateFabricPage from '../components/StateFabricPage.tsx';

const title = 'State Fabric Pricing — FunctionFly';
const description = 'State Fabric plans, add-ons, and storage pricing. Stateful capabilities for serverless from Sandbox to Enterprise.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <StateFabricPage client:load />
</Layout>
