---
import Layout from '../layouts/Layout.astro';
import '../styles/pricing.css';
import { APP_DASHBOARD_ORIGIN, AUTH_ORIGIN, SITE_ORIGIN } from '../config';
---

<Layout
  title="State Fabric Pricing — FunctionFly"
  description="State Fabric plans, add-ons, and storage pricing. Stateful capabilities for serverless from Sandbox to Enterprise."
>
  <section class="details-hero">
    <div class="container">
      <div class="badge">State Fabric</div>
      <h1>Stateful capabilities for serverless</h1>
      <p class="lead">
        From sandbox experimentation to enterprise-grade state management. Start free and scale up as your application grows.
        <a href="/pricing">← Back to simplified pricing</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="statefabric-grid">
        <article class="price-card">
          <h3 class="tier-name">Sandbox</h3>
          <div class="price-row">
            <span class="price-amount">$0</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Great for experimentation &amp; onboarding.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Stateless usage</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 state object</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 GB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 10,000 state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 7-day snapshot retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Community support</li>
          </ul>
          <a class="btn btn-secondary full-width" href={`${AUTH_ORIGIN}/signup`}>Try now — free</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Starter</h3>
          <div class="price-row">
            <span class="price-amount">$19</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Internal dev &amp; small side projects.</p>
          <div class="tier-desc tier-desc--tight">Storage: $0.10/GB · Ops: $0.50/100k</div>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Up to 5 state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> 10 GB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 100,000 state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 30-day snapshot retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Basic snapshot scheduling</li>
            <li><span class="check" aria-hidden="true">✓</span> Replay engine (limited)</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=state-fabric&plan=sf_starter`}>Choose Starter</a>
        </article>

        <article class="price-card price-card--featured">
          <h3 class="tier-name">Pro</h3>
          <div class="price-row">
            <span class="price-amount">$99</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Production apps &amp; team projects.</p>
          <div class="tier-desc tier-desc--tight">Storage: $0.08/GB · Ops: $0.35/100k</div>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Up to 50 state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> 100 GB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 1M state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 90-day snapshot retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Hot cache tier</li>
            <li><span class="check" aria-hidden="true">✓</span> Fast deterministic replay</li>
            <li><span class="check" aria-hidden="true">✓</span> Replay API + billing analytics</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=state-fabric&plan=sf_pro`}>Choose Pro</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Business</h3>
          <div class="price-row">
            <span class="price-amount">$499</span>
            <span class="price-period">/ month</span>
          </div>
          <p class="tier-desc">Business-critical systems.</p>
          <div class="tier-desc tier-desc--tight">Storage: $0.06/GB · Archive: $30/TB/mo</div>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Up to 500 state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> 1 TB event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> 10M state ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 180-day retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Multi-region replication</li>
            <li><span class="check" aria-hidden="true">✓</span> Dedicated hot cache</li>
            <li><span class="check" aria-hidden="true">✓</span> SLA + advanced analytics</li>
            <li><span class="check" aria-hidden="true">✓</span> Event subscription streams</li>
          </ul>
          <a class="btn btn-primary full-width" href={`${APP_DASHBOARD_ORIGIN}/pricing?tab=state-fabric&plan=sf_business`}>Choose Business</a>
        </article>

        <article class="price-card">
          <h3 class="tier-name">Enterprise</h3>
          <div class="price-row">
            <span class="price-amount price-amount--custom">Custom</span>
          </div>
          <p class="tier-desc">Large enterprises &amp; regulated industries.</p>
          <ul class="feature-list">
            <li><span class="check" aria-hidden="true">✓</span> Unlimited state objects</li>
            <li><span class="check" aria-hidden="true">✓</span> Unlimited event storage</li>
            <li><span class="check" aria-hidden="true">✓</span> Unlimited ops</li>
            <li><span class="check" aria-hidden="true">✓</span> 365-day retention</li>
            <li><span class="check" aria-hidden="true">✓</span> Multi-region + edge replication</li>
            <li><span class="check" aria-hidden="true">✓</span> Enterprise key management (BYOK)</li>
            <li><span class="check" aria-hidden="true">✓</span> Immutable audit logs</li>
            <li><span class="check" aria-hidden="true">✓</span> Replay export · Dedicated support</li>
          </ul>
          <a class="btn btn-secondary full-width" href="/contact">Contact sales</a>
        </article>
      </div>

      <div class="statefabric-table-wrap">
        <h3 class="comparison-title">Compare State Fabric plans</h3>
        <table class="agent-table statefabric-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Sandbox</th>
              <th scope="col">Starter</th>
              <th scope="col">Pro</th>
              <th scope="col">Business</th>
              <th scope="col">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>State objects</td>
              <td>1</td>
              <td>5</td>
              <td>50</td>
              <td>500</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Event storage</td>
              <td>1 GB</td>
              <td>10 GB</td>
              <td>100 GB</td>
              <td>1 TB</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>State ops</td>
              <td>10K</td>
              <td>100K</td>
              <td>1M</td>
              <td>10M</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Snapshot retention</td>
              <td>7 days</td>
              <td>30 days</td>
              <td>90 days</td>
              <td>180 days</td>
              <td>365 days</td>
            </tr>
            <tr>
              <td>Replay</td>
              <td>—</td>
              <td>Limited</td>
              <td>Fast + API</td>
              <td>Full</td>
              <td>Export</td>
            </tr>
            <tr>
              <td>Multi-region</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
              <td>Yes</td>
              <td>Yes + edge</td>
            </tr>
            <tr>
              <td>Hot cache</td>
              <td>—</td>
              <td>—</td>
              <td>Yes</td>
              <td>Dedicated</td>
              <td>Dedicated</td>
            </tr>
            <tr>
              <td>Support</td>
              <td>Community</td>
              <td>Email</td>
              <td>Priority</td>
              <td>SLA</td>
              <td>Dedicated</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="statefabric-addons">
        <h3 class="statefabric-addons-title">Optional add-ons</h3>
        <p class="muted statefabric-addons-sub">
          Enhance any State Fabric plan with performance, security, or analytics add-ons.
        </p>

        <div class="addon-grid">
          <article class="addon-card">
            <div class="addon-top">
              <h4>Hot Cache Booster</h4>
              <div class="addon-price">
                $49 <span>/mo per 5GB</span>
              </div>
            </div>
            <p class="addon-desc">Reduces replay and read costs.</p>
          </article>

          <article class="addon-card">
            <div class="addon-top">
              <h4>Advanced Security Pack</h4>
              <div class="addon-price">
                $99 <span>/mo</span>
              </div>
            </div>
            <p class="addon-desc">SOC2-friendly logs, key rotation, audit streams.</p>
          </article>

          <article class="addon-card">
            <div class="addon-top">
              <h4>AI Memory Pack</h4>
              <div class="addon-price">
                $149 <span>/mo</span>
              </div>
            </div>
            <p class="addon-desc">Vector index, embeddings storage, fast read engine.</p>
          </article>

          <article class="addon-card">
            <div class="addon-top">
              <h4>Advanced Insights</h4>
              <div class="addon-price">
                $79 <span>/mo</span>
              </div>
            </div>
            <p class="addon-desc">Cost forecasting, anomaly detection, hot path alerts.</p>
          </article>
        </div>

        <p class="statefabric-note">
          Add-on prices can change over time. Always confirm current rates in your billing page.
        </p>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Ready to add state to your functions?</h2>
      <p class="muted">Start with the free Sandbox or choose a plan that fits your scale.</p>
      <div class="actions">
        <a class="btn primary" href={`${AUTH_ORIGIN}/signup`}>Try now — free</a>
        <a class="btn secondary" href="/contact">Talk to sales</a>
      </div>
    </div>
  </section>
</Layout>