---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import BundlesPage from '../components/BundlesPage.tsx';

const title = 'Backend-in-a-Box Bundles — FunctionFly';
const description = 'Pre-configured backend bundles for SaaS, AI apps, and marketplaces. Auth, payments, database, and more. Free until you grow.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <BundlesPage client:load />
</Layout>