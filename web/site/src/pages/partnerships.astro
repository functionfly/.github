---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import PartnershipsPage from '../components/PartnershipsPage.tsx';

const title = 'Partnerships — FunctionFly';
const description = 'Join the FunctionFly partner ecosystem. Technology partners, resellers, and compliance consultants welcome.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <PartnershipsPage client:load />
</Layout>