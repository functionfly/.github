---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient, queries, urlFor } from '../lib/sanity';

const title = "Serverless Performance Benchmarks - FunctionFly";
const description = "Comprehensive benchmarks comparing AWS Lambda, Cloudflare Workers, and Vercel Functions. Real-world performance data to help you choose the right serverless platform.";

// Fetch benchmarks from Sanity
const benchmarks = await sanityClient.fetch(queries.benchmarks);
const featuredBenchmarks = await sanityClient.fetch(queries.featuredBenchmarks);

const latestBenchmark = benchmarks[0];

const structuredData = latestBenchmark ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": latestBenchmark.title,
  "description": latestBenchmark.description,
  "author": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "datePublished": latestBenchmark.publishedAt,
  "dateModified": latestBenchmark.updatedAt || latestBenchmark.publishedAt
} : {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Serverless Performance Benchmarks",
  "description": "Comprehensive benchmarks comparing serverless platforms performance metrics.",
  "author": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FunctionFly"
  },
  "datePublished": "2024-01-15",
  "dateModified": "2024-01-15"
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary py-24">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-5xl md-text-6xl font-bold text-text-primary mb-6">
            Serverless Performance
            <span class="text-accent-primary block">Benchmarks 2024</span>
          </h1>
          <p class="text-xl md:text-2xl text-text-secondary mb-8 max-w-3xl mx-auto">
            Real-world performance data comparing AWS Lambda, Cloudflare Workers, and Vercel Functions. Make informed decisions about your serverless architecture.
          </p>
        </div>
      </div>
    </section>

    <!-- Methodology -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-4xl font-bold text-text-primary mb-8 text-center">Benchmark Methodology</h2>

          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-2xl font-semibold text-text-primary mb-4">Test Environment</h3>
              <ul class="space-y-3 text-text-secondary">
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  10,000 concurrent requests per test
                </li>
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  5-minute sustained load
                </li>
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  Global distribution (US, EU, Asia)
                </li>
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  Real application workloads
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-2xl font-semibold text-text-primary mb-4">Metrics Measured</h3>
              <ul class="space-y-3 text-text-secondary">
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  Cold start latency
                </li>
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  P95 response time
                </li>
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  Error rates
                </li>
                <li class="flex items-start">
                  <span class="text-accent-primary mr-2">•</span>
                  Cost per 1M requests
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Results -->
    <section class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-bold text-text-primary mb-12 text-center">Performance Results</h2>

        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <!-- AWS Lambda -->
          <div class="bg-bg-secondary rounded-xl p-8 border border-text-secondary/20">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-orange-500 rounded-lg flex items-center justify-center mr-4">
                <span class="text-white font-bold text-lg">λ</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-text-primary">AWS Lambda</h3>
                <p class="text-text-secondary">Most mature platform</p>
              </div>
            </div>

            <div class="space-y-4">
              <div class="flex justify-between">
                <span class="text-text-secondary">Cold Start (P95)</span>
                <span class="font-semibold text-text-primary">2.1s</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Response Time (P95)</span>
                <span class="font-semibold text-text-primary">150ms</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Error Rate</span>
                <span class="font-semibold text-text-primary">0.02%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Cost per 1M req</span>
                <span class="font-semibold text-text-primary">$0.20</span>
              </div>
            </div>
          </div>

          <!-- Cloudflare Workers -->
          <div class="bg-bg-secondary rounded-xl p-8 border border-accent-primary relative">
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
              <span class="bg-accent-primary text-white px-4 py-2 rounded-full text-sm font-semibold">
                Best Performance
              </span>
            </div>
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-orange-400 rounded-lg flex items-center justify-center mr-4">
                <span class="text-white font-bold text-lg">⚡</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-text-primary">Cloudflare Workers</h3>
                <p class="text-text-secondary">Edge-native performance</p>
              </div>
            </div>

            <div class="space-y-4">
              <div class="flex justify-between">
                <span class="text-text-secondary">Cold Start (P95)</span>
                <span class="font-semibold text-green-400">50ms</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Response Time (P95)</span>
                <span class="font-semibold text-green-400">25ms</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Error Rate</span>
                <span class="font-semibold text-text-primary">0.01%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Cost per 1M req</span>
                <span class="font-semibold text-text-primary">$0.15</span>
              </div>
            </div>
          </div>

          <!-- Vercel Functions -->
          <div class="bg-bg-secondary rounded-xl p-8 border border-text-secondary/20">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-black rounded-lg flex items-center justify-center mr-4">
                <span class="text-white font-bold text-lg">▲</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-text-primary">Vercel Functions</h3>
                <p class="text-text-secondary">Developer experience focus</p>
              </div>
            </div>

            <div class="space-y-4">
              <div class="flex justify-between">
                <span class="text-text-secondary">Cold Start (P95)</span>
                <span class="font-semibold text-text-primary">800ms</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Response Time (P95)</span>
                <span class="font-semibold text-text-primary">120ms</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Error Rate</span>
                <span class="font-semibold text-text-primary">0.03%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary">Cost per 1M req</span>
                <span class="font-semibold text-text-primary">$0.25</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Download Data -->
        <div class="text-center">
          <div class="bg-bg-secondary rounded-xl p-8 border border-text-secondary/20 max-w-2xl mx-auto">
            <h3 class="text-2xl font-bold text-text-primary mb-4">Download Full Benchmark Data</h3>
            <p class="text-text-secondary mb-6">
              Get the complete dataset including raw performance metrics, test configurations, and analysis methodology.
            </p>
            <button class="bg-accent-primary hover:bg-accent-primary/90 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
              Download CSV (2.3MB)
            </button>
            <p class="text-sm text-text-secondary mt-4">
              Free download • Updated quarterly • Raw data included
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-24 bg-bg-secondary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-text-primary mb-4">When to Choose Each Platform</h2>
          <p class="text-xl text-text-secondary max-w-2xl mx-auto">
            Different workloads perform better on different platforms. Here's our guidance.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <h3 class="text-xl font-bold text-text-primary mb-4">AWS Lambda</h3>
            <ul class="text-left space-y-2 text-text-secondary mb-6">
              <li>• Complex business logic</li>
              <li>• VPC integration needed</li>
              <li>• Large payloads</li>
              <li>• Long-running tasks</li>
            </ul>
            <div class="text-sm text-text-secondary">Best for: Enterprise applications</div>
          </div>

          <div class="text-center">
            <h3 class="text-xl font-bold text-text-primary mb-4">Cloudflare Workers</h3>
            <ul class="text-left space-y-2 text-text-secondary mb-6">
              <li>• Global edge computing</li>
              <li>• Low-latency requirements</li>
              <li>• API gateways</li>
              <li>• Real-time applications</li>
            </ul>
            <div class="text-sm text-text-secondary">Best for: Global applications</div>
          </div>

          <div class="text-center">
            <h3 class="text-xl font-bold text-text-primary mb-4">Vercel Functions</h3>
            <ul class="text-left space-y-2 text-text-secondary mb-6">
              <li>• Frontend-focused apps</li>
              <li>• Jamstack deployments</li>
              <li>• Rapid prototyping</li>
              <li>• Git-integrated workflows</li>
            </ul>
            <div class="text-sm text-text-secondary">Best for: Frontend applications</div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>