---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../config';
import ContactPage from '../components/ContactPage.tsx';

const title = 'Contact — FunctionFly';
const description = 'Reach FunctionFly for sales, technical support, privacy and legal requests, security disclosures, and partnerships.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FunctionFly',
  url: SITE_ORIGIN,
  description,
};

const schemas = [organizationSchema];
---

<Layout
  title={title}
  description={description}
  schema={schemas}
  ogImage="/og-home.svg"
>
  <ContactPage client:load />
</Layout>
