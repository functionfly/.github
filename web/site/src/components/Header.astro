---
import { BLOG_ORIGIN, AUTH_ORIGIN } from '../config';
import { t, getLocale } from '../i18n';
import CornerBrace from './containment/CornerBrace.astro';

const currentLang = getLocale(Astro);
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function navClass(href: string): string {
  if (href.startsWith('http')) return '';
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return pathname === '/' ? 'nav-active' : '';
  return pathname === h || pathname.startsWith(`${h}/`) ? 'nav-active' : '';
}
---

<header class="header" id="site-header">
  <nav class="nav">
    <a href="/" class="logo" aria-label="FunctionFly Home">
      <img src="/functionfly.png" alt="" class="logo-mark" width="32" height="32" />
      <span class="logo-text">FunctionFly</span>
    </a>

    <div class="nav-links" id="nav-links">
      <a href="/" class:list={[navClass('/')]}>{t(currentLang, 'nav.home')}</a>
      <a href="/for-agents" class:list={[navClass('/for-agents')]}>{t(currentLang, 'nav.forAgents')}</a>
      <a href="/trust" class:list={[navClass('/trust')]}>{t(currentLang, 'nav.trust')}</a>
      <a href="/pricing" class:list={[navClass('/pricing')]}>{t(currentLang, 'nav.pricing')}</a>
      <a href={BLOG_ORIGIN} class:list={[navClass('/blog')]}>{t(currentLang, 'nav.blog')}</a>
      <a href={`${AUTH_ORIGIN}/signup`} class="nav-cta">{t(currentLang, 'nav.signUp')}</a>
    </div>

    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-content">
      <CornerBrace position="tl" />
      <CornerBrace position="br" />
      <a href="/" class:list={[navClass('/')]}>{t(currentLang, 'nav.home')}</a>
      <a href="/for-agents" class:list={[navClass('/for-agents')]}>{t(currentLang, 'nav.forAgents')}</a>
      <a href="/trust" class:list={[navClass('/trust')]}>{t(currentLang, 'nav.trust')}</a>
      <a href="/pricing" class:list={[navClass('/pricing')]}>{t(currentLang, 'nav.pricing')}</a>
      <a href={BLOG_ORIGIN} class:list={[navClass('/blog')]}>{t(currentLang, 'nav.blog')}</a>
      <a href={`${AUTH_ORIGIN}/signup`} class="mobile-cta">{t(currentLang, 'nav.signUp')}</a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    var STORAGE_KEY = 'ff-user-theme';
    var LEGACY_KEY = 'ff-theme';
    var _cached = null;

    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function resolveTheme(mode) {
      return mode === 'system' ? getSystemTheme() : mode;
    }

    function readStorage() {
      try {
        var stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          var parsed = JSON.parse(stored);
          if (parsed.mode === 'light' || parsed.mode === 'dark' || parsed.mode === 'system') {
            return parsed;
          }
        }
      } catch (e) {}
      return null;
    }

    function migrateLegacy() {
      try {
        var legacy = localStorage.getItem(LEGACY_KEY);
        if (legacy && (legacy === 'light' || legacy === 'dark')) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode: legacy }));
          localStorage.removeItem(LEGACY_KEY);
          return { mode: legacy };
        }
      } catch (e) {}
      return null;
    }

    function applyTheme() {
      var migrated = migrateLegacy();
      var preference = migrated || readStorage();
      var mode = preference ? preference.mode : 'system';
      var resolved = resolveTheme(mode);
      _cached = { mode: mode, resolved: resolved };
      document.documentElement.setAttribute('data-theme', resolved);
    }

    function updateThemeIcon() {
      var toggle = document.getElementById('theme-toggle');
      if (toggle) {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        toggle.classList.toggle('is-light', isLight);
      }
    }

    applyTheme();
    updateThemeIcon();

    window.ffThemeSync = {
      toggle: function() {
        var current = _cached ? _cached.resolved : getSystemTheme();
        var next = current === 'dark' ? 'light' : 'dark';
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode: next }));
        var resolved = resolveTheme(next);
        _cached = { mode: next, resolved: resolved };
        document.documentElement.setAttribute('data-theme', resolved);
        updateThemeIcon();
      }
    };
  })();
</script>

<script>
  const header = document.getElementById('site-header');
  const themeToggle = document.getElementById('theme-toggle');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  if (themeToggle) {
    themeToggle.addEventListener('click', function() {
      if (window.ffThemeSync) {
        window.ffThemeSync.toggle();
      }
    });
  }

  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', (!isOpen).toString());
      hamburger.classList.toggle('is-active');
      mobileMenu.classList.toggle('is-open');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.classList.remove('is-active');
        mobileMenu.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    });
  }

  let lastScrollY = 0;
  const scrollThreshold = 80;

  function handleScroll() {
    const scrollY = window.scrollY;

    if (scrollY > scrollThreshold) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }

    lastScrollY = scrollY;
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    transition: padding var(--duration-base) var(--ease-out);
  }

  .header.scrolled {
    padding-top: 0;
  }

  .nav {
    position: relative;
    width: 100%;
    padding: 18px var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    background: transparent;
    border-bottom: 1px solid var(--panel-edge);
  }

  @media (min-width: 960px) {
    .nav {
      padding: 18px var(--space-6);
    }
  }

  @media (max-width: 479px) {
    .nav {
      padding: var(--space-4) var(--space-4);
    }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
    border-radius: var(--radius);
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  .nav-links a {
    font-size: 14px;
    line-height: 1;
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    padding: var(--space-1) 0;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-links a:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
    border-radius: var(--radius-sm);
  }

  .nav-active {
    color: var(--text) !important;
    font-weight: 500;
  }

  .nav-links .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    padding: 13px 22px;
    border-radius: var(--radius);
    background: linear-gradient(180deg, #ffffff 0%, #d8dee2 100%);
    color: var(--text-on-light) !important;
    border: none;
    box-shadow: var(--shadow-btn-primary-rest);
    cursor: pointer;
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .nav-links .nav-cta:hover {
    box-shadow: var(--shadow-btn-primary-hover);
    color: var(--text-on-light) !important;
  }

  .nav-links .nav-cta:active {
    box-shadow: var(--shadow-btn-primary-active);
    transform: translateY(1px);
  }

  .nav-links .nav-cta:focus-visible {
    outline: none;
    box-shadow: var(--shadow-btn-primary-rest), var(--shadow-focus);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--steel);
    border-radius: var(--radius);
    color: var(--text-dim);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    position: relative;
  }

  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--steel-light);
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .theme-toggle .sun-icon,
  .theme-toggle .moon-icon {
    position: absolute;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .theme-toggle .sun-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  .theme-toggle .moon-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .theme-toggle.is-light .sun-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .theme-toggle.is-light .moon-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--steel);
    border-radius: var(--radius);
    cursor: pointer;
    gap: 5px;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 900px) {
    .hamburger {
      display: flex;
    }
  }

  .hamburger:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .hamburger:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--steel-light);
  }

  .hamburger-line {
    width: 18px;
    height: 2px;
    background: var(--text-dim);
    border-radius: 1px;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .hamburger.is-active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 13, 17, 0.7);
    backdrop-filter: blur(8px);
    z-index: calc(var(--z-nav) - 1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
    padding: var(--space-5) var(--space-4) var(--space-4);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu-content {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-4);
    gap: var(--space-1);
    max-width: 1180px;
    margin: 0 auto;
    background:
      radial-gradient(ellipse 140% 100% at 15% 0%, var(--glass-tint), transparent 55%),
      var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-chamber);
  }

  .mobile-menu-content a {
    font-size: 16px;
    font-weight: 400;
    color: var(--text-dim);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .mobile-menu-content a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .mobile-menu-content a:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .mobile-menu-content a.nav-active {
    color: var(--text);
    font-weight: 500;
  }

  .mobile-menu-content .mobile-cta {
    margin-top: var(--space-3);
    text-align: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    padding: 13px 22px;
    border-radius: var(--radius);
    background: linear-gradient(180deg, #ffffff 0%, #d8dee2 100%);
    color: var(--text-on-light) !important;
    border: none;
    box-shadow: var(--shadow-btn-primary-rest);
    cursor: pointer;
    transition:
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .mobile-menu-content .mobile-cta:hover {
    box-shadow: var(--shadow-btn-primary-hover);
    color: var(--text-on-light) !important;
  }

  .mobile-menu-content .mobile-cta:active {
    box-shadow: var(--shadow-btn-primary-active);
    transform: translateY(1px);
  }

  .mobile-menu-content .mobile-cta:focus-visible {
    outline: none;
    box-shadow: var(--shadow-btn-primary-rest), var(--shadow-focus);
  }
</style>
