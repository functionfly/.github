---
import { SITE_ORIGIN, BLOG_ORIGIN } from '../config';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function navClass(href: string): string {
  if (href.startsWith('http')) return '';
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return pathname === '/' ? 'nav-active' : '';
  return pathname === h || pathname.startsWith(`${h}/`) ? 'nav-active' : '';
}
---

<header class="header" id="site-header">
  <nav class="nav">
    <a href="/" class="logo" aria-label="FunctionFly Home">
      <div class="logo-icon">
        <img src="/favicon.svg" alt="" width="32" height="32" />
      </div>
      <span class="logo-text">FunctionFly</span>
    </a>

    <div class="nav-links" id="nav-links">
      <a href="/" class:list={[navClass('/')]}>Home</a>
      <a href="/for-agents" class:list={[navClass('/for-agents')]}>For AI Agents</a>
      <a href="/trust" class:list={[navClass('/trust')]}>Trust</a>
      <a href="/plans" class:list={[navClass('/plans')]}>Plans</a>
      <a href="/pricing" class:list={[navClass('/pricing')]}>Pricing</a>
      <a href={BLOG_ORIGIN} class:list={[navClass('/blog')]}>Blog</a>
      <a href={`${import.meta.env.PUBLIC_AUTH_URL || 'https://auth.functionfly.com'}/signup`} class="nav-cta">Sign up</a>
    </div>

    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-content">
      <a href="/" class:list={[navClass('/')]}>Home</a>
      <a href="/for-agents" class:list={[navClass('/for-agents')]}>For AI Agents</a>
      <a href="/trust" class:list={[navClass('/trust')]}>Trust</a>
      <a href="/plans" class:list={[navClass('/plans')]}>Plans</a>
      <a href="/pricing" class:list={[navClass('/pricing')]}>Pricing</a>
      <a href={BLOG_ORIGIN} class:list={[navClass('/blog')]}>Blog</a>
      <a href={`${import.meta.env.PUBLIC_AUTH_URL || 'https://auth.functionfly.com'}/signup`} class="mobile-cta">Sign up</a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    var STORAGE_KEY = 'ff-user-theme';
    var LEGACY_KEY = 'ff-theme';
    var _cached = null;

    function getSystemTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function resolveTheme(mode) {
      return mode === 'system' ? getSystemTheme() : mode;
    }

    function readStorage() {
      try {
        var stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          var parsed = JSON.parse(stored);
          if (parsed.mode === 'light' || parsed.mode === 'dark' || parsed.mode === 'system') {
            return parsed;
          }
        }
      } catch (e) {}
      return null;
    }

    function migrateLegacy() {
      try {
        var legacy = localStorage.getItem(LEGACY_KEY);
        if (legacy && (legacy === 'light' || legacy === 'dark')) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode: legacy }));
          localStorage.removeItem(LEGACY_KEY);
          return { mode: legacy };
        }
      } catch (e) {}
      return null;
    }

    function applyTheme() {
      var migrated = migrateLegacy();
      var preference = migrated || readStorage();
      var mode = preference ? preference.mode : 'system';
      var resolved = resolveTheme(mode);
      _cached = { mode: mode, resolved: resolved };
      document.documentElement.setAttribute('data-theme', resolved);
    }

    function updateThemeIcon() {
      var toggle = document.getElementById('theme-toggle');
      if (toggle) {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        toggle.classList.toggle('is-light', isLight);
      }
    }

    applyTheme();
    updateThemeIcon();

    window.ffThemeSync = {
      toggle: function() {
        var current = _cached ? _cached.resolved : getSystemTheme();
        var next = current === 'dark' ? 'light' : 'dark';
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode: next }));
        var resolved = resolveTheme(next);
        _cached = { mode: next, resolved: resolved };
        document.documentElement.setAttribute('data-theme', resolved);
        updateThemeIcon();
      }
    };
  })();
</script>

<script>
  const header = document.getElementById('site-header');
  const themeToggle = document.getElementById('theme-toggle');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  if (themeToggle) {
    themeToggle.addEventListener('click', function() {
      if (window.ffThemeSync) {
        window.ffThemeSync.toggle();
      }
    });
  }


  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', (!isOpen).toString());
      hamburger.classList.toggle('is-active');
      mobileMenu.classList.toggle('is-open');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.classList.remove('is-active');
        mobileMenu.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    });
  }

  let lastScrollY = 0;
  const scrollThreshold = 50;

  function handleScroll() {
    const scrollY = window.scrollY;

    if (scrollY > scrollThreshold) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }

    if (scrollY > lastScrollY && scrollY > 200) {
      header?.classList.add('hidden');
    } else {
      header?.classList.remove('hidden');
    }

    lastScrollY = scrollY;
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

<style is:global>
  .header {
    position: sticky;
    top: 0;
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.7);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
    transition: padding 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease, background 0.3s ease;
  }

  .header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(255, 107, 53, 0.03) 0%, transparent 100%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .header.scrolled::before {
    opacity: 1;
  }

  .header.scrolled {
    padding-top: 0;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15), 0 0 40px rgba(255, 107, 53, 0.05);
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.85);
  }

  .header.hidden {
    transform: translateY(-100%);
  }

  [data-theme='light'] .header {
    background: rgba(255, 255, 255, 0.85);
  }

  [data-theme='light'] .header.scrolled {
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08), 0 0 40px rgba(99, 102, 241, 0.05);
  }

  [data-theme='light'] .header::before {
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.05) 0%, transparent 100%);
  }

  .nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
    padding: 6px 10px;
    border-radius: 8px;
    transition: transform 0.2s ease;
    position: relative;
  }

  .logo:hover {
    transform: translateY(-1px);
  }

  .logo:hover .logo-icon {
    box-shadow: 0 0 20px rgba(255, 107, 53, 0.4);
  }

  .logo:focus-visible {
    outline: 2px solid var(--ff-cyan, #00D4FF);
    outline-offset: 2px;
  }

  .logo-icon {
    position: relative;
    transition: box-shadow 0.3s ease;
  }

  .logo-icon::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 10px;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.3) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .logo:hover .logo-icon::after {
    opacity: 1;
  }

  .logo-text {
    position: relative;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-links a {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
    padding: 8px 14px;
    border-radius: 6px;
    position: relative;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 14px;
    right: 14px;
    height: 2px;
    background: var(--ff-cyan, #00D4FF);
    transform: scaleX(0);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 1px;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--ff-cyan, #00D4FF);
    outline-offset: 2px;
  }

  .nav-active {
    color: var(--ff-cyan, #00D4FF) !important;
    font-weight: 600;
  }

  .nav-active::after {
    transform: scaleX(1) !important;
    background: var(--ff-cyan, #00D4FF);
  }

  [data-theme='light'] .nav-active {
    color: var(--ff-cyan, #00A8CC) !important;
  }

  .nav-cta {
    background: linear-gradient(135deg, var(--ff-flame, #FF6B35) 0%, #FF8C5A 100%);
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    color: white !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    margin-left: 0.5rem;
    box-shadow: 0 2px 10px rgba(255, 107, 53, 0.3);
  }

  .nav-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(255, 107, 53, 0.4);
    background: linear-gradient(135deg, var(--ff-flame-dark, #E85A2A) 0%, var(--ff-flame, #FF6B35) 100%);
  }

  .nav-cta:hover::before {
    opacity: 1;
  }

  .nav-cta:active {
    transform: translateY(0);
  }

  .nav-cta:focus-visible {
    outline: 2px solid var(--ff-cyan, #00D4FF);
    outline-offset: 2px;
  }

  .logo-bg {
    fill: #0F172A;
    transition: fill var(--duration-fast);
  }

  [data-theme='light'] .logo-bg {
    fill: #1e293b;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .theme-toggle:hover {
    background: var(--ff-flame, #FF6B35);
    border-color: var(--ff-flame, #FF6B35);
    color: white;
    transform: rotate(15deg);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--ff-cyan, #00D4FF);
    outline-offset: 2px;
  }

  [data-theme='light'] .theme-toggle {
    background: rgba(255, 255, 255, 0.8);
  }

  [data-theme='light'] .theme-toggle:hover {
    background: var(--ff-flame, #E85A2A);
    border-color: var(--ff-flame, #E85A2A);
  }

  .theme-toggle .sun-icon,
  .theme-toggle .moon-icon {
    position: absolute;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .theme-toggle .sun-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  .theme-toggle .moon-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .theme-toggle.is-light .sun-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .theme-toggle.is-light .moon-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    gap: 5px;
    transition: all 0.25s ease;
  }

  .hamburger:focus-visible {
    outline: 2px solid var(--ff-cyan, #00D4FF);
    outline-offset: 2px;
  }

  [data-theme='light'] .hamburger {
    background: rgba(255, 255, 255, 0.8);
  }

  .hamburger-line {
    width: 18px;
    height: 2px;
    background: var(--color-text-muted);
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger.is-active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 65px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(var(--ff-tarmac-rgb, 13, 17, 23), 0.95);
    backdrop-filter: blur(20px);
    z-index: 99;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  [data-theme='light'] .mobile-menu {
    background: rgba(255, 255, 255, 0.95);
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    gap: 0.5rem;
  }

  .mobile-menu-content a {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    font-weight: 500;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .mobile-menu-content a:hover,
  .mobile-menu-content a.nav-active {
    color: var(--ff-cyan, #00D4FF);
    background: rgba(0, 212, 255, 0.1);
    border-color: rgba(0, 212, 255, 0.2);
  }

  .mobile-menu-content a:focus-visible {
    outline: 2px solid var(--ff-cyan, #00D4FF);
    outline-offset: 2px;
  }

  .mobile-cta {
    background: linear-gradient(135deg, var(--ff-flame, #FF6B35) 0%, #FF8C5A 100%);
    color: white !important;
    text-align: center;
    margin-top: 1rem;
    font-weight: 600;
    box-shadow: 0 2px 15px rgba(255, 107, 53, 0.3);
  }

  .mobile-cta:hover {
    box-shadow: 0 4px 25px rgba(255, 107, 53, 0.4);
  }

  @keyframes navEntrance {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .header {
    animation: navEntrance 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .nav-links a {
    animation: navEntrance 0.4s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  }

  .nav-links a:nth-child(1) { animation-delay: 0.05s; }
  .nav-links a:nth-child(2) { animation-delay: 0.1s; }
  .nav-links a:nth-child(3) { animation-delay: 0.15s; }
  .nav-links a:nth-child(4) { animation-delay: 0.2s; }
  .nav-links a:nth-child(5) { animation-delay: 0.25s; }
  .nav-links a:nth-child(6) { animation-delay: 0.3s; }
  .nav-links a:nth-child(7) { animation-delay: 0.35s; }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .nav {
      padding: 0.875rem 1.25rem;
    }

    .logo-text {
      font-size: 1.1rem;
    }
  }
</style>
