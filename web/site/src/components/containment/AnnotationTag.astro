---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="annotation-tag">
  {subtitle && <div class="annotation-tag-subtitle">{subtitle}</div>}
  <div class="annotation-tag-title">{title}</div>
</div>

<style>
  .annotation-tag {
    position: absolute;
    top: var(--space-7, 48px);
    right: var(--space-7, 48px);
    text-align: right;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--text-faint);
  }

  .annotation-tag-subtitle {
    color: var(--text-dim);
  }

  .annotation-tag-title {
    color: var(--text-faint);
  }
</style>
