---
interface Props {
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  variant?: 'default' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  loading?: boolean;
  class?: string;
  id?: string;
}

const {
  type = 'button',
  href,
  variant = 'default',
  size = 'md',
  disabled = false,
  loading = false,
  class: className,
  id,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={[
    'frame-button',
    `frame-button--${size}`,
    { 'frame-button--accent': variant === 'accent' },
    { 'frame-button--disabled': disabled },
    { 'frame-button--loading': loading },
    className,
  ]}
  type={href ? undefined : type}
  href={href}
  disabled={href ? undefined : disabled}
  data-loading={loading ? 'true' : undefined}
  id={id}
>
  {loading && (
    <span class="frame-button__spinner" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="32" stroke-dashoffset="8">
          <animateTransform attributeName="transform" type="rotate" from="0 8 8" to="360 8 8" dur="0.8s" repeatCount="indefinite"/>
        </circle>
      </svg>
    </span>
  )}
  <span class="frame-button__content" class:list={{ 'visually-hidden': loading }}>
    <slot />
  </span>
</Tag>

<style>
  .frame-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
    white-space: nowrap;
    box-shadow: none;
  }

  /* Sizes */
  .frame-button--sm {
    padding: 8px 16px;
    font-size: 13px;
    min-height: 32px;
    border: 1px solid var(--steel);
  }

  .frame-button--md {
    padding: 12px 24px;
    font-size: 14px;
    min-height: 42px;
    border: 1px solid var(--steel);
  }

  .frame-button--lg {
    padding: 16px 32px;
    font-size: 16px;
    min-height: 52px;
    border: 1px solid var(--steel);
  }

  /* Default variant */
  .frame-button:not(.frame-button--accent) {
    background: transparent;
    color: var(--text);
    border-color: var(--steel);
  }

  .frame-button:not(.frame-button--accent):hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--steel-light);
    color: var(--text);
  }

  .frame-button:not(.frame-button--accent):active {
    background: rgba(0, 0, 0, 0.1);
    box-shadow: var(--shadow-btn-secondary-active);
    color: var(--text);
  }

  /* Accent variant */
  .frame-button--accent {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }

  .frame-button--accent:hover {
    background: var(--accent-dim);
    border-color: var(--accent-hover);
    color: var(--accent-hover);
  }

  .frame-button--accent:active {
    background: rgba(255, 122, 61, 0.2);
    box-shadow: var(--shadow-btn-secondary-active);
    color: var(--accent);
  }

  /* States */
  .frame-button:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .frame-button--disabled,
  .frame-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .frame-button--loading {
    cursor: wait;
  }

  /* Spinner */
  .frame-button__spinner {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .frame-button__content {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
