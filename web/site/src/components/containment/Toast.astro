---
interface Props {
  id: string;
  status: 'live' | 'pending' | 'revoked';
  title: string;
  message?: string;
}

const { id, status, title, message } = Astro.props;

const statusColors = {
  live: 'var(--status-ok)',
  pending: 'var(--status-pending)',
  revoked: 'var(--status-revoked)',
};
---

<div
  class="toast"
  id={id}
  style={`--toast-accent: ${statusColors[status]};`}
  role="alert"
  aria-live="polite"
>
  <div class="toast-accent"></div>
  <div class="toast-content">
    <div class="toast-title">{title}</div>
    {message && <div class="toast-message">{message}</div>}
  </div>
  <button class="toast-dismiss" aria-label="Dismiss notification" onclick="this.closest('.toast').remove()">
    ×
  </button>
</div>

<style>
  .toast {
    position: fixed;
    bottom: var(--space-5, 24px);
    right: var(--space-5, 24px);
    background: var(--panel-raised);
    border: 1px solid var(--panel-edge);
    border-radius: var(--radius, 4px);
    padding: var(--space-4, 16px);
    z-index: var(--z-toast, 200);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3, 12px);
    min-width: 280px;
    box-shadow: var(--shadow-chamber);
    animation: toast-enter 0.2s ease-out forwards;
  }

  .toast-accent {
    width: 3px;
    align-self: stretch;
    border-radius: 2px;
    background: var(--toast-accent);
  }

  .toast-content {
    flex: 1;
  }

  .toast-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .toast-message {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-dim);
    margin-top: var(--space-1, 4px);
  }

  .toast-dismiss {
    background: none;
    border: none;
    color: var(--text-faint);
    cursor: pointer;
    padding: var(--space-1, 4px);
    font-size: 18px;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .toast-dismiss:hover {
    color: var(--text);
  }

  @keyframes toast-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
