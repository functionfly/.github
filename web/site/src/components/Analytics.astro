// Analytics configuration for FunctionFly public site
// Includes Google Analytics, Search Console verification, and other measurement tools
---

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'GA_MEASUREMENT_ID', {
    'custom_map': {
      'dimension1': 'page_type',
      'dimension2': 'content_category'
    }
  });
</script>

<!-- Google Search Console Verification -->
<meta name="google-site-verification" content="YOUR_SEARCH_CONSOLE_VERIFICATION_CODE" />

<!-- Bing Webmaster Tools Verification -->
<meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" />

<!-- Vercel Analytics (if using Vercel) -->
<script>
  window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
</script>
<script defer src="/_vercel/insights/script.js"></script>

