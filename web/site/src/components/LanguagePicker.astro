---
// LanguagePicker.astro — compact globe icon button that opens a language dropdown
// Used on the marketing site header nav and docs sidebar.

import { LANGUAGES_BY_NATIVE_NAME, getLanguage } from '../lib/i18n/languages';
import type { Language } from '../lib/i18n/languages';

// The current language code (passed from Layout.astro via props/default)
interface Props {
  currentLang?: string;
  locales?: Record<string, Record<string, string>>;
}
const { currentLang = 'en', locales = {} } = Astro.props;

// Helper to resolve a translation string from the locale map
function t(key: string): string {
  const parts = key.split('.');
  let val: unknown = locales[currentLang] ?? locales['en'];
  for (const part of parts) {
    if (val && typeof val === 'object' && part in (val as Record<string, unknown>)) {
      val = (val as Record<string, unknown>)[part];
    } else {
      return key; // fall back to the key itself
    }
  }
  return typeof val === 'string' ? val : key;
}

const current = getLanguage(currentLang) ?? getLanguage('en')!;
const isRtl = current.dir === 'rtl';

// Detect if browser lang differs from current (for "detected" badge)
const browserLang = Astro.request.headers.get('accept-language') ?? '';
import { detectLanguage } from '../lib/i18n/languages';
const detectedCode = detectLanguage(browserLang);
const showDetected = detectedCode !== currentLang && detectedCode !== 'en';
const detectedLang = getLanguage(detectedCode);
---

<!-- Language Picker -->
<div class="lang-picker-wrapper">
  <button
    class="lang-trigger"
    id="lang-trigger"
    aria-label={t('language.title')}
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <span class="lang-flag">{current.flag}</span>
    <span class="lang-name">{current.name}</span>
    <svg class="lang-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
      <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="lang-dropdown" id="lang-dropdown" role="listbox" aria-label={t('language.title')}>
    <div class="lang-dropdown-header">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
      <span>{t('language.title')}</span>
    </div>

    {showDetected && (
      <div class="lang-detected">
        <span class="lang-detected-badge">{t('language.detected')}</span>
        <span class="lang-detected-name">{detectedLang?.flag} {detectedLang?.name}</span>
      </div>
    )}

    <div class="lang-list">
      {LANGUAGES_BY_NATIVE_NAME.map((lang: Language) => {
        const selected = lang.code === currentLang;
        return (
          <button
            class:list={['lang-option', { selected }]}
            role="option"
            aria-selected={selected ? 'true' : 'false'}
            data-lang={lang.code}
            dir={lang.dir ?? 'ltr'}
          >
            <span class="lang-option-flag">{lang.flag}</span>
            <span class="lang-option-name">{lang.name}</span>
            {lang.nameEn !== lang.name && (
              <span class="lang-option-name-en">{lang.nameEn}</span>
            )}
            {selected && (
              <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            )}
          </button>
        );
      })}
    </div>

    <div class="lang-dropdown-footer">
      {t('language.autoDetected')}
    </div>
  </div>
</div>

<script define:vars={{ detectedCode, detectedLang: detectedLang ?? null }}>
  // Persist language to localStorage + cookie, then reload
  document.querySelectorAll('.lang-option[data-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (!lang) return;
      localStorage.setItem('ff_lang', lang);
      document.cookie = `ff_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
      // For instant UI update without reload, post a custom event
      window.dispatchEvent(new CustomEvent('ff:lang-change', { detail: { lang } }));
      // Reload to let the server re-render with the new locale
      window.location.reload();
    });
  });

  // Toggle dropdown
  const trigger = document.getElementById('lang-trigger');
  const dropdown = document.getElementById('lang-dropdown');
  trigger?.addEventListener('click', () => {
    const isOpen = dropdown?.classList.contains('open');
    dropdown?.classList.toggle('open', !isOpen);
    trigger?.setAttribute('aria-expanded', String(!isOpen));
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.lang-picker-wrapper')) {
      dropdown?.classList.remove('open');
      trigger?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .lang-picker-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .lang-trigger:hover {
    color: var(--color-text);
    background: rgba(255,255,255,0.05);
    border-color: var(--color-border);
  }
  .lang-flag { font-size: 1rem; line-height: 1; }
  .lang-name { font-weight: 500; }
  .lang-chevron {
    transition: transform 0.2s;
    opacity: 0.6;
  }
  .lang-trigger[aria-expanded="true"] .lang-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 220px;
    background: #1a2336;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: 0 16px 40px rgba(0,0,0,0.5);
    z-index: 200;
    overflow: hidden;
  }
  .lang-dropdown.open { display: block; }

  .lang-dropdown-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .lang-dropdown-header svg { opacity: 0.6; }

  .lang-detected {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    background: rgba(245,158,11,0.08);
    border-bottom: 1px solid rgba(245,158,11,0.15);
    font-size: 0.75rem;
  }
  .lang-detected-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #f59e0b;
  }
  .lang-detected-name { color: var(--color-text-muted); }

  .lang-list {
    max-height: 300px;
    overflow-y: auto;
    padding: 0.35rem 0;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  .lang-list::-webkit-scrollbar { width: 4px; }
  .lang-list::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 4px; }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.55rem 1rem;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.1s;
    text-align: left;
  }
  .lang-option:hover { background: rgba(99,102,241,0.1); }
  .lang-option.selected { background: rgba(99,102,241,0.12); }

  .lang-option-flag { font-size: 1.1rem; line-height: 1; }
  .lang-option-name { flex: 1; font-weight: 500; }
  .lang-option-name-en {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin-left: 0.25rem;
  }
  .lang-check { color: #818cf8; flex-shrink: 0; }

  .lang-dropdown-footer {
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.7rem;
    color: var(--color-text-subtle, #5B6D8E);
    text-align: center;
  }

  /* Mobile: show flag only */
  @media (max-width: 768px) {
    .lang-name { display: none; }
  }
</style>
