---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  /** Wider column for legal / long-form pages */
  contentWidth?: 'default' | 'wide';
}

const { title, description, contentWidth = 'default' } = Astro.props;
---

<Layout title={title} description={description}>
  <article class:list={['content-page', contentWidth === 'wide' && 'content-page--wide']}>
    <div class="content-inner">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .content-page {
    padding: 4rem 1.5rem 5rem;
  }

  .content-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .content-page--wide .content-inner {
    max-width: 56rem;
  }

  .content-inner :global(h1) {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .content-inner :global(h2) {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--color-text);
  }

  .content-inner :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: var(--color-text);
  }

  .content-inner :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    margin: 1rem 0 0.35rem;
    color: var(--color-text);
  }

  .content-inner :global(p),
  .content-inner :global(li) {
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .content-inner :global(ul) {
    margin: 0.5rem 0 1rem 1.25rem;
    padding-left: 0.25rem;
  }

  .content-inner :global(ul) li {
    margin-bottom: 0.35rem;
  }

  .content-inner :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .content-inner :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .content-inner :global(a:hover) {
    color: var(--color-text);
  }

  .content-inner :global(.lead) {
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .content-inner :global(.actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .content-inner :global(.btn-outline) {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  .content-inner :global(.btn-outline:hover) {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  .content-inner :global(.btn-primary) {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: var(--color-primary);
    color: white !important;
    text-decoration: none;
    font-weight: 500;
  }

  .content-inner :global(.btn-primary:hover) {
    background: var(--color-primary-dark);
  }

  .content-inner :global(.muted) {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .content-inner :global(.legal-card) {
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    margin: 2rem 0;
  }

  .content-inner :global(.legal-card > h2:first-child),
  .content-inner :global(.legal-card > h3:first-child) {
    margin-top: 0;
  }

  .content-inner :global(.legal-header) {
    text-align: center;
    padding: 2rem 0 1rem;
    margin-bottom: 1rem;
  }

  .content-inner :global(.legal-header-icon) {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1rem;
    border-radius: 1rem;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .content-inner :global(.cookie-category) {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .content-inner :global(.cookie-category:last-child) {
    border-bottom: none;
  }

  .content-inner :global(.badge) {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.2);
    color: var(--color-primary);
  }

  .content-inner :global(.badge-muted) {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .content-inner :global(.back-home) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  .content-inner :global(.back-home:hover) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
