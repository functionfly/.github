---
import { SITE_ORIGIN, API_ORIGIN, DOCS_ORIGIN, BLOG_ORIGIN, STATUS_ORIGIN } from '../config';
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import { t, getLocale, SUPPORTED_LOCALES, isRtl, LOCALE_DATA } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/sc-main.css';

const mixpanelToken = import.meta.env.PUBLIC_MIXPANEL_TOKEN as string | undefined;
const gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID as string | undefined;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  nofollow?: boolean;
  canonical?: string;
  /** JSON-LD schema object(s) to include */
  schema?: object | object[];
  /** Page type for default schema selection */
  type?: 'website' | 'article' | 'product' | 'person' | 'software';
}

const {
  title,
  description = 'FunctionFly is the trust layer for AI agents - verified functions, trust scores, and zero-knowledge vault. Publish once, run everywhere, get paid.',
  ogImage,
  noindex = false,
  nofollow = false,
  canonical,
  schema,
  type = 'website',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function navClass(href: string): string {
  if (href.startsWith('http')) return '';
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return pathname === '/' ? 'nav-active' : '';
  return pathname === h || pathname.startsWith(`${h}/`) ? 'nav-active' : '';
}

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE_ORIGIN).toString();
const ogUrl = ogImage?.startsWith('http') ? ogImage : new URL(ogImage || '/og-default.svg', SITE_ORIGIN).toString();

// Newsletter API endpoint for client-side JS
const newsletterSubscribeUrl = `${API_ORIGIN}/newsletter/subscribe`;

// i18n hreflang tags - all supported languages
const currentLang = getLocale(Astro);
const dir = isRtl(currentLang) ? 'rtl' : 'ltr';
const locales = LOCALE_DATA;

// i18n hreflang alternates — only include x-default until locale-in-path routing is implemented.
// Per-locale hreflang entries would require i18n URL structure (e.g., /es/path, /fr/path).
// For now, omit per-locale entries to avoid incorrectly claiming translations exist at the same URL.

// Default schema if none provided
const defaultSchemas = {
  website: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalURL,
    image: ogUrl,
  },
  article: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonicalURL,
    image: ogUrl,
    publisher: {
      '@type': 'Organization',
      name: 'FunctionFly',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', SITE_ORIGIN).toString(),
      },
    },
  },
};

const finalSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [defaultSchemas[type] || defaultSchemas.website];
---

<!doctype html>
<html lang={currentLang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title}
      titleTemplate="%s — FunctionFly"
      titleDefault="FunctionFly™ — Ship Functions. Earn Trust. Get Found."
      description={description}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={{
        basic: {
          title,
          type: type === 'article' ? 'article' : 'website',
          image: ogUrl,
          url: canonicalURL,
        },
        optional: {
          siteName: 'FunctionFly',
          description,
        },
        image: {
          url: ogUrl,
          secureUrl: ogUrl.replace('http:', 'https:'),
          type: 'image/svg+xml',
          width: 1200,
          height: 630,
          alt: `${title} — FunctionFly`,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@functionflycom',
        creator: '@functionflycom',
        title,
        description,
        image: ogUrl,
        imageAlt: `${title} — FunctionFly`,
      }}
      extend={{
        link: [
          // Preconnect hints
          { rel: 'preconnect', href: 'https://fonts.googleapis.com' },
          { rel: 'preconnect', href: 'https://fonts.gstatic.com', crossorigin: 'anonymous' },
          // 2026 Font Stack - Velocity Brand
          // Instrument Sans: Primary sans (Google Fonts)
          // Space Grotesk: Display/hero headlines (Google Fonts - aviation aesthetic)
          // Commit Mono: UI-optimized monospace (jsDelivr CDN)
          { rel: 'stylesheet', href: 'https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap' },
          { rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/gh/nickolay8857/CommitMono@main/CommitMono.css' },
          // Favicons
          { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
          { rel: 'icon', type: 'image/x-icon', href: '/favicon.ico' },
          { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
          // Canonical self-reference
          { rel: 'canonical', href: canonicalURL },
          // x-default: no locale-in-path i18n yet; this signals the canonical page serves all languages
          { rel: 'alternate', hreflang: 'x-default', href: canonicalURL },
        ],
        meta: [
          { name: 'generator', content: Astro.generator },
          { name: 'theme-color', content: '#0a0d11' },
          { name: 'msapplication-TileColor', content: '#0a0d11' },
          { name: 'color-scheme', content: 'dark light' },
        ],
      }}
    />

    {/* JSON-LD Structured Data */}
    {finalSchemas.map((s, i) => (
      <Schema key={i} item={s} />
    ))}

    {/* Mixpanel Analytics — public site, no auth required */}
    {mixpanelToken && (
      <script define:vars={{ mixpanelToken }}>
        (function() {
          (function() {
            var w = window, mp = w.mixpanel = w.mixpanel || [];
            function i() { mp.push(arguments); }
            i.q = mp.q || []; mp._i = [];
            mp.init = function(token) { mp.push(['init', token]); return mp; };
            mp.track = function() { return mp.q.push(arguments); };
            mp.people = { track_charge: function() { mp.q.push(['people.track_charge', arguments]); } };
            var s = document.createElement('script');
            s.type = 'text/javascript'; s.async = true;
            s.src = 'https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js';
            var x = document.getElementsByTagName('script')[0];
            x.parentNode.insertBefore(s, x);
          })();
          window.mixpanel.init(mixpanelToken);

          // Delegate CTA click tracking for all pages
          document.addEventListener('click', function(e) {
            var target = e.target.closest('a[href*="signup"], a[href*="auth"]');
            if (!target) return;
            var href = target.getAttribute('href') || '';
            if (href.includes('plan=')) {
              var plan = new URL(href, location.href).searchParams.get('plan') || 'unknown';
              window.mixpanel.track('site_cta_clicked', { location: 'site', plan: plan, href: href });
            } else {
              window.mixpanel.track('site_cta_clicked', { location: 'site', href: href });
            }
          });
        })();
      </script>
    )}

    {/* Google Analytics */}
    {gaId && (
      <script define:vars={{ gaId }}>
        (function() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        })();
      </script>
    )}
  </head>
  <body class="ff-grid-bg">
    <a href="#main-content" class="skip-link">{t(currentLang, 'layout.skipToContent')}</a>
    <script is:inline>
      // Theme initialization - unified across all FunctionFly apps
      (function() {
        var STORAGE_KEY = 'ff-user-theme';
        var LEGACY_KEY = 'ff-theme';
        var _cached = null;

        function getSystemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function resolveTheme(mode) {
          return mode === 'system' ? getSystemTheme() : mode;
        }

        function readStorage() {
          try {
            var stored = localStorage.getItem(STORAGE_KEY);
            if (stored) {
              var parsed = JSON.parse(stored);
              if (parsed.mode === 'light' || parsed.mode === 'dark' || parsed.mode === 'system') {
                return parsed;
              }
            }
          } catch (e) {}
          return null;
        }

        function migrateLegacy() {
          try {
            var legacy = localStorage.getItem(LEGACY_KEY);
            if (legacy && (legacy === 'light' || legacy === 'dark')) {
              localStorage.setItem(STORAGE_KEY, JSON.stringify({ mode: legacy }));
              localStorage.removeItem(LEGACY_KEY);
              return { mode: legacy };
            }
          } catch (e) {}
          return null;
        }

        function applyTheme() {
          var migrated = migrateLegacy();
          var preference = migrated || readStorage();
          var mode = preference ? preference.mode : 'system';
          var resolved = resolveTheme(mode);
          _cached = { mode: mode, resolved: resolved };
          document.documentElement.setAttribute('data-theme', resolved);
        }

        applyTheme();

        window.addEventListener('ff-theme-change', function(e) {
          _cached = e.detail;
          document.documentElement.setAttribute('data-theme', e.detail.resolved);
          updateThemeIcon();
        });

        function updateThemeIcon() {
          var toggle = document.getElementById('theme-toggle');
          if (toggle) {
            var isLight = document.documentElement.getAttribute('data-theme') === 'light';
            toggle.classList.toggle('is-light', isLight);
          }
        }

                    document.documentElement.setAttribute('data-theme', resolved);
            window.dispatchEvent(new CustomEvent('ff-theme-change', { detail: _cached }));
            updateThemeIcon();
          },
          updateIcon: updateThemeIcon
        };
      })();
    </script>

    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <button class="back-to-top" id="backToTop" aria-label="Back to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <script>
      // Back to top button
      const btn = document.getElementById('backToTop');
      if (btn) {
        window.addEventListener('scroll', () => {
          btn.classList.toggle('visible', window.scrollY > 400);
        }, { passive: true });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      </script>

    {/* Newsletter Form Handler */}
    <script is:inline define:vars={{ newsletterSubscribeUrl }}>
      (function() {
        const form = document.getElementById('newsletter-form');
        const emailInput = document.getElementById('newsletter-email');
        const statusDiv = document.getElementById('newsletter-status');
        const submitButton = form?.querySelector('button[type="submit"]');

        if (!form || !emailInput || !statusDiv) return;

        const showStatus = (message, type) => {
          statusDiv.textContent = message;
          statusDiv.className = 'newsletter-status ' + type;
        };

        const clearStatus = () => {
          statusDiv.textContent = '';
          statusDiv.className = 'newsletter-status';
        };

        const setLoading = (loading) => {
          if (submitButton) {
            submitButton.disabled = loading;
            submitButton.innerHTML = loading
              ? '<div class="spinner"></div>'
              : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path></svg>';
          }
          emailInput.disabled = loading;
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = emailInput.value.trim();

          if (!email) {
            showStatus('Please enter your email address.', 'error');
            return;
          }

          // Basic email validation
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            showStatus('Please enter a valid email address.', 'error');
            return;
          }

          clearStatus();
          setLoading(true);

          try {
            const response = await fetch(newsletterSubscribeUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ email }),
            });

            const data = await response.json().catch(() => ({}));

            if (response.ok) {
              showStatus('Successfully subscribed! Check your email for confirmation.', 'success');
              emailInput.value = '';
              setTimeout(clearStatus, 5000);
            } else {
              const errorMessage = data.error || data.message || 'Failed to subscribe. Please try again.';
              showStatus(errorMessage, 'error');
            }
          } catch (err) {
            showStatus('An error occurred. Please try again later.', 'error');
          } finally {
            setLoading(false);
          }
        });

        // Clear status when user starts typing
        emailInput.addEventListener('input', () => {
          if (statusDiv.textContent) {
            clearStatus();
          }
        });
      })();
    </script>
    <script>
      // Global observer for [data-animate] elements (e.g. DemoPlayground)
      // that don't have their own ScrollReveal wrapper. Adds the
      // ff-animate-visible class when the element enters the viewport,
      // so it transitions from opacity:0 to visible.
      (function() {
        if (typeof window === 'undefined' || !('IntersectionObserver' in window)) return;
        var els = document.querySelectorAll('[data-animate]:not(.ff-animate-visible)');
        if (!els.length) return;
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              e.target.classList.add('ff-animate-visible');
              // Also add ff-animate-visible to children with ff-animate-slide-up
              e.target.querySelectorAll('.ff-animate-slide-up').forEach(function(child) {
                child.classList.add('ff-animate-visible');
              });
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        els.forEach(function(el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #FF6B35;
    --color-primary-dark: #E85A2A;
    --color-secondary: #00D4FF;
    --color-bg: var(--bg-default, #0f172a);
    --color-bg-light: var(--bg-subtle, #1e293b);
    --color-text: var(--fg-default, #f8fafc);
    --color-text-muted: var(--fg-muted, #94a3b8);
    --color-border: var(--slate-3, #334155);
    /* 2026 Font Stack - Velocity Brand Aesthetic */
    /* Primary: Instrument Sans (Google Fonts, 2024-2025 trending) */
    --font-sans: 'Instrument Sans', 'Inter', system-ui, -apple-system, sans-serif;
    /* Display: Space Grotesk (NASA/JPL vibe, aviation-forward) */
    --font-display: 'Space Grotesk', 'Instrument Sans', system-ui, sans-serif;
    /* Monospace: Commit Mono (UI-optimized, calm at small sizes) */
    --font-mono: 'Commit Mono', 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  }

  [data-theme='light'] {
    --color-primary: #E85A2A;
    --color-primary-dark: #D14A1A;
    --color-secondary: #00A8CC;
    --color-bg: #ffffff;
    --color-bg-light: #f8fafc;
    --color-text: #0f172a;
    --color-text-muted: #64748b;
    --color-border: #e2e8f0;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  main {
    flex: 1;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .header {
    position: sticky;
    top: 0;
    background: rgba(var(--bg-default-rgb, 13, 17, 23), 0.7);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  [data-theme='light'] .header {
    background: rgba(255, 255, 255, 0.85);
  }

  .nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
    padding: 6px 10px;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .logo:hover {
    background: rgba(var(--bg-default-rgb, 13, 17, 23), 0.5);
  }

  [data-theme='light'] .logo:hover {
    background: rgba(99, 102, 241, 0.08);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    grid-template-columns: repeat(2, 1fr);
    }

    .footer-newsletter {
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer-newsletter-inner {
      max-width: 100%;
  }

  .nav-links a {
    color: var(--color-text-muted);
    transition: color 0.2s, background 0.2s, padding 0.2s;
    padding: 6px 12px;
    border-radius: 6px;
  }

  .nav-links a:hover {
    color: var(--color-text);
    background: rgba(var(--bg-default-rgb, 13, 17, 23), 0.5);
  }

  .nav-active {
    color: var(--ff-cyan, #00D4FF) !important;
    font-weight: 600;
    background: rgba(0, 212, 255, 0.1);
    padding: 6px 12px;
    border-radius: 6px;
  }

  .nav-active:hover {
    color: var(--ff-cyan, #00D4FF) !important;
    background: rgba(0, 212, 255, 0.15);
  }

  [data-theme='light'] .nav-links a:hover {
    background: rgba(99, 102, 241, 0.08);
  }

  [data-theme='light'] .nav-active {
    color: var(--ff-cyan, #00A8CC) !important;
    background: rgba(99, 102, 241, 0.1);
  }

  [data-theme='light'] .nav-active:hover {
    background: rgba(99, 102, 241, 0.15);
  }

  .nav-cta {
    background: var(--color-primary);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 500;
    color: white !important;
    transition: background 0.2s;
  }

  .nav-cta:hover {
    background: var(--color-primary-dark);
  }

  /* Logo background - changes in light mode */
  .logo-bg {
    fill: #0F172A;
    transition: fill var(--duration-fast);
  }

  [data-theme='light'] .logo-bg {
    fill: #1e293b;
  }

  /* Back to top button */
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
    z-index: 50;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.3);
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.3);
  }

  @media (max-width: 640px) {
    .back-to-top {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 8px;
    }
  }

  /* Theme Toggle (Velocity Brand) */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: rgba(var(--bg-default-rgb, 13, 17, 23), 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    position: relative;
  }

  .theme-toggle:hover {
    background: var(--ff-flame, #FF6B35);
    border-color: var(--ff-flame, #FF6B35);
    color: white;
  }

  [data-theme='light'] .theme-toggle {
    background: rgba(255, 255, 255, 0.8);
  }

  [data-theme='light'] .theme-toggle:hover {
    background: var(--ff-flame, #E85A2A);
    border-color: var(--ff-flame, #E85A2A);
  }

  .theme-toggle .sun-icon,
  .theme-toggle .moon-icon {
    position: absolute;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .theme-toggle .sun-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  .theme-toggle .moon-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .theme-toggle.is-light .sun-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .theme-toggle.is-light .moon-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  /* Newsletter Styles */
  .newsletter-column {
    max-width: 280px;
  }

  .newsletter-description {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 0.875rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .newsletter-input::placeholder {
    color: var(--color-text-muted);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
  }

  .newsletter-input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    background: var(--color-primary);
    border: none;
    border-radius: 6px;
    color: white;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .newsletter-button:hover:not(:disabled) {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .newsletter-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-button .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
