# Optional: canonical site for OG URLs, sitemap, and robots (default: https://functionfly.com)
# PUBLIC_SITE_URL=https://functionfly.com

# Optional: standalone Astro docs site (web/docs; default https://docs.functionfly.com). Local dev:
# PUBLIC_DOCS_URL=http://localhost:4322

# Optional: dashboard app URL for “Dashboard” / Get Started links (default: https://app.functionfly.com)
# Local: run the Vite dashboard on 3000, then:
# PUBLIC_APP_URL=http://localhost:3000

# NestJS blog API base URL (no path; no trailing slash). Required for /blog to list posts at build time.
# Defaults to http://localhost:3000 if unset (run cmd/blog-api on that port).
# Nx targets `functionfly-marketing` build/dev load variables from web/site/.env (see web/site/project.json envFile).
# Copy this file to .env locally: cp .env.example .env
PUBLIC_BLOG_API_URL=http://localhost:3000
# Production example:
# PUBLIC_BLOG_API_URL=https://blog-api.functionfly.com

# Standalone Astro blog site URL (web/blog). Used for redirects from /blog to the new blog location.
# Production: https://blog.functionfly.com, local dev: http://localhost:4323
# PUBLIC_BLOG_URL=http://localhost:4323
