// Design Mode - Graph-centric workspace
function DesignView() {
  const [neuralMapOpen, setNeuralMapOpen] = React.useState(false);

  // Sample neural nodes derived from the function graph
  const neuralNodes = sampleNodes.map((n, i) => ({
    id: n.id,
    label: n.label || n.id,
    type: (n.type || "function") as "agent" | "function" | "api" | "memory" | "database" | "input" | "output",
    position: [
      (i % 5) * 6 - 12,
      Math.floor(i / 5) * -5 + 5,
      Math.random() * 2,
    ] as [number, number, number],
    status: (n.status || "idle") as "idle" | "active" | "error" | "processing",
    connections: sampleEdges.filter(e => e.from === n.id || e.to === n.id).map(e => e.from === n.id ? e.to : e.from),
    load: Math.random() * 0.8 + 0.1,
    size: 0.8 + Math.random() * 0.4,
  }));

  const neuralConnections = sampleEdges.map(e => ({
    from: e.from,
    to: e.to,
    type: "data" as const,
    strength: 0.6 + Math.random() * 0.4,
    active: Math.random() > 0.3,
  }));

  return (
    <div className="flex-1 flex flex-col overflow-hidden">
      {/* Top section: Function Canvas */}
      <div className="flex-1 flex overflow-hidden">
        {/* Left Panel - Function Canvas */}
        <div className="flex-1 flex flex-col overflow-hidden">
          <div className="px-4 py-2 border-b border-border-subtle bg-bg-secondary flex items-center justify-between">
            <div className="flex items-center gap-2">
              <GitBranch className="size-4 text-brand-400" />
              <span className="text-sm font-medium text-text-primary">Function Canvas</span>
              <Badge variant="brand" size="sm">Design Mode</Badge>
            </div>
            <div className="flex items-center gap-2">
              <button
                onClick={() => setNeuralMapOpen(!neuralMapOpen)}
                className={cn(
                  "px-2 py-1 text-[10px] border rounded font-medium transition-colors flex items-center gap-1.5",
                  neuralMapOpen
                    ? "bg-purple-500/20 text-purple-400 border-purple-500/30"
                    : "bg-bg-primary text-text-muted border-border-subtle hover:text-text-primary"
                )}
              >
                <Brain className="size-3" /> Neural Map
              </button>
              <button className="px-2 py-1 text-[10px] bg-bg-primary border border-border-subtle rounded text-text-muted hover:text-text-primary transition-colors">
                Auto Layout
              </button>
              <button className="px-2 py-1 text-[10px] bg-brand-500/10 text-brand-400 border border-brand-500/30 rounded font-medium transition-colors">
                Add Node +
              </button>
            </div>
          </div>
          <div className="flex-1 relative overflow-hidden">
            <FunctionCanvas
              nodes={sampleNodes}
              edges={sampleEdges}
              viewMode="design"
              showGrid={true}
              showMinimap={true}
              enableConnect={true}
              enableDrag={true}
              enablePan={true}
              enableZoom={true}
              animateTokenFlow={false}
            />
          </div>
        </div>
      </div>

      {/* Right Panel - Node Inspector */}
      <div className="w-80 border-l border-border-subtle bg-bg-secondary flex flex-col">
        <div className="px-4 py-2 border-b border-border-subtle">
          <span className="text-sm font-medium text-text-primary">Node Inspector</span>
        </div>
        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {/* Selected node info */}
          <GlassCard intensity="medium" glowColor="#f97316">
            <div className="space-y-3">
              <div className="flex items-center gap-2">
                <span className="text-xl">⚡</span>
                <div>
                  <div className="font-semibold text-text-primary">Processor Node</div>
                  <div className="text-[11px] text-text-muted">function · v2.1</div>
                </div>
              </div>
              <div className="grid grid-cols-2 gap-2 text-[11px]">
                <div>
                  <span className="text-text-muted">Status</span>
                  <div className="flex items-center gap-1 mt-0.5">
                    <div className="size-2 rounded-full bg-success" />
                    <span className="text-success font-medium">Active</span>
                  </div>
                </div>
                <div>
                  <span className="text-text-muted">Latency</span>
                  <div className="font-mono mt-0.5">45ms avg</div>
                </div>
                <div>
                  <span className="text-text-muted">Cost</span>
                  <div className="font-mono mt-0.5">$0.002/call</div>
                </div>
                <div>
                  <span className="text-text-muted">Reliability</span>
                  <div className="mt-0.5"><TrustScoreMeter score={92} size="sm" /></div>
                </div>
              </div>
            </div>
          </GlassCard>

          {/* Code Preview */}
          <div>
            <h4 className="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">Source Code</h4>
            <pre className="text-[11px] font-mono bg-bg-primary rounded-lg p-3 border border-border-subtle overflow-x-auto" style={{ maxHeight: 200 }}>
{`export async function handler(event, context) {
  const data = await fetchData(event);
  const result = await process(data);
  return {
    statusCode: 200,
    body: JSON.stringify(result)
  };
}`}
            </pre>
          </div>

          {/* Ports */}
          <div>
            <h4 className="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">Connections</h4>
            <div className="space-y-1 text-[11px]">
              <div className="flex items-center gap-2 py-1">
                <div className="size-2 rounded-full bg-[#3b82f6] border-2 border-border-subtle" />
                <span className="text-text-secondary">Input: HTTP Trigger</span>
              </div>
              <div className="flex items-center gap-2 py-1">
                <div className="size-2 rounded-full bg-[#10b981] border-2 border-border-subtle" />
                <span className="text-text-secondary">Output → LLM Agent</span>
              </div>
            </div>
          </div>

          {/* Neural Execution Map - 3D visualization */}
          {neuralMapOpen && (
            <div>
              <h4 className="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <Brain className="size-3 text-purple-400" /> Neural Execution Map
              </h4>
              <div className="rounded-lg overflow-hidden border border-purple-500/20" style={{ height: 280 }}>
                <NeuralExecutionMap
                  nodes={neuralNodes}
                  connections={neuralConnections}
                  showLabels={true}
                  showConnections={true}
                  interactive={true}
                  autoRotate={false}
                  style="dark"
                />
              </div>
            </div>
          )}
        </div>
      </div>
  );
}
function ExecuteView() {
  return (
    <div className="flex-1 flex overflow-hidden">
      {/* Main Canvas with live execution */}
      <div className="flex-1 flex flex-col overflow-hidden">
        <div className="px-4 py-2 border-b border-border-subtle bg-bg-secondary flex items-center justify-between">
          <div className="flex items-center gap-2">
            <Activity className="size-4 text-success" />
            <span className="text-sm font-medium text-text-primary">Live Execution Monitor</span>
            <Badge variant="success" size="sm" dot pulse>Running</Badge>
          </div>
          <div className="flex items-center gap-2">
            <button className="px-3 py-1.5 text-[11px] bg-error/10 text-error border border-error/30 rounded-lg hover:bg-error/20 transition-colors flex items-center gap-1.5">
              <XCircle className="size-3.5" /> Stop Execution
            </button>
          </div>
        </div>
        <div className="flex-1 relative overflow-hidden">
          <FunctionCanvas
            nodes={sampleNodes.map((n) => ({
              ...n,
              status: Math.random() > 0.3 ? "running" : "completed",
              executionTime: Math.floor(Math.random() * 200 + 20),
              tokenCost: parseFloat((Math.random() * 0.005).toFixed(4)),
              errorRate: parseFloat((Math.random() * 2).toFixed(1)),
              reliabilityScore: Math.floor(Math.random() * 30 + 70),
            }))}
            edges={sampleEdges.map((e) => ({ ...e, status: "active" as const }))}
            viewMode="execute"
            showGrid={false}
            showMinimap={true}
            enableConnect={false}
            enableDrag={false}
            enablePan={true}
            enableZoom={true}
            animateTokenFlow={true}
            tokenFlowSpeed={1.5}
          />
        </div>
      </div>

      {/* Right Panel - Execution Timeline */}
      <div className="w-96 border-l border-border-subtle bg-bg-secondary flex flex-col">
        <div className="px-4 py-2 border-b border-border-subtle">
          <span className="text-sm font-medium text-text-primary">Execution Timeline</span>
        </div>
        <div className="flex-1 overflow-y-auto p-4">
          <ExecutionTimeline
            events={[
              { id: "ev1", timestamp: Date.now() - 5000, type: "node_start", nodeId: "trigger-1", nodeLabel: "HTTP Trigger", result: "success", duration: 5 },
              { id: "ev2", timestamp: Date.now() - 4990, type: "edge_traversal", edgeId: "e1", result: "success" },
              { id: "ev3", timestamp: Date.now() - 4900, type: "node_start", nodeId: "auth-agent", nodeLabel: "Auth Agent", result: "success" },
              { id: "ev4", timestamp: Date.now() - 4800, type: "node_end", nodeId: "auth-agent", result: "success", duration: 45 },
              { id: "ev5", timestamp: Date.now() - 4790, type: "fork", result: "success" },
              { id: "ev6", timestamp: Date.now() - 4700, type: "node_start", nodeId: "vector-memory", nodeLabel: "Vector Memory", result: "success" },
              { id: "ev7", timestamp: Date.now() - 4600, type: "node_start", nodeId: "processor-fn", nodeLabel: "Data Processor", result: "partial" },
              { id: "ev8", timestamp: Date.now() - 4450, type: "node_end", nodeId: "vector-memory", result: "success", duration: 150 },
              { id: "ev9", timestamp: Date.now() - 4200, type: "node_end", nodeId: "processor-fn", result: "success", duration: 550 },
              { id: "ev10", timestamp: Date.now() - 4190, type: "node_start", nodeId: "llm-agent", nodeLabel: "LLM Agent", result: "success" },
              { id: "ev11", timestamp: Date.now() - 3500, type: "node_end", nodeId: "llm-agent", result: "success", duration: 690 },
              { id: "ev12", timestamp: Date.now() - 3490, type: "join", result: "success" },
              { id: "ev13", timestamp: Date.now() - 3400, type: "node_start", nodeId: "output-1", nodeLabel: "Response", result: "success" },
              { id: "ev14", timestamp: Date.now() - 3350, type: "node_end", nodeId: "output-1", result: "success", duration: 50 },
            ]}
            currentTime={Date.now() - 3000}
            onTimeChange={(time) => console.log("Time:", time)}
          />
        </div>
        <div className="px-4 py-3 border-t border-border-subtle bg-bg-tertiary">
          <div className="flex items-center justify-between text-[10px] text-text-muted">
            <span>Last 30s of execution</span>
            <span>Paused at breakpoint</span>
          </div>
        </div>
      </div>
    </div>
  );
}

