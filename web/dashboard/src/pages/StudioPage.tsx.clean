// --- Left Panel Sub-components ---
function NodePanel() {
  return (
    <div className="p-3 space-y-2">
      <h4 className="text-[11px] font-semibold text-text-muted uppercase tracking-wider">Node Library</h4>
      <div className="space-y-1">
        {[
          { type: "trigger" as const, label: "Trigger", icon: "🎯" },
          { type: "function" as const, label: "Function", icon: "⚡" },
          { type: "agent" as const, label: "Agent", icon: "🤖" },
          { type: "api" as const, label: "API", icon: "🔌" },
          { type: "memory" as const, label: "Memory", icon: "🧠" },
          { type: "database" as const, label: "Database", icon: "🗄️" },
          { type: "browser" as const, label: "Browser", icon: "🌐" },
          { type: "gpu" as const, label: "GPU", icon: "🖥️" },
          { type: "output" as const, label: "Output", icon: "📤" },
        ].map((node) => (
          <button
            key={node.type}
            className="w-full flex items-center gap-2 px-3 py-2 text-sm text-text-secondary hover:bg-bg-hover hover:text-text-primary rounded-lg transition-colors"
          >
            <span>{node.icon}</span>
            <span>{node.label}</span>
          </button>
        ))}
      </div>
    </div>
  );
}

function TemplatePanel() {
  return (
    <div className="p-3 space-y-2">
      <h4 className="text-[11px] font-semibold text-text-muted uppercase tracking-wider">Templates</h4>
      <div className="space-y-2">
        {[
          { name: "REST API", desc: "Basic API with auth" },
          { name: "Data Pipeline", desc: "ETL workflow" },
          { name: "AI Agent", desc: "Multi-step reasoning" },
          { name: "Web Scraper", desc: "Browser automation" },
        ].map((t, i) => (
          <div key={i} className="p-2.5 bg-bg-primary rounded-lg border border-border-subtle hover:border-border-default cursor-pointer transition-colors">
            <div className="text-sm font-medium text-text-primary">{t.name}</div>
            <div className="text-[11px] text-text-muted">{t.desc}</div>
          </div>
        ))}
      </div>
    </div>
  );
}