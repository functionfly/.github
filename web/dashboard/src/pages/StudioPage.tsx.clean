          <MetricCard label="Avg Latency" value={42} unit="ms" status="ok" trend="down" delta={-5} sparkline={[0.6, 0.5, 0.4, 0.3, 0.4, 0.3, 0.5, 0.4, 0.3, 0.4]} />
          <MetricCard label="Error Rate" value={0.2} unit="%" status="ok" trend="down" delta={-15} sparkline={[0.3, 0.2, 0.1, 0.2, 0.1, 0.1, 0.2, 0.1, 0.1, 0.2]} />
          <MetricCard label="Active Agents" value={3} unit="agents" status="warning" trend="down" delta={-1} sparkline={[0.8, 0.9, 1, 0.9, 0.8, 0.9, 0.8, 0.7, 0.8, 0.75]} />
          <MetricCard label="Token Usage" value={45.2} unit="K/min" trend="up" delta={15} sparkline={[0.4, 0.5, 0.6, 0.5, 0.7, 0.6, 0.8, 0.7, 0.9, 0.85]} />
          <MetricCard label="Cost/hr" value={0.85} unit="$" status="warning" trend="up" delta={12} sparkline={[0.3, 0.4, 0.3, 0.5, 0.4, 0.5, 0.6, 0.5, 0.7, 0.6]} />
