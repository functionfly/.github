            </div>
          </div>
          <div className="flex items-center gap-2">
            <button className="px-3 py-1.5 text-xs bg-amber-500 hover:bg-amber-600 text-white rounded-lg flex items-center gap-1.5">
              <Zap className="size-3" /> Publish Function
