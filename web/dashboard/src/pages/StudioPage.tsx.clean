// Simulate Mode - Pre-deployment simulation (R-Sim)
function SimulateView() {
  const [simulationConfig, setSimulationConfig] = React.useState({
    workflowId: "wf-001",
    duration: 60,
    parallelism: 10,
    iterations: 1000,
    confidenceLevel: 0.95,
    failureInjection: false,
    stressMode: false,
  });

  const [simulationResult, setSimulationResult] = React.useState<any>(null);

  const handleStart = () => {
    setSimulationResult({
      id: "sim-001",
      status: "running" as const,
      progress: 0,
      startedAt: new Date().toISOString(),
      iteration: 0,
      totalIterations: 1000,
      currentMetrics: { throughput: 847, errorRate: 0.4, avgLatency: 38, p99Latency: 185 },
    });
    // Simulate progress
    let iter = 0;
    const interval = setInterval(() => {
      iter += 50;
      setSimulationResult((r: any) => ({
        ...r,
        iteration: iter,
        progress: iter / 1000,
        currentMetrics: {
          throughput: 800 + Math.random() * 100,
          errorRate: Math.random() * 1,
          avgLatency: 35 + Math.random() * 10,
          p99Latency: 180 + Math.random() * 20,
        },
      }));
      if (iter >= 1000) clearInterval(interval);
    }, 100);
  };

  const sampleForecasts = [
    { timestamp: Date.now() - 3600000, value: 850, lower: 780, upper: 920, confidence: 0.92 },
    { timestamp: Date.now() - 2700000, value: 920, lower: 840, upper: 1000, confidence: 0.94 },
    { timestamp: Date.now() - 1800000, value: 1100, lower: 1000, upper: 1200, confidence: 0.89 },
    { timestamp: Date.now() - 900000, value: 980, lower: 900, upper: 1060, confidence: 0.91 },
    { timestamp: Date.now(), value: 1050, lower: 970, upper: 1130, confidence: 0.93 },
  ];

  const sampleOutcome = {
    outcome: "success" as const,
    probability: 94.2,
    expectedDuration: 45200,
    costEstimate: 0.087,
    riskFactors: ["Network latency variance", "External API rate limits", "Memory pressure at scale"],
  };

  const sampleFailureNodes = [
    { nodeId: "auth-agent", nodeName: "Auth Agent", probability: 0.15, factors: [{ name: "Token expiry", contribution: 0.6 }, { name: "Rate limiting", contribution: 0.4 }], trend: "stable" as const },
    { nodeId: "llm-agent", nodeName: "LLM Agent", probability: 0.08, factors: [{ name: "Model timeout", contribution: 0.7 }, { name: "Context length", contribution: 0.3 }], trend: "decreasing" as const },
    { nodeId: "processor", nodeName: "Data Processor", probability: 0.03, factors: [{ name: "Schema mismatch", contribution: 0.5 }, { name: "Null handling", contribution: 0.5 }], trend: "decreasing" as const },
    { nodeId: "vector-db", nodeName: "Vector Memory", probability: 0.22, factors: [{ name: "Index rebuild", contribution: 0.8 }, { name: "Query timeout", contribution: 0.2 }], trend: "increasing" as const },
    { nodeId: "output-fn", nodeName: "Output Fn", probability: 0.01, factors: [{ name: "Serialization", contribution: 1.0 }], trend: "stable" as const },
  ];

  const sampleLatencyPredictions = Array.from({ length: 20 }, (_, i) => ({
    timestamp: Date.now() - (20 - i) * 300000,
    p50: 35 + Math.random() * 15,
    p95: 120 + Math.random() * 40,
    p99: 280 + Math.random() * 80,
    samples: 1000 + i * 50,
  }));

  const sampleHallucinationRisks = [
    { score: 0.18, factors: [{ name: "Context length", weight: 0.3, description: "Long context increases confusion" }, { name: "Temperature", weight: 0.2, description: "Higher temp = more creative but less precise" }], model: "claude-sonnet-4", confidence: 0.89, recommendations: ["Reduce temperature", "Add validation layer"] },
    { score: 0.42, factors: [{ name: "Model size", weight: 0.5, description: "Larger models hallucinate more" }, { name: "Training data", weight: 0.3, description: "Outdated knowledge cutoff" }], model: "gpt-4o", confidence: 0.75, recommendations: ["Add fact-checking agent", "Use retrieval augmentation"] },
  ];

  const sampleCostEstimate = {
    totalTokens: 4523000,
    inputTokens: 3200000,
    outputTokens: 1323000,
    computeCost: 0.042,
    apiCost: 0.045,
    totalCost: 0.087,
    hourlyBreakdown: Array.from({ length: 24 }, (_, h) => ({ hour: h, cost: 0.003 + Math.random() * 0.008, tokens: 150000 + Math.random() * 100000 })),
  };

  const sampleScalingRecs = [
    { component: "LLM Agent", currentCapacity: 75, bottleneckThreshold: 100, recommendedScale: 150, reason: "P99 latency exceeds SLA at current load", estimatedCostIncrease: 0.12, urgency: "high" as const },
    { component: "Vector Memory", currentCapacity: 88, bottleneckThreshold: 100, recommendedScale: 200, reason: "Memory usage approaching limits", estimatedCostIncrease: 0.08, urgency: "critical" as const },
    { component: "Data Processor", currentCapacity: 45, bottleneckThreshold: 100, recommendedScale: 80, reason: "Queue depth growing steadily", estimatedCostIncrease: 0.05, urgency: "medium" as const },
  ];

  return (
    <div className="flex-1 overflow-y-auto">
      <div className="p-4 space-y-4 max-w-7xl mx-auto">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="size-8 rounded-lg bg-purple-500/20 flex items-center justify-center">
              <Brain className="size-4 text-purple-400" />
            </div>
            <div>
              <h2 className="text-lg font-semibold text-text-primary">R-Sim Simulation Engine</h2>
              <p className="text-xs text-text-muted">Predict outcomes before deployment</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Badge variant="info" size="sm">1,000 iterations</Badge>
            <Badge variant="brand" size="sm">95% confidence</Badge>
          </div>
        </div>

        {/* Simulation Control + Forecast */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div className="lg:col-span-1">
            <SimulationControlCenter
              config={simulationConfig}
              result={simulationResult}
              onConfigChange={setSimulationConfig}
              onStart={handleStart}
              onStop={() => setSimulationResult(null)}
              onReset={() => setSimulationResult(null)}
            />
          </div>
          <div className="lg:col-span-2">
            <ExecutionForecastPanel forecasts={sampleForecasts} outcome={sampleOutcome} />
          </div>
        </div>

        {/* Failure Probability + Latency */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <FailureProbabilityMap nodes={sampleFailureNodes} />
          <LatencyPredictionGraph predictions={sampleLatencyPredictions} />
        </div>

        {/* Hallucination Risk + Cost */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <HallucinationRiskAnalyzer risks={sampleHallucinationRisks} />
          <CostSimulationChart estimate={sampleCostEstimate} />
        </div>

        {/* Scaling Forecast + Agent Behavior */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <ScalingForecastMap recommendations={sampleScalingRecs} />
          <AgentBehaviorPredictor
            predictions={[
              {
                agentId: "Code Architect",
                likelyActions: [
                  { action: "Design API schema", probability: 0.72, expectedOutcome: "OpenAPI 3.1 spec" },
                  { action: "Generate unit tests", probability: 0.58, expectedOutcome: "85% coverage" },
                  { action: "Optimize queries", probability: 0.45, expectedOutcome: "50% latency reduction" },
                ],
                confidence: 0.88,
                basedOnSamples: 342,
              },
              {
                agentId: "Security Auditor",
                likelyActions: [
                  { action: "Scan for vulnerabilities", probability: 0.85, expectedOutcome: "Risk assessment report" },
                  { action: "Validate auth flows", probability: 0.67, expectedOutcome: "Security clearance" },
                ],
                confidence: 0.92,
                basedOnSamples: 128,
              },
            ]}
          />
        </div>

        {/* Workflow Outcome + Resource Collision */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <WorkflowOutcomeSimulator
            iterations={1000}
            outcomes={Array.from({ length: 1000 }, () => {
              const r = Math.random();
              return {
                outcome: r > 0.94 ? "failed" : r > 0.88 ? "partial" : "success",
                probability: r,
                expectedDuration: 45000 + Math.random() * 10000,
                costEstimate: 0.08 + Math.random() * 0.02,
                riskFactors: [],
              };
            })}
          />
          <ResourceCollisionDetector
            collisions={[
              {
                resourceId: "gpu-0",
                resourceName: "GPU Cluster us-east-1",
                severity: "high",
                conflictingTasks: [
                  { taskId: "task-342", startTime: Date.now() + 60000, endTime: Date.now() + 180000 },
                  { taskId: "task-343", startTime: Date.now() + 90000, endTime: Date.now() + 150000 },
                ],
                resolution: "Reschedule task-343 to GPU cluster us-west-2",
              },
            ]}
          />
        </div>

        {/* Stress Test Runner */}
        <StressTestRunner
          isRunning={simulationResult?.status === "running"}
          config={{ iterations: 1000, parallelism: 10 }}
          result={simulationResult ? {
            iterations: simulationResult.iteration,
            totalExecutions: simulationResult.iteration,
            successRate: 99.1,
            throughput: 847,
            latencyP50: 38,
            latencyP95: 142,
            latencyP99: 285,
            errors: [
              { type: "Timeout", count: 5, percentage: 0.5 },
              { type: "Rate Limit", count: 3, percentage: 0.3 },
              { type: "Auth Failure", count: 2, percentage: 0.2 },
            ],
            timeline: [],
          } : undefined}
        />
      </div>
    </div>
  );
}

// Ghost Mode View - Autonomous building
function GhostModeView() {
  const [build, setBuild] = React.useState<any>({
    id: "build-001",
    goal: "Build a REST API for user management with auth, CRUD operations, and rate limiting",
    description: "Auto-generating full-stack user management microservice",
    phase: "building",
    progress: 0.67,
    startedAt: new Date(Date.now() - 300000).toISOString(),
    updatedAt: new Date().toISOString(),
    estimatedCompletion: new Date(Date.now() + 180000).toISOString(),
    currentTaskId: "task-4",
    humanApprovalRequired: true,
    approvalType: "schema",
    tasks: [
      { id: "task-1", title: "Design database schema", description: "Create user table with roles and permissions", status: "completed", phase: "planning", startedAt: new Date(Date.now() - 280000).toISOString(), completedAt: new Date(Date.now() - 240000).toISOString(), duration: 40000, logs: [], agentId: "arch-agent" },
      { id: "task-2", title: "Provision infrastructure", description: "Create Docker containers and networking", status: "completed", phase: "provisioning", startedAt: new Date(Date.now() - 230000).toISOString(), completedAt: new Date(Date.now() - 180000).toISOString(), duration: 50000, logs: [], agentId: "infra-agent" },
      { id: "task-3", title: "Implement auth endpoints", description: "JWT-based authentication with refresh tokens", status: "completed", phase: "building", startedAt: new Date(Date.now() - 170000).toISOString(), completedAt: new Date(Date.now() - 100000).toISOString(), duration: 70000, logs: [], agentId: "backend-agent" },
      { id: "task-4", title: "Generate CRUD handlers", description: "User create/read/update/delete operations", status: "in_progress", phase: "building", startedAt: new Date(Date.now() - 90000).toISOString(), logs: [{ timestamp: new Date().toISOString(), level: "info", message: "Parsing OpenAPI spec..." }, { timestamp: new Date().toISOString(), level: "info", message: "Generating handler code..." }], agentId: "backend-agent" },
      { id: "task-5", title: "Add rate limiting middleware", description: "Token bucket algorithm for API protection", status: "pending", phase: "building", dependencies: ["task-4"] },
      { id: "task-6", title: "Write unit tests", description: "80% code coverage requirement", status: "pending", phase: "building", dependencies: ["task-4"] },
      { id: "task-7", title: "Deploy to staging", description: "Blue-green deployment to staging environment", status: "pending", phase: "deploying", dependencies: ["task-5", "task-6"] },
    ],
  });

  return (
    <div className="flex-1 overflow-y-auto">
      <GhostModeOrchestrator build={build} onApproval={(type) => console.log("Approve:", type)} />
    </div>
  );
}

// Agents View - Full agent lifecycle management
function AgentsView() {
  return (
    <div className="flex-1 overflow-y-auto p-4">
      <div className="max-w-6xl mx-auto space-y-6">
        {/* Header */}
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="size-8 rounded-lg bg-emerald-500/20 flex items-center justify-center">
              <Bot className="size-4 text-emerald-400" />
            </div>
            <div>
              <h2 className="text-lg font-semibold text-text-primary">Agent OS</h2>
              <p className="text-xs text-text-muted">Autonomous agents, swarms & consensus</p>
            </div>
          </div>
          <button className="px-3 py-1.5 text-xs bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg flex items-center gap-1.5">
            <Zap className="size-3" /> Spawn Agent
          </button>
        </div>

        {/* Agent Cards Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {sampleAgents.map((agent) => (
            <AgentCard
              key={agent.id}
              agent={agent}
              onClick={() => console.log("Agent:", agent.id)}
            />
          ))}
        </div>

        {/* Autonomous Task Board */}
        <AutonomousTaskBoard
          agents={sampleAgents}
          tasks={[
            { id: "t1", title: "Refactor auth middleware", status: "in-progress" as const, priority: "high" as const, assignedAgentId: "agent-1", createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(), tags: ["auth", "security"], progress: 65, executionTrace: [{ timestamp: Date.now() - 30000, action: "Analyzing middleware chain", agent: "Code Architect" }, { timestamp: Date.now() - 20000, action: "Identifying bottleneck", agent: "Code Architect" }, { timestamp: Date.now() - 5000, action: "Implementing optimizations", agent: "Code Architect" }] },
            { id: "t2", title: "Add WebSocket support", status: "todo" as const, priority: "medium" as const, assignedAgentId: "agent-3", createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(), tags: ["realtime", "websocket"], progress: 0 },
            { id: "t3", title: "Review API contracts", status: "review" as const, priority: "high" as const, assignedAgentId: "agent-2", createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(), tags: ["api", "review"], progress: 90 },
            { id: "t4", title: "Optimize DB queries", status: "done" as const, priority: "medium" as const, assignedAgentId: "agent-4", createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(), tags: ["database", "performance"], progress: 100 },
          ]}
          onTaskCreate={(task) => console.log("Create task:", task)}
          onTaskUpdate={(id, updates) => console.log("Update task:", id, updates)}
          onTaskAssign={(id, agentId) => console.log("Assign:", id, agentId)}
        />

        {/* Agent Consensus + Conflict */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <AgentConsensusViewer
            consensus={{
              id: "consensus-1",
              topic: "Architecture Decision: REST vs GraphQL",
              status: "voting",
              votes: [
                { id: "v1", agentId: "agent-1", agentName: "Code Architect", vote: "approve", rationale: "REST is simpler and better for our use case", timestamp: new Date().toISOString() },
                { id: "v2", agentId: "agent-2", agentName: "Security Auditor", vote: "reject", rationale: "GraphQL provides better type safety", timestamp: new Date().toISOString() },
                { id: "v3", agentId: "agent-3", agentName: "UI Designer", vote: "approve", rationale: "REST is easier to cache", timestamp: new Date().toISOString() },
                { id: "v4", agentId: "agent-4", agentName: "Infra Agent", vote: "abstain", rationale: "Both options are viable", timestamp: new Date().toISOString() },
              ],
              approvalRate: 0.6,
              createdAt: new Date(Date.now() - 600000).toISOString(),
              expiresAt: new Date(Date.now() + 600000).toISOString(),
            }}
          />
          <AgentConflictResolver
            conflicts={[
              { id: "cf1", severity: "medium", type: "Resource Contention", description: "Code Architect and Infra Agent both need GPU access", agents: [{ id: "agent-1", name: "Code Architect" }, { id: "agent-4", name: "Infra Agent" }], status: "mediating", createdAt: new Date(Date.now() - 300000).toISOString(), mediationRequests: [{ agentId: "agent-1", request: "GPU priority for ML inference", priority: "high" as const }] },
              { id: "cf2", severity: "low", type: "Style Conflict", description: "Two agents generated conflicting code formatting", agents: [{ id: "agent-1", name: "Code Architect" }, { id: "agent-3", name: "UI Designer" }], status: "resolved", createdAt: new Date(Date.now() - 600000).toISOString(), resolution: "Applied project-wide Prettier config" },
            ]}
          />
        </div>

        {/* Agent Skill Graph */}
        <AgentSkillGraph
          agents={sampleAgents.map((a) => ({ ...a, skills: [{ name: "code", level: 0.9 }, { name: "security", level: 0.7 }, { name: "design", level: 0.6 }] }))}
        />
      </div>
    </div>
  );
}

