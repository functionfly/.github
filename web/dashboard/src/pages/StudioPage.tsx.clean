// Collaboration View - Multiplayer, shared editing, async review
function CollaborationView() {
  return (
    <div className="flex-1 overflow-y-auto p-4">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="size-8 rounded-lg bg-cyan-500/20 flex items-center justify-center">
              <Users className="size-4 text-cyan-400" />
            </div>
            <div>
              <h2 className="text-lg font-semibold text-text-primary">Multiplayer & Collaboration</h2>
              <p className="text-xs text-text-muted">Real-time collaboration, shared sessions, async review</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            <Badge variant="success" size="sm" dot>3 collaborators online</Badge>
          </div>
        </div>

        {/* Live Presence + Pair Programming */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <LivePresence
            collaborators={sampleCollaborators}
            currentUser={{ name: "You", color: "#f97316" }}
          />
          <LivePairProgrammingView
            session={{
              id: "session-1",
              hostId: "user-1",
              guestId: "user-2",
              status: "active",
              currentFile: "src/handlers/auth.go",
              currentLine: 42,
              startedAt: new Date(Date.now() - 1200000).toISOString(),
            }}
            host={{ id: "user-1", name: "Alice Chen", color: "#f97316" }}
            guest={{ id: "user-2", name: "Bob Smith", color: "#3b82f6" }}
            onEnd={() => console.log("End session")}
          />
        </div>

        {/* Shared Execution + Graph Editor */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <SharedExecutionView
            executions={sampleExecutions.map((e, i) => ({ ...e, participantId: sampleCollaborators[i % sampleCollaborators.length].id }))}
            participants={sampleCollaborators}
          />
          <CollaborativeGraphEditor
            graph={{ nodes: sampleNodes, edges: sampleEdges }}
            collaborators={sampleCollaborators}
            onNodeUpdate={(nodeId, updates) => console.log("Node update:", nodeId, updates)}
          />
        </div>

        {/* Annotations + Async Review */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <RealtimeAnnotationSystem
            annotations={[
              { id: "a1", nodeId: "trigger-1", type: "comment", content: "Consider adding rate limiting here", author: { name: "Bob Smith", color: "#3b82f6" }, resolved: false, createdAt: new Date().toISOString() },
              { id: "a2", nodeId: "llm-agent", type: "suggestion", content: "Use streaming for better UX", author: { name: "Carol Davis", color: "#10b981" }, resolved: true, createdAt: new Date(Date.now() - 3600000).toISOString() },
            ]}
            onResolve={(id) => console.log("Resolve:", id)}
          />
          <AsyncReviewTimeline
            reviews={[
              { id: "r1", author: { name: "Bob Smith", color: "#3b82f6" }, file: "src/handlers/auth.go", line: 42, content: "Consider using a constant for the max retry count", status: "resolved", timestamp: new Date(Date.now() - 1800000).toISOString() },
              { id: "r2", author: { name: "Alice Chen", color: "#f97316" }, file: "src/middleware/ratelimit.go", line: 15, content: "This logic looks correct", status: "pending", timestamp: new Date(Date.now() - 600000).toISOString() },
            ]}
            onResolve={(id) => console.log("Resolve review:", id)}
          />
        </div>

        {/* Collaborative Prompt Editor */}
        <CollaborativePromptEditor
          prompt="You are a security auditor. Review the following code for vulnerabilities and suggest fixes. Focus on: SQL injection, XSS, authentication bypass, and improper error handling."
          onSave={(prompt) => console.log("Save prompt:", prompt)}
          onVersionSelect={(v) => console.log("Version:", v)}
        />
      </div>
    </div>
  );
}

// Extensions View - Extension SDK, hooks, sandbox
function ExtensionsView() {
  return (
    <div className="flex-1 overflow-y-auto p-4">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="size-8 rounded-lg bg-pink-500/20 flex items-center justify-center">
              <Plug className="size-4 text-pink-400" />
            </div>
            <div>
              <h2 className="text-lg font-semibold text-text-primary">Extensions & SDK</h2>
              <p className="text-xs text-text-muted">Plugin system, hooks, sandbox management</p>
            </div>
          </div>
          <button className="px-3 py-1.5 text-xs bg-pink-500 hover:bg-pink-600 text-white rounded-lg flex items-center gap-1.5">
            <Plug className="size-3" /> Install Extension
          </button>
        </div>

        {/* Extension Manager + Hook Visualizer */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <ExtensionManager
            extensions={[
              { id: "ext-1", name: "GitHub Integration", description: "Sync functions with GitHub repos", version: "1.2.0", author: "FunctionFly", category: "integration", enabled: true, installDate: new Date(Date.now() - 86400000 * 30).toISOString(), lastUsed: new Date().toISOString(), config: {} },
              { id: "ext-2", name: "Slack Notifier", description: "Send alerts to Slack channels", version: "0.9.1", author: "FunctionFly", category: "notifications", enabled: true, installDate: new Date(Date.now() - 86400000 * 15).toISOString(), lastUsed: new Date(Date.now() - 86400000).toISOString(), config: { webhookUrl: "https://hooks.slack.com/..." } },
              { id: "ext-3", name: "DataDog Monitor", description: "Export metrics to DataDog", version: "2.0.0", author: "DataDog Inc", category: "monitoring", enabled: false, installDate: new Date(Date.now() - 86400000 * 5).toISOString(), lastUsed: new Date(Date.now() - 86400000 * 2).toISOString(), config: {} },
            ]}
            onEnable={(id) => console.log("Enable:", id)}
            onDisable={(id) => console.log("Disable:", id)}
            onConfigure={(id) => console.log("Configure:", id)}
            onUninstall={(id) => console.log("Uninstall:", id)}
          />
          <HookSystemVisualizer
            events={["onFunctionExecute", "onAgentSpawn", "onWorkflowDeploy", "onErrorOccurred"]}
            hooks={[
              { id: "h1", event: "onFunctionExecute", pluginId: "ext-1", enabled: true, handler: "logExecution" },
              { id: "h2", event: "onAgentSpawn", pluginId: "ext-2", enabled: true, handler: "notifySlack" },
              { id: "h3", event: "onErrorOccurred", pluginId: "ext-2", enabled: false, handler: "alertTeam" },
            ]}
            onToggle={(id, enabled) => console.log("Toggle hook:", id, enabled)}
          />
        </div>

        {/* Sandbox Monitor + SDK Debugger */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <SandboxMonitor
            sandboxes={[
              { id: "sbox-1", extensionId: "ext-1", status: "running", createdAt: new Date(Date.now() - 3600000).toISOString(), memoryUsage: 128, cpuUsage: 0.15 },
              { id: "sbox-2", extensionId: "ext-2", status: "suspended", createdAt: new Date(Date.now() - 7200000).toISOString(), memoryUsage: 0, cpuUsage: 0 },
            ]}
            onSuspend={(id) => console.log("Suspend:", id)}
            onResume={(id) => console.log("Resume:", id)}
            onTerminate={(id) => console.log("Terminate:", id)}
          />
          <ExtensionSDKDebugger
            logs={[
              { timestamp: "14:30:12", level: "info", message: "Extension 'GitHub Integration' initialized" },
              { timestamp: "14:30:13", level: "debug", message: "Hook 'onFunctionExecute' registered" },
              { timestamp: "14:30:14", level: "warn", message: "Rate limit approaching for webhook" },
              { timestamp: "14:30:15", level: "error", message: "Failed to sync repo: timeout" },
            ]}
          />
        </div>
      </div>
    </div>
  );
}

// ============================
// MAIN STUDIO VIEW
// ============================
export default function StudioPage() {
  const [viewMode, setViewMode] = React.useState<"design" | "execute" | "debug" | "monitor" | "simulate" | "agents" | "ghost" | "marketplace" | "collaborate" | "extensions">("design");
  const [selectedAgentId, setSelectedAgentId] = React.useState<string | null>(null);
  const [commandPaletteOpen, setCommandPaletteOpen] = React.useState(false);

  // Side panel configs
  const leftPanels: PanelConfig[] = [
    { id: "nodes", title: "Nodes", icon: <GitBranch className="size-4" />, component: <NodePanel />, defaultOpen: true },
    { id: "templates", title: "Templates", icon: <Code2 className="size-4" />, component: <TemplatePanel />, defaultOpen: false },
  ];

  const rightPanels: PanelConfig[] = [
    { id: "telemetry", title: "Telemetry", icon: <Activity className="size-4" />, component: <RightTelemetryPanel />, defaultOpen: true },
    { id: "agents", title: "Agents", icon: <Bot className="size-4" />, component: <RightAgentPanel />, defaultOpen: true },
    { id: "collaborators", title: "Collaborators", icon: <Users className="size-4" />, component: <RightCollaboratorPanel />, defaultOpen: false },
    { id: "security", title: "Security", icon: <Shield className="size-4" />, component: <RightSecurityPanel />, defaultOpen: false },
  ];

  return (
    <StudioShell>
      {/* AI Command Palette */}
      <AICommandPalette
        isOpen={commandPaletteOpen}
        onClose={() => setCommandPaletteOpen(false)}
        onToggle={() => setCommandPaletteOpen(!commandPaletteOpen)}
        commands={[
          { id: "deploy", label: "Deploy Workflow", description: "Deploy current workflow to production", category: "Deployment", shortcut: "⌘D", icon: <Zap className="size-4" />, action: () => console.log("Deploy") },
          { id: "simulate", label: "Run Simulation", description: "Simulate workflow with 10,000 executions", category: "Simulation", shortcut: "⌘S", icon: <Zap className="size-4" />, action: () => setViewMode("simulate") },
          { id: "add-node", label: "Add Node", description: "Add a new node to the canvas", category: "Canvas", shortcut: "⌘N", icon: <GitBranch className="size-4" />, action: () => console.log("Add node") },
          { id: "fork", label: "Fork Workflow", description: "Create a fork of the current workflow", category: "Workflow", shortcut: "⌘F", icon: <GitBranch className="size-4" />, action: () => console.log("Fork") },
          { id: "clear", label: "Clear Canvas", description: "Remove all nodes from canvas", category: "Canvas", shortcut: "⌘⌫", icon: <XCircle className="size-4" />, action: () => console.log("Clear") },
          { id: "export", label: "Export as JSON", description: "Export workflow configuration", category: "Export", shortcut: "⌘E", icon: <Eye className="size-4" />, action: () => console.log("Export") },
        ]}
        promptTemplates={[]}
        placeholder="Type a command or search nodes..."
      />

      {/* Title Bar */}
      <div className="h-10 flex items-center justify-between px-4 bg-bg-secondary border-b border-border-subtle shrink-0">
        <div className="flex items-center gap-3">
          <button className="p-1.5 rounded-md text-text-muted hover:text-text-primary hover:bg-bg-hover transition-colors md:hidden" onClick={() => {}}>
            <Menu className="size-4" />
          </button>

          {/* View Mode Tabs */}
          <div className="flex items-center gap-1">
            <button onClick={() => setViewMode("design")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "design"
                ? "bg-brand-500/20 text-brand-400 border border-brand-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <GitBranch className="size-3" /> Design
            </button>
            <button onClick={() => setViewMode("execute")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "execute"
                ? "bg-brand-500/20 text-brand-400 border border-brand-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Activity className="size-3" /> Execute
            </button>
            <button onClick={() => setViewMode("debug")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "debug"
                ? "bg-brand-500/20 text-brand-400 border border-brand-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Terminal className="size-3" /> Debug
            </button>
            <button onClick={() => setViewMode("monitor")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "monitor"
                ? "bg-brand-500/20 text-brand-400 border border-brand-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <BarChart2 className="size-3" /> Monitor
            </button>
            <button onClick={() => setViewMode("simulate")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "simulate"
                ? "bg-brand-500/20 text-brand-400 border border-brand-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Brain className="size-3" /> Simulate
            </button>
            <button onClick={() => setViewMode("agents")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "agents"
                ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Bot className="size-3" /> Agents
            </button>
            <button onClick={() => setViewMode("ghost")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "ghost"
                ? "bg-purple-500/20 text-purple-400 border border-purple-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Ghost className="size-3" /> Ghost
            </button>
            <button onClick={() => setViewMode("marketplace")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "marketplace"
                ? "bg-amber-500/20 text-amber-400 border border-amber-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Package className="size-3" /> Market
            </button>
            <button onClick={() => setViewMode("collaborate")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "collaborate"
                ? "bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Users className="size-3" /> Collab
            </button>
            <button onClick={() => setViewMode("extensions")} className={cn(
              "px-3 py-1.5 text-[11px] rounded-lg transition-all flex items-center gap-1.5",
              viewMode === "extensions"
                ? "bg-pink-500/20 text-pink-400 border border-pink-500/30 font-medium"
                : "text-text-muted hover:text-text-secondary"
            )}>
              <Plug className="size-3" /> Extensions
            </button>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <Tooltip content="Orbit Command Layer (⌘K)">
            <button onClick={() => setCommandPaletteOpen(true)} className="p-2 rounded-lg bg-brand-500/10 hover:bg-brand-500/20 text-brand-400 transition-colors flex items-center gap-1.5">
              <Zap className="size-4" />
              <span className="text-[11px] font-medium hidden md:inline">Command Palette</span>
              <kbd className="ml-1 text-[10px] bg-brand-500/20 px-1.5 py-0.5 rounded text-brand-400">⌘K</kbd>
            </button>
          </Tooltip>
          <button className="p-2 rounded-lg bg-bg-tertiary hover:bg-bg-hover text-text-muted hover:text-text-primary transition-colors">
            <Maximize2 className="size-4" />
          </button>
        </div>
      </div>

      {/* Main Workspace */}
      <div className="flex-1 flex overflow-hidden">
        {/* Left Sidebar */}
        <LeftSidebar panels={leftPanels} />

        {/* Main Content */}
        <div className="flex-1 overflow-hidden">
          {viewMode === "design" && <DesignView />}
          {viewMode === "execute" && <ExecuteView />}
          {viewMode === "monitor" && <MonitorView />}
          {viewMode === "simulate" && <SimulateView />}
          {viewMode === "agents" && <AgentsView />}
          {viewMode === "ghost" && <GhostModeView />}
          {viewMode === "marketplace" && <MarketplaceView />}
          {viewMode === "collaborate" && <CollaborationView />}
          {viewMode === "extensions" && <ExtensionsView />}
          {viewMode === "debug" && (
            <div className="flex-1 flex flex-col overflow-hidden">
              <div className="px-4 py-2 border-b border-border-subtle bg-bg-secondary flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Terminal className="size-4 text-brand-400" />
                  <span className="text-sm font-medium text-text-primary">Debug Console</span>
                </div>
                <button className="px-3 py-1 text-[11px] bg-bg-primary border border-border-subtle rounded text-text-muted hover:text-text-primary transition-colors">
                  Clear
                </button>
              </div>
              <div className="flex-1 font-mono text-[12px] p-4 overflow-y-auto bg-[#0a0a0f]">
                {sampleLogs.map((log, i) => (
                  <div key={i} className="py-0.5" style={{ color: log.level === "error" ? "#ef4444" : log.level === "warn" ? "#f59e0b" : log.level === "debug" ? "#6b7280" : "#a0a0b0" }}>
                    <span className="text-text-muted">[{log.timestamp}]</span>{" "}
                    <span className="uppercase font-bold">[{log.level}]</span> {log.message}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Right Panel */}
        <RightPanel panels={rightPanels} />
      </div>
    </StudioShell>
  );
}

