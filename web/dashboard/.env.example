# FunctionFly API Configuration
#
# VITE_COMING_SOON_ONLY: Production build only — launch page for every route (pre-launch hosting).
# In dev, this is ignored unless you also set VITE_COMING_SOON_IN_DEV=true (so prod .env does not lock localhost).
# VITE_COMING_SOON_ONLY=true
# VITE_COMING_SOON_IN_DEV=true
#
# VITE_API_URL: Backend for dashboard API calls (auth, API keys, billing, etc.).
#
# Local dev (recommended): point directly at the API so /v1/api-keys etc. work.
# 1. Start the API: ./bin/orchestrator-api --skip-migrations (see AGENTS.md).
# 2. Use either:
#    VITE_API_URL=http://localhost:8080   <- API calls go to backend (no proxy)
#    VITE_API_URL=/api                     <- API calls go through Vite proxy to 8080 (proxy target: API_PROXY_TARGET or VITE_PROXY_API_TARGET)
# If you see "GET http://localhost:3000/api/v1/api-keys 404", the proxy cannot reach the backend: start the API on 8080 or set VITE_API_URL=http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Optional: origin shown in app URL previews (create app, etc.). Default: https://functionfly.com
# VITE_PUBLIC_SITE_URL=https://staging.example.com

# Optional: Astro marketing dev origin (web/site). Logged-out "/" redirects here; default is http://localhost:4321 if unset.
# VITE_MARKETING_DEV_URL=http://localhost:4321

# Optional: standalone Astro docs site (web/docs). Nav "Docs" and /docs/* use this; default dev http://localhost:4322 if unset.
# VITE_DOCS_SITE_URL=http://localhost:4322

# Neon Data API URL (required for database operations)
# Get this from your Neon project dashboard: https://console.neon.tech
# Format: https://console.neon.tech/main-branch
# VITE_NEON_DATA_API_URL=https://console.neon.tech/main-branch

# Blog API (NestJS microservice)
VITE_BLOG_API_URL=https://blog-api.functionfly.com

# Blog Site URL (standalone Astro blog at web/blog)
# Production: https://blog.functionfly.com, local dev: http://localhost:4327
# VITE_BLOG_SITE_URL=http://localhost:4323

# Sanity Configuration (legacy - to be removed)
# VITE_SANITY_PROJECT_ID=your_project_id_here
# VITE_SANITY_DATASET=production
# VITE_SANITY_API_VERSION=2024-01-01
# IMPORTANT: Do NOT commit real auth tokens - use environment variables instead

# Metrics API endpoint for real-time monitoring data
VITE_METRICS_API_URL=https://api.functionfly.com/v1/metrics

# API key for authenticated requests (if required)
VITE_METRICS_API_KEY=your_api_key_here

# Alternative monitoring service configurations:

# DataDog API (if using DataDog for metrics)
# VITE_DATADOG_API_KEY=your_datadog_api_key
# VITE_DATADOG_APP_KEY=your_datadog_app_key

# StatusPage.io (if using StatusPage for status)
# VITE_STATUSPAGE_PAGE_ID=your_statuspage_id

# Custom backend URL (if you have your own metrics service)
# VITE_CUSTOM_METRICS_URL=https://your-metrics-api.com/api/v1

# Google Analytics 4
# Get your Measurement ID from Google Analytics (format: G-XXXXXXXXXX)
VITE_GOOGLE_ANALYTICS_ID=your_ga_measurement_id_here

# Hotjar
# Get your Site ID from Hotjar (numeric format: 1234567)
VITE_HOTJAR_SITE_ID=your_hotjar_site_id_here

# Stripe Price IDs for Billing
# Get these from your Stripe dashboard (Product catalog -> Price details)
# Platform Plans
VITE_STRIPE_PRICE_STARTER=price_starter_id_here
VITE_STRIPE_PRICE_PROFESSIONAL=price_professional_id_here

# Agent Execution Plans
VITE_STRIPE_PRICE_AGENT_STARTER=price_agent_starter_id_here
VITE_STRIPE_PRICE_AGENT_SCALE=price_agent_scale_id_here
VITE_STRIPE_PRICE_AGENT_PRO=price_agent_pro_id_here

# State Fabric Plans
VITE_STRIPE_PRICE_SF_STARTER=price_sf_starter_id_here
VITE_STRIPE_PRICE_SF_PRO=price_sf_pro_id_here
VITE_STRIPE_PRICE_SF_BUSINESS=price_sf_business_id_here