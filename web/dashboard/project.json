{
  "name": "dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/dashboard/src",
  "projectType": "application",
  "tags": ["type:app", "platform:web"],
  "implicitDependencies": ["docs"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "web/dashboard/dist"
      },
      "configurations": {
        "production": {
          "mode": "production"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env -i HOME=/home/micro TERM=$TERM PATH=/home/micro/.n/bin:/home/micro/.bun/bin:/usr/bin:/bin bunx vite --host 0.0.0.0 --port 3000",
        "cwd": "web/dashboard",
        "env": {
          "VITE_API_URL": "http://localhost:8080",
          "VITE_PROXY_API_TARGET": "http://localhost:8080"
        }
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "web/dashboard"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["web/dashboard/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "web/dashboard"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest",
        "cwd": "web/dashboard"
      }
    }
  }
}
