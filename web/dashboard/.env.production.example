# FunctionFly Dashboard - Production Environment Variables
# Copy this file to .env.production and fill in the values
# For Cloudflare Pages, set these in the Pages project settings

# ===========================================
# REQUIRED
# ===========================================

# Production API URL (point to Fly.io deployed API)
# This is the main endpoint for dashboard authentication, API keys, billing, etc.
VITE_API_URL=https://api.functionfly.com

# Coming-soon mode: show only the launch/waitlist page on functionfly.com until you go live.
# Set to "true" when deploying the main domain as a coming-soon page; remove or set to "false" for full site.
VITE_COMING_SOON_ONLY=true

# ===========================================
# OPTIONAL - Analytics & Monitoring
# ===========================================

# Google Analytics 4 (get from https://analytics.google.com)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Hotjar (get from https://hotjar.com)
# VITE_HOTJAR_SITE_ID=1234567

# ===========================================
# OPTIONAL - Blog API
# ===========================================

# Blog API endpoint (NestJS microservice)
VITE_BLOG_API_URL=https://blog-api.functionfly.com

# ===========================================
# OPTIONAL - Legacy (to be removed)
# ===========================================

# Sanity CMS (legacy - to be removed)
# VITE_SANITY_PROJECT_ID=your_project_id
# VITE_SANITY_DATASET=production
# VITE_SANITY_API_VERSION=2024-01-01
# VITE_SANITY_AUTH_TOKEN=your_token

# Metrics API (optional custom metrics service)
# VITE_METRICS_API_URL=https://api.functionfly.com/v1/metrics
# VITE_METRICS_API_KEY=your_api_key
