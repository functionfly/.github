{
  "name": "functionfly-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "rm -rf node_modules/.vite 2>/dev/null || echo 'Hint: if Vite fails with EACCES on .vite, run: sudo rm -rf node_modules/.vite'",
    "dev": "npx --yes kill-port 3000 2>/dev/null; sleep 2; infisical run --env=dev -- vite",
    "build": "tsc -b && vite build",
    "build:standalone": "vite build",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-robots": "generate-robotstxt",
    "seo": "npm run generate-robots && npm run generate-sitemap",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "prepare": "husky || true"
  },
