# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Strict CSP for auth pages (connect-src allows API and WSS for split-domain app.functionfly.com -> api.functionfly.com)
/login*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://api.functionfly.com https://api.staging.functionfly.com wss://api.functionfly.com wss://api.staging.functionfly.com; frame-ancestors 'none';

/signup*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://api.functionfly.com https://api.staging.functionfly.com wss://api.functionfly.com wss://api.staging.functionfly.com; frame-ancestors 'none';

/auth*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://api.functionfly.com https://api.staging.functionfly.com wss://api.functionfly.com wss://api.staging.functionfly.com; frame-ancestors 'none';

# Standard CSP for other pages
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://va.vercel-scripts.com https://api.functionfly.com https://api.staging.functionfly.com wss://api.functionfly.com wss://api.staging.functionfly.com https: wss:; worker-src 'self' blob:;
