# Blog API Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL with Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/functionfly_blog

# JWT Authentication (share secret with orchestrator-api)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://functionfly.com

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
