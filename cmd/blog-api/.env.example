# Blog API Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL with Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/functionfly_blog

# JWT Authentication (share secret with orchestrator-api)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional: extra CORS origins (merged with localhost:5173,3000,4321 and functionfly.com by default)
# CORS_ORIGIN=https://staging.functionfly.com

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
