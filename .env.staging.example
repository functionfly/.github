# ============================================================================
# FunctionFly Staging Environment Configuration
# ============================================================================
# Copy this file to .env.staging and fill in the actual values
# DO NOT commit .env.staging to version control
# ============================================================================

# ============================================================================
# CORE ENVIRONMENT CONFIGURATION
# ============================================================================
NODE_ENV=staging
ENVIRONMENT=staging
PORT=8082

# ============================================================================
# DATABASE CONFIGURATION (Neon Staging Branch)
# ============================================================================
# Neon staging database connection
DB_HOST=ep-staging-example.c-4.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=functionfly_owner
DB_PASSWORD=your-neon-staging-password-here
DB_NAME=functionfly
DB_SSLMODE=require

# Database Encryption (staging-specific master key)
DB_ENCRYPTION_ENABLED=true
DB_MASTER_KEY_PASSWORD=your-staging-master-key-min-32-chars-long

# ============================================================================
# REDIS CONFIGURATION (Staging Instance)
# ============================================================================
# Redis is running on port 6380 in staging
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=1
ARTIFACT_TTL=24h

# Cache Configuration
CACHE_REDIS_ENABLED=true
CACHE_MEMORY_MAX_MB=100
CACHE_DISK_ENABLED=false
CACHE_REDIS_REGISTRY_TTL=600
CACHE_DEFAULT_TTL=3600

# CDN Configuration (Staging)
CACHE_CDN_ENABLED=true
CACHE_CDN_PROVIDER=cloudflare
CACHE_CDN_BASE_URL=https://cdn.staging.functionfly.com
CACHE_CDN_MAX_AGE=3600
CACHE_SDK_BASE_PATH=/sdk
CACHE_DOCS_BASE_PATH=/docs
CACHE_STATIC_BASE_PATH=/static

# Edge Cache Configuration
CACHE_EDGE_ENABLED=true
CACHE_EDGE_MIN_POPULARITY=50
CACHE_EDGE_MIN_EXECUTIONS=100
CACHE_EDGE_MIN_TRUST_SCORE=70.0
CACHE_EDGE_MIN_SUCCESS_RATE=95.0
CACHE_EDGE_MAX_LATENCY_MS=5000
CACHE_EDGE_DURATION=1h
CACHE_EDGE_MAX_FUNCTIONS=100
CACHE_EDGE_REFRESH_INTERVAL=10m

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# JWT and API Secrets (staging-specific, different from production)
# Generate with: openssl rand -base64 48
JWT_SECRET=your-staging-jwt-secret-min-32-chars-long-change-this
API_SHARED_SECRET=your-staging-api-shared-secret-min-32-chars-change-this

# Rate Limiting (relaxed for staging/testing)
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://staging.functionfly.com,https://app.staging.functionfly.com,https://api.staging.functionfly.com,http://localhost:3000
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"
CORS_ALLOWED_HEADERS="Accept, Content-Type, Content-Length, Accept-Encoding, X-CSRF-Token, Authorization, X-FFLY-Timestamp, X-FFLY-Signature, x-neon-client-info"

# Content Security Policy
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:;"
HSTS_MAX_AGE=31536000

# ============================================================================
# ADVANCED SECURITY MIDDLEWARE
# ============================================================================
ADVANCED_SECURITY_SLIDING_WINDOW_LIMIT=200
ADVANCED_SECURITY_SLIDING_WINDOW_MINUTES=1
ADVANCED_SECURITY_TOKEN_BUCKET_RATE=20.0
ADVANCED_SECURITY_TOKEN_BUCKET_BURST=40
ADVANCED_SECURITY_ENABLE_BOT_DETECTION=true
ADVANCED_SECURITY_ENABLE_TRAFFIC_ANALYSIS=true
ADVANCED_SECURITY_SUSPICIOUS_THRESHOLD=15
ADVANCED_SECURITY_BLOCK_MINUTES=30
ADVANCED_SECURITY_CIRCUIT_BREAKER_THRESHOLD=0.7
ADVANCED_SECURITY_CIRCUIT_BREAKER_MINUTES=2
ADVANCED_SECURITY_QUEUE_SIZE=2000
ADVANCED_SECURITY_QUEUE_SECONDS=60
ADVANCED_SECURITY_BLOCKED_COUNTRIES=
ADVANCED_SECURITY_BLOCKED_IPS=
ADVANCED_SECURITY_ALLOWED_IPS=
ADVANCED_SECURITY_ENABLE_SQL_INJECTION_FILTER=true
ADVANCED_SECURITY_ENABLE_XSS_FILTER=true
ADVANCED_SECURITY_ENABLE_PATH_TRAVERSAL_FILTER=true
ADVANCED_SECURITY_METRICS_ENABLED=true

# ============================================================================
# URL CONFIGURATION
# ============================================================================
BASE_URL=https://api.staging.functionfly.com
FRONTEND_URL=https://app.staging.functionfly.com

# ============================================================================
# EMAIL CONFIGURATION (External SMTP for staging)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=staging@functionfly.com
SMTP_PASSWORD=your-app-specific-password-here
FROM_EMAIL=noreply@staging.functionfly.com
FROM_NAME=FunctionFly Staging

# ============================================================================
# OAUTH PROVIDER CONFIGURATION (Test/Sandbox Accounts)
# ============================================================================
# Google OAuth - Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-google-client-secret

# GitHub OAuth - Create OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-staging-github-client-id
GITHUB_CLIENT_SECRET=your-staging-github-client-secret

# GitHub API (for release management and changelog)
GITHUB_OWNER=functionfly
GITHUB_REPO=functionfly
GITHUB_TOKEN=ghp_your-github-personal-access-token-here

# ============================================================================
# SANITY CMS (for content management)
# ============================================================================
SANITY_PROJECT_ID=your-staging-sanity-project-id
SANITY_DATASET=staging
SANITY_AUTH_TOKEN=your-sanity-auth-token-here

# ============================================================================
# SUPABASE (Dashboard)
# ============================================================================
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-supabase-anon-key

# ============================================================================
# ARCHIVE STORAGE (Disabled in staging to reduce costs)
# ============================================================================
ARCHIVE_ENABLED=false
ARCHIVE_RETENTION_DAYS=30
ARCHIVE_CLEANUP_INTERVAL_HOURS=24

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug

# ============================================================================
# DASHBOARD BUILD CONFIGURATION
# ============================================================================
VITE_API_URL=https://api.staging.functionfly.com

# ============================================================================
# FUNCTION VERIFICATION SERVICES
# ============================================================================
# ClamAV and YARA can be enabled for staging to test malware scanning
# CLAMAV_URL=http://clamav:3310
# YARA_URL=http://yara:8080
VERIFICATION_ENABLED=true
VERIFICATION_TIMEOUT_SECONDS=30
VERIFICATION_MAX_FILE_SIZE_MB=10
VERIFICATION_CACHE_TTL_MINUTES=60

# ============================================================================
# TRUST LEVELS CONFIGURATION
# ============================================================================
MINIMUM_TRUST_LEVEL=standard
TRUST_LEVEL_STANDARD_ENABLED=true
TRUST_LEVEL_HIGH_ENABLED=true
TRUST_LEVEL_ENTERPRISE_ENABLED=true
TRUST_LEVEL_STANDARD_REQUIRE_MALWARE_SCAN=true
TRUST_LEVEL_HIGH_REQUIRE_SIGNATURE_VERIFICATION=true
TRUST_LEVEL_HIGH_REQUIRE_APPROVAL=true
TRUST_LEVEL_ENTERPRISE_REQUIRE_MANUAL_APPROVAL=true

# ============================================================================
# STRIPE PAYMENT PROCESSING (Test Mode)
# ============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ============================================================================
# MONITORING AND ALERTING
# ============================================================================
# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9090

# Alerting configuration
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_RECIPIENTS=alerts@functionfly.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=
ALERT_PAGERDUTY_ENABLED=false
ALERT_PAGERDUTY_SERVICE_KEY=

# ============================================================================
# EDGE SERVICE CONFIGURATION
# ============================================================================
EDGE_SERVICE_PORT=8081
EDGE_SERVICE_HOST=edge-service

# Cloudflare Workers Edge Target
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# Vercel Edge Target
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-vercel-team-id

# Fly.io Edge Target
FLY_API_TOKEN=your-fly-api-token
FLY_ORG_SLUG=your-fly-org

# Deno Deploy Edge Target
DENO_DEPLOY_TOKEN=your-deno-deploy-token
DENO_DEPLOY_PROJECT=your-deno-project

# ============================================================================
# BACKUP AND DISASTER RECOVERY
# ============================================================================
# S3-compatible storage for backups (Staging)
BACKUP_S3_ENDPOINT=s3.us-east-1.amazonaws.com
BACKUP_S3_BUCKET=functionfly-staging-backups
BACKUP_S3_ACCESS_KEY=your-backup-access-key
BACKUP_S3_SECRET_KEY=your-backup-secret-key
BACKUP_S3_REGION=us-east-1
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
