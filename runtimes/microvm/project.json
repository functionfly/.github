{
  "name": "runtime-microvm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "runtimes/microvm/src",
  "projectType": "application",
  "tags": ["type:runtime", "platform:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/target/release"],
      "options": {
        "command": "cd runtimes/microvm && cargo build --release"
      },
      "cache": true
    },
    "build:debug": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/target/debug"],
      "options": {
        "command": "cd runtimes/microvm && cargo build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd runtimes/microvm && cargo test"
      },
      "cache": true
    }
  }
}
