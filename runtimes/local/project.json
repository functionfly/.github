{
  "name": "runtime-local",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "runtimes/local/src",
  "projectType": "application",
  "tags": ["type:runtime", "platform:rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/target/release/functionfly-local"],
      "options": {
        "commands": [
          "cd runtimes/local && cargo build --release",
          "cp runtimes/local/target/release/functionfly-local bin/"
        ],
        "parallel": false
      },
      "cache": true
    },
    "build:debug": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/target/debug/functionfly-local"],
      "options": {
        "command": "cd runtimes/local && cargo build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd runtimes/local && cargo test"
      },
      "cache": true
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd runtimes/local && cargo clean"
      }
    }
  }
}
