# =============================================================================
# FunctionFly Local SAR Runtime — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# AI Service (FlyMind Python microservice)
# -----------------------------------------------------------------------------
# Base URL of the FlyMind AI routing service (port 8081 by default)
FLYMIND_URL=http://localhost:8081
# Optional API key for FlyMind auth
# FLYMIND_API_KEY=

# -----------------------------------------------------------------------------
# Go Orchestrator Backend
# -----------------------------------------------------------------------------
# Orchestrator URL (used for MicroVM execution and billing callbacks)
ORCHESTRATOR_URL=http://localhost:8080
# Timeout for MicroVM execution requests to the orchestrator (seconds)
ORCHESTRATOR_TIMEOUT_SECS=30
# API token for orchestrator (if required)
# FUNCTIONFLY_MICROVM_API_TOKEN=

# -----------------------------------------------------------------------------
# Billing (AI Usage Charging)
# -----------------------------------------------------------------------------
# The SAR runtime fires a POST to this URL after each LLM call to charge the
# tenant wallet. This must point to the Go orchestrator's base URL.
# The endpoint called is: {ORCHESTRATOR_BILLING_URL}/v1/billing/ai/charge
ORCHESTRATOR_BILLING_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# WASM Execution
# -----------------------------------------------------------------------------
# Directory containing pre-compiled WASM function artifacts (.wasm files)
# WASM_ARTIFACTS_DIR=./artifacts
# Enable WASM instance pooling for warm reuse across requests
# WASM_POOL_ENABLED=true
# Maximum concurrent warm WASM instances
# WASM_POOL_MAX_CONCURRENT=10
# Maximum idle WASM instances to keep warm
# WASM_POOL_MAX_IDLE=5

# -----------------------------------------------------------------------------
# Python Runtime (RustPython fallback)
# -----------------------------------------------------------------------------
# Enable RustPython fallback for functions that need Python
# PYTHON_ENABLED=true
# Python packages to pre-install (comma-separated)
# PYTHON_PACKAGES=numpy,requests

# -----------------------------------------------------------------------------
# Memory Layer (Hot/Warm/Cold tier storage)
# -----------------------------------------------------------------------------
# Enable the multi-tier memory layer (Phase 3)
# MEMORY_LAYER_ENABLED=true
# Hot tier TTL in seconds (Redis)
# MEMORY_HOT_TTL_SECS=300
# Warm tier TTL in seconds
# MEMORY_WARM_TTL_SECS=3600

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
# Redis password (if required)
# REDIS_PASSWORD=
# Redis database number
# REDIS_DB=0

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/functionfly?sslmode=disable

# -----------------------------------------------------------------------------
# Enterprise Features
# -----------------------------------------------------------------------------
# Enable enterprise tier (required for MicroVM orchestrator)
# ENTERPRISE_ENABLED=false

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Logging level: trace, debug, info, warn, error
# LOG_LEVEL=info
# Enable structured JSON logging
# STRUCTURED_LOGGING=true
# Enable OpenTelemetry tracing
# OTEL_ENABLED=false
# OTEL_ENDPOINT=http://localhost:4317
