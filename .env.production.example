# =============================================================================
# FunctionFly Production Environment Template
# =============================================================================
# ⚠️  SECURITY WARNING: This file contains sensitive configuration templates.
#    - Copy this file to .env.production and fill with actual values
#    - NEVER commit .env.production to version control
#    - Keep production secrets in a secure secrets manager (Infisical, Vault, etc.)
#    - Rotate all secrets marked with # CHANGE THIS: before production deployment
# =============================================================================

## =============================================================================
## Database Configuration (Neon PostgreSQL)
## =============================================================================
# Neon PostgreSQL connection settings
# Get these from your Neon dashboard: https://console.neon.tech

# Database host (e.g., ep-cool-river-123456.us-east-1.aws.neon.tech)
DB_HOST=

# Database port (PostgreSQL default)
DB_PORT=5432

# Database name
DB_NAME=functionfly

# Database user
DB_USER=

# Database password # CHANGE THIS: Use strong password from Neon
DB_PASSWORD=

# SSL mode for secure connections (required for Neon)
DB_SSL_MODE=require

# Full connection URL (optional - used if individual vars not set)
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

## =============================================================================
## Redis Configuration
## =============================================================================
# Redis is used for caching, sessions, and real-time features
# Use Redis Cloud, Upstash, or self-hosted Redis

# Redis server hostname or IP
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis password (if authentication enabled) # CHANGE THIS: From your Redis provider
REDIS_PASSWORD=

# Enable SSL/TLS for Redis connection
REDIS_SSL=false

# Redis database number (0-15)
REDIS_DB=0

## =============================================================================
## API Configuration
## =============================================================================
# Core API server settings

# Port for the API server to listen on
API_PORT=8080

# Host interface to bind to (0.0.0.0 for all interfaces)
API_HOST=0.0.0.0

# Base URL for API endpoints (must match your domain)
BASE_URL=https://api.functionfly.com

# Frontend dashboard URL for CORS and OAuth redirects (canonical app origin)
FRONTEND_URL=https://app.functionfly.com

## =============================================================================
## CORS Configuration (Production)
## =============================================================================
# Comma-separated list of allowed origins. Do not use * in production.
# Required for split-domain deployment (app/admin/api).
CORS_ALLOWED_ORIGINS=https://app.functionfly.com,https://admin.functionfly.com,https://api.functionfly.com
# Optional: include marketing/docs if they call API directly
# CORS_ALLOWED_ORIGINS=https://app.functionfly.com,https://admin.functionfly.com,https://api.functionfly.com,https://functionfly.com,https://docs.functionfly.com

## =============================================================================
## Authentication & Security
## =============================================================================
# ⚠️  CRITICAL: Generate strong random values for all secrets below
#    Use: openssl rand -base64 32  (for JWT_SECRET, API_KEY_SALT)
#    Use: openssl rand -hex 32     (for ENCRYPTION_KEY - 64 hex chars)

# JWT signing secret for authentication tokens
# Generate with: openssl rand -base64 48
JWT_SECRET=  # CHANGE THIS: 32+ character random string

# JWT token expiry time in hours
JWT_EXPIRY_HOURS=24

# Encryption key for sensitive data at rest (64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=  # CHANGE THIS: 64 character hex string

# Salt for API key hashing
# Generate with: openssl rand -base64 24
API_KEY_SALT=  # CHANGE THIS: 16+ character random string

## =============================================================================
## Infisical Secrets Management
## =============================================================================
# Infisical provides centralized secrets management
# Docs: https://infisical.com/docs

# Infisical service token for fetching secrets
# Get from: Infisical Dashboard > Project Settings > Service Tokens
INFISICAL_TOKEN=  # CHANGE THIS: From Infisical dashboard

# Infisical project ID
INFISICAL_PROJECT_ID=

# Infisical environment (production, staging, development)
INFISICAL_ENVIRONMENT=production

## =============================================================================
## Runtime Configuration
## =============================================================================
# Function runtime endpoints for executing code

# Local/WASM runtime endpoint
RUNTIME_LOCAL_URL=http://localhost:8081

# Node.js runtime endpoint
RUNTIME_NODEJS_URL=http://localhost:8082

# Python runtime endpoint
RUNTIME_PYTHON_URL=http://localhost:8083

# ClamAV antivirus scanner endpoint
CLAMAV_URL=tcp://localhost:3310

# YARA malware detection service endpoint
YARA_URL=http://localhost:8084

## =============================================================================
## Monitoring & Observability
## =============================================================================
# Tools for monitoring production health and performance

# Loki log aggregation endpoint
LOKI_URL=http://localhost:3100

# Prometheus metrics endpoint
PROMETHEUS_URL=http://localhost:9090

# Grafana admin password (initial setup)
GRAFANA_ADMIN_PASSWORD=  # CHANGE THIS: Strong admin password

# Slack webhook URL for Alertmanager notifications (optional)
# Get from: Slack Apps > Incoming Webhooks
ALERTMANAGER_SLACK_WEBHOOK=

## =============================================================================
## Storage & Backups
## =============================================================================
# S3-compatible storage for backups and file storage
# Supports AWS S3, Cloudflare R2, MinIO, etc.

# S3 endpoint URL
# AWS: s3.us-east-1.amazonaws.com
# Cloudflare R2: <account>.r2.cloudflarestorage.com
S3_ENDPOINT=  # e.g., s3.us-east-1.amazonaws.com

# S3 bucket name for backups
S3_BUCKET=functionfly-backups

# S3 access key ID # CHANGE THIS: From your S3 provider
S3_ACCESS_KEY=

# S3 secret access key # CHANGE THIS: From your S3 provider
S3_SECRET_KEY=

# Encryption key for backup files (32 characters)
# Generate with: openssl rand -base64 24 | cut -c1-32
BACKUP_ENCRYPTION_KEY=  # CHANGE THIS: 32 character string

## =============================================================================
## Feature Flags
## =============================================================================
# Toggle application features

# Allow new user registration
ENABLE_REGISTRATION=true

# Enable billing features (Stripe integration)
ENABLE_BILLING=true

# Put site in maintenance mode (blocks all requests)
MAINTENANCE_MODE=false

# Enable the trigger engine for state change notifications
# The trigger engine processes state triggers and executes registered webhooks
# Default: true (enabled)
TRIGGER_ENGINE_ENABLED=true

## =============================================================================
## State Trigger Configuration
## =============================================================================
# Settings for state change triggers (requires TRIGGER_ENGINE_ENABLED=true)

# URL of the function execution service to call when triggers fire
# This is the runtime endpoint that handles trigger webhook calls
FUNCTION_EXECUTION_URL=http://localhost:8080

# API key for authenticating with the function execution service
FUNCTION_API_KEY=  # CHANGE THIS: Set a secure API key

## =============================================================================
## End of Configuration
## =============================================================================
# Remember to:
# 1. Copy this file: cp .env.production.example .env.production
# 2. Fill in all values marked with # CHANGE THIS:
# 3. Generate strong random secrets
# 4. Test your configuration before production deployment
# 5. Store .env.production securely (never in git!)
# =============================================================================
