# FunctionFly Production Environment Configuration
# Copy this file to .env.production and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=functionfly
DB_USER=functionfly
DB_PASSWORD=your_secure_password_here_min_32_chars
DB_SSL_MODE=require

# Database Pool Settings
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# Redis Pool Settings
REDIS_MAX_CONNECTIONS=50
REDIS_MAX_IDLE_CONNECTIONS=10

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# API Security
API_SHARED_SECRET=your_api_shared_secret_minimum_32_chars
API_RATE_LIMIT=100
API_RATE_LIMIT_BURST=200

# Stripe (required for State Fabric add-on purchases + entitlement sync)
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_SF_ADDON_HOT_CACHE=price_hot_cache
STRIPE_PRICE_SF_ADDON_SECURITY=price_security_pack
STRIPE_PRICE_SF_ADDON_AI_MEMORY=price_ai_memory
STRIPE_PRICE_SF_ADDON_INSIGHTS=price_advanced_insights

# CORS Configuration (comma-separated; include every browser origin that calls the API)
# Must include https://admin.functionfly.com when the admin SPA is on that host.
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=info
APP_PORT=8080

# Base URL
BASE_URL=https://yourdomain.com
API_URL=https://yourdomain.com/api

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=FunctionFly

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
GRAFANA_SECRET_KEY=your_grafana_secret_key

# Loki
LOKI_URL=http://loki:3100

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Local Storage
STORAGE_TYPE=local
STORAGE_PATH=/data/storage

# S3 Compatible Storage (optional)
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=functionfly-storage
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
# S3_REGION=us-east-1

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL Certificate (for Caddy)
SSL_EMAIL=your_email@example.com
SSL_DOMAIN=yourdomain.com

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# =============================================================================
# FLYWHEEL SOCIAL NETWORK
# =============================================================================

# Flywheel Settings
FLYWHEEL_ENABLED=true
FLYWHEEL_MAX_THREADS_PER_USER=100
FLYWHEEL_MAX_REPLIES_PER_THREAD=1000
FLYWHEEL_REPUTATION_ENABLED=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Worker Settings
WORKER_COUNT=4
WORKER_MAX_REQUESTS=10000
WORKER_MAX_REQUESTS_JITTER=1000

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Settings
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=/var/log/functionfly/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=7
