# FunctionFly Production Environment Configuration
# Copy this file to .env.production and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=functionfly
DB_USER=functionfly
DB_PASSWORD=your_secure_password_here_min_32_chars
DB_SSL_MODE=require

# Database Pool Settings
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection (standard Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# Redis Pool Settings
REDIS_MAX_CONNECTIONS=50
REDIS_MAX_IDLE_CONNECTIONS=10

# Upstash Redis (recommended for serverless environments)
# Get these from https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# API Security
API_SHARED_SECRET=your_api_shared_secret_minimum_32_chars
API_RATE_LIMIT=100
API_RATE_LIMIT_BURST=200

# Stripe (required for State Fabric add-on purchases + entitlement sync)
# Get these from your Stripe Dashboard → Products → Price IDs (format: price_...)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SF_ADDON_HOT_CACHE=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SF_ADDON_SECURITY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SF_ADDON_AI_MEMORY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_SF_ADDON_INSIGHTS=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exchange Rates (multi-currency - rates stored in currency_exchange_rates table)
# Frankfurter (ECB) is used by default for live rates (no API key needed)
# Set STRIPE_SECRET_KEY above to use Stripe live rates instead (+1% markup)
# EXCHANGE_RATE_SYNC_ENABLED=true
# EXCHANGE_RATE_SYNC_CRON=0 0 * * *
# EXCHANGE_RATE_CACHE_TTL=15m

# CORS Configuration (comma-separated; include every browser origin that calls the API)
# Must include https://admin.yourdomain.com when the admin SPA is on that host,
# and https://auth.yourdomain.com when the auth service is on that host.
CORS_ALLOWED_ORIGINS=https://functionfly.com,https://www.functionfly.com,https://app.functionfly.com,https://auth.functionfly.com,https://admin.functionfly.com,https://status.functionfly.com

# OAuth Providers (Google + GitHub — set values in Vercel env vars for auth.functionfly.com)
# Google: https://console.cloud.google.com/apis/credentials/oauthclient
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub: https://github.com/settings/developers (OAuth Apps)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Settings
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info
APP_PORT=8080

# Base URL
BASE_URL=https://yourdomain.com
API_URL=https://yourdomain.com/api

# =============================================================================
# EMAIL CONFIGURATION (Resend preferred)
# =============================================================================
RESEND_API_KEY=re_your_api_key
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret
# RESEND_REPLY_TO=support@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=FunctionFly

# Email retry configuration (for transient failures like rate limits)
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_WAIT_SECONDS=2

# Optional SMTP fallback (e.g. Mailpit in Docker)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# =============================================================================
# EMAIL BRANDING CONFIGURATION
# =============================================================================
# Customize email templates for your brand (optional - defaults to FunctionFly)
# EMAIL_COMPANY_NAME=YourCompany
# EMAIL_COMPANY_DOMAIN=yourdomain.com
# EMAIL_DASHBOARD_URL=https://dashboard.yourdomain.com
# EMAIL_STATUS_PAGE_URL=https://status.yourdomain.com
# EMAIL_SUPPORT_URL=https://yourdomain.com/support
# EMAIL_PRIVACY_URL=https://yourdomain.com/privacy
# EMAIL_TERMS_URL=https://yourdomain.com/terms

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
GRAFANA_SECRET_KEY=your_grafana_secret_key

# Loki
LOKI_URL=http://loki:3100

# Datadog Remote Write (optional - for Prometheus metrics forwarding)
# DATADOG_API_KEY=your_datadog_api_key
# DATADOG_SITE=datadoghq.com  # Use datadoghq.eu for EU region

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Local Storage
STORAGE_TYPE=local
STORAGE_PATH=/data/storage

# S3 Compatible Storage (optional)
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=functionfly-storage
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
# S3_REGION=us-east-1

# =============================================================================
# R2 ARTIFACT STORAGE (Production Redundancy)
# =============================================================================
# R2 Account ID (from Cloudflare dashboard)
# R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 Artifact Storage Buckets (primary + up to 3 replicas for cross-region redundancy)
# R2_ARTIFACT_BUCKET_PRIMARY=functionfly-artifacts
# R2_ARTIFACT_BUCKET_REPLICA_1=functionfly-artifacts-us-west
# R2_ARTIFACT_REGION_REPLICA_1=us-west-1
# R2_ARTIFACT_BUCKET_REPLICA_2=functionfly-artifacts-eu
# R2_ARTIFACT_REGION_REPLICA_2=eu-central-1

# Sync Replication: set to "true" for synchronous replication (blocks until all replicas confirm)
# Recommended for critical production deployments
# R2_ARTIFACT_SYNC_REPLICATION=false

# Versioning: set to "true" to enable R2 object versioning for rollback support
# R2_ARTIFACT_VERSIONING_ENABLED=true

# Auto-archive to R2 (when using RedisArtifactStore as primary)
# R2_AUTO_ARCHIVE_ENABLED=true
# R2_ARCHIVE_SYNC=false

# =============================================================================
# REDIS CLUSTER (Horizontal Scaling)
# =============================================================================
# Set to "true" to enable Redis Cluster mode for horizontal scaling
# REDIS_CLUSTER_ENABLED=true
# Comma-separated list of cluster nodes (format: host1:port,host2:port,host3:port)
# REDIS_CLUSTER_NODES=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379
# Optional: cluster password if authentication is enabled
# REDIS_CLUSTER_PASSWORD=your_cluster_password

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL Certificate (for Caddy)
SSL_EMAIL=your_email@example.com
SSL_DOMAIN=yourdomain.com

# CSP Configuration (for Caddy)
# Additional API origins for Content-Security-Policy connect-src (space-separated)
# CSP_API_ORIGINS=https://api.yourdomain.com https://api.staging.yourdomain.com

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Worker Settings
WORKER_COUNT=4
WORKER_MAX_REQUESTS=10000
WORKER_MAX_REQUESTS_JITTER=1000

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Settings
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=/var/log/functionfly/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=7

# FRG (Function Runtime Graph) Security
# Secret for webhook signature verification (HMAC-SHA256)
# Generate with: openssl rand -hex 32
FRG_WEBHOOK_SECRET=

# =============================================================================
# SECRET VERSION RETENTION
# =============================================================================
# Cleanup old secret versions to prevent unbounded DB growth
SECRET_VERSION_RETENTION_DAYS=90           # How long to keep old versions (default: 90 days, 0 to disable)
SECRET_VERSION_KEEP_LATEST=5              # Minimum versions to keep per secret (default: 5)
SECRET_VERSION_CLEANUP_INTERVAL=24h      # How often to run cleanup (default: 24h)
SECRET_VERSION_CLEANUP_BATCH_SIZE=1000    # DB batch size for deletions (default: 1000)
# SECRET_VERSION_CLEANUP_VERBOSE=true     # Enable verbose debug logging
# SECRET_VERSION_CLEANUP_DRY_RUN=true      # Log only, don't actually delete (for testing)

# =============================================================================
# DEVELOPMENT & PRODUCTION MODE
# =============================================================================
# IMPORTANT: Set to 'false' in production to enable all security middleware
DEVELOPMENT=false

# =============================================================================
# MIGRATION & VERIFICATION
# =============================================================================
# Skip migration validation (set to false in production)
SKIP_MIGRATION_VALIDATION=false

# Enable trust verification (ClamAV/YARA malware scanning)
VERIFICATION_ENABLED=true

# =============================================================================
# AGENT WALLET ALERTS
# =============================================================================
# Low balance alert threshold in USD (default: 5.00)
AGENT_WALLET_LOW_BALANCE_USD=5.00

# =============================================================================
# DATA RETENTION POLICY (Billing/Compliance)
# =============================================================================
DATA_RETENTION_ENABLED=true
DATA_RETENTION_CRON=0 3 * * *  # Daily at 3 AM
DATA_RETENTION_DETAILED_DAYS=90   # Keep execution logs for 90 days
DATA_RETENTION_FINANCIAL_YEARS=7  # Keep financial data for 7 years (SOX compliance)
DATA_RETENTION_DRY_RUN=false
DATA_RETENTION_SKIP_IF_LEGAL_HOLD=true

# =============================================================================
# DATABASE ENCRYPTION
# =============================================================================
DB_ENCRYPTION_ENABLED=true
# Generate a secure master key with: openssl rand -hex 32
DB_MASTER_KEY_PASSWORD=your_db_master_key_password_min_32_chars

# =============================================================================
# TRUST LEVEL CONFIGURATION
# =============================================================================
MINIMUM_TRUST_LEVEL=standard
TRUST_LEVEL_STANDARD_ENABLED=true
TRUST_LEVEL_HIGH_ENABLED=true
TRUST_LEVEL_ENTERPRISE_ENABLED=true
TRUST_LEVEL_STANDARD_REQUIRE_MALWARE_SCAN=true
TRUST_LEVEL_HIGH_REQUIRE_SIGNATURE_VERIFICATION=true
TRUST_LEVEL_HIGH_REQUIRE_APPROVAL=true
TRUST_LEVEL_ENTERPRISE_REQUIRE_MANUAL_APPROVAL=true

# =============================================================================
# ARCHIVE CONFIGURATION
# =============================================================================
ARCHIVE_ENABLED=true
ARCHIVE_RETENTION_DAYS=2555  # ~7 years for compliance
ARCHIVE_CLEANUP_INTERVAL_HOURS=168  # Weekly cleanup

# =============================================================================
# EDGE HEALTH MONITORING
# =============================================================================
# Probe https://edge.functionfly.com/healthz every 5s; stats at GET /api/v1/status/edge
EDGE_HEALTH_URL=https://edge.functionfly.com
EDGE_HEALTH_SECRET=your_edge_health_secret

# =============================================================================
# ADVANCED SECURITY MIDDLEWARE
# =============================================================================
PRODUCTION_ENV=true               # Set to 'true' in production to enable security middleware
STRICT_IP_VALIDATION=true         # Set to 'false' to allow proxy rotation for admin sessions

# Password Hashing (Argon2id) - OWASP minimum for sensitive applications
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KB=65536

# Account Security
MAX_LOGIN_ATTEMPTS=5              # Failed attempts before account lockout
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Advanced Rate Limiting
ADVANCED_SECURITY_SLIDING_WINDOW_LIMIT=100
ADVANCED_SECURITY_SLIDING_WINDOW_MINUTES=1
ADVANCED_SECURITY_TOKEN_BUCKET_RATE=10.0
ADVANCED_SECURITY_TOKEN_BUCKET_BURST=20
ADVANCED_SECURITY_ENABLE_BOT_DETECTION=true
ADVANCED_SECURITY_ENABLE_TRAFFIC_ANALYSIS=true
ADVANCED_SECURITY_SUSPICIOUS_THRESHOLD=10
ADVANCED_SECURITY_BLOCK_MINUTES=15
ADVANCED_SECURITY_CIRCUIT_BREAKER_THRESHOLD=0.5
ADVANCED_SECURITY_CIRCUIT_BREAKER_MINUTES=1
ADVANCED_SECURITY_QUEUE_SIZE=1000
ADVANCED_SECURITY_QUEUE_SECONDS=30
ADVANCED_SECURITY_BLOCKED_COUNTRIES=
ADVANCED_SECURITY_BLOCKED_IPS=
ADVANCED_SECURITY_ALLOWED_IPS=
ADVANCED_SECURITY_ENABLE_SQL_INJECTION_FILTER=true
ADVANCED_SECURITY_ENABLE_XSS_FILTER=true
ADVANCED_SECURITY_ENABLE_PATH_TRAVERSAL_FILTER=true
ADVANCED_SECURITY_METRICS_ENABLED=true

# =============================================================================
# STATE FABRIC CONFIGURATION
# =============================================================================
# HTTP client timeout for pipeline execution
# STATEFABRIC_HTTP_TIMEOUT=30s

# Maximum store size
# STATEFABRIC_MAX_STORE_SIZE=500GB

# Cleanup worker settings
# STATEFABRIC_CLEANUP_INTERVAL=1h
# STATEFABRIC_CLEANUP_BATCH_SIZE=1000

# Circuit breaker for pipeline execution
# STATEFABRIC_CB_FAILURE_THRESHOLD=5
# STATEFABRIC_CB_COOLDOWN=30s

# Platform settings defaults
# STATEFABRIC_MAX_FABRICS_PER_TENANT=10
# STATEFABRIC_SNAPSHOT_RETENTION_DAYS=30
# STATEFABRIC_ALLOW_PUBLIC_PIPELINES=false
# STATEFABRIC_MAINTENANCE_MODE=false

# =============================================================================
# STATE FABRIC R2 STORAGE
# =============================================================================
# R2 buckets for State Fabric large data storage (>100KB snapshots, event logs, memory blobs)
# Single bucket with prefixes (recommended):
# R2_STATEFABRIC_BUCKET=functionfly-statefabric
# Or separate buckets:
# R2_STATEFABRIC_EVENTS_BUCKET=functionfly-events      # Archived event logs
# R2_STATEFABRIC_SNAPSHOTS_BUCKET=functionfly-snapshots  # Snapshot data
# R2_STATEFABRIC_MEMORY_BUCKET=functionfly-memory      # Memory blobs
# R2_STATEFABRIC_REPLAY_BUCKET=functionfly-replays     # Replay sessions
R2_STATEFABRIC_BUCKET=functionfly-statefabric
R2_STATEFABRIC_REGION=auto
R2_STATEFABRIC_COMPRESSION=true

# =============================================================================
# CDN CONFIGURATION
# =============================================================================
# Cache static assets (SDK, docs, static) - see docs/CDN_SETUP.md
# CACHE_CDN_ENABLED=true
# CACHE_CDN_PROVIDER=cloudflare
# CACHE_CDN_BASE_URL=https://cdn.functionfly.com
# CACHE_CDN_MAX_AGE=86400

# =============================================================================
# FUNCTION VERIFICATION SERVICES
# =============================================================================
# ClamAV/YARA for malware scanning
CLAMAV_URL=http://localhost:3310
YARA_URL=http://localhost:8082
VERIFICATION_TIMEOUT_SECONDS=30
VERIFICATION_MAX_FILE_SIZE_MB=10
VERIFICATION_CACHE_TTL_MINUTES=60

# =============================================================================
# SEARCH PROVIDER (Agent Search)
# =============================================================================
# Search provider: "mock" for development, "serpapi" for production
SEARCH_PROVIDER=serpapi
# SERPAPI_KEY=your_serpapi_key
# SERPAPI_URL=https://serpapi.com
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_TTL_HOURS=24
# SEARCH_CACHE_MAX_ENTRIES=10000
# SEARCH_RATE_LIMIT_PER_MINUTE=60
# SEARCH_LOG_EXECUTIONS=true
