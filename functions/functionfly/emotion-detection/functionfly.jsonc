{
  "author": "functionfly",
  "name": "emotion-detection",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Emotion Detection",
  "description": "Detect emotions in text (joy, sadness, anger, fear, surprise, disgust, trust, anticipation) using lexicon-based analysis.",
  "category": "ai-ml",
  "tags": ["emotion", "nlp", "sentiment", "affect", "ai"],
  "input": {
    "type": "object",
    "properties": { "text": { "type": "string" } },
    "required": ["text"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "emotions": {},
      "dominant": {},
      "error": {},
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 500,
  "memory_mb": 64,
  "example": {
    "input": { "text": "I am so excited and happy about this wonderful news!" },
    "output": { "ok": true, "dominant": "joy" },
  },
}
