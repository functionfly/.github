{
  "author": "functionfly",
  "name": "env-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse .env File",
  "description": "Parse a .env file string into a key-value object, handling comments and quoted values.",
  "category": "devops",
  "tags": ["env", "dotenv", "parse", "configuration", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "content": { "type": "string", "description": ".env file content" },
      "expand": { "type": "boolean", "default": false, "description": "Expand variable references" }
    },
    "required": ["content"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": { "type": "object" }, "count": { "type": "integer" }, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 1000, "memory_mb": 64,
  "example": {
    "input": { "content": "# Database\nDB_HOST=localhost\nDB_PORT=5432\nDB_NAME=\"mydb\"\n" },
    "output": { "ok": true, "result": { "DB_HOST": "localhost", "DB_PORT": "5432", "DB_NAME": "mydb" }, "count": 3 }
  }
}
