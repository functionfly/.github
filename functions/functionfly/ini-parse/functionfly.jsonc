{
  "author": "functionfly",
  "name": "ini-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse INI",
  "description": "Parse an INI/CFG configuration string into a structured object using Python's configparser.",
  "category": "format",
  "tags": ["ini", "cfg", "parse", "config"],
  "input": { "type": "object", "properties": { "data": { "type": "string" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 500, "memory_mb": 64,
  "example": { "input": { "data": "[database]\nhost=localhost\nport=5432" }, "output": { "ok": true } }
}
