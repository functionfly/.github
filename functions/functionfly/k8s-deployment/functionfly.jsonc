{
  "author": "functionfly",
  "name": "k8s-deployment",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Generate K8s Deployment",
  "description": "Generate a Kubernetes Deployment manifest with container spec, replicas, and resource limits.",
  "category": "devops",
  "tags": ["kubernetes", "deployment", "k8s", "infrastructure", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "image": { "type": "string" },
      "replicas": { "type": "integer", "default": 1 },
      "namespace": { "type": "string", "default": "default" },
      "ports": { "type": "array", "items": { "type": "integer" } },
      "env": { "type": "object" },
      "resources": { "type": "object" },
      "labels": { "type": "object" }
    },
    "required": ["name", "image"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": { "type": "string" }, "yaml": { "type": "string" }, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 2000, "memory_mb": 64,
  "example": {
    "input": { "name": "web-app", "image": "nginx:latest", "replicas": 2, "ports": [80] },
    "output": { "ok": true, "yaml": "apiVersion: apps/v1\nkind: Deployment\n..." }
  }
}
