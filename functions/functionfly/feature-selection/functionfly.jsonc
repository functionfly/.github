{
  "author": "functionfly",
  "name": "feature-selection",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Feature Selection",
  "description": "Select the most important features from a dataset.",
  "category": "ai-ml",
  "tags": [
    "feature-selection",
    "ml",
    "data",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "data": {
        "type": "array"
      },
      "labels": {
        "type": "array"
      },
      "method": {
        "type": "string",
        "default": "variance"
      },
      "k": {
        "type": "integer",
        "default": 5
      }
    },
    "required": [
      "data"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "data": [
        [
          1,
          2,
          3
        ],
        [
          4,
          5,
          6
        ],
        [
          7,
          8,
          9
        ]
      ],
      "k": 2
    },
    "output": {
      "ok": true
    }
  }
}