{
  "author": "functionfly",
  "name": "palette-generator",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Color Palette Generator",
  "description": "Generate a harmonious color palette from a base color using classic color theory schemes.",
  "category": "color",
  "tags": ["color", "palette", "harmony", "design", "scheme"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string", "description": "Base hex color" },
      "scheme": { "type": "string", "description": "Harmony scheme", "default": "complementary", "enum": ["complementary", "analogous", "triadic", "tetradic", "split-complementary", "monochromatic"] }
    },
    "required": ["color"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": { "type": "array", "items": { "type": "string" } }, "scheme": {}, "base": {}, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 86400, "timeout_ms": 100, "memory_mb": 64,
  "example": {
    "input": { "color": "#ff5733", "scheme": "triadic" },
    "output": { "ok": true, "result": ["#FF5733", "#33FF57", "#5733FF"] }
  }
}
