{
  "author": "functionfly",
  "name": "image-hue-rotate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Rotate Image Hue",
  "description": "Rotate the hue of all pixels in an image by a given number of degrees (0-360).",
  "category": "color",
  "tags": ["image", "hue", "rotate", "color", "filter"],
  "input": {
    "type": "object",
    "properties": {
      "image": { "type": "string" },
      "degrees": { "type": "number", "default": 90 },
      "format": { "type": "string", "default": "PNG" }
    },
    "required": ["image"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "format": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 0, "timeout_ms": 10000, "memory_mb": 256,
  "example": { "input": { "image": "...", "degrees": 180 }, "output": { "ok": true } }
}
