{"author":"functionfly","name":"slug-generate","version":"1.0.0","runtime":"python3.11","title":"Slug Generate","description":"Generate URL-friendly slugs from text. Lowercase, hyphens, no special characters.","category":"Utility","tags":["slug","url","generate","text","seo"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to convert to slug"},"separator":{"type":"string","description":"Character between words","default":"-"},"max_length":{"type":"integer","description":"Maximum slug length (0 = no limit)","default":0}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"slug":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"Hello World!"},"output":{"ok":true,"slug":"hello-world"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
