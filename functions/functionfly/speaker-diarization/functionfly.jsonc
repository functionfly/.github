{
  "author": "functionfly",
  "name": "speaker-diarization",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Speaker Diarization",
  "description": "Identify and separate different speakers in audio (mock implementation).",
  "category": "ai-ml",
  "tags": [
    "speaker-diarization",
    "audio",
    "speech",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "audio_url": {
        "type": "string"
      },
      "audio_base64": {
        "type": "string"
      },
      "num_speakers": {
        "type": "integer"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 3000,
  "memory_mb": 256,
  "example": {
    "input": {
      "audio_url": "https://example.com/meeting.mp3"
    },
    "output": {
      "ok": true
    }
  }
}