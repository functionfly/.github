{
  "author": "functionfly",
  "name": "image-contrast-adjust",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Adjust Image Contrast",
  "description": "Adjust image contrast by a factor (1.0=original, 0=grey, 2.0=twice the contrast).",
  "category": "color",
  "tags": ["image", "contrast", "adjust", "pillow"],
  "input": {
    "type": "object",
    "properties": {
      "image": { "type": "string" },
      "factor": { "type": "number", "default": 1.5 },
      "format": { "type": "string", "default": "JPEG" }
    },
    "required": ["image"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "format": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 0, "timeout_ms": 5000, "memory_mb": 256,
  "example": { "input": { "image": "...", "factor": 2.0 }, "output": { "ok": true } }
}
