{
  "author": "functionfly",
  "name": "encrypt-private-key",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Encrypt Private Key",
  "description": "Encrypt an unprotected PEM private key with a passphrase using PKCS8 encryption.",
  "category": "crypto",
  "tags": ["crypto", "private-key", "pem", "encrypt", "passphrase"],
  "input": {
    "type": "object",
    "properties": {
      "private_key": { "type": "string", "description": "Unencrypted PEM private key" },
      "passphrase": { "type": "string", "description": "Passphrase to encrypt with" }
    },
    "required": ["private_key", "passphrase"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string", "description": "Passphrase-protected PEM key" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 0,
  "timeout_ms": 2000,
  "memory_mb": 128,
  "example": {
    "input": { "private_key": "-----BEGIN PRIVATE KEY-----\n...", "passphrase": "mysecretpass" },
    "output": { "ok": true }
  }
}
