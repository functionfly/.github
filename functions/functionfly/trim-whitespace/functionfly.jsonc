{"author":"functionfly","name":"trim-whitespace","version":"1.0.0","runtime":"python3.12","title":"Trim Whitespace","description":"Remove leading and trailing whitespace from a string. Optionally collapse internal whitespace.","category":"text-processing","tags":["trim","whitespace","string","text","strip"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to trim"},"collapse":{"type":"boolean","description":"Collapse internal runs of whitespace to single space","default":false}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"trimmed":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"  hello   world  "},"output":{"ok":true,"trimmed":"hello   world"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
