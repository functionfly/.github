{
  "author": "functionfly",
  "name": "cbor-decode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "CBOR Decode",
  "description": "Decode Base64-encoded CBOR binary data to a structured object. Requires cbor2.",
  "category": "format",
  "tags": ["cbor", "decode", "deserialize", "binary"],
  "input": { "type": "object", "properties": { "data": { "type": "string" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 500, "memory_mb": 64,
  "example": { "input": { "data": "..." }, "output": { "ok": true } }
}
