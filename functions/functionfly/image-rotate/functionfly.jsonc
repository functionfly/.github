{
  "author": "functionfly",
  "name": "image-rotate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Image Rotate",
  "description": "Rotate image by degrees. Requires Pillow.",
  "category": "media",
  "tags": [
    "image",
    "rotate",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string"
      },
      "degrees": {
        "type": "number"
      },
      "expand": {
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "image",
      "degrees"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "image_base64": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 10000,
  "memory_mb": 256,
  "example": {
    "input": {
      "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
      "degrees": 90
    },
    "output": {
      "ok": true
    }
  }
}
