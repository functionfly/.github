{"author":"functionfly","name":"string-similarity","version":"1.0.0","runtime":"python3.12","title":"String Similarity","description":"Calculate similarity score between two strings (0–1). Uses Levenshtein-based ratio.","category":"text-processing","tags":["similarity","string","compare","levenshtein"],"input":{"type":"object","properties":{"a":{"type":"string","description":"First string"},"b":{"type":"string","description":"Second string"}},"required":["a","b"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"similarity":{"type":"number"},"error":{"type":"string"}}},"example":{"input":{"a":"hello","b":"hallo"},"output":{"ok":true,"similarity":0.8}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
