{
  "author": "functionfly",
  "name": "verify-signature",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Verify Digital Signature",
  "description": "Verify a digital signature against a message using a public key. Auto-detects RSA (PKCS1/PSS) and ECDSA.",
  "category": "crypto",
  "tags": ["crypto", "signature", "verify", "rsa", "ecdsa", "asymmetric"],
  "input": {
    "type": "object",
    "properties": {
      "message": { "description": "Original message" },
      "signature": { "type": "string", "description": "Base64-encoded signature" },
      "public_key": { "type": "string", "description": "PEM-encoded public key" },
      "algorithm": { "type": "string", "description": "Hash algorithm", "default": "sha256", "enum": ["sha1", "sha256", "sha384", "sha512"] },
      "scheme": { "type": "string", "description": "Signature scheme: 'auto', 'rsa_pkcs1', 'rsa_pss', 'ecdsa'", "default": "auto" }
    },
    "required": ["message", "signature", "public_key"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "boolean" },
      "scheme": { "type": "string" },
      "key_type": { "type": "string" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": { "message": "Hello", "signature": "...", "public_key": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----" },
    "output": { "ok": true, "result": true }
  }
}
