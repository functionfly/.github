{
  "author": "functionfly",
  "name": "http-head",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HTTP HEAD",
  "description": "Perform an HTTP HEAD request to get headers without body.",
  "category": "http",
  "tags": ["http", "head", "request", "api", "web", "headers"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "URL to request" },
      "headers": { "type": "object", "description": "HTTP headers to send", "default": {} },
      "params": { "type": "object", "description": "Query parameters to append to URL" },
      "timeout": { "type": "integer", "description": "Request timeout in seconds", "default": 30, "minimum": 1 },
      "follow_redirects": { "type": "boolean", "description": "Whether to follow redirects", "default": true }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "status_code": { "type": "integer" },
      "headers": { "type": "object" },
      "content_type": { "type": "string" },
      "content_length": { "description": "Content-Length header value" },
      "last_modified": { "type": "string", "description": "Last-Modified header" },
      "etag": { "type": "string", "description": "ETag header" },
      "url": { "type": "string", "description": "Final URL after redirects" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": true,
  "cache_ttl": 300,
  "timeout_ms": 35000,
  "memory_mb": 128,
  "example": {
    "input": {
      "url": "https://httpbin.org/json",
      "headers": { "Accept": "application/json" }
    },
    "output": {
      "ok": true,
      "status_code": 200,
      "headers": {
        "content-type": "application/json",
        "content-length": "429",
        "last-modified": "Wed, 01 Jan 2025 12:00:00 GMT"
      },
      "content_type": "application/json",
      "content_length": "429",
      "etag": "\"abc123\"",
      "url": "https://httpbin.org/json"
    }
  }
}