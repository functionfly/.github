{
  "author": "functionfly",
  "name": "ecc-sign",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "ECDSA Sign",
  "description": "Sign a message with an ECC private key using ECDSA.",
  "category": "crypto",
  "tags": ["crypto", "ecc", "ecdsa", "sign", "asymmetric"],
  "input": {
    "type": "object",
    "properties": {
      "message": { "description": "Message to sign" },
      "private_key": { "type": "string", "description": "PEM-encoded ECC private key" },
      "algorithm": { "type": "string", "description": "Hash algorithm", "default": "sha256", "enum": ["sha256", "sha384", "sha512"] }
    },
    "required": ["message", "private_key"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string", "description": "Base64-encoded DER signature" },
      "algorithm": { "type": "string" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 0,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": { "message": "Hello", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----" },
    "output": { "ok": true }
  }
}
