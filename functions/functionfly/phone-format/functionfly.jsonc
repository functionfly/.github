{"author":"functionfly","name":"phone-format","version":"1.0.0","runtime":"python3.11","title":"Phone Format","description":"Format phone numbers to E.164 standard. Strips non-digits and returns digits with optional leading +.","category":"Utility","tags":["phone","e164","format","number"],"input":{"type":"object","properties":{"phone":{"type":"string","description":"Phone number to format"},"e164":{"type":"boolean","description":"Prepend + for E.164","default":true}},"required":["phone"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"formatted":{"type":"string"},"digits":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"phone":"(555) 123-4567"},"output":{"ok":true,"formatted":"+5551234567","digits":"5551234567"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
