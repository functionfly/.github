{
  "author": "functionfly",
  "name": "http-get",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HTTP GET",
  "description": "Perform an HTTP GET request to a URL.",
  "category": "http",
  "tags": ["http", "get", "request", "api", "web"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "URL to request" },
      "headers": { "type": "object", "description": "HTTP headers to send", "default": {} },
      "params": { "type": "object", "description": "Query parameters to append to URL" },
      "timeout": { "type": "integer", "description": "Request timeout in seconds", "default": 30, "minimum": 1 },
      "follow_redirects": { "type": "boolean", "description": "Whether to follow redirects", "default": true }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "status_code": { "type": "integer" },
      "headers": { "type": "object" },
      "content_type": { "type": "string" },
      "content_length": { "type": "integer" },
      "result": { "description": "Response content (parsed if JSON, string otherwise)" },
      "url": { "type": "string", "description": "Final URL after redirects" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 35000,
  "memory_mb": 128,
  "example": {
    "input": {
      "url": "https://httpbin.org/get",
      "headers": { "Accept": "application/json" },
      "params": { "test": "value" }
    },
    "output": {
      "ok": true,
      "status_code": 200,
      "headers": { "content-type": "application/json" },
      "content_type": "application/json",
      "content_length": 123,
      "result": { "test": "value" },
      "url": "https://httpbin.org/get?test=value"
    }
  }
}