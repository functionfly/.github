{
  "author": "functionfly",
  "name": "image-color-quantize",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Image Color Quantization",
  "description": "Reduce an image to N colors using median-cut quantization, also returning the resulting palette.",
  "category": "color",
  "tags": ["image", "quantize", "palette", "reduce", "color"],
  "input": {
    "type": "object",
    "properties": {
      "image": { "type": "string" },
      "colors": { "type": "integer", "description": "Target number of colors (2-256)", "default": 8 },
      "format": { "type": "string", "default": "PNG" }
    },
    "required": ["image"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "palette": { "type": "array" }, "format": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 0, "timeout_ms": 5000, "memory_mb": 256,
  "example": { "input": { "image": "...", "colors": 4 }, "output": { "ok": true } }
}
