{
  "author": "functionfly",
  "name": "reverse-geocode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Reverse Geocode",
  "description": "Convert latitude/longitude coordinates to a street address. Returns mock data based on nearest known city.",
  "category": "geospatial",
  "tags": [
    "reverse-geocode",
    "coordinates",
    "address",
    "latitude",
    "longitude",
    "location",
  ],
  "input": {
    "type": "object",
    "properties": {
      "lat": { "type": "number", "description": "Latitude (-90 to 90)" },
      "lng": { "type": "number", "description": "Longitude (-180 to 180)" },
    },
    "required": ["lat", "lng"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "lat": { "type": "number", "description": "Input latitude" },
          "lng": { "type": "number", "description": "Input longitude" },
          "formatted_address": {
            "type": "string",
            "description": "Formatted address",
          },
          "city": { "type": "string", "description": "City name" },
          "country": { "type": "string", "description": "Country name" },
          "country_code": {
            "type": "string",
            "description": "ISO country code",
          },
          "confidence": {
            "type": "number",
            "description": "Confidence score 0-1",
          },
        },
      },
      "error": { "type": "string" },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 3000,
  "memory_mb": 128,
  "example": {
    "input": {
      "lat": 40.7128,
      "lng": -74.006,
    },
    "output": {
      "ok": true,
      "result": {
        "lat": 40.7128,
        "lng": -74.006,
        "formatted_address": "New York, NY, USA",
        "city": "New York",
        "country": "United States",
        "country_code": "US",
        "confidence": 0.92,
      },
    },
  },
}
