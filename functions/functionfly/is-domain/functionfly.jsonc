{
  "author": "functionfly",
  "name": "is-domain",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Is Domain",
  "description": "Validate whether a string is a valid domain name (FQDN).",
  "category": "validation",
  "tags": ["validation", "domain", "fqdn", "dns", "check"],
  "input": {
    "type": "object",
    "properties": {
      "value": { "type": "string", "description": "Domain name to validate" }
    },
    "required": ["value"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": { "type": "string" },
      "result": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": "example.com" },
    "output": { "ok": true, "value": "example.com", "result": true }
  }
}
