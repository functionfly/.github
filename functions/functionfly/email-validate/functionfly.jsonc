{"author":"functionfly","name":"email-validate","version":"1.0.0","runtime":"python3.11","title":"Email Validate","description":"Validate email format and check basic deliverability hints. Returns format validity and parsed local/domain.","category":"Email","tags":["email","validate","format","deliverability"],"input":{"type":"object","properties":{"email":{"type":"string","description":"Email address to validate"}},"required":["email"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"valid":{"type":"boolean"},"format_valid":{"type":"boolean"},"email":{"type":"string"},"local":{"type":"string"},"domain":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"email":"user@example.com"},"output":{"ok":true,"valid":true,"format_valid":true,"email":"user@example.com","local":"user","domain":"example.com"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
