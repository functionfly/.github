{"author":"functionfly","name":"mime-type-detect","version":"1.0.0","runtime":"python3.11","title":"MIME Type Detect","description":"Detect MIME type from file extension or filename. Common types for images, documents, text, etc.","category":"File Processing","tags":["mime","content-type","file","extension"],"input":{"type":"object","properties":{"filename":{"type":"string","description":"Filename or path to get extension from"}},"required":["filename"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"mime_type":{"type":"string"},"extension":{"type":["string","null"]},"error":{"type":"string"}}},"example":{"input":{"filename":"image.png"},"output":{"ok":true,"mime_type":"image/png","extension":".png"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
