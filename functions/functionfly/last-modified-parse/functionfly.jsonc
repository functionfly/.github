{
  "author": "functionfly",
  "name": "last-modified-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse Last-Modified",
  "description": "Parse an HTTP Last-Modified header value into a structured date object.",
  "category": "http",
  "tags": ["http", "last-modified", "date", "parse", "header", "cache"],
  "input": {
    "type": "object",
    "properties": {
      "value": {
        "type": "string",
        "description": "Last-Modified header value (RFC 7231 date format)"
      }
    },
    "required": ["value"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": { "type": "string" },
      "iso": { "type": "string", "description": "ISO 8601 date-time string" },
      "timestamp": { "type": "integer", "description": "Unix timestamp" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": "Wed, 21 Oct 2015 07:28:00 GMT" },
    "output": {
      "ok": true,
      "value": "Wed, 21 Oct 2015 07:28:00 GMT",
      "iso": "2015-10-21T07:28:00Z",
      "timestamp": 1445412480
    }
  }
}
