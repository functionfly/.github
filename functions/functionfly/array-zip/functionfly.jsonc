{
  "author": "functionfly",
  "name": "array-zip",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Zip",
  "description": "Zip multiple arrays into array of tuples (stops at shortest length).",
  "category": "arrays",
  "tags": ["array", "zip", "combine", "tuple"],
  "input": {
    "type": "object",
    "properties": {
      "arrays": { "type": "array", "items": { "type": "array" }, "description": "Arrays to zip" }
    },
    "required": ["arrays"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "arrays": [[1, 2, 3], ["a", "b", "c"]] },
    "output": { "ok": true, "result": [[1, "a"], [2, "b"], [3, "c"]] }
  }
}
