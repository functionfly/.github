{
  "author": "functionfly",
  "name": "validate-credit-card",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Validate Credit Card Number",
  "description": "Validate a credit card number using the Luhn algorithm and detect the card network.",
  "category": "ecommerce",
  "tags": ["credit-card", "validate", "luhn", "payment", "ecommerce"],
  "input": {
    "type": "object",
    "properties": { "number": { "type": "string" } },
    "required": ["number"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": { "type": "boolean" }, "valid": {}, "card_type": {}, "length": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "number": "4532015112830366" }, "output": { "ok": true, "valid": true, "card_type": "visa" } }
}
