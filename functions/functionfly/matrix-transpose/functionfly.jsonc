{
  "author": "functionfly",
  "name": "matrix-transpose",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Matrix Transpose",
  "description": "Transpose a matrix (swap rows and columns).",
  "category": "arrays",
  "tags": ["matrix", "transpose", "math", "linear-algebra"],
  "input": {
    "type": "object",
    "properties": {
      "matrix": { "type": "array", "description": "Matrix to transpose (2D array)", "items": { "type": "array" } }
    },
    "required": ["matrix"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array", "items": { "type": "array" } },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "matrix": [[1, 2, 3], [4, 5, 6]] },
    "output": { "ok": true, "result": [[1, 4], [2, 5], [3, 6]] }
  }
}