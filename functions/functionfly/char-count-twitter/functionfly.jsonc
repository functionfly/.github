{
  "author": "functionfly",
  "name": "char-count-twitter",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Twitter Character Count",
  "description": "Count characters per Twitter's weighted algorithm (URLs = 23 chars, CJK = 2 chars each) and check 280-char limit.",
  "category": "social",
  "tags": ["twitter", "character-count", "social", "text", "validation"],
  "input": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] },
  "output": { "type": "object", "properties": { "ok": {}, "char_count": {}, "limit": {}, "remaining": {}, "over_limit": {}, "fits": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "text": "Hello Twitter! Check out https://example.com/some/long/url #hashtag" }, "output": { "ok": true, "char_count": 52, "remaining": 228, "fits": true } }
}
