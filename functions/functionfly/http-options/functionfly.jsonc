{
  "author": "functionfly",
  "name": "http-options",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HTTP OPTIONS",
  "description": "Perform an HTTP OPTIONS request to check supported methods.",
  "category": "http",
  "tags": ["http", "options", "request", "api", "web", "cors"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "URL to request" },
      "headers": { "type": "object", "description": "HTTP headers to send", "default": {} },
      "params": { "type": "object", "description": "Query parameters to append to URL" },
      "timeout": { "type": "integer", "description": "Request timeout in seconds", "default": 30, "minimum": 1 },
      "follow_redirects": { "type": "boolean", "description": "Whether to follow redirects", "default": true }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "status_code": { "type": "integer" },
      "headers": { "type": "object" },
      "allowed_methods": { "type": "array", "items": { "type": "string" }, "description": "HTTP methods allowed by the server" },
      "content_type": { "type": "string" },
      "content_length": { "type": "integer" },
      "result": { "description": "Response content (if any)" },
      "url": { "type": "string", "description": "Final URL after redirects" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": true,
  "cache_ttl": 300,
  "timeout_ms": 35000,
  "memory_mb": 128,
  "example": {
    "input": {
      "url": "https://httpbin.org/",
      "headers": { "Origin": "https://example.com" }
    },
    "output": {
      "ok": true,
      "status_code": 200,
      "headers": {
        "allow": "GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS",
        "access-control-allow-methods": "GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS"
      },
      "allowed_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"],
      "content_type": "",
      "content_length": 0,
      "url": "https://httpbin.org/"
    }
  }
}