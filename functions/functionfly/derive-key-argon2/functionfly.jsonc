{
  "author": "functionfly",
  "name": "derive-key-argon2",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Derive Key (Argon2)",
  "description": "Derive a raw cryptographic key from a password using Argon2id.",
  "category": "crypto",
  "tags": ["crypto", "argon2", "kdf", "key-derivation", "password", "memory-hard"],
  "input": {
    "type": "object",
    "properties": {
      "password": { "type": "string", "description": "Input password" },
      "salt": { "type": "string", "description": "Salt (hex or Base64)" },
      "time_cost": { "type": "integer", "description": "Iterations", "default": 3 },
      "memory_cost": { "type": "integer", "description": "Memory in KiB", "default": 65536 },
      "parallelism": { "type": "integer", "description": "Parallelism factor", "default": 4 },
      "length": { "type": "integer", "description": "Output key length in bytes", "default": 32 },
      "output": { "type": "string", "description": "'hex' or 'base64'", "default": "hex", "enum": ["hex", "base64"] }
    },
    "required": ["password", "salt"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "time_cost": { "type": "integer" },
      "memory_cost": { "type": "integer" },
      "length": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 10000,
  "memory_mb": 256,
  "price_per_call": 0.01,
  "example": {
    "input": { "password": "mypassword", "salt": "aabbcc..." },
    "output": { "ok": true }
  }
}
