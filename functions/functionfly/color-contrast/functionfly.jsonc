{
  "author": "functionfly",
  "name": "color-contrast",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Color Contrast Ratio",
  "description": "Calculate WCAG 2.1 contrast ratio between two colors and check AA/AAA accessibility compliance.",
  "category": "color",
  "tags": ["color", "contrast", "wcag", "accessibility", "a11y"],
  "input": {
    "type": "object",
    "properties": {
      "color1": { "type": "string", "description": "First hex color" },
      "color2": { "type": "string", "description": "Second hex color" }
    },
    "required": ["color1", "color2"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "number" },
      "ratio": { "type": "string" },
      "passes_aa": { "type": "boolean" },
      "passes_aa_large": { "type": "boolean" },
      "passes_aaa": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "color1": "#ffffff", "color2": "#000000" },
    "output": { "ok": true, "result": 21.0, "ratio": "21.0:1", "passes_aa": true, "passes_aaa": true }
  }
}
