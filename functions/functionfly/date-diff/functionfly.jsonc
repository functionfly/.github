{
  "author": "functionfly",
  "name": "date-diff",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Date Diff",
  "description": "Calculate difference between dates.",
  "category": "datetime",
  "tags": [
    "date",
    "diff",
    "delta"
  ],
  "input": {
    "type": "object",
    "properties": {
      "date_a": {
        "type": "string"
      },
      "date_b": {
        "type": "string"
      },
      "unit": {
        "type": "string",
        "default": "days"
      }
    },
    "required": [
      "date_a",
      "date_b"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "difference": {
        "type": "number"
      },
      "unit": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "date_a": "2024-01-15",
      "date_b": "2024-01-20"
    },
    "output": {
      "ok": true
    }
  }
}
