{
  "author": "functionfly",
  "name": "hash-file",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Hash File",
  "description": "Generate hash of file content (pass content as base64 or string).",
  "category": "security",
  "tags": [
    "hash",
    "checksum",
    "file",
    "security"
  ],
  "input": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string",
        "description": "File content (string or base64)"
      },
      "content_base64": {
        "type": "string"
      },
      "algorithm": {
        "type": "string",
        "default": "sha256"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "hash": {
        "type": "string"
      },
      "algorithm": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 5000,
  "memory_mb": 128,
  "example": {
    "input": {
      "content": "hello"
    },
    "output": {
      "ok": true,
      "hash": "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
      "algorithm": "sha256"
    }
  }
}
