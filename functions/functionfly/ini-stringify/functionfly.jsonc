{
  "author": "functionfly",
  "name": "ini-stringify",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Stringify to INI",
  "description": "Convert a nested object to INI/CFG format string using Python's configparser.",
  "category": "format",
  "tags": ["ini", "cfg", "stringify", "config"],
  "input": { "type": "object", "properties": { "data": { "type": "object" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": { "type": "string" }, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 500, "memory_mb": 64,
  "example": { "input": { "data": { "database": { "host": "localhost", "port": "5432" } } }, "output": { "ok": true } }
}
