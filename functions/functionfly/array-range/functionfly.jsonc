{
  "author": "functionfly",
  "name": "array-range",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Range",
  "description": "Create an array with a range of numbers.",
  "category": "arrays",
  "tags": ["array", "range", "sequence", "numbers"],
  "input": {
    "type": "object",
    "properties": {
      "start": { "type": "number", "description": "Start value", "default": 0 },
      "stop": { "type": "number", "description": "Stop value (exclusive)" },
      "step": { "type": "number", "description": "Step size", "default": 1 }
    },
    "required": ["stop"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array", "items": { "type": "number" }, "description": "Generated range array" },
      "count": { "type": "integer", "description": "Number of elements in range" },
      "start": { "type": "number", "description": "Start value used" },
      "stop": { "type": "number", "description": "Stop value used" },
      "step": { "type": "number", "description": "Step size used" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": { "start": 1, "stop": 10, "step": 2 },
    "output": {
      "ok": true,
      "result": [1, 3, 5, 7, 9],
      "count": 5,
      "start": 1,
      "stop": 10,
      "step": 2
    }
  }
}