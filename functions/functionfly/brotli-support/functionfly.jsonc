{
  "author": "functionfly",
  "name": "brotli-support",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Check Brotli Support",
  "description": "Check if a server supports Brotli content encoding.",
  "category": "devops",
  "tags": ["brotli", "compression", "http", "performance", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string" },
      "timeout": { "type": "integer", "default": 10 }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "supported": { "type": "boolean" }, "encoding": { "type": "string" }, "error": {} }
  },
  "deterministic": false, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 15000, "memory_mb": 128,
  "example": {
    "input": { "url": "https://example.com" },
    "output": { "ok": true, "supported": true, "encoding": "br" }
  }
}
