{
  "author": "functionfly",
  "name": "adler32",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Adler-32 Checksum",
  "description": "Calculate Adler-32 checksum of data. Faster than CRC32, used in zlib.",
  "category": "encoding",
  "tags": ["hash", "adler32", "checksum", "zlib"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "description": "Data to checksum" },
      "format": { "type": "string", "description": "Output format: 'decimal' or 'hex'", "default": "decimal", "enum": ["decimal", "hex"] }
    },
    "required": ["data"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {},
      "hex": { "type": "string" },
      "decimal": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 200,
  "memory_mb": 64,
  "example": {
    "input": { "data": "Hello World" },
    "output": { "ok": true, "decimal": 436929775 }
  }
}
