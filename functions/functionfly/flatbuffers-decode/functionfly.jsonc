{
  "author": "functionfly",
  "name": "flatbuffers-decode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "FlatBuffers Decode",
  "description": "Decode FlatBuffers binary data. Full support requires schema-generated code. Falls back to JSON decoding.",
  "category": "format",
  "tags": ["flatbuffers", "google", "decode", "binary"],
  "input": { "type": "object", "properties": { "data": { "type": "string" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "note": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 1000, "memory_mb": 64,
  "example": { "input": { "data": "..." }, "output": { "ok": true } }
}
