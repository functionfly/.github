{
  "author": "functionfly",
  "name": "decrypt-aes-gcm",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "AES-GCM Decrypt",
  "description": "Decrypt AES-GCM authenticated ciphertext. Verifies the authentication tag before decryption.",
  "category": "crypto",
  "tags": ["crypto", "aes", "gcm", "aead", "decrypt", "authenticated"],
  "input": {
    "type": "object",
    "properties": {
      "ciphertext": { "type": "string", "description": "Base64-encoded ciphertext+tag" },
      "key": { "type": "string", "description": "AES key (hex or Base64)" },
      "nonce": { "type": "string", "description": "Nonce (hex or Base64)" },
      "aad": { "type": "string", "description": "Additional authenticated data (must match encryption)" },
      "encoding": { "type": "string", "description": "Text encoding", "default": "utf-8" }
    },
    "required": ["ciphertext", "key", "nonce"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "is_text": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 64,
  "example": {
    "input": { "ciphertext": "...", "key": "0123456789abcdef0123456789abcdef", "nonce": "..." },
    "output": { "ok": true, "result": "Hello Secret", "is_text": true }
  }
}
