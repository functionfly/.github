{"author":"functionfly","name":"censor-words","version":"1.0.0","runtime":"python3.12","title":"Censor Words","description":"Replace profanity or blocked words with a censor character (e.g. ***).","category":"text-processing","tags":["censor","profanity","filter","text","moderate"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to censor"},"replacement":{"type":"string","description":"Replacement string (default: ***)","default":"***"},"words":{"type":"array","items":{"type":"string"},"description":"Optional custom list of words to censor (overrides default)"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"replacements_count":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"That is bad word here"},"output":{"ok":true,"result":"That is *** word here","replacements_count":1}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
