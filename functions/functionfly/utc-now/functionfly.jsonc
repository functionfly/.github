{
  "author": "functionfly",
  "name": "utc-now",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "UTC Now",
  "description": "Get current UTC datetime.",
  "category": "datetime",
  "tags": [
    "utc",
    "now"
  ],
  "input": {
    "type": "object"
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "iso": {
        "type": "string"
      },
      "timestamp": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {},
    "output": {
      "ok": true
    }
  }
}
