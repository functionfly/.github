{"author":"functionfly","name":"timezone-convert","version":"1.0.0","runtime":"python3.11","title":"Timezone Convert","description":"Convert timestamps between timezones. Uses IANA timezone names (e.g. UTC, America/New_York).","category":"Utility","tags":["timezone","convert","datetime","timestamp"],"input":{"type":"object","properties":{"timestamp":{"type":["string","number"],"description":"ISO datetime or Unix timestamp"},"from_tz":{"type":"string","description":"Source timezone","default":"UTC"},"to_tz":{"type":"string","description":"Target timezone","default":"UTC"}},"required":["timestamp"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"iso":{"type":"string"},"unix":{"type":"integer"},"timezone":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"timestamp":"2024-01-15T12:00:00Z","from_tz":"UTC","to_tz":"America/New_York"},"output":{"ok":true,"iso":"2024-01-15T07:00:00-05:00","unix":1705323600,"timezone":"America/New_York"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
