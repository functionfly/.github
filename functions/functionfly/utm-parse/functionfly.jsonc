{
  "author": "functionfly",
  "name": "utm-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse UTM Parameters",
  "description": "Parse and extract UTM campaign tracking parameters from a URL.",
  "category": "social",
  "tags": ["utm", "parse", "campaign", "tracking", "url", "analytics"],
  "input": { "type": "object", "properties": { "url": { "type": "string" } }, "required": ["url"] },
  "output": { "type": "object", "properties": { "ok": {}, "utm_params": {}, "has_utm": {}, "source": {}, "medium": {}, "campaign": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "url": "https://example.com/?utm_source=google&utm_medium=cpc&utm_campaign=brand" }, "output": { "ok": true, "has_utm": true, "source": "google", "medium": "cpc", "campaign": "brand" } }
}
