{
  "author": "functionfly",
  "name": "array-power-set",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Power Set",
  "description": "Generate the power set (all possible subsets) of an array.",
  "category": "arrays",
  "tags": ["array", "power-set", "subsets", "math", "combinatorics"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array to generate power set from" }
    },
    "required": ["items"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array", "items": { "type": "array" } },
      "count": { "type": "integer", "description": "Number of subsets generated (2^n)" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 5000,
  "memory_mb": 256,
  "example": {
    "input": { "items": [1, 2, 3] },
    "output": {
      "ok": true,
      "result": [[], [1], [2], [3], [1, 2], [1, 3], [2, 3], [1, 2, 3]],
      "count": 8
    }
  }
}
