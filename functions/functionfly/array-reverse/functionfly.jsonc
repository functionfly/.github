{
  "author": "functionfly",
  "name": "array-reverse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Reverse",
  "description": "Reverse array order.",
  "category": "arrays",
  "tags": ["array", "reverse", "order"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array to reverse" }
    },
    "required": ["items"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "items": [1, 2, 3, 4] },
    "output": { "ok": true, "result": [4, 3, 2, 1] }
  }
}
