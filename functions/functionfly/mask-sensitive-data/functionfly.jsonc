{"author":"functionfly","name":"mask-sensitive-data","version":"1.0.0","runtime":"python3.12","title":"Mask Sensitive Data","description":"Mask credit card numbers, SSN, and similar patterns in text.","category":"text-processing","tags":["mask","sensitive","pii","credit-card","ssn","security"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text that may contain sensitive data"},"mask_char":{"type":"string","description":"Character to use for masking (default: *)","default":"*"},"show_last":{"type":"integer","description":"Number of trailing digits to show (default: 4 for cards, 4 for SSN)","default":4}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"Card 4111111111111111"},"output":{"ok":true,"result":"Card ************1111"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
