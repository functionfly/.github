{
  "author": "functionfly",
  "name": "is-array",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Is Array",
  "description": "Check whether a value is an array (list).",
  "category": "validation",
  "tags": ["validation", "array", "list", "type", "check"],
  "input": {
    "type": "object",
    "properties": {
      "value": { "description": "Value to check" }
    },
    "required": ["value"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": {},
      "result": { "type": "boolean" },
      "length": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": [1, 2, 3] },
    "output": { "ok": true, "value": [1, 2, 3], "result": true, "length": 3 }
  }
}
