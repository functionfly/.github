{
  "author": "functionfly",
  "name": "is-dark-color",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Is Dark Color?",
  "description": "Check if a color is dark (below a luminance threshold). Useful for choosing text color on a background.",
  "category": "color",
  "tags": ["color", "dark", "luminance", "wcag", "accessibility"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string" },
      "threshold": { "type": "number", "description": "Luminance threshold (0-1)", "default": 0.5 }
    },
    "required": ["color"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": { "type": "boolean" }, "luminance": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 86400, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "color": "#000000" }, "output": { "ok": true, "result": true, "luminance": 0.0 } }
}
