{
  "author": "functionfly",
  "name": "credit-card-type",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Detect Credit Card Type",
  "description": "Detect the card network (Visa, Mastercard, Amex, Discover, JCB, Diners, UnionPay, Maestro) from a card number.",
  "category": "ecommerce",
  "tags": ["credit-card", "card-type", "detect", "payment", "ecommerce"],
  "input": {
    "type": "object",
    "properties": { "number": { "type": "string" } },
    "required": ["number"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "type": {}, "name": {}, "length": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "number": "4532015112830366" }, "output": { "ok": true, "type": "visa", "name": "Visa" } }
}
