{
  "author": "functionfly",
  "name": "image-resize",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Image Resize",
  "description": "Resize image to specified dimensions. Preserves aspect ratio if one dimension omitted. Requires Pillow.",
  "category": "media",
  "tags": [
    "image",
    "resize",
    "dimensions",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "description": "Image as base64 string"
      },
      "width": {
        "type": "integer",
        "description": "Target width (optional if height set)"
      },
      "height": {
        "type": "integer",
        "description": "Target height (optional if width set)"
      },
      "fit": {
        "type": "string",
        "description": "Fit mode: cover, contain, fill",
        "default": "fill"
      }
    },
    "required": [
      "image"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "image_base64": {
        "type": "string"
      },
      "width": {
        "type": "integer"
      },
      "height": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": false,
  "cache_ttl": 3600,
  "timeout_ms": 15000,
  "memory_mb": 256,
  "example": {
    "input": {
      "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
      "width": 10,
      "height": 10
    },
    "output": {
      "ok": true
    }
  }
}
