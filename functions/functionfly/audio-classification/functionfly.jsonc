{
  "author": "functionfly",
  "name": "audio-classification",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Audio Classification",
  "description": "Classify audio into categories like music, speech, noise, etc. (mock implementation).",
  "category": "ai-ml",
  "tags": [
    "audio-classification",
    "audio",
    "speech",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "audio_url": {
        "type": "string"
      },
      "audio_base64": {
        "type": "string"
      },
      "top_k": {
        "type": "integer",
        "default": 5
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 3000,
  "memory_mb": 256,
  "example": {
    "input": {
      "audio_url": "https://example.com/audio.mp3"
    },
    "output": {
      "ok": true
    }
  }
}