{
  "author": "functionfly",
  "name": "matrix-determinant",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Matrix Determinant",
  "description": "Calculate the determinant of a square matrix.",
  "category": "arrays",
  "tags": ["matrix", "determinant", "math", "linear-algebra"],
  "input": {
    "type": "object",
    "properties": {
      "matrix": { "type": "array", "description": "Square matrix (2D array)", "items": { "type": "array", "items": { "type": "number" } } }
    },
    "required": ["matrix"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "number" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": { "matrix": [[1, 2], [3, 4]] },
    "output": { "ok": true, "result": -2 }
  }
}