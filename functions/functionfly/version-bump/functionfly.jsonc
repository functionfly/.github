{
  "author": "functionfly",
  "name": "version-bump",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Bump Version",
  "description": "Increment a semantic version string by major, minor, or patch level.",
  "category": "devops",
  "tags": ["semver", "version", "bump", "release", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "version": { "type": "string" },
      "bump": { "type": "string", "enum": ["major", "minor", "patch", "premajor", "preminor", "prepatch", "prerelease"], "default": "patch" },
      "preid": { "type": "string", "description": "Pre-release identifier (e.g. alpha, beta, rc)" }
    },
    "required": ["version"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": { "type": "string" }, "previous": { "type": "string" }, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 500, "memory_mb": 64,
  "example": {
    "input": { "version": "1.2.3", "bump": "minor" },
    "output": { "ok": true, "result": "1.3.0", "previous": "1.2.3" }
  }
}
