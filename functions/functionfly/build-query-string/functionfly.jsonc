{"author":"functionfly","name":"build-query-string","version":"1.0.0","runtime":"python3.12","title":"Build Query String","description":"Build URL query string from an object. Arrays become repeated keys.","category":"text-processing","tags":["query","url","build","params"],"input":{"type":"object","properties":{"params":{"type":"object","description":"Key-value pairs (values can be string or array of strings)"},"prefix_question_mark":{"type":"boolean","description":"Prefix with ?","default":true}},"required":["params"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"query":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"params":{"a":"1","b":"2"}},"output":{"ok":true,"query":"?a=1&b=2"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
