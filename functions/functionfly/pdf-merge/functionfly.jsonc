{
  "author": "functionfly",
  "name": "pdf-merge",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "PDF Merge",
  "description": "Merge multiple PDFs into one. Input is array of base64 PDF strings. Requires pypdf.",
  "category": "media",
  "tags": [
    "pdf",
    "merge",
    "combine",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "pdfs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Array of PDF files as base64 strings"
      }
    },
    "required": [
      "pdfs"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "pdf_base64": {
        "type": "string"
      },
      "pages_total": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": false,
  "cache_ttl": 0,
  "timeout_ms": 20000,
  "memory_mb": 512,
  "example": {
    "input": {
      "pdfs": [
        ""
      ]
    },
    "output": {
      "ok": true
    }
  }
}
