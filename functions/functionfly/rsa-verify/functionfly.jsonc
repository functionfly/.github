{
  "author": "functionfly",
  "name": "rsa-verify",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "RSA Verify",
  "description": "Verify an RSA PKCS#1 v1.5 signature against a message using a public key.",
  "category": "crypto",
  "tags": ["crypto", "rsa", "verify", "signature", "asymmetric"],
  "input": {
    "type": "object",
    "properties": {
      "message": { "description": "Original message" },
      "signature": { "type": "string", "description": "Base64-encoded signature from rsa-sign" },
      "public_key": { "type": "string", "description": "PEM-encoded RSA public key" },
      "algorithm": { "type": "string", "description": "Hash algorithm", "default": "sha256", "enum": ["sha1", "sha256", "sha384", "sha512"] }
    },
    "required": ["message", "signature", "public_key"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "price_per_call": 0.001,
  "example": {
    "input": { "message": "Hello", "signature": "...", "public_key": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----" },
    "output": { "ok": true, "result": true }
  }
}
