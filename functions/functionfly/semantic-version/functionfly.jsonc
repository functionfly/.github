{
  "author": "functionfly",
  "name": "semantic-version",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse Semantic Version",
  "description": "Parse a semantic version string into its components (major, minor, patch, prerelease, build).",
  "category": "devops",
  "tags": ["semver", "version", "parse", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "version": { "type": "string", "description": "Semantic version string (e.g. 1.2.3-alpha.1+build.123)" }
    },
    "required": ["version"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": { "type": "object", "properties": { "major": { "type": "integer" }, "minor": { "type": "integer" }, "patch": { "type": "integer" }, "prerelease": {}, "build": {} } },
      "valid": { "type": "boolean" },
      "error": {}
    }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 500, "memory_mb": 64,
  "example": {
    "input": { "version": "1.2.3-alpha.1+build.123" },
    "output": { "ok": true, "valid": true, "result": { "major": 1, "minor": 2, "patch": 3, "prerelease": "alpha.1", "build": "build.123" } }
  }
}
