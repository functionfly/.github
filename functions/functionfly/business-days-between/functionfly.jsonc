{
  "author": "functionfly",
  "name": "business-days-between",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Business Days Between",
  "description": "Count business days between dates.",
  "category": "datetime",
  "tags": [
    "business",
    "days",
    "between"
  ],
  "input": {
    "type": "object",
    "properties": {
      "date_a": {
        "type": "string"
      },
      "date_b": {
        "type": "string"
      }
    },
    "required": [
      "date_a",
      "date_b"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "business_days": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "date_a": "2024-01-15",
      "date_b": "2024-01-25"
    },
    "output": {
      "ok": true
    }
  }
}
