{
  "author": "functionfly",
  "name": "simplify-polyline",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Simplify Polyline",
  "description": "Simplify a polyline using the Ramer-Douglas-Peucker algorithm, reducing the number of points while preserving shape.",
  "category": "geospatial",
  "tags": [
    "simplify",
    "polyline",
    "ramer-douglas-peucker",
    "rdp",
    "coordinates",
    "geospatial",
  ],
  "input": {
    "type": "object",
    "properties": {
      "coordinates": {
        "type": "array",
        "description": "Array of [lat, lng] coordinate pairs forming the polyline",
        "items": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
        },
      },
      "tolerance": {
        "type": "number",
        "description": "Simplification tolerance in degrees (default: 0.0001)",
      },
    },
    "required": ["coordinates"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "coordinates": {
            "type": "array",
            "description": "Simplified polyline coordinates",
            "items": { "type": "array" },
          },
          "original_count": {
            "type": "integer",
            "description": "Original number of points",
          },
          "simplified_count": {
            "type": "integer",
            "description": "Simplified number of points",
          },
          "reduction_percent": {
            "type": "number",
            "description": "Percentage of points removed",
          },
        },
      },
      "error": { "type": "string" },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 128,
  "example": {
    "input": {
      "coordinates": [
        [0, 0],
        [1, 0.1],
        [2, -0.1],
        [3, 5],
        [4, 6],
        [5, 7],
      ],
      "tolerance": 1.0,
    },
    "output": {
      "ok": true,
      "result": {
        "coordinates": [
          [0, 0],
          [2, -0.1],
          [3, 5],
          [5, 7],
        ],
        "original_count": 6,
        "simplified_count": 4,
        "reduction_percent": 33.33,
      },
    },
  },
}
