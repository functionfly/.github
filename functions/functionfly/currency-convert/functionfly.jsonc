{"author":"functionfly","name":"currency-convert","version":"1.0.0","runtime":"python3.11","title":"Currency Convert","description":"Convert amounts between currencies. Pass an exchange rate (1 from = rate to); for live rates use an external API.","category":"Payment","tags":["currency","convert","money","exchange","rate"],"input":{"type":"object","properties":{"amount":{"type":"number","description":"Amount in source currency"},"from_currency":{"type":"string","default":"USD"},"to_currency":{"type":"string","default":"EUR"},"rate":{"type":"number","description":"Exchange rate (1 from_currency = rate to_currency)"}},"required":["amount"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"amount":{"type":"number"},"original_amount":{"type":"number"},"from_currency":{"type":"string"},"to_currency":{"type":"string"},"rate_used":{"type":["number","null"]},"message":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"amount":100,"from_currency":"USD","to_currency":"EUR","rate":0.92},"output":{"ok":true,"amount":92,"original_amount":100,"from_currency":"USD","to_currency":"EUR","rate_used":0.92}},"deterministic":true,"idempotent":true,"cache_ttl":60,"timeout_ms":5000,"memory_mb":128}
