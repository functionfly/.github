{
  "author": "functionfly",
  "name": "barcode-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Barcode Validate",
  "description": "Validate barcode format.",
  "category": "utilities",
  "tags": ["barcode", "validate"],
  "input": {
    "type": "object",
    "properties": {
      "barcode": {
        "type": "string",
      },
      "format": {
        "type": "string",
      },
    },
    "required": ["barcode"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
      },
      "valid": {
        "type": "boolean",
      },
      "format": {
        "type": "string",
      },
      "error": {
        "type": "string",
      },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "barcode": "5901234123457",
    },
    "output": {
      "ok": true,
      "valid": true,
      "format": "EAN-13",
    },
  },
}
