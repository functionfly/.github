{"author":"functionfly","name":"truncate","version":"1.0.0","runtime":"python3.12","title":"Truncate","description":"Truncate a string to a specified length with optional suffix (e.g. ellipsis).","category":"text-processing","tags":["truncate","string","text","length"],"input":{"type":"object","properties":{"text":{"type":"string","description":"String to truncate"},"max_length":{"type":"integer","description":"Maximum length (required)"},"suffix":{"type":"string","description":"Suffix to append when truncated (e.g. ...)","default":"..."}},"required":["text","max_length"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"truncated":{"type":"boolean"},"error":{"type":"string"}}},"example":{"input":{"text":"Hello world","max_length":8},"output":{"ok":true,"result":"Hello...","truncated":true}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
