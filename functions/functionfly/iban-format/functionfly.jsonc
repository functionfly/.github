{
  "author": "functionfly",
  "name": "iban-format",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "IBAN Format",
  "description": "Format IBAN.",
  "category": "utilities",
  "tags": ["iban", "format"],
  "input": {
    "type": "object",
    "properties": {
      "iban": {
        "type": "string"
      },
      "format": {
        "type": "string"
      }
    },
    "required": ["iban"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "formatted": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "iban": "GB82WEST12345698765432"
    },
    "output": {
      "ok": true,
      "formatted": "GB82 WEST 1234 5698 7654 32"
    }
  }
}
