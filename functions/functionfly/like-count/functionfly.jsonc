{
  "author": "functionfly",
  "name": "like-count",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Social Like Count",
  "description": "Get like/reaction counts for content across social platforms (requires platform API integration).",
  "category": "social",
  "tags": ["likes", "count", "social", "analytics", "engagement"],
  "input": { "type": "object", "properties": { "content_id": { "type": "string" }, "platform": { "type": "string", "default": "all" } }, "required": ["content_id"] },
  "output": { "type": "object", "properties": { "ok": {}, "likes": {}, "total": {}, "note": {}, "error": {} } },
  "deterministic": false, "idempotent": true,
  "cache_ttl": 300, "timeout_ms": 5000, "memory_mb": 64,
  "example": { "input": { "content_id": "1234567890", "platform": "twitter" }, "output": { "ok": true, "likes": { "twitter": null } } }
}
