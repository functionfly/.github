{
  "author": "functionfly",
  "name": "textile-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Textile Parse",
  "description": "Parse Textile to HTML.",
  "category": "text",
  "tags": ["textile", "html", "parse"],
  "input": {
    "type": "object",
    "properties": {
      "textile": {
        "type": "string",
      },
    },
    "required": ["textile"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
      },
      "html": {
        "type": "string",
      },
      "error": {
        "type": "string",
      },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "textile": "h1. Hello\n\nThis is *bold* text.",
    },
    "output": {
      "ok": true,
      "html": "<h1>Hello</h1>\n<p>This is <strong>bold</strong> text.</p>",
    },
  },
}
