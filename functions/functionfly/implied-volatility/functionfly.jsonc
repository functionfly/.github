{
  "author": "functionfly",
  "name": "implied-volatility",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Implied Volatility Calculate",
  "description": "Calculate implied volatility from option price using Black-Scholes model (Newton-Raphson method).",
  "category": "analytics",
  "tags": [
    "implied-volatility",
    "options",
    "black-scholes",
    "finance"
  ],
  "input": {
    "type": "object",
    "properties": {
      "option_price": {
        "type": "number",
        "description": "Market price of the option"
      },
      "spot_price": {
        "type": "number",
        "description": "Current price of underlying asset"
      },
      "strike_price": {
        "type": "number",
        "description": "Option strike price"
      },
      "time_to_expiry": {
        "type": "number",
        "description": "Time to expiry in years"
      },
      "risk_free_rate": {
        "type": "number",
        "description": "Risk-free rate (decimal)"
      },
      "option_type": {
        "type": "string",
        "description": "Option type: 'call' or 'put'",
        "default": "call"
      }
    },
    "required": [
      "option_price",
      "spot_price",
      "strike_price",
      "time_to_expiry",
      "risk_free_rate"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {},
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "option_price": 10.0,
      "spot_price": 100,
      "strike_price": 100,
      "time_to_expiry": 1.0,
      "risk_free_rate": 0.05
    },
    "output": {
      "ok": true,
      "result": 0.2
    }
  }
}