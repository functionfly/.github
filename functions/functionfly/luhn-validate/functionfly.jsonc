{
  "author": "functionfly",
  "name": "luhn-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Luhn Algorithm Validation",
  "description": "Validate a credit card number (or any numeric string) using the Luhn checksum algorithm.",
  "category": "ecommerce",
  "tags": ["luhn", "credit-card", "validate", "checksum", "ecommerce"],
  "input": {
    "type": "object",
    "properties": { "number": { "type": "string", "description": "Card number (spaces/dashes allowed)" } },
    "required": ["number"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": { "type": "boolean" }, "valid": {}, "length": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "number": "4532015112830366" }, "output": { "ok": true, "valid": true } }
}
