{
  "author": "functionfly",
  "name": "service-worker",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Check Service Worker",
  "description": "Check if a URL has a service worker registered (via Service-Worker-Allowed header or sw.js).",
  "category": "devops",
  "tags": ["service-worker", "pwa", "web", "performance", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string" },
      "timeout": { "type": "integer", "default": 10 }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "has_service_worker": { "type": "boolean" }, "sw_url": { "type": "string" }, "error": {} }
  },
  "deterministic": false, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 15000, "memory_mb": 128,
  "example": {
    "input": { "url": "https://example.com" },
    "output": { "ok": true, "has_service_worker": true, "sw_url": "https://example.com/sw.js" }
  }
}
