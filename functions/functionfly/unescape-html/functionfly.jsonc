{"author":"functionfly","name":"unescape-html","version":"1.0.0","runtime":"python3.12","title":"Unescape HTML","description":"Unescape HTML entities (&amp;, &lt;, &gt;, &quot;, etc.) to plain text.","category":"text-processing","tags":["html","unescape","entities","decode"],"input":{"type":"object","properties":{"text":{"type":"string","description":"HTML-escaped string to unescape"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"&lt;div&gt;Hi&lt;/div&gt;"},"output":{"ok":true,"result":"<div>Hi</div>"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
