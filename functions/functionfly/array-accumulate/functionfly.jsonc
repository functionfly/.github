{
  "author": "functionfly",
  "name": "array-accumulate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Accumulate",
  "description": "Generate running accumulation of array elements.",
  "category": "arrays",
  "tags": ["array", "accumulate", "running-total", "reduce", "fold"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array to accumulate" },
      "operation": { "type": "string", "description": "Accumulation operation", "enum": ["sum", "product", "min", "max", "concat"], "default": "sum" },
      "initial": { "description": "Initial value (optional, uses first element if not provided)" }
    },
    "required": ["items"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array", "description": "Running accumulation results" },
      "count": { "type": "integer", "description": "Number of accumulation steps" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": { "items": [1, 2, 3, 4], "operation": "sum" },
    "output": {
      "ok": true,
      "result": [1, 3, 6, 10],
      "count": 4
    }
  }
}
