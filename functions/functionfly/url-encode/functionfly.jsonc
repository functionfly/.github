{"author":"functionfly","name":"url-encode","version":"1.0.0","runtime":"python3.11","title":"URL Encode","description":"URL encode a string (percent-encoding). Optional safe characters to leave unencoded.","category":"Data Format","tags":["url","encode","percent","encoding"],"input":{"type":"object","properties":{"text":{"type":"string","description":"String to URL encode"},"safe":{"type":"string","description":"Extra characters to leave unencoded","default":""}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"encoded":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"hello world"},"output":{"ok":true,"encoded":"hello%20world"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
