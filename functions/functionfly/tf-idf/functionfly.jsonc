{
  "author": "functionfly",
  "name": "tf-idf",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "TF-IDF Scores",
  "description": "Calculate Term Frequency-Inverse Document Frequency scores for terms in a document collection.",
  "category": "ai-ml",
  "tags": [
    "tf-idf",
    "embeddings",
    "nlp",
    "vectors",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "documents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "query": {
        "type": "string"
      }
    },
    "required": [
      "documents"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "documents": [
        "machine learning",
        "deep learning"
      ],
      "query": "learning"
    },
    "output": {
      "ok": true
    }
  }
}