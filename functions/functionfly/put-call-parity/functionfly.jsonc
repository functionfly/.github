{
  "author": "functionfly",
  "name": "put-call-parity",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Put-Call Parity Check",
  "description": "Verify put-call parity and calculate the theoretical price of a put or call.",
  "category": "finance",
  "tags": [
    "put-call-parity",
    "options",
    "derivatives",
    "finance"
  ],
  "input": {
    "type": "object",
    "properties": {
      "call_price": {
        "type": "number",
        "description": "Call option price"
      },
      "put_price": {
        "type": "number",
        "description": "Put option price"
      },
      "spot_price": {
        "type": "number",
        "description": "Current price of underlying asset"
      },
      "strike_price": {
        "type": "number",
        "description": "Option strike price"
      },
      "time_to_expiry": {
        "type": "number",
        "description": "Time to expiry in years"
      },
      "risk_free_rate": {
        "type": "number",
        "description": "Risk-free rate (decimal)"
      }
    },
    "required": [
      "spot_price",
      "strike_price",
      "time_to_expiry",
      "risk_free_rate"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {},
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "call_price": 10.45,
      "put_price": 5.57,
      "spot_price": 100,
      "strike_price": 100,
      "time_to_expiry": 1.0,
      "risk_free_rate": 0.05
    },
    "output": {
      "ok": true,
      "result": {
        "parity_holds": true,
        "theoretical_call": 10.45,
        "theoretical_put": 5.57
      }
    }
  }
}