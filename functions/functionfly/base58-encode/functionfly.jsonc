{
  "author": "functionfly",
  "name": "base58-encode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Base58 Encode",
  "description": "Encode to Base58.",
  "category": "encoding",
  "tags": ["base58", "encode"],
  "input": {
    "type": "object",
    "properties": {
      "data": {
        "type": "string",
      },
    },
    "required": ["data"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
      },
      "encoded": {
        "type": "string",
      },
      "error": {
        "type": "string",
      },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "data": "Hello",
    },
    "output": {
      "ok": true,
      "encoded": "9Ajdvzr",
    },
  },
}
