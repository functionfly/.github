{
  "author": "functionfly",
  "name": "color-darken",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Darken Color",
  "description": "Decrease the HSL lightness of a color by a given amount (0-100).",
  "category": "color",
  "tags": ["color", "darken", "hsl", "adjust"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string", "description": "Hex color" },
      "amount": { "type": "number", "description": "Amount to darken (0-100)", "default": 10 }
    },
    "required": ["color"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "original_lightness": { "type": "number" },
      "new_lightness": { "type": "number" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "color": "#336699", "amount": 20 },
    "output": { "ok": true }
  }
}
