{"author":"functionfly","name":"markdown-to-html","version":"1.0.0","runtime":"python3.11","title":"Markdown to HTML","description":"Convert Markdown to HTML. Supports headers, bold, italic, links, lists, and paragraphs.","category":"Utility","tags":["markdown","html","convert","data","format"],"input":{"type":"object","properties":{"markdown":{"type":"string","description":"Markdown string to convert"}},"required":["markdown"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"html":{"type":"string","description":"Converted HTML"},"error":{"type":"string"}}},"example":{"input":{"markdown":"# Hello\n\nWorld"},"output":{"ok":true,"html":"<h1>Hello</h1>\n<p>World</p>"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
