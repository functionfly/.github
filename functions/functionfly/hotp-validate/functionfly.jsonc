{
  "author": "functionfly",
  "name": "hotp-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HOTP Validate",
  "description": "Validate HOTP.",
  "category": "security",
  "tags": ["hotp", "validate"],
  "input": {
    "type": "object",
    "properties": {
      "hotp": {
        "type": "string",
      },
      "secret": {
        "type": "string",
      },
      "counter": {
        "type": "integer",
      },
      "digits": {
        "type": "integer",
      },
    },
    "required": ["hotp", "secret", "counter"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
      },
      "valid": {
        "type": "boolean",
      },
      "error": {
        "type": "string",
      },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "hotp": "123456",
      "secret": "JBSWY3DPEHPK3PXP",
      "counter": 0,
    },
    "output": {
      "ok": true,
      "valid": true,
    },
  },
}
