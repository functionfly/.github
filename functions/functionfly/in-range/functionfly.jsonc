{
  "author": "functionfly",
  "name": "in-range",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "In Range",
  "description": "Check whether a number is within a specified range (inclusive by default).",
  "category": "validation",
  "tags": ["validation", "range", "number", "min", "max", "check"],
  "input": {
    "type": "object",
    "properties": {
      "value": { "type": "number", "description": "Number to check" },
      "min": { "type": "number", "description": "Minimum value" },
      "max": { "type": "number", "description": "Maximum value" },
      "inclusive": { "type": "boolean", "description": "Include endpoints", "default": true }
    },
    "required": ["value", "min", "max"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": { "type": "number" },
      "result": { "type": "boolean" },
      "min": { "type": "number" },
      "max": { "type": "number" },
      "inclusive": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": 5, "min": 1, "max": 10 },
    "output": { "ok": true, "value": 5, "result": true, "min": 1, "max": 10, "inclusive": true }
  }
}
