{
  "author": "functionfly",
  "name": "hex-to-rgb",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Hex to RGB",
  "description": "Convert a CSS hex color (#RGB, #RGBA, #RRGGBB, #RRGGBBAA) to its RGB(A) components.",
  "category": "color",
  "tags": ["color", "hex", "rgb", "convert", "css"],
  "input": {
    "type": "object",
    "properties": {
      "hex": { "type": "string", "description": "Hex color (e.g. '#ff5733' or 'ff5733')" },
      "include_alpha": { "type": "boolean", "description": "Include alpha channel if present", "default": true }
    },
    "required": ["hex"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "object", "properties": { "r": {}, "g": {}, "b": {}, "a": {}, "hex": {}, "css": {} } },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "hex": "#ff5733" },
    "output": { "ok": true, "result": { "r": 255, "g": 87, "b": 51, "hex": "#FF5733", "css": "rgb(255,87,51)" } }
  }
}
