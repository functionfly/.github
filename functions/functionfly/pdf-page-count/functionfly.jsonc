{
  "author": "functionfly",
  "name": "pdf-page-count",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "PDF Page Count",
  "description": "Get the number of pages in a PDF. Requires pypdf.",
  "category": "media",
  "tags": [
    "pdf",
    "pages",
    "count",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "pdf": {
        "type": "string"
      }
    },
    "required": [
      "pdf"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "pages": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 10000,
  "memory_mb": 256,
  "example": {
    "input": {
      "pdf": ""
    },
    "output": {
      "ok": true,
      "pages": 1
    }
  }
}
