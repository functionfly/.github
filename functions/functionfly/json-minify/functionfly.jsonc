{"author":"functionfly","name":"json-minify","version":"1.0.0","runtime":"python3.11","title":"JSON Minify","description":"Minify JSON by removing whitespace.","category":"Data Format","tags":["json","minify","format","data"],"input":{"type":"object","properties":{"data":{"type":["string","object"],"description":"JSON string or object to minify"}},"required":["data"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"json":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"data":"{\"a\": 1, \"b\": 2}"},"output":{"ok":true,"json":"{\"a\":1,\"b\":2}"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
