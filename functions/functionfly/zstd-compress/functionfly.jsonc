{
  "author": "functionfly",
  "name": "zstd-compress",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Zstandard Compress",
  "description": "Compress data with Zstandard (excellent speed/ratio balance), returning Base64-encoded output.",
  "category": "encoding",
  "tags": ["compression", "zstd", "zstandard", "encode"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "description": "Data to compress" },
      "level": { "type": "integer", "description": "Compression level 1-22 (3=default)", "default": 3, "minimum": 1, "maximum": 22 }
    },
    "required": ["data"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "original_size": { "type": "integer" },
      "compressed_size": { "type": "integer" },
      "ratio": { "type": "number" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 5000,
  "memory_mb": 128,
  "example": {
    "input": { "data": "Hello World Hello World Hello World" },
    "output": { "ok": true, "original_size": 35 }
  }
}
