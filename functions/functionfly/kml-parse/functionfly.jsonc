{
  "author": "functionfly",
  "name": "kml-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "KML Parse",
  "description": "Parse KML (Keyhole Markup Language) XML data and convert to GeoJSON format.",
  "category": "geospatial",
  "tags": ["kml", "parse", "geojson", "convert", "geospatial", "xml"],
  "input": {
    "type": "object",
    "properties": {
      "kml": { "type": "string", "description": "KML XML string to parse" },
    },
    "required": ["kml"],
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "GeoJSON type (FeatureCollection)",
          },
          "features": {
            "type": "array",
            "description": "Array of GeoJSON features",
          },
          "feature_count": { "type": "integer" },
        },
      },
      "error": { "type": "string" },
    },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 128,
  "example": {
    "input": {
      "kml": "<kml><Placemark><name>New York</name><Point><coordinates>-74.006,40.7128,0</coordinates></Point></Placemark></kml>",
    },
    "output": {
      "ok": true,
      "result": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "geometry": {
              "type": "Point",
              "coordinates": [-74.006, 40.7128, 0],
            },
            "properties": { "name": "New York" },
          },
        ],
        "feature_count": 1,
      },
    },
  },
}
