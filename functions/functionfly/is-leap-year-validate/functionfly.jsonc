{
  "author": "functionfly",
  "name": "is-leap-year-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Is Leap Year (Validate)",
  "description": "Validate whether a given year is a leap year using the Gregorian calendar rules.",
  "category": "validation",
  "tags": ["validation", "leap-year", "calendar", "date", "check"],
  "input": {
    "type": "object",
    "properties": {
      "year": { "type": "integer", "description": "Year to check" }
    },
    "required": ["year"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "year": { "type": "integer" },
      "result": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "year": 2024 },
    "output": { "ok": true, "year": 2024, "result": true }
  }
}
