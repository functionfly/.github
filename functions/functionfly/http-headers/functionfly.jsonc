{
  "author": "functionfly",
  "name": "http-headers",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Fetch HTTP Headers",
  "description": "Fetch and return all HTTP response headers from a URL.",
  "category": "devops",
  "tags": ["http", "headers", "networking", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string" },
      "method": { "type": "string", "default": "HEAD" },
      "timeout": { "type": "integer", "default": 10 }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "headers": { "type": "object" }, "status_code": { "type": "integer" }, "error": {} }
  },
  "deterministic": false, "idempotent": true,
  "cache_ttl": 60, "timeout_ms": 15000, "memory_mb": 128,
  "example": {
    "input": { "url": "https://example.com" },
    "output": { "ok": true, "status_code": 200, "headers": { "content-type": "text/html", "server": "nginx" } }
  }
}
