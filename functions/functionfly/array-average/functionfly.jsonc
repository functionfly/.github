{
  "author": "functionfly",
  "name": "array-average",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Average",
  "description": "Calculate average (mean) of numeric array.",
  "category": "arrays",
  "tags": ["array", "average", "mean"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array of numbers" }
    },
    "required": ["items"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "number" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "items": [1, 2, 3, 4, 5] },
    "output": { "ok": true, "result": 3 }
  }
}
