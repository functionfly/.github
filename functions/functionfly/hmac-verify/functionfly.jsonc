{
  "author": "functionfly",
  "name": "hmac-verify",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HMAC Verify",
  "description": "Verify HMAC signature for a message. Default SHA-256.",
  "category": "security",
  "tags": [
    "hmac",
    "verify",
    "signature",
    "security"
  ],
  "input": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string"
      },
      "secret": {
        "type": "string"
      },
      "signature": {
        "type": "string",
        "description": "Base64 or hex signature"
      },
      "algorithm": {
        "type": "string",
        "default": "sha256"
      }
    },
    "required": [
      "message",
      "secret",
      "signature"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "valid": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 5000,
  "memory_mb": 128,
  "example": {
    "input": {
      "message": "hello",
      "secret": "test",
      "signature": "placeholder",
      "key": "secret"
    },
    "output": {
      "ok": false
    }
  }
}
