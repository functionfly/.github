{"author":"functionfly","name":"extract-urls","version":"1.0.0","runtime":"python3.12","title":"Extract URLs","description":"Extract all URLs from text.","category":"text-processing","tags":["url","extract","regex","text","link"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to search for URLs"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"urls":{"type":"array","items":{"type":"string"}},"count":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"Visit https://example.com and http://test.org"},"output":{"ok":true,"urls":["https://example.com","http://test.org"],"count":2}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
