{
  "author": "functionfly",
  "name": "is-null",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Is Null",
  "description": "Check whether a value is null/None.",
  "category": "validation",
  "tags": ["validation", "null", "nil", "check"],
  "input": {
    "type": "object",
    "properties": {
      "value": { "description": "Value to check" }
    },
    "required": ["value"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": {},
      "result": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": null },
    "output": { "ok": true, "value": null, "result": true }
  }
}
