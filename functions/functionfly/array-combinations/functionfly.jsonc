{
  "author": "functionfly",
  "name": "array-combinations",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Combinations",
  "description": "Generate all combinations of specified length from an array.",
  "category": "arrays",
  "tags": ["array", "combinations", "math", "subsets"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array to generate combinations from" },
      "r": { "type": "integer", "description": "Length of each combination", "minimum": 0 }
    },
    "required": ["items", "r"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array", "items": { "type": "array" } },
      "count": { "type": "integer", "description": "Number of combinations generated" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 5000,
  "memory_mb": 256,
  "example": {
    "input": { "items": [1, 2, 3, 4], "r": 2 },
    "output": {
      "ok": true,
      "result": [[1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [3, 4]],
      "count": 6
    }
  }
}
