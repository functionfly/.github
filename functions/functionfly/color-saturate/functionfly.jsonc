{
  "author": "functionfly",
  "name": "color-saturate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Saturate Color",
  "description": "Increase the HSL saturation of a color by a given amount.",
  "category": "color",
  "tags": ["color", "saturate", "saturation", "hsl"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string" },
      "amount": { "type": "number", "default": 20 }
    },
    "required": ["color"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": {}, "original_saturation": {}, "new_saturation": {}, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 86400, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "color": "#669999", "amount": 30 }, "output": { "ok": true } }
}
