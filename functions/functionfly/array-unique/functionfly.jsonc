{
  "author": "functionfly",
  "name": "array-unique",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Unique",
  "description": "Get unique elements preserving order (first occurrence).",
  "category": "arrays",
  "tags": ["array", "unique", "dedupe", "distinct"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array to deduplicate" },
      "preserve_order": { "type": "boolean", "description": "Keep first occurrence order", "default": true }
    },
    "required": ["items"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "items": [1, 2, 2, 3, 1, 4] },
    "output": { "ok": true, "result": [1, 2, 3, 4] }
  }
}
