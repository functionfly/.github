{
  "author": "functionfly",
  "name": "morse-decode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Morse Decode",
  "description": "Decode Morse code to text.",
  "category": "encoding",
  "tags": ["morse", "decode"],
  "input": {
    "type": "object",
    "properties": {
      "morse": {
        "type": "string"
      }
    },
    "required": ["morse"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "morse": ".... . .-.. .-.. ---"
    },
    "output": {
      "ok": true,
      "text": "HELLO"
    }
  }
}
