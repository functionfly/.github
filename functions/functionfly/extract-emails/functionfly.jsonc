{"author":"functionfly","name":"extract-emails","version":"1.0.0","runtime":"python3.12","title":"Extract Emails","description":"Extract all email addresses from text.","category":"text-processing","tags":["email","extract","regex","text"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to search for email addresses"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"emails":{"type":"array","items":{"type":"string"}},"count":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"Contact us at support@example.com or sales@example.com"},"output":{"ok":true,"emails":["support@example.com","sales@example.com"],"count":2}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
