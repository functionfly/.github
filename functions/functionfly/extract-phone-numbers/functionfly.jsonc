{"author":"functionfly","name":"extract-phone-numbers","version":"1.0.0","runtime":"python3.12","title":"Extract Phone Numbers","description":"Extract phone numbers from text. Supports various formats (E.164, with spaces/dashes/parens).","category":"text-processing","tags":["phone","extract","regex","text","tel"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to search for phone numbers"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"phones":{"type":"array","items":{"type":"string"}},"count":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"Call 555-123-4567 or (555) 987-6543"},"output":{"ok":true,"phones":["555-123-4567","(555) 987-6543"],"count":2}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
