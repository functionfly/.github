{
  "author": "functionfly",
  "name": "avro-encode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Avro Encode",
  "description": "Encode a record to Apache Avro binary format given a schema. Requires fastavro.",
  "category": "format",
  "tags": ["avro", "apache", "encode", "binary", "schema"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "description": "Record to encode" },
      "schema": { "type": "object", "description": "Avro schema" }
    },
    "required": ["data", "schema"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "bytes": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 1000, "memory_mb": 128,
  "example": { "input": { "data": { "name": "Alice" }, "schema": { "type": "record", "name": "User", "fields": [{ "name": "name", "type": "string" }] } }, "output": { "ok": true } }
}
