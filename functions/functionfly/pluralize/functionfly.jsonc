{"author":"functionfly","name":"pluralize","version":"1.0.0","runtime":"python3.12","title":"Pluralize","description":"Pluralize English nouns (simple rules: -y, -s, -ch, -sh, -x, irregulars).","category":"text-processing","tags":["pluralize","noun","english","grammar"],"input":{"type":"object","properties":{"word":{"type":"string","description":"Singular noun to pluralize"},"count":{"type":"integer","description":"If 1, return singular; otherwise plural","default":2}},"required":["word"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"word":"apple"},"output":{"ok":true,"result":"apples"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
