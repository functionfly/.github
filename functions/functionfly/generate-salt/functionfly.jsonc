{
  "author": "functionfly",
  "name": "generate-salt",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Generate Salt",
  "description": "Generate a cryptographically secure random salt for use with password hashing functions.",
  "category": "crypto",
  "tags": ["crypto", "salt", "random", "password", "security"],
  "input": {
    "type": "object",
    "properties": {
      "size": { "type": "integer", "description": "Salt size in bytes (8-64)", "default": 16 },
      "format": { "type": "string", "description": "'hex' or 'base64'", "default": "hex", "enum": ["hex", "base64"] }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "size": { "type": "integer" },
      "format": { "type": "string" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 0,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "size": 16 },
    "output": { "ok": true, "size": 16 }
  }
}
