{
  "author": "functionfly",
  "name": "base58-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Base58 Validate",
  "description": "Validate Base58 string.",
  "category": "encoding",
  "tags": ["base58", "validate"],
  "input": {
    "type": "object",
    "properties": {
      "data": {
        "type": "string"
      }
    },
    "required": ["data"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "valid": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "data": "9Ajdvzr"
    },
    "output": {
      "ok": true,
      "valid": true
    }
  }
}
