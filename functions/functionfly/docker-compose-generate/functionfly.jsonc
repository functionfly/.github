{
  "author": "functionfly",
  "name": "docker-compose-generate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Generate Docker Compose",
  "description": "Generate a docker-compose.yml file for multi-service applications.",
  "category": "devops",
  "tags": ["docker", "compose", "orchestration", "infrastructure", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "services": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "image": { "type": "string" },
            "ports": { "type": "array", "items": { "type": "string" } },
            "environment": { "type": "object" },
            "volumes": { "type": "array", "items": { "type": "string" } },
            "depends_on": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["name"]
        }
      },
      "version": { "type": "string", "description": "Docker Compose version" },
      "networks": { "type": "array", "items": { "type": "string" } },
      "volumes": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["services"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": { "type": "string" },
      "compose_file": { "type": "string" },
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 64,
  "example": {
    "input": {
      "services": [
        { "name": "web", "image": "nginx:latest", "ports": ["80:80"] },
        {
          "name": "db",
          "image": "postgres:15",
          "environment": { "POSTGRES_DB": "mydb" }
        }
      ]
    },
    "output": {
      "ok": true,
      "result": "docker-compose.yml generated",
      "compose_file": "version: '3.8'\nservices:\n  web:\n    image: nginx:latest\n    ports:\n      - '80:80'\n  db:\n    image: postgres:15\n    environment:\n      POSTGRES_DB: mydb\n"
    }
  }
}
