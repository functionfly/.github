{"author":"functionfly","name":"char-count","version":"1.0.0","runtime":"python3.12","title":"Character Count","description":"Count characters in text. Optionally count with or without whitespace.","category":"text-processing","tags":["character","count","text","length"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to count characters in"},"exclude_whitespace":{"type":"boolean","description":"Exclude spaces and newlines from count","default":false}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"characters":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"Hello world"},"output":{"ok":true,"characters":11}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
