{
  "author": "functionfly",
  "name": "amortize-cost",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Amortize Cost Calculate",
  "description": "Calculate the amortization of an intangible asset cost over its useful life.",
  "category": "finance",
  "tags": [
    "amortize",
    "amortization",
    "intangible",
    "accounting"
  ],
  "input": {
    "type": "object",
    "properties": {
      "cost": {
        "type": "number",
        "description": "Total cost to amortize"
      },
      "useful_life": {
        "type": "number",
        "description": "Useful life in years"
      },
      "period": {
        "type": "number",
        "description": "Current period (1-based)",
        "default": 1
      }
    },
    "required": [
      "cost",
      "useful_life"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {},
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "cost": 120000,
      "useful_life": 10
    },
    "output": {
      "ok": true,
      "result": 12000.0,
      "annual_amortization": 12000.0
    }
  }
}