{"author":"functionfly","name":"yaml-to-json","version":"1.0.0","runtime":"python3.11","title":"YAML to JSON","description":"Convert YAML to JSON. Uses PyYAML if available; simple key: value fallback otherwise.","category":"Data Format","tags":["yaml","json","convert","data","format"],"input":{"type":"object","properties":{"yaml":{"type":"string","description":"YAML string to convert"}},"required":["yaml"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"json":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"yaml":"name: hello\nversion: 1"},"output":{"ok":true,"json":"{\"name\":\"hello\",\"version\":1}"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
