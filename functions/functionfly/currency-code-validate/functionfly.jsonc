{
  "author": "functionfly",
  "name": "currency-code-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Validate Currency Code",
  "description": "Check if a string is a valid ISO 4217 currency code (covers 160+ active currencies).",
  "category": "ecommerce",
  "tags": ["currency", "validate", "iso4217", "finance"],
  "input": {
    "type": "object",
    "properties": { "code": { "type": "string" } },
    "required": ["code"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": { "type": "boolean" },
      "valid": {},
      "code": {},
      "normalized": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "code": "USD" },
    "output": { "ok": true, "valid": true }
  }
}
