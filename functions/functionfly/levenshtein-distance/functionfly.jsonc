{"author":"functionfly","name":"levenshtein-distance","version":"1.0.0","runtime":"python3.12","title":"Levenshtein Distance","description":"Calculate the Levenshtein (edit) distance between two strings.","category":"text-processing","tags":["levenshtein","distance","edit","string","similarity"],"input":{"type":"object","properties":{"a":{"type":"string","description":"First string"},"b":{"type":"string","description":"Second string"}},"required":["a","b"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"distance":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"a":"kitten","b":"sitting"},"output":{"ok":true,"distance":3}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
