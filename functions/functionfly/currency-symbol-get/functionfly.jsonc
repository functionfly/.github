{
  "author": "functionfly",
  "name": "currency-symbol-get",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Get Currency Symbol",
  "description": "Look up the currency symbol for any ISO 4217 currency code (covers 160+ currencies).",
  "category": "ecommerce",
  "tags": ["currency", "symbol", "iso4217", "finance"],
  "input": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "description": "ISO 4217 code (e.g. 'USD', 'EUR')"
      }
    },
    "required": ["code"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": { "type": "string" },
      "symbol": {},
      "code": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "code": "EUR" },
    "output": { "ok": true, "result": "€" }
  }
}
