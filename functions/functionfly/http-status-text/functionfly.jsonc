{
  "author": "functionfly",
  "name": "http-status-text",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HTTP Status Text",
  "description": "Get the standard reason phrase for an HTTP status code (e.g. 404 → 'Not Found').",
  "category": "http",
  "tags": ["http", "status", "code", "text", "reason"],
  "input": {
    "type": "object",
    "properties": {
      "status_code": { "type": "integer", "description": "HTTP status code", "minimum": 100, "maximum": 599 }
    },
    "required": ["status_code"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "status_code": { "type": "integer" },
      "text": { "type": "string" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "status_code": 404 },
    "output": { "ok": true, "status_code": 404, "text": "Not Found" }
  }
}
