{
  "author": "functionfly",
  "name": "protobuf-decode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Protocol Buffers Decode",
  "description": "Decode Protocol Buffer binary data. Requires protobuf library and message schema. Falls back to JSON decoding.",
  "category": "format",
  "tags": ["protobuf", "proto", "google", "decode", "binary"],
  "input": { "type": "object", "properties": { "data": { "type": "string" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "note": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 2000, "memory_mb": 128,
  "example": { "input": { "data": "..." }, "output": { "ok": true } }
}
