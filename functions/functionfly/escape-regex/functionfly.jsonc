{"author":"functionfly","name":"escape-regex","version":"1.0.0","runtime":"python3.12","title":"Escape Regex","description":"Escape special regex characters in a string for use as literal pattern.","category":"text-processing","tags":["regex","escape","pattern","literal"],"input":{"type":"object","properties":{"text":{"type":"string","description":"String to escape for regex"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"(hello).*"},"output":{"ok":true,"result":"\\(hello\\)\\.\\*"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
