{
  "author": "functionfly",
  "name": "secret-rotate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Rotate Secret",
  "description": "Generate a new secret value to replace an existing one, with configurable format.",
  "category": "devops",
  "tags": ["secret", "rotate", "security", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "type": { "type": "string", "enum": ["random", "uuid", "hex", "base64", "alphanumeric"], "default": "random" },
      "length": { "type": "integer", "default": 32 },
      "prefix": { "type": "string" }
    }
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": { "type": "string" }, "secret": { "type": "string" }, "error": {} }
  },
  "deterministic": false, "idempotent": false,
  "cache_ttl": 0, "timeout_ms": 1000, "memory_mb": 64,
  "example": {
    "input": { "type": "hex", "length": 32 },
    "output": { "ok": true, "secret": "a1b2c3d4e5f6..." }
  }
}
