{
  "author": "functionfly",
  "name": "array-compact",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Compact",
  "description": "Remove falsy values (null, false, 0, empty string, NaN).",
  "category": "arrays",
  "tags": ["array", "compact", "filter", "falsy"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Array to compact" }
    },
    "required": ["items"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "array" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "items": [1, 0, null, 2, false, "", 3] },
    "output": { "ok": true, "result": [1, 2, 3] }
  }
}
