{
  "author": "functionfly",
  "name": "turf-line-slice",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Turf Line Slice",
  "description": "Slice a line between two distances along it (Turf.js compatible). Uses [lng, lat] coordinate order.",
  "category": "geospatial",
  "tags": ["turf", "line-slice", "slice", "line", "segment", "geospatial"],
  "input": {
    "type": "object",
    "properties": {
      "coordinates": {
        "type": "array",
        "description": "Line as array of [lng, lat] coordinate pairs",
        "items": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "start_distance": {
        "type": "number",
        "description": "Start distance along the line"
      },
      "stop_distance": {
        "type": "number",
        "description": "Stop distance along the line"
      },
      "unit": {
        "type": "string",
        "description": "Unit: 'km', 'miles', 'meters' (default: 'km')"
      }
    },
    "required": ["coordinates", "start_distance", "stop_distance"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "coordinates": {
            "type": "array",
            "description": "Sliced line coordinates as [lng, lat] pairs",
            "items": { "type": "array" }
          },
          "length_km": {
            "type": "number",
            "description": "Length of sliced segment in km"
          }
        }
      },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "coordinates": [
        [-74.006, 40.7128],
        [-87.6298, 41.8781],
        [-118.2437, 34.0522]
      ],
      "start_distance": 500,
      "stop_distance": 1500,
      "unit": "km"
    },
    "output": {
      "ok": true,
      "result": {
        "coordinates": [
          [-80.5, 41.3],
          [-87.6298, 41.8781],
          [-95.2, 38.5]
        ],
        "length_km": 1000.0
      }
    }
  }
}
