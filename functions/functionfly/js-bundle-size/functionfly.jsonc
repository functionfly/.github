{
  "author": "functionfly",
  "name": "js-bundle-size",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Check JS Bundle Size",
  "description": "Check the size of a JavaScript bundle URL and provide optimization suggestions.",
  "category": "devops",
  "tags": ["javascript", "bundle", "performance", "web", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string" },
      "timeout": { "type": "integer", "default": 10 }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "size_bytes": { "type": "integer" }, "size_kb": { "type": "number" }, "compressed_size": { "type": "integer" }, "suggestions": { "type": "array" }, "error": {} }
  },
  "deterministic": false, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 15000, "memory_mb": 128,
  "example": {
    "input": { "url": "https://example.com/bundle.js" },
    "output": { "ok": true, "size_bytes": 512000, "size_kb": 500.0, "suggestions": ["Bundle exceeds 250KB - consider code splitting"] }
  }
}
