{
  "author": "functionfly",
  "name": "gzip-compress",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "GZIP Compress",
  "description": "Compress data with GZIP and return the result as a Base64-encoded string.",
  "category": "encoding",
  "tags": ["compression", "gzip", "encode", "deflate"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "description": "Data to compress (string, object, or array)" },
      "level": { "type": "integer", "description": "Compression level 0-9 (9=best)", "default": 9, "minimum": 0, "maximum": 9 }
    },
    "required": ["data"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string", "description": "Base64-encoded compressed data" },
      "original_size": { "type": "integer" },
      "compressed_size": { "type": "integer" },
      "ratio": { "type": "number", "description": "Compression ratio (compressed/original)" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 2000,
  "memory_mb": 128,
  "example": {
    "input": { "data": "Hello, World! This is a test string." },
    "output": { "ok": true, "original_size": 36, "compressed_size": 40, "ratio": 1.11 }
  }
}
