{
  "author": "functionfly",
  "name": "bic-validate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "BIC Validate",
  "description": "Validate BIC/SWIFT code.",
  "category": "utilities",
  "tags": ["bic", "swift", "validate"],
  "input": {
    "type": "object",
    "properties": {
      "bic": {
        "type": "string"
      }
    },
    "required": ["bic"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "valid": {
        "type": "boolean"
      },
      "country": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "bic": "DEUTDEFF"
    },
    "output": {
      "ok": true,
      "valid": true,
      "country": "DE"
    }
  }
}
