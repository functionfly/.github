{
  "author": "functionfly",
  "name": "webpage-extract-text",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Webpage Extract Text",
  "description": "Extract main text content from webpage.",
  "category": "media",
  "tags": [
    "webpage",
    "text",
    "extract",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string"
      }
    },
    "required": [
      "url"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 3600,
  "timeout_ms": 15000,
  "memory_mb": 256,
  "example": {
    "input": {
      "url": "https://example.com"
    },
    "output": {
      "ok": true
    }
  }
}
