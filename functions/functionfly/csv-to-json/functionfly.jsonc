{
  "author": "functionfly",
  "name": "csv-to-json",
  "version": "1.0.0",
  "runtime": "python3.11",
  "title": "CSV to JSON Converter",
  "description": "Convert CSV string to JSON array of objects. Automatically detects and converts data types.",
  "category": "Data Format",
  "tags": ["csv", "json", "convert", "data", "formatting"],
  "input": {
    "type": "object",
    "properties": {
      "csv": {
        "type": "string",
        "description": "CSV string to convert to JSON",
        "example": "name,age,email\nJohn Doe,30,john@example.com\nJane Smith,25,jane@example.com"
      },
      "delimiter": {
        "type": "string",
        "description": "CSV delimiter character",
        "default": ","
      },
      "has_header": {
        "type": "boolean",
        "description": "First row is header row",
        "default": true
      },
      "skip_blank_lines": {
        "type": "boolean",
        "description": "Skip blank lines",
        "default": true
      },
      "trim_fields": {
        "type": "boolean",
        "description": "Trim whitespace from fields",
        "default": true
      },
      "null_value": {
        "type": "string",
        "description": "Value to interpret as null",
        "default": ""
      }
    },
    "required": ["csv"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "data": {
        "type": "array",
        "description": "Array of objects"
      },
      "row_count": { "type": "number", "description": "Number of data rows" },
      "column_count": { "type": "number", "description": "Number of columns" },
      "error": { "type": "string", "description": "Error message if ok is false" }
    }
  },
  "example": {
    "input": {
      "csv": "name,age,email\nJohn Doe,30,john@example.com\nJane Smith,25,jane@example.com"
    },
    "output": {
      "ok": true,
      "data": [
        {"name": "John Doe", "age": 30, "email": "john@example.com"},
        {"name": "Jane Smith", "age": 25, "email": "jane@example.com"}
      ],
      "row_count": 2,
      "column_count": 3
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 5000,
  "memory_mb": 128
}
