{
  "author": "functionfly",
  "name": "hocon-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse HOCON",
  "description": "Parse a HOCON (Human-Optimized Config Object Notation) string. Uses pyhocon if available.",
  "category": "format",
  "tags": ["hocon", "config", "parse", "akka", "scala"],
  "input": { "type": "object", "properties": { "data": { "type": "string" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "note": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 1000, "memory_mb": 128,
  "example": { "input": { "data": "server { host = localhost\nport = 8080 }" }, "output": { "ok": true } }
}
