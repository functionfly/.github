{
  "author": "functionfly",
  "name": "object-detection",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Object Detection",
  "description": "Detect objects in an image with bounding boxes (mock implementation for pipeline testing).",
  "category": "ai-ml",
  "tags": [
    "object-detection",
    "vision",
    "image",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "image_url": {
        "type": "string"
      },
      "image_base64": {
        "type": "string"
      },
      "confidence_threshold": {
        "type": "number",
        "default": 0.5
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "image_url": "https://example.com/street.jpg"
    },
    "output": {
      "ok": true
    }
  }
}