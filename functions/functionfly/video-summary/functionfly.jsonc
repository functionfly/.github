{
  "author": "functionfly",
  "name": "video-summary",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Video Summarization",
  "description": "Generate a text summary of video content (mock implementation).",
  "category": "ai-ml",
  "tags": [
    "video-summary",
    "ml",
    "data",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "video_url": {
        "type": "string"
      },
      "num_keyframes": {
        "type": "integer",
        "default": 5
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "video_url": "https://example.com/video.mp4"
    },
    "output": {
      "ok": true
    }
  }
}