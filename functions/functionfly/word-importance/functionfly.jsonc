{
  "author": "functionfly",
  "name": "word-importance",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Word Importance (TF-IDF)",
  "description": "Calculate word importance scores using TF-IDF across a collection of documents.",
  "category": "ai-ml",
  "tags": [
    "word-importance",
    "nlp",
    "text",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "documents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "query": {
        "type": "string"
      }
    },
    "required": [
      "documents"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 500,
  "memory_mb": 64,
  "example": {
    "input": {
      "documents": [
        "machine learning is great",
        "deep learning uses neural networks"
      ],
      "query": "learning"
    },
    "output": {
      "ok": true
    }
  }
}