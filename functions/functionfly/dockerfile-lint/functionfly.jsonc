{
  "author": "functionfly",
  "name": "dockerfile-lint",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Lint Dockerfile",
  "description": "Lint a Dockerfile for common issues and best practice violations.",
  "category": "devops",
  "tags": ["docker", "dockerfile", "lint", "validate", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "content": { "type": "string", "description": "Dockerfile content" }
    },
    "required": ["content"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "valid": { "type": "boolean" }, "issues": { "type": "array" }, "warnings": { "type": "array" }, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 2000, "memory_mb": 64,
  "example": {
    "input": { "content": "FROM ubuntu\nRUN apt-get update\nRUN apt-get install -y curl\n" },
    "output": { "ok": true, "valid": true, "issues": [], "warnings": ["Use specific image tag instead of 'latest' or untagged", "Combine RUN commands to reduce layers"] }
  }
}
