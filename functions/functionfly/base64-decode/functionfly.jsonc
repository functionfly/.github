{
  "author": "functionfly",
  "name": "base64-decode",
  "version": "1.0.0",
  "runtime": "python3.11",
  "title": "Base64 Decode",
  "description": "Decode a Base64 string to plain text. Optional URL-safe input.",
  "category": "Data Format",
  "tags": ["base64", "decode", "encoding", "data", "format"],
  "input": {
    "type": "object",
    "properties": {
      "encoded": {
        "type": "string",
        "description": "Base64 string to decode"
      },
      "url_safe": {
        "type": "boolean",
        "description": "Input is URL-safe Base64",
        "default": false
      }
    },
    "required": ["encoded"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "text": { "type": "string", "description": "Decoded string" },
      "error": { "type": "string", "description": "Error message if ok is false" }
    }
  },
  "example": {
    "input": { "encoded": "SGVsbG8sIFdvcmxkIQ==" },
    "output": { "ok": true, "text": "Hello, World!" }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 5000,
  "memory_mb": 128
}
