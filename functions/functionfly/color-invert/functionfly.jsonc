{
  "author": "functionfly",
  "name": "color-invert",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Invert Color",
  "description": "Invert a color by subtracting each RGB component from 255.",
  "category": "color",
  "tags": ["color", "invert", "negate"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string", "description": "Hex color to invert" }
    },
    "required": ["color"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "r": { "type": "integer" },
      "g": { "type": "integer" },
      "b": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "color": "#ff5733" },
    "output": { "ok": true, "result": "#00A8CC" }
  }
}
