{
  "author": "functionfly",
  "name": "color-complement",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Complementary Color",
  "description": "Get the complementary color (180° hue rotation on the HSL color wheel).",
  "category": "color",
  "tags": ["color", "complement", "hue", "palette"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string", "description": "Hex color" }
    },
    "required": ["color"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "r": { "type": "integer" },
      "g": { "type": "integer" },
      "b": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "color": "#ff5733" },
    "output": { "ok": true, "result": "#33BAFF" }
  }
}
