{
  "author": "functionfly",
  "name": "time-ago",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Time Ago",
  "description": "Human-readable time difference.",
  "category": "datetime",
  "tags": [
    "time",
    "ago"
  ],
  "input": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string"
      },
      "base": {
        "type": "string"
      }
    },
    "required": [
      "date"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": false,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "date": "2024-01-15T12:00:00"
    },
    "output": {
      "ok": true
    }
  }
}
