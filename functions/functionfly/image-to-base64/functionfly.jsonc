{"author":"functionfly","name":"image-to-base64","version":"1.0.0","runtime":"python3.12","title":"Image to Base64","description":"Convert image bytes to Base64 string for embedding or transport. Input can be base64 or raw bytes (as base64).","category":"media","tags":["image","base64","encode","media"],"input":{"type":"object","properties":{"image":{"type":"string","description":"Image as base64 string (data URL or raw base64)"},"data_url":{"type":"boolean","description":"If true, return data URL (data:image/...;base64,...)","default":false}},"required":["image"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"encoded":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"image":"iVBORw0KGgo="},"output":{"ok":true,"encoded":"iVBORw0KGgo="}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":10000,"memory_mb":256}
