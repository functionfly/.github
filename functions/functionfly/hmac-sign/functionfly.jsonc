{
  "author": "functionfly",
  "name": "hmac-sign",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HMAC Sign",
  "description": "Generate HMAC signature for a message. Default SHA-256.",
  "category": "security",
  "tags": [
    "hmac",
    "sign",
    "signature",
    "security"
  ],
  "input": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string"
      },
      "secret": {
        "type": "string"
      },
      "algorithm": {
        "type": "string",
        "default": "sha256"
      }
    },
    "required": [
      "message",
      "secret"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "signature": {
        "type": "string"
      },
      "hex": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 5000,
  "memory_mb": 128,
  "example": {
    "input": {
      "message": "hello",
      "secret": "test",
      "key": "secret",
      "algorithm": "sha256"
    },
    "output": {
      "ok": true
    }
  }
}
