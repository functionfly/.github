{"author":"functionfly","name":"word-count","version":"1.0.0","runtime":"python3.12","title":"Word Count","description":"Count the number of words in text. Optionally count characters and lines.","category":"text-processing","tags":["word","count","text","stats"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to count words in"},"include_chars":{"type":"boolean","description":"Include character count in output","default":false},"include_lines":{"type":"boolean","description":"Include line count in output","default":false}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"words":{"type":"integer"},"characters":{"type":"integer"},"lines":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"Hello world. How are you?"},"output":{"ok":true,"words":5}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
