{
  "author": "functionfly",
  "name": "pdf-split",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "PDF Split",
  "description": "Split a PDF into separate pages. Returns array of base64 PDF strings. Requires pypdf.",
  "category": "media",
  "tags": [
    "pdf",
    "split",
    "pages",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "pdf": {
        "type": "string",
        "description": "PDF file as base64 string"
      }
    },
    "required": [
      "pdf"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "pages": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "count": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 20000,
  "memory_mb": 512,
  "example": {
    "input": {
      "pdf": ""
    },
    "output": {
      "ok": true
    }
  }
}
