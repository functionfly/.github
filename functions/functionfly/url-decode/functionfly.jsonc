{"author":"functionfly","name":"url-decode","version":"1.0.0","runtime":"python3.11","title":"URL Decode","description":"URL decode a percent-encoded string.","category":"Data Format","tags":["url","decode","percent","encoding"],"input":{"type":"object","properties":{"encoded":{"type":"string","description":"URL-encoded string to decode"},"errors":{"type":"string","description":"Decode error handling: strict, replace, ignore","default":"replace"}},"required":["encoded"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"decoded":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"encoded":"hello%20world"},"output":{"ok":true,"decoded":"hello world"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
