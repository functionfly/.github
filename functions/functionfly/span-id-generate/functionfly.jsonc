{
  "author": "functionfly",
  "name": "span-id-generate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Generate Span ID",
  "description": "Generate a distributed tracing span ID (W3C TraceContext format or custom).",
  "category": "devops",
  "tags": ["tracing", "observability", "distributed", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "format": { "type": "string", "enum": ["w3c", "b3", "hex"], "default": "w3c" }
    }
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "span_id": { "type": "string" }, "format": { "type": "string" }, "error": {} }
  },
  "deterministic": false, "idempotent": false,
  "cache_ttl": 0, "timeout_ms": 500, "memory_mb": 64,
  "example": {
    "input": { "format": "w3c" },
    "output": { "ok": true, "span_id": "00f067aa0ba902b7", "format": "w3c" }
  }
}
