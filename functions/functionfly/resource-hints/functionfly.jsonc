{
  "author": "functionfly",
  "name": "resource-hints",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Check Resource Hints",
  "description": "Check for resource hints (preload, prefetch, preconnect, dns-prefetch) in HTTP headers.",
  "category": "devops",
  "tags": ["resource-hints", "performance", "http", "web", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string" },
      "timeout": { "type": "integer", "default": 10 }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "hints": { "type": "array" }, "count": { "type": "integer" }, "error": {} }
  },
  "deterministic": false, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 15000, "memory_mb": 128,
  "example": {
    "input": { "url": "https://example.com" },
    "output": { "ok": true, "count": 2, "hints": [{ "rel": "preload", "href": "/style.css", "as": "style" }] }
  }
}
