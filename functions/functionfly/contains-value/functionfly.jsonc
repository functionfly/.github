{
  "author": "functionfly",
  "name": "contains-value",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Contains Value",
  "description": "Check whether a string, array, or object contains a specified value.",
  "category": "validation",
  "tags": ["validation", "contains", "search", "includes", "check"],
  "input": {
    "type": "object",
    "properties": {
      "value": { "description": "String, array, or object to search in" },
      "search": { "description": "Value to search for" },
      "case_sensitive": { "type": "boolean", "description": "Case-sensitive search (strings only)", "default": true }
    },
    "required": ["value", "search"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": {},
      "result": { "type": "boolean" },
      "search": {},
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": "Hello World", "search": "World" },
    "output": { "ok": true, "value": "Hello World", "result": true, "search": "World" }
  }
}
