{
  "author": "functionfly",
  "name": "is-alphanumeric",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Is Alphanumeric",
  "description": "Check whether a string contains only alphanumeric characters (letters and digits).",
  "category": "validation",
  "tags": ["validation", "alphanumeric", "string", "check"],
  "input": {
    "type": "object",
    "properties": {
      "value": { "type": "string", "description": "String to check" }
    },
    "required": ["value"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "value": { "type": "string" },
      "result": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "value": "Hello123" },
    "output": { "ok": true, "value": "Hello123", "result": true }
  }
}
