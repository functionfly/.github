{
  "author": "functionfly",
  "name": "audio-transcribe",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Audio Transcription",
  "description": "Transcribe audio to text (mock implementation for pipeline testing).",
  "category": "ai-ml",
  "tags": [
    "audio-transcribe",
    "audio",
    "speech",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "audio_url": {
        "type": "string"
      },
      "audio_base64": {
        "type": "string"
      },
      "language": {
        "type": "string",
        "default": "en"
      },
      "model": {
        "type": "string",
        "default": "base"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 3000,
  "memory_mb": 256,
  "price_per_call": 0.02,
  "example": {
    "input": {
      "audio_url": "https://example.com/speech.mp3"
    },
    "output": {
      "ok": true
    }
  }
}