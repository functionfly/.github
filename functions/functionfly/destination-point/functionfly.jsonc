{
  "author": "functionfly",
  "name": "destination-point",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Destination Point",
  "description": "Calculate the destination point given a start point, bearing, and distance using the Vincenty formula.",
  "category": "geospatial",
  "tags": [
    "destination",
    "bearing",
    "distance",
    "coordinates",
    "navigation",
    "geospatial"
  ],
  "input": {
    "type": "object",
    "properties": {
      "lat": { "type": "number", "description": "Start latitude (-90 to 90)" },
      "lng": {
        "type": "number",
        "description": "Start longitude (-180 to 180)"
      },
      "bearing": {
        "type": "number",
        "description": "Bearing in degrees (0-360)"
      },
      "distance": { "type": "number", "description": "Distance to travel" },
      "unit": {
        "type": "string",
        "description": "Unit of distance: 'km', 'miles', 'meters' (default: 'km')"
      }
    },
    "required": ["lat", "lng", "bearing", "distance"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "lat": { "type": "number", "description": "Destination latitude" },
          "lng": { "type": "number", "description": "Destination longitude" },
          "bearing": { "type": "number", "description": "Input bearing" },
          "distance": { "type": "number", "description": "Input distance" },
          "unit": { "type": "string", "description": "Unit of distance" }
        }
      },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "lat": 40.7128,
      "lng": -74.006,
      "bearing": 90,
      "distance": 100,
      "unit": "km"
    },
    "output": {
      "ok": true,
      "result": {
        "lat": 40.7128,
        "lng": -72.7498,
        "bearing": 90,
        "distance": 100,
        "unit": "km"
      }
    }
  }
}
