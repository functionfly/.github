{
  "author": "functionfly",
  "name": "unicode-unescape",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Unicode Unescape",
  "description": "Convert \\uXXXX Unicode escape sequences back to their actual Unicode characters.",
  "category": "encoding",
  "tags": ["encoding", "unicode", "unescape", "decode"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "type": "string", "description": "String with \\uXXXX escape sequences" }
    },
    "required": ["data"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "data": "h\\u00e9llo" },
    "output": { "ok": true, "result": "héllo" }
  }
}
