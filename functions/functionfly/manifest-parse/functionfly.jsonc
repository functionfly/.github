{
  "author": "functionfly",
  "name": "manifest-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse Web App Manifest",
  "description": "Parse and validate a Web App Manifest (manifest.json) for PWA compliance.",
  "category": "devops",
  "tags": ["manifest", "pwa", "web", "devops"],
  "input": {
    "type": "object",
    "properties": {
      "manifest": { "type": "object", "description": "Parsed manifest JSON object" },
      "url": { "type": "string", "description": "URL to fetch manifest from" }
    }
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "valid": { "type": "boolean" }, "name": { "type": "string" }, "icons": { "type": "array" }, "missing_fields": { "type": "array" }, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 5000, "memory_mb": 64,
  "example": {
    "input": { "manifest": { "name": "My App", "short_name": "App", "start_url": "/", "display": "standalone", "icons": [{ "src": "/icon.png", "sizes": "192x192" }] } },
    "output": { "ok": true, "valid": true, "name": "My App", "missing_fields": [] }
  }
}
