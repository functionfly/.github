{
  "author": "functionfly",
  "name": "turf-voronoi",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Turf Voronoi",
  "description": "Generate a Voronoi diagram from a set of points. Returns the Voronoi cells as polygons. Uses [lng, lat] coordinate order.",
  "category": "geospatial",
  "tags": [
    "turf",
    "voronoi",
    "diagram",
    "tessellation",
    "geospatial",
    "computational-geometry"
  ],
  "input": {
    "type": "object",
    "properties": {
      "points": {
        "type": "array",
        "description": "Array of points as [lng, lat]",
        "items": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "bbox": {
        "type": "array",
        "description": "Bounding box [minLng, minLat, maxLng, maxLat] for clipping (optional)",
        "items": { "type": "number" },
        "minItems": 4,
        "maxItems": 4
      }
    },
    "required": ["points"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "description": "Array of Voronoi cell polygons, each as array of [lng, lat] pairs",
            "items": { "type": "array" }
          },
          "point_count": { "type": "integer" }
        }
      },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "points": [
        [0, 0],
        [10, 0],
        [5, 8]
      ],
      "bbox": [-5, -5, 15, 15]
    },
    "output": {
      "ok": true,
      "result": {
        "cells": [
          [
            [-5, -5],
            [5, -5],
            [5, 4],
            [2.5, 4],
            [-5, 1.5],
            [-5, -5]
          ],
          [
            [5, -5],
            [15, -5],
            [15, 1.5],
            [7.5, 4],
            [5, 4],
            [5, -5]
          ],
          [
            [2.5, 4],
            [5, 4],
            [7.5, 4],
            [5, 15],
            [-5, 15],
            [-5, 1.5],
            [2.5, 4]
          ]
        ],
        "point_count": 3
      }
    }
  }
}
