{
  "author": "functionfly",
  "name": "gzip-decompress",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "GZIP Decompress",
  "description": "Decompress a Base64-encoded GZIP payload back to its original content.",
  "category": "encoding",
  "tags": ["compression", "gzip", "decode", "decompress"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "type": "string", "description": "Base64-encoded GZIP data" },
      "encoding": { "type": "string", "description": "Text encoding for output", "default": "utf-8" }
    },
    "required": ["data"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "is_text": { "type": "boolean" },
      "decompressed_size": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 2000,
  "memory_mb": 128,
  "example": {
    "input": { "data": "H4sIAAAAAAAAA0rNS8svyklRBAQAAP//..." },
    "output": { "ok": true, "result": "Hello, World!", "is_text": true, "decompressed_size": 13 }
  }
}
