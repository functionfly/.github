{"author":"functionfly","name":"singularize","version":"1.0.0","runtime":"python3.12","title":"Singularize","description":"Singularize English nouns (simple rules: remove -s, -es, -ies, -ves).","category":"text-processing","tags":["singularize","noun","english","grammar"],"input":{"type":"object","properties":{"word":{"type":"string","description":"Plural noun to singularize"}},"required":["word"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"word":"apples"},"output":{"ok":true,"result":"apple"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
