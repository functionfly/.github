{
  "author": "functionfly",
  "name": "color-desaturate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Desaturate Color",
  "description": "Decrease the HSL saturation of a color by a given amount (towards grey).",
  "category": "color",
  "tags": ["color", "desaturate", "saturation", "hsl", "grey"],
  "input": {
    "type": "object",
    "properties": {
      "color": { "type": "string" },
      "amount": { "type": "number", "default": 20 }
    },
    "required": ["color"]
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": {}, "original_saturation": {}, "new_saturation": {}, "error": {} }
  },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 86400, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "color": "#ff5733", "amount": 50 }, "output": { "ok": true } }
}
