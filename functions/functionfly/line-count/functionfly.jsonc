{"author":"functionfly","name":"line-count","version":"1.0.0","runtime":"python3.12","title":"Line Count","description":"Count the number of lines in text. Optionally exclude empty lines.","category":"text-processing","tags":["line","count","text","newline"],"input":{"type":"object","properties":{"text":{"type":"string","description":"Text to count lines in"},"exclude_empty":{"type":"boolean","description":"Exclude empty lines from count","default":false}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"lines":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"text":"line1\nline2\nline3"},"output":{"ok":true,"lines":3}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
