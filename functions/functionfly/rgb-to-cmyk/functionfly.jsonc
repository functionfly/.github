{
  "author": "functionfly",
  "name": "rgb-to-cmyk",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "RGB to CMYK",
  "description": "Convert RGB color (0-255 each) to CMYK print color model (0-100% each).",
  "category": "color",
  "tags": ["color", "rgb", "cmyk", "convert", "print"],
  "input": {
    "type": "object",
    "properties": {
      "r": { "type": "integer" },
      "g": { "type": "integer" },
      "b": { "type": "integer" }
    },
    "required": ["r", "g", "b"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "object", "properties": { "c": {}, "m": {}, "y": {}, "k": {} } },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "r": 255, "g": 87, "b": 51 },
    "output": { "ok": true, "result": { "c": 0.0, "m": 65.88, "y": 80.0, "k": 0.0 } }
  }
}
