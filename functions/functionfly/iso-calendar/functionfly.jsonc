{
  "author": "functionfly",
  "name": "iso-calendar",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "ISO Calendar",
  "description": "Get ISO calendar date.",
  "category": "datetime",
  "tags": ["iso", "calendar"],
  "input": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "year": {
        "type": "integer"
      },
      "week": {
        "type": "integer"
      },
      "weekday": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "date": "2024-01-15"
    },
    "output": {
      "ok": true,
      "year": 2024,
      "week": 3,
      "weekday": 1
    }
  }
}
