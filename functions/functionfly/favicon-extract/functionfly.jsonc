{
  "author": "functionfly",
  "name": "favicon-extract",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Favicon Extract",
  "description": "Extract favicon URL from domain or page.",
  "category": "media",
  "tags": [
    "favicon",
    "icon",
    "domain",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string"
      },
      "domain": {
        "type": "string"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "favicon_url": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": false,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 10000,
  "memory_mb": 128,
  "example": {
    "input": {
      "url": "https://example.com"
    },
    "output": {
      "ok": true
    }
  }
}
