{
  "author": "functionfly",
  "name": "webpage-screenshot",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Webpage Screenshot",
  "description": "Take screenshot of webpage. Requires Playwright.",
  "category": "media",
  "tags": [
    "webpage",
    "screenshot",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string"
      },
      "width": {
        "type": "integer"
      },
      "height": {
        "type": "integer"
      }
    },
    "required": [
      "url"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "image_base64": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 3600,
  "timeout_ms": 30000,
  "memory_mb": 512,
  "example": {
    "input": {
      "url": "https://example.com"
    },
    "output": {
      "ok": true
    }
  }
}
