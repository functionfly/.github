{
  "author": "functionfly",
  "name": "instagram-embed",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Generate Instagram Embed",
  "description": "Generate an Instagram post/reel embedded player iframe from an Instagram URL.",
  "category": "social",
  "tags": ["instagram", "embed", "post", "social"],
  "input": { "type": "object", "properties": { "url": { "type": "string", "description": "Instagram post URL" }, "width": { "type": "integer", "default": 400 } }, "required": ["url"] },
  "output": { "type": "object", "properties": { "ok": {}, "embed_html": {}, "embed_url": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "url": "https://www.instagram.com/p/ABC123xyz/" }, "output": { "ok": true } }
}
