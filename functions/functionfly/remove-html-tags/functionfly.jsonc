{"author":"functionfly","name":"remove-html-tags","version":"1.0.0","runtime":"python3.12","title":"Remove HTML Tags","description":"Strip all HTML tags from text, leaving plain text. Optionally normalize whitespace.","category":"text-processing","tags":["html","strip","tags","text","sanitize"],"input":{"type":"object","properties":{"text":{"type":"string","description":"HTML or text to strip tags from"},"normalize_whitespace":{"type":"boolean","description":"Collapse runs of whitespace to single space","default":true}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"text":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"<p>Hello <b>world</b></p>"},"output":{"ok":true,"text":"Hello world"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
