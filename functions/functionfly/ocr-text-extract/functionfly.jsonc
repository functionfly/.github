{
  "author": "functionfly",
  "name": "ocr-text-extract",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "OCR Text Extraction",
  "description": "Extract text from images using optical character recognition (mock implementation).",
  "category": "ai-ml",
  "tags": [
    "ocr-text-extract",
    "vision",
    "image",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "image_url": {
        "type": "string"
      },
      "image_base64": {
        "type": "string"
      },
      "language": {
        "type": "string",
        "default": "en"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "image_url": "https://example.com/document.jpg"
    },
    "output": {
      "ok": true
    }
  }
}