{"author":"functionfly","name":"escape-html","version":"1.0.0","runtime":"python3.12","title":"Escape HTML","description":"Escape HTML special characters (&, <, >, \") to prevent XSS.","category":"text-processing","tags":["html","escape","xss","sanitize","security"],"input":{"type":"object","properties":{"text":{"type":"string","description":"String to escape for HTML"}},"required":["text"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"result":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"text":"<script>alert(1)</script>"},"output":{"ok":true,"result":"&lt;script&gt;alert(1)&lt;/script&gt;"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
