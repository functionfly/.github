{
  "author": "functionfly",
  "name": "oembed-parse",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Parse oEmbed Response",
  "description": "Parse an oEmbed JSON response (from YouTube, Vimeo, Twitter, etc.) and extract structured embed metadata.",
  "category": "social",
  "tags": ["oembed", "embed", "video", "social", "metadata"],
  "input": { "type": "object", "properties": { "data": { "description": "oEmbed JSON object or string" } }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "oembed": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "data": { "type": "video", "title": "My Video", "provider_name": "YouTube" } }, "output": { "ok": true } }
}
