{
  "author": "functionfly",
  "name": "pdf-extract-text",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "PDF Extract Text",
  "description": "Extract text content from a PDF. Optional page range. Requires pypdf.",
  "category": "media",
  "tags": [
    "pdf",
    "text",
    "extract",
    "media"
  ],
  "input": {
    "type": "object",
    "properties": {
      "pdf": {
        "type": "string"
      },
      "page_start": {
        "type": "integer"
      },
      "page_end": {
        "type": "integer"
      }
    },
    "required": [
      "pdf"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "text": {
        "type": "string"
      },
      "pages": {
        "type": "integer"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 15000,
  "memory_mb": 256,
  "price_per_call": 0.01,
  "example": {
    "input": {
      "pdf": ""
    },
    "output": {
      "ok": true
    }
  }
}
