{
  "author": "functionfly",
  "name": "http-status-category",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HTTP Status Category",
  "description": "Classify an HTTP status code into its category: informational, success, redirection, client_error, or server_error.",
  "category": "http",
  "tags": ["http", "status", "category", "classify", "code"],
  "input": {
    "type": "object",
    "properties": {
      "status_code": { "type": "integer", "description": "HTTP status code", "minimum": 100, "maximum": 599 }
    },
    "required": ["status_code"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "status_code": { "type": "integer" },
      "category": { "type": "string" },
      "description": { "type": "string" },
      "is_informational": { "type": "boolean" },
      "is_success": { "type": "boolean" },
      "is_redirection": { "type": "boolean" },
      "is_client_error": { "type": "boolean" },
      "is_server_error": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "status_code": 404 },
    "output": {
      "ok": true, "status_code": 404, "category": "client_error",
      "description": "Request contains bad syntax or cannot be fulfilled",
      "is_informational": false, "is_success": false, "is_redirection": false,
      "is_client_error": true, "is_server_error": false
    }
  }
}
