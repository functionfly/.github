{"author":"functionfly","name":"base64-to-image","version":"1.0.0","runtime":"python3.12","title":"Base64 to Image","description":"Decode Base64 string to image data. Returns image as base64 for embedding (e.g. img src).","category":"media","tags":["image","base64","decode","media"],"input":{"type":"object","properties":{"data":{"type":"string","description":"Base64-encoded image (optionally with data:image/...;base64, prefix)"}},"required":["data"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"image_base64":{"type":"string"},"bytes_count":{"type":"integer"},"error":{"type":"string"}}},"example":{"input":{"data":"iVBORw0KGgo="},"output":{"ok":true,"image_base64":"iVBORw0KGgo=","bytes_count":8}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":10000,"memory_mb":256}
