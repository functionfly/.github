{
  "author": "functionfly",
  "name": "nper-calculate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Number of Periods Calculate",
  "description": "Calculate the number of periods required to pay off a loan or reach a savings goal.",
  "category": "finance",
  "tags": [
    "nper",
    "periods",
    "loan",
    "savings"
  ],
  "input": {
    "type": "object",
    "properties": {
      "rate": {
        "type": "number",
        "description": "Interest rate per period (decimal)"
      },
      "payment": {
        "type": "number",
        "description": "Periodic payment amount"
      },
      "present_value": {
        "type": "number",
        "description": "Present value"
      },
      "future_value": {
        "type": "number",
        "description": "Future value (default 0)",
        "default": 0
      }
    },
    "required": [
      "rate",
      "payment",
      "present_value"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {},
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "rate": 0.005,
      "payment": -1199.1,
      "present_value": 200000
    },
    "output": {
      "ok": true,
      "result": 360.0
    }
  }
}