{
  "author": "functionfly",
  "name": "flatbuffers-encode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "FlatBuffers Encode",
  "description": "Encode data using FlatBuffers. Full support requires schema-generated code. Returns JSON fallback otherwise.",
  "category": "format",
  "tags": ["flatbuffers", "google", "encode", "binary", "performance"],
  "input": { "type": "object", "properties": { "data": {} }, "required": ["data"] },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "note": {}, "format": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 1000, "memory_mb": 64,
  "example": { "input": { "data": { "id": 1 } }, "output": { "ok": true } }
}
