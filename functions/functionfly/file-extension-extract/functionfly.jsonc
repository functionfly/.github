{"author":"functionfly","name":"file-extension-extract","version":"1.0.0","runtime":"python3.11","title":"File Extension Extract","description":"Extract file extension from a filename or path. Optionally include or exclude the leading dot.","category":"File Processing","tags":["file","extension","path","filename"],"input":{"type":"object","properties":{"filename":{"type":"string","description":"Filename or path"},"include_dot":{"type":"boolean","description":"Include leading dot in extension","default":true}},"required":["filename"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"extension":{"type":"string"},"basename":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"filename":"/path/to/image.png"},"output":{"ok":true,"extension":".png","basename":"image.png"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
