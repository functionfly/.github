{
  "author": "functionfly",
  "name": "facebook-embed",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Generate Facebook Embed",
  "description": "Generate a Facebook post or video embedded iframe from a Facebook URL.",
  "category": "social",
  "tags": ["facebook", "embed", "post", "video", "social"],
  "input": { "type": "object", "properties": { "url": { "type": "string" }, "type": { "type": "string", "enum": ["post", "video"], "default": "post" }, "width": { "type": "integer", "default": 500 }, "show_text": { "type": "boolean", "default": true } }, "required": ["url"] },
  "output": { "type": "object", "properties": { "ok": {}, "embed_html": {}, "embed_url": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "url": "https://www.facebook.com/photo/?fbid=12345" }, "output": { "ok": true } }
}
