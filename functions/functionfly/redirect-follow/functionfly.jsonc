{
  "author": "functionfly",
  "name": "redirect-follow",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Follow HTTP Redirects",
  "description": "Follow HTTP redirects manually with full control and tracking.",
  "category": "http",
  "tags": ["http", "redirect", "follow", "chain", "301", "302"],
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "Initial URL to request" },
      "method": { "type": "string", "description": "HTTP method", "default": "GET", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
      "headers": { "type": "object", "description": "HTTP headers to send", "default": {} },
      "data": { "description": "Request body data (for POST/PUT/PATCH)" },
      "max_redirects": { "type": "integer", "description": "Maximum number of redirects to follow", "default": 5, "minimum": 0, "maximum": 20 },
      "timeout": { "type": "integer", "description": "Request timeout in seconds", "default": 30, "minimum": 1 }
    },
    "required": ["url"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "description": "Final response content" },
      "final_response": {
        "type": "object",
        "properties": {
          "status_code": { "type": "integer" },
          "headers": { "type": "object" },
          "url": { "type": "string", "description": "Final URL after all redirects" },
          "redirect_count": { "type": "integer", "description": "Number of redirects followed" }
        }
      },
      "redirect_chain": { "type": "array", "description": "Array of all URLs visited during redirects" },
      "total_redirects": { "type": "integer", "description": "Total number of redirects followed" },
      "error": { "type": "string" }
    }
  },
  "deterministic": false,
  "idempotent": false,
  "cache_ttl": 0,
  "timeout_ms": 40000,
  "memory_mb": 128,
  "example": {
    "input": {
      "url": "https://httpbin.org/redirect/2",
      "method": "GET",
      "max_redirects": 3
    },
    "output": {
      "ok": true,
      "result": { "url": "https://httpbin.org/get" },
      "final_response": {
        "status_code": 200,
        "headers": { "content-type": "application/json" },
        "url": "https://httpbin.org/get",
        "redirect_count": 2
      },
      "redirect_chain": [
        { "url": "https://httpbin.org/redirect/2", "method": "GET", "redirect_count": 0 },
        { "url": "https://httpbin.org/redirect/1", "method": "GET", "redirect_count": 1 },
        { "url": "https://httpbin.org/get", "method": "GET", "redirect_count": 2 }
      ],
      "total_redirects": 2
    }
  }
}