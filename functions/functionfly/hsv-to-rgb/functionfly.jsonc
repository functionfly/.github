{
  "author": "functionfly",
  "name": "hsv-to-rgb",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "HSV to RGB",
  "description": "Convert HSV/HSB (hue 0-360, saturation 0-100, value 0-100) to RGB components.",
  "category": "color",
  "tags": ["color", "hsv", "hsb", "rgb", "convert"],
  "input": {
    "type": "object",
    "properties": {
      "h": { "type": "number", "description": "Hue (0-360)" },
      "s": { "type": "number", "description": "Saturation (0-100)" },
      "v": { "type": "number", "description": "Value (0-100)" }
    },
    "required": ["h", "s", "v"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "object" },
      "hex": { "type": "string" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 100,
  "memory_mb": 64,
  "example": {
    "input": { "h": 14.11, "s": 80, "v": 100 },
    "output": { "ok": true, "result": { "r": 255, "g": 87, "b": 51 } }
  }
}
