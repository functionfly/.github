{
  "author": "functionfly",
  "name": "data-normalize",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Data Normalization",
  "description": "Normalize data to [0,1] range using min-max scaling.",
  "category": "ai-ml",
  "tags": [
    "data-normalize",
    "ml",
    "data",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "data": {
        "type": "array"
      },
      "feature_range": {
        "type": "array",
        "default": [
          0,
          1
        ]
      }
    },
    "required": [
      "data"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "data": [
        1,
        5,
        10,
        3,
        7
      ]
    },
    "output": {
      "ok": true
    }
  }
}