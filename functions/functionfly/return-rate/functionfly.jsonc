{
  "author": "functionfly",
  "name": "return-rate",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Calculate Return Rate",
  "description": "Calculate product/order return rate as a percentage with industry benchmarks and top return reasons.",
  "category": "ecommerce",
  "tags": ["returns", "rate", "analytics", "ecommerce"],
  "input": {
    "type": "object",
    "properties": {
      "returns": { "type": "integer" },
      "total_orders": { "type": "integer" },
      "period": { "type": "string", "default": "monthly" },
      "return_reasons": { "type": "array" }
    },
    "required": ["returns", "total_orders"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "return_rate_pct": {}, "industry_benchmarks": {}, "top_reasons": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 100, "memory_mb": 64,
  "example": { "input": { "returns": 15, "total_orders": 200 }, "output": { "ok": true, "return_rate_pct": 7.5 } }
}
