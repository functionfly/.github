{
  "author": "functionfly",
  "name": "elevation-query",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Elevation Query",
  "description": "Get the elevation (altitude above sea level) at given coordinates. Returns simulated elevation data.",
  "category": "geospatial",
  "tags": ["elevation", "altitude", "terrain", "dem", "geospatial", "mock"],
  "input": {
    "type": "object",
    "properties": {
      "lat": { "type": "number", "description": "Latitude (-90 to 90)" },
      "lng": { "type": "number", "description": "Longitude (-180 to 180)" }
    },
    "required": ["lat", "lng"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "elevation_m": {
            "type": "number",
            "description": "Elevation in meters above sea level"
          },
          "elevation_ft": {
            "type": "number",
            "description": "Elevation in feet above sea level"
          },
          "resolution_m": {
            "type": "number",
            "description": "Data resolution in meters"
          },
          "note": { "type": "string" }
        }
      },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 86400,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "lat": 40.7128,
      "lng": -74.006
    },
    "output": {
      "ok": true,
      "result": {
        "lat": 40.7128,
        "lng": -74.006,
        "elevation_m": 10.0,
        "elevation_ft": 32.8,
        "resolution_m": 30,
        "note": "Simulated elevation data"
      }
    }
  }
}
