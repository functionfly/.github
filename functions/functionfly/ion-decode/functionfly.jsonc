{
  "author": "functionfly",
  "name": "ion-decode",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Amazon Ion Decode",
  "description": "Decode Amazon Ion text or binary data. Requires amazon.ion library.",
  "category": "format",
  "tags": ["ion", "amazon", "decode", "format", "aws"],
  "input": {
    "type": "object",
    "properties": {
      "data": { "type": "string" },
      "binary": { "type": "boolean", "default": false }
    },
    "required": ["data"]
  },
  "output": { "type": "object", "properties": { "ok": {}, "result": {}, "note": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 1000, "memory_mb": 64,
  "example": { "input": { "data": "{name: \"Alice\"}" }, "output": { "ok": true } }
}
