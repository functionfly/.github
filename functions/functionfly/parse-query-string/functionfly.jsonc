{"author":"functionfly","name":"parse-query-string","version":"1.0.0","runtime":"python3.12","title":"Parse Query String","description":"Parse URL query string into an object. Handles multiple values as arrays.","category":"text-processing","tags":["query","url","parse","params"],"input":{"type":"object","properties":{"query":{"type":"string","description":"Query string (with or without leading ?)"}},"required":["query"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"params":{"type":"object"},"error":{"type":"string"}}},"example":{"input":{"query":"a=1&b=2&a=3"},"output":{"ok":true,"params":{"a":["1","3"],"b":"2"}}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
