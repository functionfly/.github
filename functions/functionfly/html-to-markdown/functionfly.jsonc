{"author":"functionfly","name":"html-to-markdown","version":"1.0.0","runtime":"python3.11","title":"HTML to Markdown","description":"Convert HTML to Markdown. Basic conversion for common elements (headers, links, bold, italic, lists).","category":"Utility","tags":["html","markdown","convert","data","format"],"input":{"type":"object","properties":{"html":{"type":"string","description":"HTML string to convert"}},"required":["html"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"markdown":{"type":"string","description":"Converted Markdown"},"error":{"type":"string"}}},"example":{"input":{"html":"<h1>Hello</h1><p>World</p>"},"output":{"ok":true,"markdown":"# Hello\n\nWorld"}},"deterministic":true,"idempotent":true,"cache_ttl":3600,"timeout_ms":5000,"memory_mb":128}
