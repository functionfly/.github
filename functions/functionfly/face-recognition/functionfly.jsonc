{
  "author": "functionfly",
  "name": "face-recognition",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Face Recognition",
  "description": "Recognize and identify faces in an image (mock implementation for pipeline testing).",
  "category": "ai-ml",
  "tags": [
    "face-recognition",
    "vision",
    "image",
    "ai"
  ],
  "input": {
    "type": "object",
    "properties": {
      "image_url": {
        "type": "string"
      },
      "image_base64": {
        "type": "string"
      },
      "known_faces": {
        "type": "array"
      }
    },
    "required": []
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {},
      "result": {},
      "error": {}
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 2000,
  "memory_mb": 256,
  "example": {
    "input": {
      "image_url": "https://example.com/person.jpg"
    },
    "output": {
      "ok": true
    }
  }
}