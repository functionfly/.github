{
  "author": "functionfly",
  "name": "derive-key-scrypt",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Derive Key (scrypt)",
  "description": "Derive a cryptographic key from a password using scrypt (memory-hard KDF).",
  "category": "crypto",
  "tags": ["crypto", "scrypt", "kdf", "key-derivation", "password", "memory-hard"],
  "input": {
    "type": "object",
    "properties": {
      "password": { "type": "string", "description": "Input password" },
      "salt": { "type": "string", "description": "Salt (hex or Base64)" },
      "n": { "type": "integer", "description": "CPU/memory cost (power of 2)", "default": 16384 },
      "r": { "type": "integer", "description": "Block size", "default": 8 },
      "p": { "type": "integer", "description": "Parallelization factor", "default": 1 },
      "length": { "type": "integer", "description": "Output key length in bytes", "default": 32 },
      "output": { "type": "string", "description": "'hex' or 'base64'", "default": "hex", "enum": ["hex", "base64"] }
    },
    "required": ["password", "salt"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "n": { "type": "integer" },
      "r": { "type": "integer" },
      "p": { "type": "integer" },
      "length": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 10000,
  "memory_mb": 256,
  "price_per_call": 0.008,
  "example": {
    "input": { "password": "mypassword", "salt": "aabbcc..." },
    "output": { "ok": true }
  }
}
