{"author":"functionfly","name":"url-metadata-extract","version":"1.0.0","runtime":"python3.11","title":"URL Metadata Extract","description":"Extract Open Graph and Twitter card metadata from a URL. Fetches the page and parses og:* and twitter:* meta tags.","category":"Web Scraping","tags":["url","metadata","opengraph","twitter","card","seo"],"input":{"type":"object","properties":{"url":{"type":"string","description":"URL to fetch and extract metadata from"}},"required":["url"]},"output":{"type":"object","properties":{"ok":{"type":"boolean"},"metadata":{"type":"object","description":"Extracted meta keys (og_title, og_description, etc.)"},"url":{"type":"string"},"error":{"type":"string"}}},"example":{"input":{"url":"https://example.com"},"output":{"ok":true,"metadata":{},"url":"https://example.com"}},"deterministic":false,"idempotent":false,"cache_ttl":300,"timeout_ms":10000,"memory_mb":128}
