{
  "author": "functionfly",
  "name": "timezone-offset",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Timezone Offset",
  "description": "Get timezone offset from UTC.",
  "category": "datetime",
  "tags": [
    "timezone",
    "offset"
  ],
  "input": {
    "type": "object",
    "properties": {
      "timezone": {
        "type": "string"
      },
      "date": {
        "type": "string"
      }
    },
    "required": [
      "timezone"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "offset_seconds": {
        "type": "integer"
      },
      "offset_hours": {
        "type": "number"
      },
      "error": {
        "type": "string"
      }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": {
      "timezone": "America/New_York"
    },
    "output": {
      "ok": true
    }
  }
}
