{
  "author": "functionfly",
  "name": "encoding-detect",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Text Encoding Detection",
  "description": "Detect the character encoding of text content using statistical analysis.",
  "category": "http",
  "tags": ["encoding", "charset", "text", "detection", "unicode"],
  "input": {
    "type": "object",
    "properties": {
      "content": { "description": "Content to analyze (string or bytes)" },
      "confidence_threshold": { "type": "number", "description": "Minimum confidence level (0-1)", "default": 0.7, "minimum": 0, "maximum": 1 }
    },
    "required": ["content"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": {
        "type": "object",
        "properties": {
          "encoding": { "type": "string", "description": "Detected encoding" },
          "confidence": { "type": "number", "description": "Detection confidence (0-1)" },
          "language": { "type": "string", "description": "Detected language" },
          "is_confident": { "type": "boolean", "description": "Whether confidence meets threshold" },
          "is_valid_utf8": { "type": "boolean", "description": "Whether content is valid UTF-8" },
          "is_valid_latin1": { "type": "boolean", "description": "Whether content is valid Latin-1" },
          "bytes_length": { "type": "integer", "description": "Content length in bytes" },
          "content_type": { "type": "string", "description": "Input content type" },
          "suggestions": { "type": "array", "items": {
            "type": "object",
            "properties": {
              "encoding": { "type": "string" },
              "reason": { "type": "string" }
            }
          }, "description": "Alternative encoding suggestions" }
        }
      },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 1000,
  "memory_mb": 128,
  "example": {
    "input": {
      "content": "Hello, wörld! Café müßte schön sein.",
      "confidence_threshold": 0.8
    },
    "output": {
      "ok": true,
      "result": {
        "encoding": "utf-8",
        "confidence": 0.99,
        "language": "",
        "is_confident": true,
        "is_valid_utf8": true,
        "is_valid_latin1": true,
        "bytes_length": 34,
        "content_type": "string",
        "suggestions": []
      }
    }
  }
}