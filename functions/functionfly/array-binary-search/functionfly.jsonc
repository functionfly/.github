{
  "author": "functionfly",
  "name": "array-binary-search",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Array Binary Search",
  "description": "Binary search in sorted array; returns index or -1.",
  "category": "arrays",
  "tags": ["array", "binary", "search", "sorted"],
  "input": {
    "type": "object",
    "properties": {
      "items": { "type": "array", "description": "Sorted array" },
      "value": { "description": "Value to find" }
    },
    "required": ["items", "value"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "index": { "type": "integer" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 128,
  "example": {
    "input": { "items": [1, 3, 5, 7, 9], "value": 5 },
    "output": { "ok": true, "index": 2 }
  }
}
