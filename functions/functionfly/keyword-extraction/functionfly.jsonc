{
  "author": "functionfly",
  "name": "keyword-extraction",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Keyword Extraction",
  "description": "Extract the most important keywords from text using TF-IDF scoring and n-gram analysis.",
  "category": "ai-ml",
  "tags": ["keywords", "nlp", "tfidf", "extraction", "ai"],
  "input": {
    "type": "object",
    "properties": {
      "text": { "type": "string" },
      "top_n": { "type": "integer", "default": 10 },
      "ngram_max": { "type": "integer", "default": 2 },
    },
    "required": ["text"],
  },
  "output": {
    "type": "object",
    "properties": { "ok": {}, "result": {}, "keywords": {}, "error": {} },
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 500,
  "memory_mb": 64,
  "example": {
    "input": {
      "text": "Machine learning algorithms process large datasets to find patterns.",
      "top_n": 5,
    },
    "output": { "ok": true },
  },
}
