{
  "author": "functionfly",
  "name": "base64-encode",
  "version": "1.0.0",
  "runtime": "python3.11",
  "title": "Base64 Encode",
  "description": "Encode a string to Base64. Optional URL-safe encoding.",
  "category": "Data Format",
  "tags": ["base64", "encode", "encoding", "data", "format"],
  "input": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "String to encode to Base64"
      },
      "url_safe": {
        "type": "boolean",
        "description": "Use URL-safe alphabet (no +/)",
        "default": false
      }
    },
    "required": ["text"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "encoded": { "type": "string", "description": "Base64-encoded string" },
      "error": { "type": "string", "description": "Error message if ok is false" }
    }
  },
  "example": {
    "input": { "text": "Hello, World!" },
    "output": { "ok": true, "encoded": "SGVsbG8sIFdvcmxkIQ==" }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 3600,
  "timeout_ms": 5000,
  "memory_mb": 128
}
