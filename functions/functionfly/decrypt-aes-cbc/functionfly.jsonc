{
  "author": "functionfly",
  "name": "decrypt-aes-cbc",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "AES-CBC Decrypt",
  "description": "Decrypt AES-CBC encrypted data (Base64 ciphertext) using the provided key and IV.",
  "category": "crypto",
  "tags": ["crypto", "aes", "cbc", "decrypt", "symmetric"],
  "input": {
    "type": "object",
    "properties": {
      "ciphertext": { "type": "string", "description": "Base64-encoded ciphertext" },
      "key": { "type": "string", "description": "AES key (hex or Base64)" },
      "iv": { "type": "string", "description": "IV (hex or Base64, 16 bytes)" },
      "encoding": { "type": "string", "description": "Text encoding for output", "default": "utf-8" }
    },
    "required": ["ciphertext", "key", "iv"]
  },
  "output": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "result": { "type": "string" },
      "is_text": { "type": "boolean" },
      "error": { "type": "string" }
    }
  },
  "deterministic": true,
  "idempotent": true,
  "cache_ttl": 0,
  "timeout_ms": 500,
  "memory_mb": 64,
  "example": {
    "input": { "ciphertext": "...", "key": "0123456789abcdef0123456789abcdef", "iv": "..." },
    "output": { "ok": true, "result": "Hello Secret World", "is_text": true }
  }
}
