{
  "author": "functionfly",
  "name": "emoji-extract",
  "version": "1.0.0",
  "runtime": "python3.12",
  "title": "Extract Emojis",
  "description": "Extract all Unicode emoji characters from a text string with frequency counts.",
  "category": "social",
  "tags": ["emoji", "extract", "unicode", "text", "social"],
  "input": { "type": "object", "properties": { "text": { "type": "string" } }, "required": ["text"] },
  "output": { "type": "object", "properties": { "ok": {}, "emojis": {}, "unique": {}, "counts": {}, "has_emojis": {}, "error": {} } },
  "deterministic": true, "idempotent": true,
  "cache_ttl": 3600, "timeout_ms": 200, "memory_mb": 64,
  "example": { "input": { "text": "Hello 👋 World 🌍! Great day 😊" }, "output": { "ok": true, "count": 3 } }
}
