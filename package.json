{
  "name": "@functionfly/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FunctionFly - Serverless Function Platform",
  "workspaces": [
    "web/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev -p dashboard,functionfly-marketing,docs --parallel=3",
    "dev:all": "nx run-many -t dev --all --parallel=4",
    "dev:admin": "nx run admin-dashboard -t dev",
    "dev:blog": "nx run blog-api -t dev",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "graph": "nx graph",
    "clean-install": "bun pm cache rm && rm -rf node_modules bun.lockb && mv .env .env.tmp 2>/dev/null; mv .env.production .env.production.tmp 2>/dev/null; bun install && mv .env.tmp .env 2>/dev/null; mv .env.production.tmp .env.production 2>/dev/null; true"
  },
  "devDependencies": {
    "nx": "^22.5.4",
    "@nx/js": "^22.5.4",
    "@nx/vite": "^22.5.4",
    "@nx/eslint": "^22.5.4",
    "@nx/jest": "^22.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "astro": "^6.0.5",
    "devalue": "^5.6.4",
    "dompurify": "^3.3.3",
    "esbuild": "^0.25.0",
    "fastify": "^5.8.4",
    "file-type": "^21.3.3",
    "flatted": "^3.4.2",
    "jspdf": "^4.2.1",
    "minimatch": "^9.0.7",
    "next": "^16.1.7",
    "undici": "^7.24.0",
    "vercel": "^50.38.2"
  },
  "overrides": {
    "dompurify": "^3.3.3",
    "esbuild": "^0.25.0",
    "flatted": "^3.4.2",
    "h3": "^1.15.9",
    "kysely": "0.28.14",
    "minimatch": "^9.0.7",
    "path-to-regexp": "8.4.0",
    "picomatch": "^2.3.2",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.3",
    "brace-expansion": "^5.0.5",
    "fastify": "^5.8.4"
  }
}
