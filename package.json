{
  "name": "@functionfly/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FunctionFly™ - Serverless Function Platform",
  "workspaces": [
    "web/*",
    "!web/shared",
    "packages/*",
    "!packages/shared"
  ],
  "scripts": {
<<<<<<< HEAD
    "dev": "bun run --cwd web/dashboard dev & bun run --cwd web/site dev & bun run --cwd web/docs dev & bun run --cwd web/auth dev & bun run --cwd web/blog dev & bun run --cwd web/status dev & wait",
    "dev:clean": "lsof -ti :4321 -ti :4322 -ti :4323 -ti :4324 -ti :4325 -ti :4326 -ti :4327 -ti :3000 -ti :3001 -ti :3002 2>/dev/null | xargs kill -9 2>/dev/null; echo 'Ports cleared'; bun run dev:site",
    "dev:site": "bun run --cwd web/site dev",
    "dev:dashboard": "bun run --cwd web/dashboard dev",
    "dev:docs": "bun run --cwd web/docs dev",
    "dev:blog": "bun run --cwd web/blog dev",
    "dev:admin": "bun run --cwd web/admin-dashboard dev",
    "dev:auth": "bun run --cwd web/auth dev",
    "dev:all": "lsof -ti :4321 -ti :4322 -ti :4323 -ti :4324 -ti :4325 -ti :4326 -ti :4327 -ti :3000 -ti :3001 -ti :3002 2>/dev/null | xargs kill -9 2>/dev/null; echo 'Starting all dev servers...'; bun run --cwd web/site dev & bun run --cwd web/dashboard dev & bun run --cwd web/docs dev & wait",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "graph": "nx graph",
    "clean-install": "bun pm cache rm && rm -rf node_modules bun.lock && mv .env .env.tmp 2>/dev/null; mv .env.production .env.production.tmp 2>/dev/null; bun install && mv .env.tmp .env 2>/dev/null; mv .env.production.tmp .env.production 2>/dev/null; true",
    "i18n:check": "bun scripts/sync-translations.ts --check",
    "i18n:sync": "bun scripts/sync-translations.ts",
    "i18n:write": "bun scripts/sync-translations.ts --write",
    "i18n:ollama": "bun scripts/sync-translations.ts --write --backend=ollama"
  },
