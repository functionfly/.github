{
  "name": "@functionfly/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FunctionFly - Serverless Function Platform",
  "workspaces": [
    "web/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --all --parallel=4",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "graph": "nx graph",
    "clean-install": "bun pm cache rm && rm -rf node_modules bun.lockb && mv .env .env.tmp 2>/dev/null; mv .env.production .env.production.tmp 2>/dev/null; bun install && mv .env.tmp .env 2>/dev/null; mv .env.production.tmp .env.production 2>/dev/null; true"
  },
  "devDependencies": {
    "nx": "^22.5.4",
    "@nx/js": "^22.5.4",
    "@nx/vite": "^22.5.4",
    "@nx/eslint": "^22.5.4",
    "@nx/jest": "^22.5.4"
  },
  "overrides": {
    "minimatch": "9.0.7",
    "undici": "7.24.0",
    "flatted": "3.4.0",
    "esbuild": "0.25.0",
    "next": "16.1.7",
    "file-type": "21.3.3",
    "fastify": "5.8.2",
    "ajv": "8.18.0",
    "devalue": "5.6.4",
    "dompurify": "3.3.3",
    "jspdf": "4.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "astro": "^6.0.5",
    "devalue": "^5.6.4",
    "dompurify": "^3.3.3",
    "esbuild": "^0.25.0",
    "fastify": "^5.8.2",
    "file-type": "^21.3.3",
    "flatted": "^3.4.0",
    "jspdf": "^4.2.1",
    "minimatch": "^9.0.7",
    "next": "^16.1.7",
    "undici": "^7.24.0"
  }
}
