# Production Database Configuration
# Copy to production.env and set real values. production.env is gitignored and must not be committed.
DB_HOST=production-db-host
DB_PORT=5432
DB_USER=functionfly_prod
DB_PASSWORD=${DB_PASSWORD}  # Set via environment variable
DB_NAME=functionfly_prod
DB_SSLMODE=require

# Connection Pool Settings (Production optimized)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=10m
DB_CONN_MAX_IDLE_TIME=5m

# PostgreSQL Production Settings
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_DEFAULT_STATISTICS_TARGET=100

# Backup Configuration
DB_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM UTC
DB_BACKUP_RETENTION_DAYS=30

# Choose your storage backend (cheaper alternatives to S3):
# - b2: Backblaze B2 (~$0.005/GB/month - RECOMMENDED for cost savings)
# - wasabi: Wasabi (~$0.04/GB/month - S3-compatible)
# - scp: SCP to another server (~$5-10/month VPS cost)
# - local: Local storage only (free)

# Example: Backblaze B2 (much cheaper than S3)
DB_BACKUP_STORAGE_BACKEND=b2
DB_BACKUP_B2_KEY_ID=your_b2_application_key_id
DB_BACKUP_B2_KEY=your_b2_application_key
DB_BACKUP_B2_BUCKET=functionfly-db-backups
DB_BACKUP_S3_PREFIX=production/

# Alternative: Wasabi (S3-compatible, cheaper than AWS)
# DB_BACKUP_STORAGE_BACKEND=wasabi
# DB_BACKUP_S3_ENDPOINT=https://s3.wasabisys.com
# DB_BACKUP_S3_BUCKET=functionfly-db-backups
# DB_BACKUP_S3_PREFIX=production/
# AWS_ACCESS_KEY_ID=your_wasabi_access_key
# AWS_SECRET_ACCESS_KEY=your_wasabi_secret_key

# Alternative: SCP to cheap VPS
# DB_BACKUP_STORAGE_BACKEND=scp
# DB_BACKUP_SCP_HOST=your-backup-server.com
# DB_BACKUP_SCP_USER=backup
# DB_BACKUP_SCP_PATH=/var/backups/functionfly
# DB_BACKUP_SCP_KEY_FILE=/path/to/ssh/key

# Monitoring
DB_MONITOR_QUERY_LOG=true
DB_MONITOR_SLOW_QUERY_THRESHOLD=1000ms