# FunctionFly Database Backup Configuration Examples
# Copy relevant sections to your environment file

# =============================================================================
# CHEAPEST OPTIONS (Recommended for cost-conscious deployments)
# =============================================================================

# Option 1: Backblaze B2 (Very Cheap - ~$0.005/GB/month)
# Much cheaper than S3, designed specifically for backups
DB_BACKUP_STORAGE_BACKEND=b2
DB_BACKUP_B2_KEY_ID=your_b2_application_key_id
DB_BACKUP_B2_KEY=your_b2_application_key
DB_BACKUP_B2_BUCKET=functionfly-db-backups
DB_BACKUP_S3_PREFIX=production/

# Option 2: Wasabi (Hot storage cheaper than S3 - ~$0.04/GB/month)
# S3-compatible API, often 80% cheaper than AWS S3
DB_BACKUP_STORAGE_BACKEND=wasabi
DB_BACKUP_S3_ENDPOINT=https://s3.wasabisys.com
DB_BACKUP_S3_BUCKET=functionfly-db-backups
DB_BACKUP_S3_PREFIX=production/
AWS_ACCESS_KEY_ID=your_wasabi_access_key
AWS_SECRET_ACCESS_KEY=your_wasabi_secret_key

# Option 3: DigitalOcean Spaces (Often cheaper than S3 in certain regions)
DB_BACKUP_STORAGE_BACKEND=s3
DB_BACKUP_S3_ENDPOINT=https://your-region.digitaloceanspaces.com
DB_BACKUP_S3_BUCKET=functionfly-db-backups
DB_BACKUP_S3_PREFIX=production/
AWS_ACCESS_KEY_ID=your_do_spaces_key
AWS_SECRET_ACCESS_KEY=your_do_spaces_secret

# Option 4: SCP to another VPS/server (Very cheap if you have another server)
# Cost: Only the cost of another cheap VPS (~$5-10/month)
DB_BACKUP_STORAGE_BACKEND=scp
DB_BACKUP_SCP_HOST=your.backup.server.com
DB_BACKUP_SCP_USER=backup
DB_BACKUP_SCP_PATH=/var/backups/functionfly
DB_BACKUP_SCP_KEY_FILE=/path/to/ssh/private/key

# Option 5: Rsync to local network storage or cheap VPS
DB_BACKUP_STORAGE_BACKEND=rsync
DB_BACKUP_RSYNC_DEST=user@backup-server:/var/backups/functionfly/

# =============================================================================
# SELF-HOSTED OPTIONS (Free if you have the infrastructure)
# =============================================================================

# Option 6: MinIO (Self-hosted S3-compatible storage)
# Free to run on your own infrastructure
DB_BACKUP_STORAGE_BACKEND=minio
DB_BACKUP_MINIO_ENDPOINT=http://your-minio-server:9000
DB_BACKUP_S3_BUCKET=functionfly-db-backups
DB_BACKUP_MINIO_ACCESS_KEY=your_minio_access_key
DB_BACKUP_MINIO_SECRET_KEY=your_minio_secret_key

# Option 7: Local storage with external drive/NAS (Free)
# Just keep backups local - add your own replication strategy
DB_BACKUP_STORAGE_BACKEND=local
# Backups stay in /var/backups/functionfly

# =============================================================================
# OTHER CLOUD OPTIONS
# =============================================================================

# Option 8: Google Cloud Storage (Often cheaper than S3 in some regions)
DB_BACKUP_STORAGE_BACKEND=gcs
DB_BACKUP_GCS_BUCKET=functionfly-db-backups
DB_BACKUP_GCS_KEY_FILE=/path/to/gcp-service-account.json
DB_BACKUP_S3_PREFIX=production/

# =============================================================================
# AWS S3 (Most expensive option - keep as fallback)
# =============================================================================

DB_BACKUP_STORAGE_BACKEND=s3
DB_BACKUP_S3_BUCKET=functionfly-db-backups
DB_BACKUP_S3_PREFIX=production/
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# COMMON SETTINGS (Apply to all configurations)
# =============================================================================

# Retention policy (days to keep backups)
DB_BACKUP_RETENTION_DAYS=30

# Database connection (same for all)
DB_HOST=postgres
DB_PORT=5432
DB_USER=functionfly_prod
DB_PASSWORD=your_secure_password
DB_NAME=functionfly_prod