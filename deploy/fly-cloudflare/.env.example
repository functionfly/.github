# FunctionFly Fly.io + Cloudflare Deployment Environment Variables
# Copy to .env and fill in your values
# These are runtime secrets set via: fly secrets set KEY="value" -a functionfly-api

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
# Get from Neon Console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/functionfly?sslmode=require

# =============================================================================
# REDIS (Upstash)
# =============================================================================
# Get from Upstash Console: https://console.upstash.com
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-here
# Generate with: openssl rand -hex 32
API_SHARED_SECRET=your-internal-api-secret-here

# =============================================================================
# API KEYS (AI Providers)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# DRE (Distributed Runtime Environment)
# =============================================================================
# Generate with: openssl rand -base64 32
DRE_NODE_KEY=base64-encoded-ed25519-key

# =============================================================================
# STRIPE (Billing)
# =============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# CLOUDFLARE
# =============================================================================
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# =============================================================================
# FLY.IO
# =============================================================================
# Create at: https://fly.io/user/personal_access_tokens
FLY_API_TOKEN=your-fly-api-token
