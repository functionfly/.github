# Build stage
FROM golang:1.25-bookworm AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gcc \
    libc6-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o orchestrator-api ./cmd/orchestrator-api

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 functionfly && \
    useradd -u 1000 -g functionfly -s /bin/false -M functionfly

# Copy binary from builder
COPY --from=builder /app/orchestrator-api .

# Copy migrations
COPY --from=builder /app/migrations ./migrations

# Set ownership
RUN chown -R functionfly:functionfly /app

# Switch to non-root user
USER functionfly

# Expose ports
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application
# Note: --skip-migrations is required due to duplicate sequence numbers in migrations/
# Schema is applied via direct SQL during initial setup instead
ENTRYPOINT ["./orchestrator-api", "--skip-migrations"]
