# Dockerfile.microvm — builds the functionfly-microvm binary and packages it
# with the Firecracker binary and a compatible Linux kernel for MicroVM execution.
#
# Build context: repo root
#   docker build -f deploy/production/Dockerfile.microvm -t functionfly/microvm-orchestrator:latest .
#
# The resulting image expects VM images (vmlinux + python311.ext4) to be mounted
# at /var/lib/functionfly/vmimages at runtime (see docker-compose.yml / DaemonSet).

# ── Stage 1: Rust build ──────────────────────────────────────────────────────
FROM rust:1.82-bookworm AS rust-builder

WORKDIR /build

# Cache dependency downloads separately from source compilation.
COPY runtimes/microvm/Cargo.toml runtimes/microvm/Cargo.lock ./
RUN mkdir src && echo "fn main(){}" > src/main.rs && cargo build --release 2>/dev/null || true
RUN rm -rf src

COPY runtimes/microvm/src ./src
RUN cargo build --release

# ── Stage 2: Download Firecracker ────────────────────────────────────────────
FROM debian:bookworm-slim AS fc-downloader

ARG FIRECRACKER_VERSION=1.10.1
ARG FC_ARCH=x86_64

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
    "https://github.com/firecracker-microvm/firecracker/releases/download/v${FIRECRACKER_VERSION}/firecracker-v${FIRECRACKER_VERSION}-${FC_ARCH}.tgz" \
    -o /tmp/firecracker.tgz \
    && tar -xzf /tmp/firecracker.tgz -C /tmp \
    && mv "/tmp/release-v${FIRECRACKER_VERSION}-${FC_ARCH}/firecracker-v${FIRECRACKER_VERSION}-${FC_ARCH}" \
          /usr/local/bin/firecracker \
    && chmod +x /usr/local/bin/firecracker \
    && /usr/local/bin/firecracker --version

# ── Stage 3: Runtime image ───────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        # Runtime libs required by firecracker (libseccomp) and our binary
        libseccomp2 \
        # Network utilities for tap device management
        iproute2 \
        iptables \
        # Health check
        curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for the orchestrator process (Firecracker itself runs
# as this user; KVM access is granted via the device node permissions).
RUN groupadd -g 1000 microvm && useradd -u 1000 -g microvm -m -s /bin/bash microvm

# Firecracker binary
COPY --from=fc-downloader /usr/local/bin/firecracker /usr/local/bin/firecracker

# MicroVM orchestrator binary
COPY --from=rust-builder /build/target/release/functionfly-microvm /usr/local/bin/functionfly-microvm

# Directory for API sockets and temp files (owned by the microvm user)
RUN mkdir -p /var/lib/functionfly/vmimages \
    && mkdir -p /tmp/functionfly-fc \
    && chown -R microvm:microvm /tmp/functionfly-fc

# Expose metrics/API port (default 9091)
EXPOSE 9091

# Drop to non-root for the orchestrator process.
# NOTE: the container still needs /dev/kvm accessible (group kvm or 0666).
USER microvm

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:9091/health || exit 1

ENTRYPOINT ["/usr/local/bin/functionfly-microvm"]
CMD ["--image-path=/var/lib/functionfly/vmimages", "--port=9091"]
