# Edge Caddyfile Environment Variables
# Copy this to .env.edge and customize for your deployment

# Domain for edge endpoint
EDGE_DOMAIN=edge.example.com

# Email for TLS certificate renewal notifications
EDGE_EMAIL=ops@example.com

# Upstream configuration (where SAR runtime is running)
EDGE_UPSTREAM_HOST=localhost
EDGE_UPSTREAM_PORT=8082

# Load balancer edge nodes (host:port format)
EDGE_NODE_1=217.160.124.206:443
EDGE_NODE_2=209.46.125.113:443

# Health check configuration
EDGE_HEALTH_URI=/health
EDGE_HEALTH_INTERVAL=10s
EDGE_HEALTH_TIMEOUT=5s
EDGE_FAIL_DURATION=30s
EDGE_MAX_FAILS=3
