# Paperclip deployment (authenticated + private)
# Copy to .env and set at least BETTER_AUTH_SECRET.
# See deploy/paperclip/README.md.

# Required for authenticated mode (generate a long random string)
BETTER_AUTH_SECRET=

# Deployment mode and exposure (do not change for internal use)
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# URL where operators reach Paperclip (for auth redirects and links)
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Optional: LLM keys if agents will use them
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Postgres (used by Docker Compose; when set, Paperclip uses this instead of embedded Postgres)
# PAPERCLIP_DB_PASSWORD=paperclip

# Data persistence (default in container: /paperclip)
PAPERCLIP_HOME=/paperclip
PAPERCLIP_PORT=3100
PAPERCLIP_DATA_DIR=./data/docker-paperclip
