FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o health-monitor ./cmd/health-monitor

FROM alpine:latest

# Use official Infisical CLI image as base for secrets injection
# Multi-stage: copy binary from builder, use infisical image for running
COPY --from=builder /app/health-monitor .

WORKDIR /app

# Run the binary directly - Infisical token injection should happen at runtime
# via environment variables or secrets manager integration
CMD ["./health-monitor"]