FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy only dirs needed for orchestrator-api (faster than COPY . . and avoids accidental bloat)
COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o orchestrator-api ./cmd/orchestrator-api

FROM alpine:latest

# Install curl for healthcheck and other utilities
RUN apk --no-cache add ca-certificates curl wget

WORKDIR /root/

# Copy the binary and migrations (internal/storage/sql/migrations matches DB version format 20260217200000)
COPY --from=builder /app/orchestrator-api .
COPY --from=builder /app/internal/storage/sql/migrations ./internal/storage/sql/migrations

# Expose port
EXPOSE 8080

# Run with --skip-migrations. Use shell form so Fly's proxy sees the app listening on 0.0.0.0:8080.
CMD ["./orchestrator-api", "--skip-migrations"]
