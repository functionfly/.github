# FunctionFly Caddy Configuration
# This Caddyfile sets up the edge proxy for FunctionFly with:
# - Automatic HTTPS/TLS termination
# - Public routing endpoint /{appSlug}/*
# - Rate limiting per app
# - Proxy to orchestrator for route decisions and backend proxying
# - @username profile and function routes
# - Subdomain routing for app, admin, run, registry, docs

# Global settings
{
    # Enable automatic HTTPS with HTTP to HTTPS redirects
    auto_https on
    # Log to stdout for Docker
    log {
        output stdout
        format json
    }
}

# Main domain - serve marketing site from static files
functionfly.com {
    # Serve static marketing site
    root * /var/www/functionfly
    try_files {path} /index.html
    file_server

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss:;"
    }

    # Rate limiting for the entire domain
    rate_limit {
        zone static {
            key {remote_host}
            window 1m
            events 100
        }
    }

    # Health check endpoint (public)
    /health {
        respond "OK" 200
    }

    # NEW: @username profile routes - /@/{username}
    /@/* {
        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # NEW: @username function routes - /@/{username}/v1/fx/{functionName}
    /@/*/v1/fx/* {
        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Public routing endpoint: /{appSlug}/*
    handle /{appSlug}/* {
        # Rate limiting per app
        rate_limit {
            zone per_app {
                key {path.0}  # appSlug from path
                window 1m
                events 1000   # Higher limit per app
            }
        }

        # Forward to orchestrator API for routing and proxying
        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}

            # Health check settings for the orchestrator
            health_uri /health
            health_interval 30s
            health_timeout 10s
        }
    }

    # API routes - proxy to orchestrator
    /v1/* {
        # Rate limiting for API calls
        rate_limit {
            zone api {
                key {remote_host}
                window 1m
                events 100
            }
        }

        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Playground routes (public) - /run/{appSlug}/{functionName} and /run/{author}/{name}
    /run/* {
        # More permissive rate limiting for playground
        rate_limit {
            zone playground {
                key {remote_host}
                window 1m
                events 60
            }
        }

        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Function page routes (public) - /fx/{author}/{name}
    /fx/* {
        # More permissive rate limiting for function pages
        rate_limit {
            zone function_page {
                key {remote_host}
                window 1m
                events 120
            }
        }

        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Replay routes (public) - /replay/{executionId}
    /replay/* {
        # More permissive rate limiting for replay
        rate_limit {
            zone replay {
                key {remote_host}
                window 1m
                events 120
            }
        }

        reverse_proxy orchestrator-api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Default response for unmatched routes
    respond "FunctionFly - Not Found" 404
}

# App (dashboard) subdomain - app.functionfly.com
app.functionfly.com {
    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss:; form-action 'self' https://api.functionfly.com https://api.staging.functionfly.com;"
    }

    reverse_proxy dashboard:3000 {
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}

# Admin UI subdomain - admin.functionfly.com (separate origin from app)
admin.functionfly.com {
    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss:; form-action 'self' https://api.functionfly.com https://api.staging.functionfly.com;"
    }

    reverse_proxy dashboard:3000 {
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}

# Execution subdomain - run.functionfly.com (high traffic optimization)
run.functionfly.com {
    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss:;"
    }

    # Cache responses for better performance
    @cacheable {
        path /@*/*
    }

    cache @cacheable {
        header_regexp Cache-Control "public"
        default_max_age 60
    }

    reverse_proxy orchestrator-api:8080 {
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}

