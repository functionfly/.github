# Auth site subdomain - auth.functionfly.com (invite-only signup)
auth.functionfly.com {
    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.functionfly.com wss:; form-action 'self' https://api.functionfly.com https://api.staging.functionfly.com;"
    }

    # Serve static auth site
    root * /var/www/auth
    try_files {path} /index.html
    file_server
}

# CDN subdomain - cdn.functionfly.com (SDK, docs, static assets with edge caching)
# API serves these under /v1/sdk, /v1/docs, /v1/static – rewrite path before proxying
cdn.functionfly.com {
    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: wss:;"
    }

    # Rewrite /sdk|docs|static -> /v1/sdk|docs|static so orchestrator routes match
    rewrite * /v1{uri}

    # Cache static asset responses at the edge
    @cdn_cache path /v1/sdk/* /v1/docs/* /v1/static/*
    cache @cdn_cache {
        header_regexp Cache-Control "public"
        default_max_age 86400
    }

    reverse_proxy orchestrator-api:8080 {
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}
