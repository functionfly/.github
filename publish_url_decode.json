  "trust_level": "high",
  "description": "URL percent-decode a string.",
  "tags": ["url", "decode", "encoding", "percent-encoding"],
  "visibility": "public",
  "pricing": { "type": "free" },
  "source_hash": "f86e888c97adcdd83352319be4e7e010f909de73b0a0f9e3f0169ebd470f483b",
  "manifest": {
    "name": "url-decode",
    "version": "1.0.0",
    "runtime": "python3.11",
    "title": "URL Decode",
    "description": "URL percent-decode a string.",
    "handler": "handler",
    "timeout_ms": 5000,
    "memory_mb": 128,
    "deterministic": true,
    "cache_ttl": 86400,
    "side_effects": "none",
    "idempotent": true,
    "public": true,
    "category": "encoding",
    "tags": ["url", "decode", "encoding", "percent-encoding"],
    "capabilities": [],
    "input": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "URL percent-encoded string to decode" }
      },
      "example": { "text": "hello%20world" }
    },
    "output": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "result": { "type": "string", "description": "Decoded string" },
        "error": { "type": "string", "description": "Error message if ok is false" }
      },
      "example": { "ok": true, "result": "hello world" }
    }
  },
  "source": {
    "code": "from urllib.parse import unquote\n\n\ndef handler(event):\n    try:\n        if isinstance(event, dict):\n            text = event.get(\"text\", \"\")\n        else:\n            text = str(event) if event is not None else \"\"\n\n        if text is None:\n            return {\"ok\": False, \"error\": \"Missing required field: text\"}\n\n        if not isinstance(text, str):\n            text = str(text)\n\n        result = unquote(text)\n        return {\"ok\": True, \"result\": result}\n    except Exception as e:\n        return {\"ok\": False, \"error\": str(e)}\n",
    "runtime": "python3.11"
  }
}
