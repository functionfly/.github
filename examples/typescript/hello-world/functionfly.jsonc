{
  "name": "hello-world",
  "version": "1.0.0",
  "runtime": "bun",
  "title": "Hello World",
  "description": "Basic TypeScript function that returns a greeting",
  "category": "examples",
  "tags": ["typescript", "hello-world", "basic"],
  "entry": "main.ts",
  "handler": "handler",
  "memory": "128MB",
  "timeout": "5s",
  "environment": {
    "GREETING": "Hello",
  },
  "example": {
    "input": { "name": "World" },
    "output": { "message": "Hello, World!" },
  },
}
