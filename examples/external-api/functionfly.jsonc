{
  "name": "external-api",
  "version": "1.0.0",
  "runtime": "python3.11",
  "description": "Example function demonstrating external API capability",
  "entry": "main.py",
  "handler": "handler",
  "memory": "128MB",
  "timeout": "15s",
  "capabilities": [
    "external_api"
  ],
  "environment": {
    "API_BASE_URL": "https://httpbin.org",
    "API_TIMEOUT": "10"
  }
}