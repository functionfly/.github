  "manifest": {
    "name": "url-encode",
    "version": "1.0.0",
    "runtime": "python3.11",
    "title": "URL Encode",
    "description": "URL percent-encode a string.",
    "handler": "handler",
    "timeout_ms": 5000,
    "memory_mb": 128,
    "deterministic": true,
    "cache_ttl": 86400,
    "side_effects": "none",
    "idempotent": true,
    "public": true,
    "category": "encoding",
    "tags": ["url", "encode", "encoding", "percent-encoding"],
    "capabilities": [],
    "input": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "String to URL-encode" }
      },
      "example": { "text": "hello world" }
    },
    "output": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "result": { "type": "string", "description": "URL percent-encoded string" },
        "error": { "type": "string", "description": "Error message if ok is false" }
      },
      "example": { "ok": true, "result": "hello%20world" }
    }
  },
  "source": {
    "code": "from urllib.parse import quote\n\n\ndef handler(event):\n    try:\n        if isinstance(event, dict):\n            text = event.get(\"text\", \"\")\n        else:\n            text = str(event) if event is not None else \"\"\n\n        if text is None:\n            return {\"ok\": False, \"error\": \"Missing required field: text\"}\n\n        if not isinstance(text, str):\n            text = str(text)\n\n        result = quote(text, safe=\"\")\n        return {\"ok\": True, \"result\": result}\n    except Exception as e:\n        return {\"ok\": False, \"error\": str(e)}\n",
    "runtime": "python3.11"
  }
}
