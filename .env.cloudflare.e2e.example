# Copy to .env.cloudflare.e2e and fill in. Do not commit .env.cloudflare.e2e.
# Run E2E: source .env.cloudflare.e2e && go test ./internal/adapters/cloudflare -run E2E -v -timeout 120s -count=1

# Required for E2E
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: test HTTP invocation (script URL and /healthz)
# Your Workers subdomain from Cloudflare dashboard (e.g. mycompany for mycompany.workers.dev)
CLOUDFLARE_WORKERS_SUBDOMAIN=
