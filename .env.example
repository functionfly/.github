# Copy to .env and fill in values (gitignored). Canonical store: Infisical — see docs/INFISICAL_SETUP.md
# Sync Fly.io runtime secrets from Infisical: ./scripts/sync-infisical-to-fly.sh
# Local: infisical run -- make dev  OR  source .env after copying from this file.
#
# Database: local Postgres default 5432; Docker postgres use 5434
# For Neon: set DATABASE_URL (pooled string from Neon Console) or DB_* below; see docs/NEON.md
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/functionfly?sslmode=require
# Optional: for Neon CLI (make neon-cs, neon-branches, etc.). Create at https://console.neon.tech/app/settings/api-keys
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH=main
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=functionfly
DB_SSLMODE=disable
# Optional: Neon read replicas (hybrid) – see docs/NEON.md
# DB_READ_REPLICA_ENABLED=true
# DB_REPLICA_1_HOST=ep-xxx-readonly-pooler.region.aws.neon.tech
# DB_REPLICA_1_PORT=5432
# DB_REPLICA_1_WEIGHT=1
# DB_REPLICA_1_PRIORITY=1
# DB_REPLICA_1_REGION=us-east-1

# Redis: local default 6379 (Docker redis maps to 6380)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
ARTIFACT_TTL=168h

# Upstash Redis (alternative to standard Redis)
# Get these from https://console.upstash.com - both required for Upstash
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Server
PORT=8080
# Local development: set DEVELOPMENT=true so CORS allows localhost, advanced security is relaxed, and permission checks are bypassed for admin routes
# DEVELOPMENT=true

# Stripe billing (required for add-on checkout + webhook entitlement sync)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SF_ADDON_HOT_CACHE=price_...
# STRIPE_PRICE_SF_ADDON_SECURITY=price_...
# STRIPE_PRICE_SF_ADDON_AI_MEMORY=price_...
# STRIPE_PRICE_SF_ADDON_INSIGHTS=price_...

# Stripe Metered Billing (usage-based billing via Meter Events API)
# STRIPE_OVERAGE_METER_NAME=functionfly_overage  # Meter event name for overage billing

# Stripe Meter Usage Scheduler (automated overage reporting)
# STRIPE_METER_SCHEDULER_ENABLED=true             # Enable automatic usage reporting
# STRIPE_METER_SCHEDULER_CRON=0 * * * *           # Run every hour (default)
# STRIPE_METER_SCHEDULER_DRY_RUN=false            # Set to true to test without reporting
# STRIPE_METER_SCHEDULER_LOOKBACK_HOURS=1         # How far back to aggregate usage
# STRIPE_METER_SCHEDULER_MAX_TENANTS=100          # Max tenants to process per run

# Chargeback Automated Response (dispute automation)
CHARGEBACK_AUTO_REFUND_ENABLED=true                  # Enable auto-refund for small disputes
CHARGEBACK_AUTO_REFUND_THRESHOLD_CENTS=5000          # Max amount to auto-refund ($50)
CHARGEBACK_AUTO_REFUND_ALLOWED_REASONS=duplicate,product_not_received  # Reasons eligible for auto-refund
CHARGEBACK_EVIDENCE_AUTO_SUBMIT=true                # Auto-submit evidence to Stripe
CHARGEBACK_CUSTOMER_NOTIFICATION_ENABLED=true        # Send customer notifications
CHARGEBACK_ADMIN_ESCALATION_ENABLED=true            # Escalate large disputes to admin

# Exchange Rate Configuration (multi-currency support)
# ENABLE_EXCHANGE_RATE_SYNC=true               # Enable scheduled sync (default: true)
# EXCHANGE_RATE_SYNC_CRON=0 0 * * *           # Cron: daily at midnight
# EXCHANGE_RATE_CACHE_TTL=15m                 # Live rate cache TTL (default: 15 minutes)
# STRIPE_SECRET_KEY=                          # If set, uses Stripe live rates (+1% markup)

# Edge monitoring: probe https://edge.functionfly.com/healthz every 5s; stats at GET /api/v1/status/edge
EDGE_HEALTH_URL=https://edge.functionfly.com
EDGE_HEALTH_SECRET=
# Optional: list edge VPS nodes for status UI (host:region,host:region). Default: 209.46.125.113 (Americas/APAC), 217.160.124.206 (Europe/Africa)
# EDGE_NODES=209.46.125.113:Americas / APAC,217.160.124.206:Europe / Africa

# JWT
# Generate a secure secret with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Security
# Generate a secure secret with: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=*

# Runtime API Token (shared secret for authenticating requests to runtime /execute endpoints)
# All runtimes (bun, deno, kotlin, ruby, nodejs, wasmedge, prism, microvm) accept this token
# via Authorization: Bearer <token>. Generate with: openssl rand -hex 32
# In production (ENVIRONMENT=production), runtimes log an error if this is unset.
# RUNTIME_API_TOKEN=
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
CORS_ALLOWED_HEADERS=Accept, Content-Type, Content-Length, Accept-Encoding, X-CSRF-Token, Authorization, X-FFLY-Timestamp, X-FFLY-Signature, x-neon-client-info
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self';
HSTS_MAX_AGE=31536000

# Production Security
PRODUCTION_ENV=false              # Set to 'true' in production to enable security middleware
STRICT_IP_VALIDATION=true         # Set to 'false' to allow proxy rotation for admin sessions

# Password Hashing (Argon2id)
ARGON2_TIME_COST=3                # OWASP minimum for sensitive applications
ARGON2_MEMORY_COST_KB=65536       # 64MB memory cost

# Account Security
MAX_LOGIN_ATTEMPTS=5              # Failed attempts before account lockout
ACCOUNT_LOCKOUT_DURATION_MINUTES=15 # Lockout duration in minutes

# Logging
LOG_LEVEL=info

# Database Encryption
DB_ENCRYPTION_ENABLED=true
# Generate a secure master key with: openssl rand -hex 32
DB_MASTER_KEY_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Advanced Security Middleware
ADVANCED_SECURITY_SLIDING_WINDOW_LIMIT=100
ADVANCED_SECURITY_SLIDING_WINDOW_MINUTES=1
ADVANCED_SECURITY_TOKEN_BUCKET_RATE=10.0
ADVANCED_SECURITY_TOKEN_BUCKET_BURST=20
ADVANCED_SECURITY_ENABLE_BOT_DETECTION=true
ADVANCED_SECURITY_ENABLE_TRAFFIC_ANALYSIS=true
ADVANCED_SECURITY_SUSPICIOUS_THRESHOLD=10
ADVANCED_SECURITY_BLOCK_MINUTES=15
ADVANCED_SECURITY_CIRCUIT_BREAKER_THRESHOLD=0.5
ADVANCED_SECURITY_CIRCUIT_BREAKER_MINUTES=1
ADVANCED_SECURITY_QUEUE_SIZE=1000
ADVANCED_SECURITY_QUEUE_SECONDS=30
ADVANCED_SECURITY_BLOCKED_COUNTRIES=
ADVANCED_SECURITY_BLOCKED_IPS=
ADVANCED_SECURITY_ALLOWED_IPS=
ADVANCED_SECURITY_ENABLE_SQL_INJECTION_FILTER=true
ADVANCED_SECURITY_ENABLE_XSS_FILTER=true
ADVANCED_SECURITY_ENABLE_PATH_TRAVERSAL_FILTER=true
ADVANCED_SECURITY_METRICS_ENABLED=true

# Paperclip integration (internal control-plane: webhook adapter + cost bridge)
# PAPERCLIP_WEBHOOK_SECRET=     # required if you want to auth webhook calls (X-Paperclip-Webhook-Secret)
# PAPERCLIP_BASE_URL=http://localhost:3100
# PAPERCLIP_API_KEY=            # for posting issue comments and cost-events
# FUNCTIONFLY_BASE_URL=http://localhost:8080
# FUNCTIONFLY_AGENT_API_KEY=    # agent API key used when adapter calls /v1/agent/execute

# DRE (Deterministic Reliable Execution) – optional keys for signing FXCERTs
# When set, execution certificates include signatures and Key IDs are shown in the UI.
# Omit to keep unsigned certs (e.g. bootstrap / dev). Prefer storing in Infisical in production.
# DRE_NODE_PRIVATE_KEY=     # base64-encoded 64-byte Ed25519 private key (node signature)
# DRE_NODE_PRIVATE_KEY_PATH= # or path to file (raw 64 bytes or base64)
# DRE_PLATFORM_PRIVATE_KEY= # optional: base64 64-byte Ed25519 platform key (platform signature)
# DRE_PLATFORM_PRIVATE_KEY_PATH= # or path to file for platform key
# DRE_NODE_ID=bootstrap      # node identifier (default: bootstrap)
# DRE_REGION=internal        # region (default: internal)

# Function Verification Services (ClamAV/YARA). For local: localhost, e.g. http://localhost:3310
CLAMAV_URL=http://localhost:3310
YARA_URL=http://localhost:8082
VERIFICATION_ENABLED=true
VERIFICATION_TIMEOUT_SECONDS=30
VERIFICATION_MAX_FILE_SIZE_MB=10
VERIFICATION_CACHE_TTL_MINUTES=60

# Trust Levels Configuration
MINIMUM_TRUST_LEVEL=standard
TRUST_LEVEL_STANDARD_ENABLED=true
TRUST_LEVEL_HIGH_ENABLED=true
TRUST_LEVEL_ENTERPRISE_ENABLED=true
TRUST_LEVEL_STANDARD_REQUIRE_MALWARE_SCAN=true
TRUST_LEVEL_HIGH_REQUIRE_SIGNATURE_VERIFICATION=true
TRUST_LEVEL_HIGH_REQUIRE_APPROVAL=true
TRUST_LEVEL_ENTERPRISE_REQUIRE_MANUAL_APPROVAL=true

# Archive Storage (PostgreSQL-based for cost efficiency)
ARCHIVE_ENABLED=true
ARCHIVE_RETENTION_DAYS=2555  # ~7 years for compliance
ARCHIVE_CLEANUP_INTERVAL_HOURS=168  # Weekly cleanup
# Envelope encryption (production): 32-byte KEK as base64 or hex. When set, DEK is stored wrapped; leave unset for legacy raw DEK.
# ARCHIVE_MASTER_KEY=
# ARCHIVE_ENCRYPTION_KEY_ID=  # Key reference for metadata (e.g. KMS key ID or vault path)

# Secret Version Retention (cleanup old secret versions to prevent unbounded DB growth)
# SECRET_VERSION_RETENTION_DAYS=90           # How long to keep old versions (default: 90 days, 0 to disable)
# SECRET_VERSION_KEEP_LATEST=5              # Minimum versions to keep per secret (default: 5)
# SECRET_VERSION_CLEANUP_INTERVAL=24h      # How often to run cleanup (default: 24h)
# SECRET_VERSION_CLEANUP_BATCH_SIZE=1000    # DB batch size for deletions (default: 1000)
# SECRET_VERSION_CLEANUP_VERBOSE=true     # Enable verbose debug logging
# SECRET_VERSION_CLEANUP_DRY_RUN=true      # Log only, don't actually delete (for testing)

# Supabase (Frontend) - get from Supabase project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# OAuth Providers
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub API (for release management and changelog)
GITHUB_OWNER=functionfly
GITHUB_REPO=functionfly
GITHUB_TOKEN=your-github-personal-access-token

# Sanity CMS (for content management)
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_AUTH_TOKEN=your-sanity-auth-token

# Base URL for OAuth redirects (must match your deployment URL)
BASE_URL=http://localhost:8080

# Auth frontend URL (used for verification/reset email links)
AUTH_URL=https://auth.functionfly.com

# Magic Link Authentication Settings
# MAGIC_LINK_TOKEN_EXPIRY_MINUTES=15      # Token validity in minutes (default: 15)
# MAGIC_LINK_MAX_ATTEMPTS_PER_HOUR=5      # Max requests per email per hour (default: 5)
# MAGIC_LINK_ALLOW_SIGNUP=true            # Allow new user signup via magic link (default: true)
# MAGIC_LINK_CLEANUP_SCHEDULE="0 2 * * *" # Cron schedule for cleanup (default: daily at 2AM)
# MAGIC_LINK_CLEANUP_RETENTION_DAYS=7     # Days to keep used/expired links (default: 7)
# MAGIC_LINK_CLEANUP_DISABLED=false       # Set to true to disable cleanup job

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# Open Router (optional): AI-generated descriptions in Admin Registry. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Generation Cache Configuration (Redis-backed for distributed deployments)
# When OPENROUTER_API_KEY is set, the generation service uses LLM for code generation
GENERATION_CACHE_REDIS_ENABLED=true  # Set to false to use in-memory cache
GENERATION_CACHE_TTL=1800  # Cache TTL in seconds (default: 30 minutes)
GENERATION_CACHE_REDIS_DB=0  # Redis DB number for generation cache

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Email: Resend (preferred) or SMTP. Without both, dev uses mock email unless SMTP_HOST points at Mailpit.
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...   # for POST /v1/webhooks/resend
# RESEND_REPLY_TO=support@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=FunctionFly

# Email retry configuration (for transient failures like rate limits)
# EMAIL_MAX_RETRIES=3                    # number of retry attempts (default: 3)
# EMAIL_RETRY_BASE_WAIT_SECONDS=1        # base wait time in seconds between retries (default: 1)

# Mailchimp Newsletter Integration (audience sync for marketing emails)
# Get API key from: Mailchimp → Account → Extras → API keys
# Server prefix is the last part of your API key (e.g., "us1", "us21")
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=us1
# MAILCHIMP_DEFAULT_LIST_ID=              # Found in Mailchimp → Audience → Settings → Audience name and defaults
# MAILCHIMP_WEBHOOK_SECRET=              # For validating incoming webhooks (generate a random string)
# MAILCHIMP_SYNC_ENABLED=true            # Set to false to disable automatic sync to Mailchimp

# SMTP fallback (e.g. Mailpit: SMTP_HOST=localhost SMTP_PORT=1025)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Monitoring (Alertmanager, Prometheus, Grafana)
MONITORING_BASIC_AUTH_HASH=$2y$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/X4b6nPUEK.qj6q.mq  # bcrypt hash for basic auth - generate with: htpasswd -nbBC 12 admin <password> | cut -d: -f2

# Datadog (optional — Prometheus remote_write evaluation; see deploy/datadog/README.md)
# Get your API key at: https://app.datadoghq.com/organization-settings/api-keys
# DD_API_KEY=
# DD_SITE=datadoghq.com  # use datadoghq.eu for EU region

# Cloud Storage Configuration (optional - defaults to local filesystem)
# Set STORAGE_BACKEND to "s3" or "r2" for cloud storage. See docs/OBJECT_STORAGE.md.
STORAGE_BACKEND=local  # Options: local, s3, r2
STORAGE_BUCKET=functionfly-uploads

# AWS S3 Configuration (when STORAGE_BACKEND=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3-compatible custom endpoint (MinIO, Backblaze B2, Wasabi, DO Spaces)
# When set with STORAGE_BACKEND=s3, requests go to this endpoint; path-style is used.
# STORAGE_PUBLIC_URL=optional base URL for public object links (e.g. CDN or bucket URL)
# STORAGE_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_PUBLIC_URL=https://uploads.yourdomain.com

# =============================================================================
# CLOUDFLARE (see docs/CLOUDFLARE.md)
# =============================================================================
# DNS / API automation (scripts/update-cloudflare-dns.sh, CI, Workers)
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_ZONE_ID=your-zone-id
# CLOUDFLARE_API_TOKEN=your-api-token

# Cloudflare R2 (when STORAGE_BACKEND=r2) – use R2_* or AWS_* (R2 API token)
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT=your-r2-endpoint  # Optional: usually auto-detected
R2_PUBLIC_URL=https://cdn.yourdomain.com  # Custom domain for R2

# =============================================================================
# STATE FABRIC R2 STORAGE (Offload large data to Cloudflare R2)
# =============================================================================
# Configure R2 buckets for State Fabric large data storage. When enabled, large
# snapshots (>100KB), archived event logs, memory blobs, and replay data are
# stored in R2 while metadata remains in PostgreSQL.
#
# You can use a single bucket with prefixes (recommended for simple setups):
#   R2_STATEFABRIC_BUCKET=functionfly-statefabric
#
# Or separate buckets for different data types:
#   R2_STATEFABRIC_EVENTS_BUCKET=functionfly-events      # Archived event logs
#   R2_STATEFABRIC_SNAPSHOTS_BUCKET=functionfly-snapshots  # Snapshot data
#   R2_STATEFABRIC_MEMORY_BUCKET=functionfly-memory      # Memory blobs
#   R2_STATEFABRIC_REPLAY_BUCKET=functionfly-replays     # Replay sessions
#
# Storage configuration
R2_STATEFABRIC_BUCKET=functionfly-statefabric
# R2_STATEFABRIC_EVENTS_BUCKET=     # Optional: separate bucket for events
# R2_STATEFABRIC_SNAPSHOTS_BUCKET=  # Optional: separate bucket for snapshots
# R2_STATEFABRIC_MEMORY_BUCKET=     # Optional: separate bucket for memory
# R2_STATEFABRIC_REPLAY_BUCKET=     # Optional: separate bucket for replays
R2_STATEFABRIC_REGION=auto          # R2 region (auto, wnam, enam, weur, eeas, apac, oc)
R2_STATEFABRIC_COMPRESSION=true     # Enable gzip compression (default: true)

# =============================================================================
# STATE FABRIC CONFIGURATION
# =============================================================================
# HTTP client timeout for pipeline execution (supports time.Duration format)
# STATEFABRIC_HTTP_TIMEOUT=30s

# Maximum store size (supports GB, MB suffixes or plain bytes)
# STATEFABRIC_MAX_STORE_SIZE=500GB

# Cleanup worker settings
# STATEFABRIC_CLEANUP_INTERVAL=1h
# STATEFABRIC_CLEANUP_BATCH_SIZE=1000

# Circuit breaker configuration for pipeline execution
# STATEFABRIC_CB_FAILURE_THRESHOLD=5
# STATEFABRIC_CB_COOLDOWN=30s

# Platform settings defaults
# STATEFABRIC_MAX_FABRICS_PER_TENANT=10
# STATEFABRIC_SNAPSHOT_RETENTION_DAYS=30
# STATEFABRIC_ALLOW_PUBLIC_PIPELINES=false
# STATEFABRIC_MAINTENANCE_MODE=false

# =============================================================================
# STATE FABRIC FEATURE FLAGS
# =============================================================================
# These flags control experimental/beta features. Set to "true" to enable.
# NOTE: Features may be incomplete or unstable. Review implementation before enabling.
#
# Replay Progress Streaming (SSE)
# Enable Server-Sent Events for real-time replay progress updates.
# When enabled, active replays stream progress via SSE instead of polling.
# Recommended for production use (stable as of 2026-06).
# STATEFABRIC_FEATURE_STATEFABRIC_REPLAY_STREAMING=false
#
# Pipeline Circuit Breaker
# Prevents cascade failures when pipeline execution fails repeatedly.
# STATEFABRIC_FEATURE_STATEFABRIC_PIPELINE_CIRCUIT_BREAKER=false
#
# R2 Storage Offload
# Automatically offloads cold data to R2 when local storage is exceeded.
# STATEFABRIC_FEATURE_STATEFABRIC_R2_OFFLOAD=false
#
# Advanced Security Pack
# Enables additional security validations for StateFabric operations.
# STATEFABRIC_FEATURE_STATEFABRIC_ADVANCED_SECURITY=false
#
# Hot Cache Booster
# Enables accelerated snapshot and replay with in-memory caching.
# Required for Replay Sessions add-on.
# STATEFABRIC_FEATURE_STATEFABRIC_HOT_CACHE=false
#
# AI Memory Pack
# Enables AI-powered memory summarization and pattern recognition.
# STATEFABRIC_FEATURE_STATEFABRIC_AI_MEMORY=false

# CDN (static assets: SDK, docs, static) - see docs/CDN_SETUP.md
# CACHE_CDN_ENABLED=true
# CACHE_CDN_PROVIDER=cloudflare
# CACHE_CDN_BASE_URL=https://cdn.functionfly.com
# CACHE_CDN_MAX_AGE=86400

# =============================================================================
# EXECUTION RECEIPTS (Public shareable execution receipts)
# =============================================================================
# RECEIPT_ENABLED=true
# RECEIPT_PUBLIC_BASE_URL=https://functionfly.com/r
# RECEIPT_OG_BASE_URL=https://functionfly.com/og/receipt
# RECEIPT_SIGNING_KEY=<generate with: openssl rand -hex 32>
# RECEIPT_MILESTONE_ENABLED=false

# FRG (Function Runtime Graph) Security
# Secret for webhook signature verification (HMAC-SHA256)
# Generate with: openssl rand -hex 32
# FRG_WEBHOOK_SECRET=

# =============================================================================
# AGENT SEARCH PROVIDER CONFIGURATION
# =============================================================================
# Search provider: "mock" for development (default), "serpapi" for production
SEARCH_PROVIDER=mock
# SERP API key (required for production web search)
# Get your key at: https://serpapi.com
# SERPAPI_KEY=
# Optional: Custom SERP API URL (defaults to https://serpapi.com)
# SERPAPI_URL=https://serpapi.com
# Cache configuration
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_TTL_HOURS=24
# SEARCH_CACHE_MAX_ENTRIES=10000
# SEARCH_CACHE_CLEANUP_INTERVAL=60
# Rate limiting (requests per minute)
# SEARCH_RATE_LIMIT_PER_MINUTE=60
# Log search executions
# SEARCH_LOG_EXECUTIONS=true

# =============================================================================
# VECTOR SEARCH (pgvector-based semantic search)
# =============================================================================
# Enable vector search for agent memory, team memory, recommendations, and FRG.
# Requires pgvector extension installed in PostgreSQL.
# When disabled, falls back to text-based search (ILIKE pattern matching).
ENABLE_VECTOR_SEARCH=false

# Google Analytics (GA4 measurement ID — shared across all frontend apps)
# Get your ID from https://analytics.google.com → Admin → Data Streams
# Vite apps (dashboard, admin-dashboard, status) read VITE_GOOGLE_ANALYTICS_ID
# Astro apps (site, docs, auth, blog) read PUBLIC_GOOGLE_ANALYTICS_ID
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mixpanel (product analytics — shared across all frontend apps)
# Get your Project Token from Mixpanel → Project Settings → Keys
# Vite apps (dashboard, admin-dashboard, status) read VITE_MIXPANEL_TOKEN
# Astro apps (site, docs, auth, blog) read PUBLIC_MIXPANEL_TOKEN
# VITE_MIXPANEL_TOKEN=your_mixpanel_project_token_here
# PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token_here